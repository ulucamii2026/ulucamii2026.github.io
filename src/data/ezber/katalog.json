  "seviyeler": [
    { "kimlik": 1,
      "ad": {"tr":"İlk adım: iman ve besmele","fr":"Premier pas : la foi et la basmala","en":"First step: faith and the basmala","nl":"Eerste stap: geloof en de basmala","de":"Erster Schritt: Glaube und Basmala"},
      "amac": {"tr":"Besmeleyi, kelime-i tevhid ve şehâdeti, imanın ve İslâm’ın şartlarını ezbere söyleyebilmek.","fr":"Réciter par cœur la basmala, l’attestation de foi, les piliers de la foi et ceux de l’islam.","en":"Recite by heart the basmala, the declaration of faith, the articles of faith and the pillars of Islam.","nl":"De basmala, de geloofsbelijdenis, de geloofsartikelen en de zuilen van de islam uit het hoofd opzeggen.","de":"Die Basmala, das Glaubensbekenntnis, die Glaubensartikel und die Säulen des Islam auswendig aufsagen."} },
    { "kimlik": 2,
      "ad": {"tr":"Namaza hazırlık","fr":"Se préparer à la prière","en":"Getting ready for prayer","nl":"Voorbereiding op het gebed","de":"Vorbereitung auf das Gebet"},
      "amac": {"tr":"Otuz iki farzı tamamlamak; abdest alıp niyet ederek tekbir ve Sübhâneke ile namaza başlayabilmek.","fr":"Compléter les trente-deux obligations ; faire les ablutions, formuler l’intention et commencer la prière avec le takbir et le Soubhanaka.","en":"Complete the thirty-two obligations; perform ablution, make the intention and begin the prayer with the takbir and the Subhanaka.","nl":"De tweeëndertig verplichtingen voltooien; de wudu (rituele wassing) verrichten, de intentie maken en het gebed beginnen met de takbier en de Soebhanaka.","de":"Die zweiunddreißig Pflichten vervollständigen; den Wudu (rituelle Waschung) vornehmen, die Absicht fassen und das Gebet mit dem Takbir und dem Subhanaka beginnen."} },
    { "kimlik": 3,
      "ad": {"tr":"Kıyam, rükû ve secde","fr":"Debout, inclinaison et prosternation","en":"Standing, bowing and prostration","nl":"Staan, buiging en prosternatie","de":"Stehen, Verbeugung und Niederwerfung"},
      "amac": {"tr":"Fâtiha ve iki kısa sûreyle kıyamı, rükû ve secde tesbihleriyle rekâtları eksiksiz kılabilmek.","fr":"Accomplir les unités de prière : la Fatiha et deux courtes sourates debout, puis les glorifications de l’inclinaison et de la prosternation.","en":"Perform the units of prayer: Al-Fatihah and two short surahs while standing, then the glorifications in bowing and prostration.","nl":"De gebedseenheden verrichten: Al-Fatiha en twee korte soera’s staande, daarna de lofprijzingen bij de buiging en de prosternatie.","de":"Die Gebetseinheiten verrichten: die Fatiha und zwei kurze Suren im Stehen, dann die Lobpreisungen in Verbeugung und Niederwerfung."} },
    { "kimlik": 4,
      "ad": {"tr":"Oturuş ve selâm","fr":"Position assise et salutation finale","en":"Sitting and the closing salutation","nl":"Zitten en de afsluitende groet","de":"Sitzen und der abschließende Friedensgruß"},
      "amac": {"tr":"Oturuş duaları ve selâmla bir namazı baştan sona kılabilmek.","fr":"Accomplir une prière du début à la fin, avec les invocations de la position assise et la salutation finale.","en":"Perform a prayer from beginning to end, with the supplications of the sitting and the closing salutation.","nl":"Een gebed van begin tot eind verrichten, met de smeekbeden van het zitten en de afsluitende groet.","de":"Ein Gebet von Anfang bis Ende verrichten, mit den Bittgebeten des Sitzens und dem abschließenden Friedensgruß."} },
    { "kimlik": 5,
      "ad": {"tr":"Namaz sûreleri I","fr":"Sourates de la prière I","en":"Prayer surahs I","nl":"Gebedssoera’s I","de":"Gebetssuren I"},
      "amac": {"tr":"Namazda Fâtiha’dan sonra okunacak kısa sûreleri çoğaltmak.","fr":"Apprendre d’autres courtes sourates à réciter après la Fatiha dans la prière.","en":"Learn more short surahs to recite after Al-Fatihah in prayer.","nl":"Meer korte soera’s leren die in het gebed na Al-Fatiha worden gereciteerd.","de":"Weitere kurze Suren lernen, die im Gebet nach der Fatiha rezitiert werden."} },
    { "kimlik": 6,
      "ad": {"tr":"Namaz sûreleri II","fr":"Sourates de la prière II","en":"Prayer surahs II","nl":"Gebedssoera’s II","de":"Gebetssuren II"},
      "amac": {"tr":"Fîl’den Nâs’a kadar namaz sûrelerinin hepsini ve İnşirâh’ı ezberlemek.","fr":"Mémoriser toutes les sourates de la prière, d’Al-Fil à An-Nas, ainsi qu’Al-Inshirah.","en":"Memorise all the prayer surahs from Al-Fil to An-Nas, and Al-Inshirah.","nl":"Alle gebedssoera’s van Al-Fiel tot An-Naas en Al-Insjirah uit het hoofd leren.","de":"Alle Gebetssuren von Al-Fil bis An-Nas sowie Al-Inschirah auswendig lernen."} },
    { "kimlik": 7,
      "ad": {"tr":"Vitir, tesbihat ve ezan","fr":"Witr, glorifications et appel à la prière","en":"Witr, glorifications and the call to prayer","nl":"Witr, lofprijzingen en de gebedsoproep","de":"Witr, Lobpreisungen und Gebetsruf"},
      "amac": {"tr":"Vitirde kunut okuyabilmek, farzlardan sonra tesbihatı yapabilmek; ezanı, kāmeti, ezan duasını ve Âmentü’yü bilmek.","fr":"Réciter le qounout dans le witr et faire les glorifications après les prières obligatoires ; connaître l’adhan, l’iqama, l’invocation après l’adhan et l’Amantou.","en":"Recite the qunut in the witr and do the glorifications after the obligatory prayers; know the adhan, the iqamah, the supplication after the adhan and the Amantu.","nl":"De qoenoet in het witr-gebed reciteren en na de verplichte gebeden de lofprijzingen doen; de adhan, de iqama, de smeekbede na de adhan en de Amantoe kennen.","de":"Den Qunut im Witr-Gebet rezitieren und nach den Pflichtgebeten die Lobpreisungen sprechen; Adhan, Iqama, das Bittgebet nach dem Adhan und Amantu kennen."} },
    { "kimlik": 8,
      "ad": {"tr":"Amme cüzü","fr":"Le juz’ ‘Amma","en":"Juz’ ‘Amma","nl":"Djoez’ ‘Amma","de":"Dschuz’ ‘Amma"},
      "amac": {"tr":"Kur’an’ın son cüzünü, mushafın sonundan başına doğru tamamlamak.","fr":"Compléter le dernier juz’ du Coran, de la fin du mushaf vers son début.","en":"Complete the last juz’ of the Qur’an, from the end of the mushaf towards its beginning.","nl":"Het laatste djoez’ van de Koran voltooien, van het einde van de moesjaf naar het begin.","de":"Den letzten Dschuz’ des Korans vervollständigen, vom Ende des Mushafs zum Anfang hin."} },
    { "kimlik": "kenar",
      "ad": {"tr":"Kenar suyu","fr":"Bordure du kilim","en":"Kilim border","nl":"Rand van de kelim","de":"Kelim-Bordüre"},
      "amac": {"tr":"Bayramlar, Ramazan, hac ve özel günlerle birlikte öğrenilen dualar ve bilgiler; seviyelere bağlı değildir.","fr":"Invocations et connaissances apprises au fil des fêtes, du Ramadan, du pèlerinage et des jours particuliers ; hors niveaux.","en":"Supplications and knowledge learned with the Eids, Ramadan, the pilgrimage and special days; outside the levels.","nl":"Smeekbeden en kennis die rond de feesten, de ramadan, de bedevaart en bijzondere dagen worden geleerd; buiten de niveaus.","de":"Bittgebete und Wissen, die mit den Festen, dem Ramadan, der Pilgerfahrt und besonderen Tagen gelernt werden; außerhalb der Stufen."} }
