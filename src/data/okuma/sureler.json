    "ar": "اِلٰهِ النَّاسِۙ",
    "ses": "/media/ses/ayet/114-3.mp3",
    "sayfa": 604
   },
   {
    "n": 4,
    "ar": "مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِۙ",
