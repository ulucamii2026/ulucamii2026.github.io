    "sayfa": 0
   },
   {
    "n": 2,
    "ar": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمٖینَۙ",
    "ses": "/media/ses/ayet/1-2.mp3",
    "sayfa": 0
   },
   {
    "n": 3,
