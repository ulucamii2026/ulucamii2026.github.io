    "ses": "/media/ses/ayet/1-3.mp3",
    "sayfa": 0
   },
   {
    "n": 4,
    "ar": "مَالِكِ یَوْمِ الدّٖینِؕ",
    "ses": "/media/ses/ayet/1-4.mp3",
    "sayfa": 0
   },
   {
    "n": 5,
    "ar": "اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعٖینُؕ",
