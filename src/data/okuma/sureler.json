    "sayfa": 0
   },
   {
    "n": 7,
    "ar": "صِرَاطَ الَّذٖینَ اَنْعَمْتَ عَلَیْهِمْۙ غَیْرِ الْمَغْضُوبِ عَلَیْهِمْ وَلَا الضَّٓالّٖینَ",
    "ses": "/media/ses/ayet/1-7.mp3",
    "sayfa": 0
   }
  ]
 },
 {
