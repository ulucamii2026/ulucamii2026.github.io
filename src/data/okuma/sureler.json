    "sayfa": 603
   },
   {
    "n": 3,
    "ar": "وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُۚ",
    "ses": "/media/ses/ayet/109-3.mp3",
    "sayfa": 603
   },
   {
