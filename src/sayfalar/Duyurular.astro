---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import YilFiltresi from '../components/YilFiltresi.astro';
import DuyuruKarti from '../components/DuyuruKarti.astro';
import { ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { duyurular } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const liste = await duyurular(dil);
const yillar = [...new Set(liste.map((d) => d.data.tarih.getFullYear()))].sort((a, b) => b - a);
const altBaslik = dil === 'tr' ? 'Camimizden haberler, duyurular ve bilgilendirmeler — Facebook sayfamızdaki geçmiş duyurular da arşiv olarak burada.' : dil === 'en' ? 'News, announcements and information from our mosque — past announcements from our Facebook page are also archived here.' : 'Nouvelles, annonces et informations de la mosquée — les anciennes annonces de notre page Facebook sont archivées ici.';
const arsivNot = dil === 'tr' ? 'Arşiv' : dil === 'en' ? 'Archive' : 'Archives';
const enNotu = 'Announcements are published in Turkish and French. An English version is not available.';
---
<Base baslik={t('nav.duyurular')} dil={dil} aciklama={dil === 'tr' ? 'Marche-en-Famenne Ulu Camii’nden güncel duyurular: program ve etkinlik haberleri, kayıt dönemleri ve vefat ilanları.' : dil === 'en' ? 'News and announcements from the Ulu Mosque of Marche-en-Famenne: programmes, activities, registration periods and obituaries.' : 'Annonces de la Mosquée Ulu Camii de Marche-en-Famenne : programmes, activités, périodes d’inscription et avis de décès.'}>
  <SayfaBasligi etiket={t('site.kisa')} baslik={t('nav.duyurular')} altBaslik={altBaslik} />
  <div class="kapsayici py-10">
    {dil === 'en' && <p class="bilgi mb-6 text-sm">{enNotu}</p>}
    {liste.length === 0 && <p class="text-(--metin-2)">{t('duyuru.bos')}</p>}
    <YilFiltresi yillar={yillar} dil={dil} />
    {yillar.map((y, idx) => (
      <section id={`yil-${y}`} data-yil={y} class="[&:not([hidden])~&:not([hidden])]:mt-12">
        <h2 class="etiket etiket-vurgu text-base cetvel pt-3 mb-4">{y}{idx > 0 && <span class="ml-2 text-(--metin-2)">· {arsivNot}</span>}</h2>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {liste.filter((d) => d.data.tarih.getFullYear() === y).map((d, i) => <DuyuruKarti dil={dil} slug={d.slug} baslik={d.data.baslik} tarih={d.data.tarih} ozet={d.data.ozet} kapak={d.data.kapak} kapakAlt={d.data.kapakAlt} etiketler={d.data.etiketler} sira={i} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
