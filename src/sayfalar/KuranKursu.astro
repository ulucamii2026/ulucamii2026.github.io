---
import IcerikSayfasi from '../components/IcerikSayfasi.astro';
import { ceviri, yol, kayitBaglantisi } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
import { DERS_YILI_ETIKETI } from '../lib/etkinlik-tarihleri';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const m = dil === 'tr'
  ? { mufredat: 'Müfredat ve yıllık ders planı', mufredatA: `${DERS_YILI_ETIKETI} dönemi: beş ders alanının konuları, kaynak kitapları ve gün gün yıllık plan.`, mufredatPdf: 'PDF (A4)',
      kitap: 'Ders kitapları', kitapA: 'Öğrenciler derslere müfredatta belirtilen kitaplar, defter ve kalemle gelir; kurs ücretsizdir.', kitapBag: 'Temin bilgileri', kitapCapa: '#ders-kitaplari',
      kayit: 'Online kayıt formu', kayitA: `${DERS_YILI_ETIKETI} dönemi kayıtları açıktır. Formu doldurduktan sonra din görevlimiz sizinle iletişime geçer.`, portal: 'Veli portalı', portalA: 'Kayıtlı öğrencilerin velileri için (yakında).', soru: 'Sorularınız için', logoAlt: 'Ulu Camii Kur’an Kursu logosu' }
  : dil === 'en'
  ? { mufredat: 'Curriculum & yearly lesson plan', mufredatA: `${DERS_YILI_ETIKETI}: topics, textbooks and the day-by-day plan for the five subjects (in Turkish).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Textbooks', kitapA: 'Students come to every lesson with the books listed in the curriculum, a notebook and a pen; the course is free of charge.', kitapBag: 'How to obtain', kitapCapa: '#manuels',
      kayit: 'Online registration form', kayitA: `Registration for the ${DERS_YILI_ETIKETI} term is open. After you submit the form, our imam will contact you.`, portal: 'Parents’ portal', portalA: 'For parents of enrolled students (coming soon).', soru: 'For your questions', logoAlt: 'Ulu Camii Qur’an School logo' }
  : { mufredat: 'Programme et plan annuel des cours', mufredatA: `${DERS_YILI_ETIKETI} : sujets, manuels et plan jour par jour des cinq matières (en turc).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Manuels', kitapA: 'Les élèves viennent à chaque cours avec les manuels prévus au programme, un cahier et de quoi écrire ; le cours est gratuit.', kitapBag: 'Où se les procurer', kitapCapa: '#manuels',
      kayit: 'Formulaire d’inscription en ligne', kayitA: `Les inscriptions ${DERS_YILI_ETIKETI} sont ouvertes. Après l’envoi du formulaire, l’imam vous contactera.`, portal: 'Portail des parents', portalA: 'Pour les parents des élèves inscrits (bientôt).', soru: 'Pour toute question', logoAlt: 'Logo de l’école coranique Ulu Camii' };
---
<IcerikSayfasi dil={dil} anahtar="kurankursu" etiket={t('nav.kurankursu')}>
  <div slot="yan" class="kart p-5 text-center">
    <img src="/media/logo/kuran-kursu-logo.svg" alt={m.logoAlt} width="120" height="120" class="mx-auto h-28 w-28" loading="lazy" />
    <p class="mt-4 text-sm text-(--metin-2)">{m.kayitA}</p>
    {site.kursKayitLinki && <a href={kayitBaglantisi(site.kursKayitLinki, dil)} target="_blank" rel="noopener" class="dugme dugme-birincil mt-4 w-full justify-center">{m.kayit}<span aria-hidden="true"> ↗</span></a>}
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.mufredat}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.mufredatA}</p>
    <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] gap-2">
      <a href={yol(dil, 'mufredat')} class="dugme dugme-ikincil justify-center">{t('nav.mufredat')}</a>
      <a href="/belgeler/kuran-kursu/Ulu-Camii-Kuran-Kursu-Mufredat-2026-2027.pdf" class="dugme dugme-ikincil justify-center" download>{m.mufredatPdf}</a>
    </div>
    <a href={yol(dil, 'yillikplan')} class="dugme dugme-ikincil mt-2 w-full justify-center">{t('nav.yillikplan')}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.kitap}</p>
    {/* Kitap adları Türkçe: FR/EN sayfada ekran okuyucu doğru okusun. */}
    <ul lang="tr" class="mt-2 grid gap-1 text-sm text-(--metin-2)">
      <li>Camiye Gidiyorum 1</li>
      <li>Camiye Gidiyorum 2</li>
      <li>Temel Dinî Bilgiler</li>
    </ul>
    <p class="mt-2 text-sm text-(--metin-2)">{m.kitapA}</p>
    <a href={yol(dil, 'kurankursu') + m.kitapCapa} class="dugme dugme-ikincil mt-3 w-full justify-center">{m.kitapBag}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.portal}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.portalA}</p>
    <a href={yol(dil, 'portal')} class="dugme dugme-ikincil mt-3 w-full justify-center">{t('nav.portal')}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{dil === 'tr' ? 'Lise sonrası' : dil === 'fr' ? 'Après le secondaire' : 'After secondary school'}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{dil === 'tr' ? 'Türkiye’de Diyanet burslu ilahiyat lisansı: Uluslararası İlahiyat Programı (UİP). Şartlar, takvim ve başvuru desteği.' : dil === 'fr' ? 'Une licence de théologie en Turquie avec bourse Diyanet : le Programme international de théologie (UİP). Conditions, calendrier et aide à la candidature.' : 'A Diyanet-funded theology degree in Türkiye: the International Theology Programme (UİP). Conditions, timeline and application support.'}</p>
    <a href={yol(dil, 'uip')} class="dugme dugme-ikincil mt-3 w-full justify-center">{t('nav.uip')}</a>
  </div>
  <p slot="yan" class="text-sm"><span class="etiket">{m.soru}</span><br /><a href={tel(site.telefon.dinGorevlisi)} class="mono inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.dinGorevlisi}</a>{site.epostaDinGorevlisi && <><br /><a href={`mailto:${site.epostaDinGorevlisi}`} class="inline-flex items-center min-h-11 -my-2 py-2">{site.epostaDinGorevlisi}</a></>}</p>
</IcerikSayfasi>
