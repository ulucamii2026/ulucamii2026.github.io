---
import IcerikSayfasi from '../components/IcerikSayfasi.astro';
import WhatsappBaglanti from '../components/WhatsappBaglanti.astro';
import { ceviri, yol, kayitBaglantisi } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
import { DERS_YILI_ETIKETI } from '../lib/etkinlik-tarihleri';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const METIN = {
  tr: { materyal: 'Ders materyalleri', materyalA: 'Her ders gününün planı (PDF) ve sınıfta kullanılan sesli, iki dilli PowerPoint sunumları; evde tekrar için indirilebilir.', mufredat: 'Müfredat ve yıllık ders planı', mufredatA: `${DERS_YILI_ETIKETI} dönemi: beş ders alanının konuları, kaynak kitapları ve gün gün yıllık plan.`, mufredatPdf: 'PDF (A4)',
      kitap: 'Ders kitapları', kitapA: 'Öğrenciler derslere müfredatta belirtilen kitaplar, defter ve kalemle gelir; kurs ücretsizdir.', kitapBag: 'Temin bilgileri', kitapCapa: '#ders-kitaplari',
      kayit: 'Online kayıt formu', kayitA: `${DERS_YILI_ETIKETI} dönemi kayıtları açıktır. Formu doldurduktan sonra din görevlimiz sizinle iletişime geçer.`, portal: 'Veli portalı', portalA: 'Yoklama, ilerleme, haftalık ezber-ödev, duyurular; giriş kayıt formundaki veli e-postasıyla.', soru: 'Sorularınız için', logoAlt: 'Ulu Camii Kur’an Kursu logosu',
      seviye: 'Yetişkinler için: Kur’an okumayı ve temel dinî bilgileri öğrenmek isteyenler seviye tespit testini doldurabilir.',
      uipEt: 'Lise sonrası', uipA: 'Türkiye’de Diyanet burslu ilahiyat lisansı: Uluslararası İlahiyat Programı (UİP). Şartlar, takvim ve başvuru desteği.' },
  en: { materyal: 'Lesson materials', materyalA: 'The lesson plan (PDF) and the bilingual PowerPoint decks with audio for every lesson day; download them for revision at home.', mufredat: 'Curriculum & yearly lesson plan', mufredatA: `${DERS_YILI_ETIKETI}: topics, textbooks and the day-by-day plan for the five subjects (in Turkish).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Textbooks', kitapA: 'Students come to every lesson with the books listed in the curriculum, a notebook and a pen; the course is free of charge.', kitapBag: 'How to obtain', kitapCapa: '#manuels',
      kayit: 'Online registration form', kayitA: `Registration for the ${DERS_YILI_ETIKETI} term is open. After you submit the form, our imam will contact you.`, portal: 'Parents’ portal', portalA: 'Attendance, progress, weekly memorisation and homework, announcements; sign in with the parent e-mail from the registration form.', soru: 'For your questions', logoAlt: 'Ulu Camii Qur’an School logo',
      seviye: 'For adults: those who wish to learn to read the Qur’an and the basics of the religion can fill in the level assessment.',
      uipEt: 'After secondary school', uipA: 'A Diyanet-funded theology degree in Türkiye: the International Theology Programme (UİP). Conditions, timeline and application support.' },
  fr: { materyal: 'Supports de cours', materyalA: 'Le plan de cours (PDF) et les présentations PowerPoint bilingues et sonores de chaque jour de cours ; à télécharger pour réviser à la maison.', mufredat: 'Programme et plan annuel des cours', mufredatA: `${DERS_YILI_ETIKETI} : sujets, manuels et plan jour par jour des cinq matières (en turc).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Manuels', kitapA: 'Les élèves viennent à chaque cours avec les manuels prévus au programme, un cahier et de quoi écrire ; le cours est gratuit.', kitapBag: 'Où se les procurer', kitapCapa: '#manuels',
      kayit: 'Formulaire d’inscription en ligne', kayitA: `Les inscriptions ${DERS_YILI_ETIKETI} sont ouvertes. Après l’envoi du formulaire, l’imam vous contactera.`, portal: 'Portail des parents', portalA: 'Présences, progression, mémorisation et devoirs de la semaine, annonces ; connexion avec l’e-mail du parent indiqué à l’inscription.', soru: 'Pour toute question', logoAlt: 'Logo de l’école coranique Ulu Camii',
      seviye: 'Pour les adultes : celles et ceux qui souhaitent apprendre à lire le Coran et les bases de la religion peuvent remplir le test de niveau.',
      uipEt: 'Après le secondaire', uipA: 'Une licence de théologie en Turquie avec bourse Diyanet : le Programme international de théologie (UİP). Conditions, calendrier et aide à la candidature.' },
  nl: { materyal: 'Lesmateriaal', materyalA: 'Het lesplan (PDF) en de tweetalige PowerPointpresentaties met geluid van elke lesdag; te downloaden om thuis te herhalen.', mufredat: 'Leerplan en jaarplanning', mufredatA: `${DERS_YILI_ETIKETI}: de onderwerpen, de handboeken en de dag-per-dagplanning van de vijf vakken (in het Turks).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Handboeken', kitapA: 'De leerlingen komen naar elke les met de boeken uit het leerplan, een schrift en een pen; de lessen zijn gratis.', kitapBag: 'Waar verkrijgbaar', kitapCapa: '#manuels',
      kayit: 'Online inschrijvingsformulier', kayitA: `De inschrijvingen voor ${DERS_YILI_ETIKETI} zijn open. Nadat u het formulier hebt verstuurd, neemt onze imam contact met u op.`, portal: 'Ouderportaal', portalA: 'Aanwezigheid, vordering, memorisatie en huiswerk van de week, mededelingen; u meldt zich aan met het e-mailadres van de ouder uit het inschrijvingsformulier.', soru: 'Voor uw vragen', logoAlt: 'Logo van de Koranschool Ulu Camii',
      seviye: 'Voor volwassenen: wie de Koran wil leren lezen en de basis van het geloof wil leren kennen, kan de niveautest invullen.',
      uipEt: 'Na het secundair onderwijs', uipA: 'Een bachelor theologie in Türkiye met een beurs van de Diyanet: het Internationaal Theologieprogramma (UİP). Voorwaarden, kalender en hulp bij uw aanvraag.' },
  de: { materyal: 'Unterrichtsmaterial', materyalA: 'Der Unterrichtsplan (PDF) und die zweisprachigen PowerPoint-Präsentationen mit Ton für jeden Unterrichtstag; zum Herunterladen für die Wiederholung zu Hause.', mufredat: 'Lehrplan und Jahresplan', mufredatA: `${DERS_YILI_ETIKETI}: die Themen, die Lehrbücher und der Tag-für-Tag-Plan der fünf Fächer (auf Türkisch).`, mufredatPdf: 'PDF (A4)',
      kitap: 'Lehrbücher', kitapA: 'Die Lernenden kommen zu jedem Unterricht mit den im Lehrplan genannten Büchern, einem Heft und einem Stift; der Unterricht ist kostenlos.', kitapBag: 'Wo erhältlich', kitapCapa: '#manuels',
      kayit: 'Online-Anmeldeformular', kayitA: `Die Anmeldungen für ${DERS_YILI_ETIKETI} sind offen. Nachdem Sie das Formular abgeschickt haben, meldet sich unser Imam bei Ihnen.`, portal: 'Elternportal', portalA: 'Anwesenheit, Fortschritt, Memorierung und Hausaufgaben der Woche, Mitteilungen; die Anmeldung erfolgt mit der E-Mail-Adresse der Eltern aus dem Anmeldeformular.', soru: 'Für Ihre Fragen', logoAlt: 'Logo der Koranschule Ulu Camii',
      seviye: 'Für Erwachsene: Wer den Koran lesen lernen und die Grundlagen der Religion kennenlernen möchte, kann den Einstufungstest ausfüllen.',
      uipEt: 'Nach der Sekundarstufe', uipA: 'Ein Theologiestudium in Türkiye mit einem Diyanet-Stipendium: das Internationale Theologieprogramm (UİP). Voraussetzungen, Zeitplan und Unterstützung bei der Bewerbung.' },
} satisfies Record<Dil, unknown>;
const m = METIN[dil];
---
<IcerikSayfasi dil={dil} anahtar="kurankursu" etiket={t('nav.kurankursu')}>
  <div slot="yan" class="kart p-5 text-center">
    <img src="/media/logo/kuran-kursu-logo.svg" alt={m.logoAlt} width="120" height="120" class="mx-auto h-28 w-28" loading="lazy" />
    <p class="mt-4 text-sm text-(--metin-2)">{m.kayitA}</p>
    {site.kursKayitLinki && <a href={kayitBaglantisi(site.kursKayitLinki, dil)} target="_blank" rel="noopener" class="dugme dugme-birincil mt-4 w-full justify-center">{m.kayit}<span aria-hidden="true"> ↗</span></a>}
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.mufredat}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.mufredatA}</p>
    <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] gap-2">
      <a href={yol(dil, 'mufredat')} class="dugme dugme-ikincil justify-center">{t('nav.mufredat')}</a>
      <a href="/belgeler/kuran-kursu/Ulu-Camii-Kuran-Kursu-Mufredat-2026-2027.pdf" class="dugme dugme-ikincil justify-center" download>{m.mufredatPdf}</a>
    </div>
    <a href={yol(dil, 'yillikplan')} class="dugme dugme-ikincil mt-2 w-full justify-center">{t('nav.yillikplan')}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.materyal}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.materyalA}</p>
    <a href={yol(dil, 'dersmateryalleri')} class="dugme dugme-ikincil mt-3 w-full justify-center">{t('nav.dersmateryalleri')}</a>
    {/* Ders günlüğü: hafta hafta işlenen konular ve sınıfın geldiği nokta (kişisel veri yok). */}
    <a href={yol(dil, 'kursgunlugu')} class="dugme dugme-ikincil mt-2 w-full justify-center">{t('nav.kursgunlugu')}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.kitap}</p>
    {/* Kitap adları Türkçe: FR/EN sayfada ekran okuyucu doğru okusun. */}
    <ul lang="tr" class="mt-2 grid gap-1 text-sm text-(--metin-2)">
      <li>Camiye Gidiyorum 1</li>
      <li>Camiye Gidiyorum 2</li>
      <li>Temel Dinî Bilgiler</li>
    </ul>
    <p class="mt-2 text-sm text-(--metin-2)">{m.kitapA}</p>
    <a href={yol(dil, 'kurankursu') + m.kitapCapa} class="dugme dugme-ikincil mt-3 w-full justify-center">{m.kitapBag}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.portal}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.portalA}</p>
    <a href={yol(dil, 'veli')} class="dugme dugme-birincil mt-3 w-full justify-center">{t('nav.veli')}</a>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.uipEt}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.uipA}</p>
    <a href={yol(dil, 'uip')} class="dugme dugme-ikincil mt-3 w-full justify-center">{t('nav.uip')}</a>
  </div>
  {/* Yetişkin yerleştirme testi; çocuk kaydıyla karışmasın diye tek satır + bağlantı. */}
  <p slot="yan" class="text-sm text-(--metin-2)">{m.seviye}<br /><a href={yol(dil, 'seviyeTesti')}>{t('nav.seviyeTesti')}<span aria-hidden="true"> →</span></a></p>
  <p slot="yan" class="text-sm"><span class="etiket">{m.soru}</span><br /><WhatsappBaglanti site={site} />{site.epostaDinGorevlisi && <><br /><a href={`mailto:${site.epostaDinGorevlisi}`} class="inline-flex items-center min-h-11 -my-2 py-2">{site.epostaDinGorevlisi}</a></>}</p>
</IcerikSayfasi>
