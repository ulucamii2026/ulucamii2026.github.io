---
/**
 * Vaazlar — liste sayfası (/tr/vaazlar, /fr/sermons, /en/sermons). İçerik anonim, açık kaynak,
 * Türkçe. Her vaaz «/<dil>/vaaz/<slug>» detay sayfasına bağlanır; kategoriye göre istemci-tarafı süzme.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { katAd, katSira } from '../i18n/vaaz-kategori';

const { dil } = Astro.props as { dil: Dil };

const hepsi = (await getCollection('vaazlar')).filter((v) => !v.data.taslak);
hepsi.sort((a, b) => (a.data.siraNo ?? 0) - (b.data.siraNo ?? 0) || a.data.baslik.localeCompare(b.data.baslik, 'tr'));

const m = {
  tr: {
    etiket: 'Vaazlar', baslik: 'Vaazlar', alt: 'Camimizde okunan vaazlardan bir derleme',
    giris: 'Aşağıdaki vaazlar herkesin istifadesine açıktır; dilediğiniz gibi okuyabilir, indirebilir ve kullanabilirsiniz. Metinler tamamen anonimdir — hiçbir kişisel bilgi içermez.',
    ara: 'Vaazlarda ara…', tumu: 'Tümü', bulunamadi: 'Bu kategoride vaaz yok.', aramaBos: 'Aramanıza uyan vaaz bulunamadı.',
    sonuc: '{n} vaaz listeleniyor', okuma: 'dk', temizle: 'Aramayı temizle',
  },
  fr: {
    etiket: 'Sermons', baslik: 'Sermons', alt: 'Une sélection de sermons prêchés dans notre mosquée',
    giris: 'Les sermons ci-dessous sont mis à la disposition de tous : vous pouvez les lire, les télécharger et les utiliser librement. Les textes sont entièrement anonymes et ne contiennent aucune donnée personnelle. (Contenu en turc.)',
    ara: 'Rechercher un sermon…', tumu: 'Tous', bulunamadi: 'Aucun sermon dans cette catégorie.', aramaBos: 'Aucun sermon ne correspond à votre recherche.',
    sonuc: '{n} sermons affichés', okuma: 'min', temizle: 'Effacer la recherche',
  },
  en: {
    etiket: 'Sermons', baslik: 'Sermons', alt: 'A collection of sermons preached at our mosque',
    giris: 'The sermons below are freely available to everyone: you may read, download and use them as you wish. The texts are fully anonymous and contain no personal data. (Content in Turkish.)',
    ara: 'Search sermons…', tumu: 'All', bulunamadi: 'No sermons in this category.', aramaBos: 'No sermon matches your search.',
    sonuc: '{n} sermons shown', okuma: 'min', temizle: 'Clear search',
  },
}[dil];

// bilgi notunun üst etiketi (açık kaynak + anonimlik, tek bakışta)
const notEtiket = { tr: 'Herkese açık · Anonim', fr: 'Libre d’accès · Anonyme', en: 'Open access · Anonymous' }[dil];

// yalnız kullanılan kategoriler, sabit sırayla (sözlük: src/i18n/vaaz-kategori.ts — okuma sayfasıyla ortak)
const kullanilan = katSira.filter((k) => hepsi.some((v) => v.data.kategori === k));
const okumaDk = (kelime?: number) => (kelime ? Math.max(1, Math.round(kelime / 180)) : null);
---
<Base baslik={m.baslik} aciklama={m.alt} dil={dil}>
  <div class="kapsayici py-8 sm:py-12">
    <SayfaBasligi etiket={m.etiket} baslik={m.baslik} altBaslik={m.alt} />
    <div class="vz-not" role="note" aria-label={notEtiket}>
      <svg class="vz-not-ikon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.6C10.4 5.2 8.4 4.5 6 4.5c-1 0-2 .1-3 .4v13.7c1-.3 2-.4 3-.4 2.4 0 4.4.7 6 2.1 1.6-1.4 3.6-2.1 6-2.1 1 0 2 .1 3 .4V4.9c-1-.3-2-.4-3-.4-2.4 0-4.4.7-6 2.1Z"/><path d="M12 6.6v13.7"/></svg>
      <div class="vz-not-metin">
        <span class="vz-not-etiket">{notEtiket}</span>
        <p>{m.giris}</p>
      </div>
    </div>

    <div class="vz-ara">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="vz-ara-giris" placeholder={m.ara} aria-label={m.ara} autocomplete="off" spellcheck="false" enterkeyhint="search" />
      <button type="button" class="vz-ara-sil" aria-label={m.temizle} hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    {kullanilan.length > 1 && (
      <div class="vz-filtre" role="group" aria-label={m.etiket}>
        <button type="button" class="vz-cip etkin" data-kat="tumu" aria-pressed="true">{m.tumu} <span class="vz-say">{hepsi.length}</span></button>
        {kullanilan.map((k) => (
          <button type="button" class="vz-cip" data-kat={k} aria-pressed="false">{katAd[k][dil]} <span class="vz-say">{hepsi.filter((v) => v.data.kategori === k).length}</span></button>
        ))}
      </div>
    )}

    <ul class="vz-izgara" role="list">
      {hepsi.map((v) => (
        <li class="vz-oge" data-kat={v.data.kategori}>
          <a href={`${yol(dil, 'anasayfa')}vaaz/${v.id}`} class="vz-kart">
            <span class="vz-kat">{katAd[v.data.kategori]?.[dil] ?? v.data.kategori}</span>
            <h2 class="vz-baslik">{v.data.baslik}</h2>
            {v.data.ozet && <p class="vz-ozet">{v.data.ozet}</p>}
            <span class="vz-meta">{okumaDk(v.data.kelime) && `${okumaDk(v.data.kelime)} ${m.okuma}`}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="vz-bos" hidden data-kategori={m.bulunamadi} data-arama={m.aramaBos}>{m.bulunamadi}</p>
    <p class="gorsel-gizli" role="status" aria-live="polite" data-sonuc={m.sonuc}></p>
  </div>
</Base>

<style>
  /* Açık kaynak notu: kapsayıcı genişliğinde, İznik vurgulu kenar şeridi, koyu moda uyumlu zemin */
  .vz-not { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 1rem; align-items: start; margin: 1.75rem 0 2rem; padding: 1.05rem 1.35rem 1.1rem 1.2rem; border: 1px solid color-mix(in oklab, var(--vurgu-2) 32%, transparent); border-inline-start: 4px solid var(--vurgu-2); border-radius: var(--radius-kose); background: color-mix(in oklab, var(--vurgu-2) 7%, var(--zemin)); }
  .vz-not-ikon { color: var(--vurgu-2); margin-top: 0.2rem; }
  .vz-not-etiket { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--vurgu-2); margin-bottom: 0.3rem; }
  .vz-not p { margin: 0; font-size: 0.98rem; line-height: 1.6; color: var(--metin); text-wrap: pretty; max-width: 78ch; }
  .vz-bos { padding: 2.5rem 0; text-align: center; color: var(--metin-2); }
  @media (max-width: 640px) {
    .vz-not { grid-template-columns: 1fr; margin: 1.25rem 0 1.5rem; padding: 0.9rem 1rem 0.95rem; }
    .vz-not-ikon { display: none; }
    .vz-not p { font-size: 0.95rem; }
  }
  .vz-ara { display: flex; align-items: center; gap: 0.6rem; max-width: 26rem; margin: 0 0 1rem; padding: 0 0.9rem; border: 1px solid var(--cizgi-etkilesim); border-radius: 999px; background: var(--zemin); color: var(--metin-2); }
  .vz-ara:focus-within { border-color: var(--vurgu); box-shadow: 0 0 0 3px color-mix(in oklab, var(--vurgu) 18%, transparent); }
  .vz-ara input { flex: 1; min-width: 0; min-height: 2.75rem; border: 0; background: none; color: var(--metin); font: inherit; font-size: 0.95rem; }
  .vz-ara input:focus { outline: none; }
  .vz-ara input::-webkit-search-cancel-button { display: none; }   /* yerine her tarayıcıda çalışan kendi düğmemiz */
  .vz-ara-sil { display: grid; place-items: center; width: 2rem; height: 2rem; margin-inline-start: -0.2rem; border: 0; border-radius: 50%; background: none; color: var(--metin-2); cursor: pointer; }
  .vz-ara-sil:hover { background: var(--zemin-2); color: var(--vurgu); }
  .gorsel-gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .vz-filtre { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.8rem; }
  .vz-cip { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.3rem; padding: 0 0.85rem; border: 1px solid var(--cizgi-etkilesim); border-radius: 999px; background: var(--zemin); color: var(--metin-2); font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s; }
  .vz-cip:hover { border-color: var(--vurgu); color: var(--vurgu); }
  /* Etkin çip: açık temada beyaz metin (5,5:1), koyu temada zemin açıldığı için koyu mürekkep (6,6:1).
     Sayı rozetinde opacity vardı → 4,07:1 ile eşiğin altında kalıyordu (axe, 7 Eyl 2026). */
  .vz-cip.etkin { background: var(--vurgu); border-color: var(--vurgu); color: #fff; }
  .vz-cip.etkin .vz-say { color: inherit; }
  :root[data-theme="dark"] .vz-cip.etkin { color: var(--color-ceviz-koyu); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .vz-cip.etkin { color: var(--color-ceviz-koyu); }
  }
  .vz-say { font-size: 0.75rem; color: var(--metin-2); font-variant-numeric: tabular-nums; }

  .vz-izgara { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: 1rem; list-style: none; padding: 0; margin: 0; }
  .vz-kart { display: flex; flex-direction: column; height: 100%; padding: 1.2rem 1.25rem 1.1rem; border: 1px solid var(--cizgi); border-radius: var(--radius-kose); background: var(--zemin); text-decoration: none; color: var(--metin); transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .vz-kart:hover { border-color: var(--vurgu); box-shadow: 0 6px 22px -12px color-mix(in oklab, var(--vurgu) 45%, transparent); transform: translateY(-2px); }
  .vz-kat { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; font-weight: 700; color: var(--vurgu-2); }
  .vz-baslik { font-family: var(--font-serif, Lora), serif; font-size: 1.18rem; line-height: 1.25; margin: 0.5rem 0 0; letter-spacing: -0.01em; }
  .vz-ozet { font-size: 0.9rem; color: var(--metin-2); line-height: 1.5; margin: 0.6rem 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .vz-meta { margin-top: auto; padding-top: 0.9rem; font-size: 0.78rem; color: var(--metin-2); letter-spacing: 0.02em; text-transform: uppercase; }
</style>

<script>
  // Süzgece doğrudan bağlan: sayfada birden çok «.kapsayici» var (ilki üst menünün) — 7 Eyl 2026'da
  // querySelector('.kapsayici') menü kapsayıcısını seçince dinleyici hiç bağlanmıyordu.
  const filtre = document.querySelector<HTMLElement>('.vz-filtre');
  const arama = document.querySelector<HTMLInputElement>('#vz-ara-giris');
  const aramaSil = document.querySelector<HTMLButtonElement>('.vz-ara-sil');
  const ogeler = Array.from(document.querySelectorAll<HTMLElement>('.vz-oge'));
  const bos = document.querySelector<HTMLElement>('.vz-bos');
  const bildirim = document.querySelector<HTMLElement>('[role="status"][data-sonuc]');

  if (ogeler.length) {
    // Arama anahtarı: Türkçe küçük harf + şapka/aksan ve kesme işareti sadeleştirmesi
    // («Kur’ân» ↔ «kuran», «Îmân» ↔ «iman») — böylece klavye alışkanlığı sonucu değiştirmez.
    const sade = (metin: string) =>
      metin.replace(/İ/g, 'i').replace(/I/g, 'ı').toLowerCase()
        .replace(/[’'`´]/g, '')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/ı/g, 'i').replace(/ş/g, 's').replace(/ğ/g, 'g').replace(/ç/g, 'c').replace(/ö/g, 'o').replace(/ü/g, 'u');

    for (const o of ogeler) o.dataset.ara = sade(o.innerText + ' ' + (o.dataset.kat || ''));

    let kategori = 'tumu';
    const uygula = () => {
      const sorgu = sade(arama?.value.trim() || '');
      let gorunur = 0;
      for (const o of ogeler) {
        const g = (kategori === 'tumu' || o.dataset.kat === kategori) && (!sorgu || (o.dataset.ara || '').includes(sorgu));
        o.hidden = !g;
        if (g) gorunur++;
      }
      if (bos) {
        bos.textContent = (sorgu ? bos.dataset.arama : bos.dataset.kategori) || '';
        bos.hidden = gorunur > 0;
      }
      if (bildirim) bildirim.textContent = (bildirim.dataset.sonuc || '').replace('{n}', String(gorunur));
      if (aramaSil) aramaSil.hidden = !sorgu;
    };

    filtre?.addEventListener('click', (e) => {
      const d = (e.target as HTMLElement).closest<HTMLButtonElement>('.vz-cip');
      if (!d) return;
      kategori = d.dataset.kat || 'tumu';
      for (const c of filtre.querySelectorAll<HTMLButtonElement>('.vz-cip')) {
        const etkin = c === d;
        c.classList.toggle('etkin', etkin);
        c.setAttribute('aria-pressed', String(etkin));
      }
      uygula();
    });
    arama?.addEventListener('input', uygula);
    aramaSil?.addEventListener('click', () => { if (arama) { arama.value = ''; arama.focus(); } uygula(); });
    arama?.addEventListener('keydown', (e) => { if (e.key === 'Escape' && arama.value) { arama.value = ''; uygula(); } });
  }
</script>
