---
import QRCode from 'qrcode';
import IcerikSayfasi from '../components/IcerikSayfasi.astro';
import { ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const ibanDuz = site.banka.iban.replace(/\s+/g, '');
/* Havale açıklaması (EPC QR'ına da yazılır): aksansız, kısa ve banka uygulamalarında okunur kalır. */
const ACIKLAMA = { tr: 'Bagis Ulu Camii Marche', fr: 'Don Ulu Camii Marche', en: 'Donation Ulu Camii Marche', nl: 'Gift Ulu Camii Marche', de: 'Spende Ulu Camii Marche' } satisfies Record<Dil, string>;
const aciklama = ACIKLAMA[dil];
// EPC069-12 "SCT" QR (Belçika bankacılık uygulamalarının tamamı okur)
const epc = ['BCD', '002', '1', 'SCT', site.banka.bic, site.banka.hesapAdi.normalize('NFD').replace(/[̀-ͯ]/g, '').slice(0, 70), ibanDuz, '', '', '', aciklama].join('\n');
const qr = await QRCode.toString(epc, { type: 'svg', errorCorrectionLevel: 'M', margin: 1, color: { dark: '#24201c', light: '#fbf8f1' } });
const M = {
  tr: {
  kart: 'Banka havalesi', iban: 'IBAN', bic: 'BIC', banka: 'Banka', hesap: 'Hesap adı', acik: 'Açıklama (önerilen)',
  qr: 'Bankacılık uygulamanızla tarayın', qrAlt: 'Bağış için EPC QR kodu — IBAN bilgilerini bankacılık uygulamanıza aktarır',
  kopyala: 'IBAN’ı kopyala', kopyalandi: 'Kopyalandı ✓',
  },
  fr: {
  kart: 'Virement bancaire', iban: 'IBAN', bic: 'BIC', banka: 'Banque', hesap: 'Titulaire', acik: 'Communication (suggérée)',
  qr: 'Scannez avec votre application bancaire', qrAlt: 'Code QR EPC pour le don — transfère les coordonnées IBAN dans votre application bancaire',
  kopyala: 'Copier l’IBAN', kopyalandi: 'Copié ✓',
  },
  en: {
  kart: 'Bank transfer', iban: 'IBAN', bic: 'BIC', banka: 'Bank', hesap: 'Account holder', acik: 'Message (suggested)',
  qr: 'Scan with your banking app', qrAlt: 'EPC QR code for donations — transfers the IBAN details into your banking app',
  kopyala: 'Copy IBAN', kopyalandi: 'Copied ✓',
  },
  nl: {
  kart: 'Overschrijving', iban: 'IBAN', bic: 'BIC', banka: 'Bank', hesap: 'Rekeninghouder', acik: 'Mededeling (voorstel)',
  qr: 'Scan met uw bankapp', qrAlt: 'EPC-QR-code voor giften — zet de IBAN-gegevens in uw bankapp',
  kopyala: 'IBAN kopiëren', kopyalandi: 'Gekopieerd ✓',
  },
  de: {
  kart: 'Banküberweisung', iban: 'IBAN', bic: 'BIC', banka: 'Bank', hesap: 'Kontoinhaber', acik: 'Verwendungszweck (Vorschlag)',
  qr: 'Mit Ihrer Banking-App scannen', qrAlt: 'EPC-QR-Code für Spenden — überträgt die IBAN-Daten in Ihre Banking-App',
  kopyala: 'IBAN kopieren', kopyalandi: 'Kopiert ✓',
  },
} satisfies Record<Dil, unknown>;
const m = M[dil];
---
<IcerikSayfasi dil={dil} anahtar="bagis" etiket={t('nav.bagis')}>
  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.kart}</p>
    <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
      <div class="col-span-2"><dt class="etiket">{m.iban}</dt><dd class="mono text-lg font-medium select-all" id="iban-deger">{site.banka.iban}</dd></div>
      <div><dt class="etiket">{m.bic}</dt><dd class="mono">{site.banka.bic}</dd></div><div><dt class="etiket">{m.banka}</dt><dd>{site.banka.banka}</dd></div>
      <div class="col-span-2"><dt class="etiket">{m.hesap}</dt><dd>{site.banka.hesapAdi}</dd></div>
      <div class="col-span-2"><dt class="etiket">{m.acik}</dt><dd class="mono">{aciklama}</dd></div>
    </dl>
    <button type="button" id="iban-kopyala" class="dugme dugme-iznik mt-4 w-full justify-center" data-iban={ibanDuz} data-kopyalandi={m.kopyalandi}>{m.kopyala}</button>
  </div>
  <figure slot="yan" class="kart p-5 text-center">
    <div class="mx-auto w-48 [&_svg]:w-full [&_svg]:h-auto" role="img" aria-label={m.qrAlt} set:html={qr} />
    <figcaption class="etiket mt-3">{m.qr}</figcaption>
  </figure>
</IcerikSayfasi>
<script>
  const b = document.getElementById('iban-kopyala') as HTMLButtonElement | null;
  b?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.iban ?? ''); const eski = b.textContent; b.textContent = b.dataset.kopyalandi ?? 'OK'; setTimeout(() => (b.textContent = eski), 2000); } catch {}
  });
</script>
