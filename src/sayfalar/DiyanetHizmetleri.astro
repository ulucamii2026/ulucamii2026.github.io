---
/**
 * Diyanet Hizmetleri — Belçika Diyanet Vakfı (BDV) çatısı altındaki hizmetlere erişim.
 *
 * KURGU (26 Ağustos 2026'da gözden geçirildi): önce dokuz hizmet dokuz eşit kart olarak
 * yan yana duruyordu. Süresi dolmak üzere olan Hac ön kaydı ile yıl boyu geçerli bir bilgi
 * sayfası aynı görsel ağırlıktaydı; dokuz düğmenin dokuzu da "İncele" diyordu ve nereye
 * gittiği (dışarısı mı, kendi sayfamız mı) ayırt edilemiyordu.
 *
 * Şimdi: (1) süreli bir başvuru varsa en üstte, son tarihiyle birlikte duruyor — umre
 * aynı bölümün alt şeridinde, çünkü tek başına bir kart üç sütunlu ızgarada yalnız kalıyordu;
 * (2) kalan hizmetler üç başlık altında toplandı — göz tarayarak bulur;
 * (3) her bağlantı kendi eylemini söylüyor ("PDF indir", "Ön kayıt formu"…);
 * (4) dışarı çıkan bağlantılar hedefini adıyla yazıyor (diyanet.be).
 *
 * Hac ön kaydının son günü SABİT DEĞİL, tarihle karşılaştırılır: site her gün yeniden
 * yayımlandığı için (deploy.yml cron) süre dolduğunda kart kendiliğinden sakinleşir.
 * Kaynak: diyanet.be/onkayit — "2027 Hac Ön kayıtları 20.06.2026 – 30.09.2026 tarihleri (30 Ağu 2026'da 30.08'den uzatıldı)
 * arasında gerçekleşecektir", kişi başı ön kayıt ücreti 2.000 €.
 */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Ikon from '../components/Ikon.astro';
import { ceviri, yol } from '../i18n/utils';
import { siteAyarlari } from '../lib/icerik';
import { HAC_SON_GUN, HAC_DUYURU_SLUG, UMRE_SON_GUN, UMRE_DUYURU_SLUG } from '../lib/etkinlik-tarihleri';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const c = site.cenaze;

type IkonAd = 'harita' | 'cenaze' | 'bagis' | 'kurs' | 'takvim' | 'kurban' | 'hukuk' | 'kabe' | 'yolculuk' | 'indir' | 'kandil';
interface Kart { ikon: IkonAd; baslik: string; ozet: string; href: string; eylem: string; disLink?: boolean }
interface Grup { baslik: string; kartlar: Kart[] }

const umreAcik = Date.now() <= UMRE_SON_GUN.getTime();
const hacAcik = Date.now() <= HAC_SON_GUN.getTime();
const hacSonTarih = { tr: '30 Eylül 2026', fr: '30 septembre 2026', en: '30 September 2026' }[dil];

const m = dil === 'tr' ? {
  etiket: 'Belçika Diyanet Vakfı',
  altBaslik: 'Camimiz, Belçika Diyanet Vakfı (BDV) çatısı altında hizmet veriyor. Hac, umre, cenaze, kurban, zekât-fitre, eğitim, hukuk danışmanlığı ve dinî takvim hizmetlerine buradan ulaşabilirsiniz.',
  oneCikanEtiket: 'Başvuru sürüyor',
  oneCikanKapaliEtiket: 'Başvurular kapandı',
  sonTarihEtiket: 'Son başvuru',
