  },
  gruplar: [
    {
      baslik: 'Fonlar ve yardımlaşma',
      kartlar: [
        { ikon: 'cenaze', baslik: 'Cenaze Nakil, Yardımlaşma ve Dayanışma Fonu', ozet: 'Her yıl Ocak ayının ilk haftası üyelere yıllık aidat mektubu gönderilir; 25 Ocak’a kadar mektup ulaşmayan üyelerin fonu bilgilendirmesi gerekir.', href: yol(dil, 'cenaze'), eylem: 'Fonu tanıyın' },
        { ikon: 'kurban', baslik: 'Vekâletle Kurban', ozet: 'Kurbanınızı Belçika Diyanet Vakfı koordinasyonunda veya camimizin kendi organizasyonuyla vekâletle kestirebilirsiniz. Bedel ve son başvuru tarihi her yıl duyurulur.', href: yol(dil, 'bagis', undefined) + '#vekaletle-kurban', eylem: 'Bağış sayfası' },
        { ikon: 'bagis', baslik: 'Zekât ve Fitre Fonu', ozet: 'Fitre miktarı en az 10 €’dur. BDV Zekât-Fitre Fonu’na (Ass. Inter. Diyanet de Belgique — BE36 4300 8889 0181) açıklama kısmına bağış türünü yazarak gönderebilirsiniz.', href: 'https://www.diyanet.be/Anamenu/Zekat-Fitre-Fonu', eylem: 'Fon bilgileri', disLink: true },
      ],
    },
    {
      baslik: 'Eğitim ve danışmanlık',
      kartlar: [
        { ikon: 'kurs', baslik: 'Eğitim Hizmetleri ve UİP Bursu', ozet: 'Kur’an-ı Kerim, dinî bilgiler, dil ve bilgisayar kurslarının yanında; UİP ve diğer öğrencilere Fitre-Zekât Fonu’ndan tek seferlik eğitim bursu sağlanır.', href: 'https://www.diyanet.be/Burs', eylem: 'Burs koşulları', disLink: true },
        { ikon: 'hukuk', baslik: 'Hukuk Danışmanlığı', ozet: 'Belçika’da yaşarken karşılaşabileceğiniz hukuki konularda Belçika Diyanet Vakfı’nın hukuk danışmanlığı hizmetinden faydalanabilirsiniz.', href: 'https://www.diyanet.be/Hizmetlerimiz/Hukuk-Danışmanlığı', eylem: 'Danışmanlığa ulaşın', disLink: true },
      ],
    },
    {
      baslik: 'Dinî takvim',
      kartlar: [
        { ikon: 'indir', baslik: 'İmsakiye (Marche-en-Famenne)', ozet: 'Camimizin bulunduğu bölge için hazırlanan yıllık imsakiyeyi PDF olarak indirebilirsiniz.', href: site.imsakiyePdf ?? 'https://www.diyanet.be/imsakiyeler', eylem: 'PDF indir', disLink: true },
        { ikon: 'kandil', baslik: 'Dinî Günler ve Kandiller', ozet: 'Kandil geceleri, bayramlar ve önemli dinî günlerin güncel tarihlerini namaz vakitleri sayfamızdaki takvimden takip edebilirsiniz.', href: yol(dil, 'namaz') + '#dini-gunler', eylem: 'Takvime git' },
      ],
    },
  ] as Grup[],
} : dil === 'en' ? {
  etiket: 'Diyanet Foundation of Belgium',
  altBaslik: 'Our mosque operates under the umbrella of the Diyanet Foundation of Belgium (BDV). Services related to hajj, omra, funerals, sacrifice, zakât-fitre, education, legal counselling and the religious calendar can all be reached here.',
  oneCikanEtiket: 'Applications open',
  oneCikanKapaliEtiket: 'Applications closed',
  sonTarihEtiket: 'Closing date',
  kesinKayitEtiket: 'Final registration',
  ucretEtiket: 'Pre-registration fee',
  disKaynak: 'opens on diyanet.be',
  kurumsalBaslik: 'About the Diyanet Foundation of Belgium',
  kurumsal: 'The Diyanet Foundation of Belgium is an "international union" approved by Belgian royal decree of 3 September 1982. It now brings together 73 mosques, a research centre, a boarding-and-day education institute, and more than a hundred associations; through its Funeral, Mutual Aid and Solidarity Fund, with around 38,000 registered member families serving nearly 160,000 people, it continues to serve the Muslim Turkish community living in Belgium.',
  iletisimBaslik: 'BDV Head Office',
  cami: 'Our mosque’s contact page',
  hac: {
    baslik: '2027 Hajj Pre-registration',
    ozetAcik: 'Pre-registration has been extended to 30 September 2026. Registration is handled through the hajj organisation of the Diyanet Foundation of Belgium; places are limited, so the right to final registration is granted in order of payment.',
    ozetKapali: 'The 2027 hajj pre-registration period has ended. When the next period is announced, you can get information from our mosque and from the Diyanet Foundation of Belgium.',
    ucret: '€2,000 per person',
    kesinKayit: '30 August – 30 September 2026',
    eylem: 'Pre-registration form',
    ayrinti: 'Conditions and required documents',
  },
  umre: {
    baslik: 'Omra Trips',
    ozetAcik: 'December omra with a visit to Taif: 20 December 2026 – 1 January 2027, 13 days and 12 nights, walking-distance accommodation. From €2,290 per person; registration closes on 20 November 2026.',
    ozetKapali: 'The Diyanet Foundation of Belgium organises omra trips throughout the year; the current schedule and conditions are on the foundation’s website.',
    eylem: 'Trip schedule',
    ayrinti: 'Programme, prices and documents',
  },
  gruplar: [
    {
      baslik: 'Funds and mutual aid',
      kartlar: [
        { ikon: 'cenaze', baslik: 'Funeral, Mutual Aid and Solidarity Fund', ozet: 'Every year, in the first week of January, an annual membership letter is sent to members; members who have not received the letter by 25 January should inform the fund.', href: yol(dil, 'cenaze'), eylem: 'About the fund' },
        { ikon: 'kurban', baslik: 'Sacrifice by Proxy (Kurban)', ozet: 'You can have your sacrifice performed by proxy through the Diyanet Foundation of Belgium or our mosque’s own organisation. The fee and application deadline are announced each year.', href: yol(dil, 'bagis', undefined) + '#vekaletle-kurban', eylem: 'Donations page' },
        { ikon: 'bagis', baslik: 'Zakât and Fitre Fund', ozet: 'The minimum fitre amount is €10. You can donate to the BDV Zakât-Fitre Fund (Ass. Inter. Diyanet de Belgique — BE36 4300 8889 0181), stating the type of donation in the message field.', href: 'https://www.diyanet.be/Anamenu/Zekat-Fitre-Fonu', eylem: 'Fund details', disLink: true },
      ],
    },
    {
      baslik: 'Education and counselling',
      kartlar: [
        { ikon: 'kurs', baslik: 'Education Services and UİP Scholarship', ozet: 'Alongside Qur’an, religious knowledge, language and computer courses, a one-off education scholarship is granted to UİP and other students from the Fitre-Zakât Fund.', href: 'https://www.diyanet.be/Burs', eylem: 'Scholarship terms', disLink: true },
        { ikon: 'hukuk', baslik: 'Legal Counselling', ozet: 'You can make use of the Diyanet Foundation of Belgium’s legal counselling service for legal matters you may encounter while living in Belgium.', href: 'https://www.diyanet.be/Hizmetlerimiz/Hukuk-Danışmanlığı', eylem: 'Reach counselling', disLink: true },
      ],
    },
    {
      baslik: 'Religious calendar',
      kartlar: [
        { ikon: 'indir', baslik: 'Prayer Calendar (Marche-en-Famenne)', ozet: 'You can download the annual prayer-times calendar prepared for our region as a PDF.', href: site.imsakiyePdf ?? 'https://www.diyanet.be/imsakiyeler', eylem: 'Download PDF', disLink: true },
        { ikon: 'kandil', baslik: 'Holy Nights and Religious Days', ozet: 'You can follow the up-to-date dates of holy nights, religious festivals and other significant days in the calendar on our prayer times page.', href: yol(dil, 'namaz') + '#dini-gunler', eylem: 'Go to calendar' },
      ],
    },
  ] as Grup[],
} : {
  etiket: 'Fondation Diyanet de Belgique',
  altBaslik: 'Notre mosquée est rattachée à la Fondation Diyanet de Belgique (BDV). Retrouvez ici les services liés au hajj, à l’omra, aux funérailles, au sacrifice, à la zakât-fitre, à l’éducation, au conseil juridique et au calendrier religieux.',
  oneCikanEtiket: 'Inscriptions ouvertes',
  oneCikanKapaliEtiket: 'Inscriptions closes',
  sonTarihEtiket: 'Date limite',
  kesinKayitEtiket: 'Inscription définitive',
  ucretEtiket: 'Frais de préinscription',
  disKaynak: 's’ouvre sur diyanet.be',
  kurumsalBaslik: 'À propos de la Fondation Diyanet de Belgique',
  kurumsal: 'La Fondation Diyanet de Belgique est une « union internationale » agréée par arrêté royal belge du 3 septembre 1982. Elle regroupe aujourd’hui 73 mosquées, un centre de recherche, un institut d’enseignement avec internat, et plus de cent associations ; avec son Fonds funéraire, d’entraide et de solidarité comptant environ 38 000 familles membres et servant près de 160 000 personnes, elle continue de servir la communauté musulmane turque de Belgique.',
  iletisimBaslik: 'Siège de la BDV',
  cami: 'La page de contact de notre mosquée',
  hac: {
    baslik: 'Préinscription au Hajj 2027',
    ozetAcik: 'Les préinscriptions ont été prolongées jusqu’au 30 septembre 2026. L’inscription se fait via l’organisation du hajj de la Fondation Diyanet de Belgique ; les places étant limitées, le droit à l’inscription définitive est accordé selon l’ordre des paiements.',
    ozetKapali: 'La période de préinscription au Hajj 2027 est terminée. Vous serez informé par notre mosquée et par la Fondation Diyanet de Belgique lors de la prochaine ouverture.',
    ucret: '2 000 € par personne',
    kesinKayit: '30 août – 30 septembre 2026',
    eylem: 'Formulaire de préinscription',
    ayrinti: 'Conditions et documents requis',
  },
  umre: {
    baslik: 'Voyages d’Omra',
    ozetAcik: 'Omra de décembre avec visite de Taïf : du 20 décembre 2026 au 1er janvier 2027, 13 jours et 12 nuits, hébergement à distance de marche. À partir de 2.290 € par personne ; clôture le 20 novembre 2026.',
    ozetKapali: 'La Fondation Diyanet de Belgique organise des voyages d’omra toute l’année ; le calendrier et les conditions figurent sur le site de la Fondation.',
    eylem: 'Calendrier des voyages',
    ayrinti: 'Programme, tarifs et documents',
  },
  gruplar: [
    {
      baslik: 'Fonds et entraide',
      kartlar: [
        { ikon: 'cenaze', baslik: 'Fonds funéraire, d’entraide et de solidarité', ozet: 'Chaque année, la première semaine de janvier, une lettre de cotisation annuelle est envoyée aux membres ; sans réception avant le 25 janvier, contactez le fonds.', href: yol(dil, 'cenaze'), eylem: 'Découvrir le fonds' },
        { ikon: 'kurban', baslik: 'Sacrifice par procuration (Kurban)', ozet: 'Faites accomplir votre sacrifice par procuration, via la Fondation Diyanet de Belgique ou l’organisation propre de notre mosquée. Montant et date limite annoncés chaque année.', href: yol(dil, 'bagis', undefined) + '#vekaletle-kurban', eylem: 'Page des dons' },
        { ikon: 'bagis', baslik: 'Fonds Zakât et Fitre', ozet: 'Le montant du fitre est d’au moins 10 €. Vous pouvez faire un don au Fonds Zakât-Fitre de la BDV (Ass. Inter. Diyanet de Belgique — BE36 4300 8889 0181) en précisant le type de don.', href: 'https://www.diyanet.be/Anamenu/Zekat-Fitre-Fonu', eylem: 'Détails du fonds', disLink: true },
      ],
    },
    {
      baslik: 'Éducation et conseil',
      kartlar: [
        { ikon: 'kurs', baslik: 'Services éducatifs et bourse UİP', ozet: 'Cours de Coran, de catéchisme, de langues et d’informatique ; une bourse ponctuelle est aussi accordée aux étudiants UİP via le Fonds Fitre-Zakât.', href: 'https://www.diyanet.be/Burs', eylem: 'Conditions de bourse', disLink: true },
        { ikon: 'hukuk', baslik: 'Conseil juridique', ozet: 'Bénéficiez du service de conseil juridique de la Fondation Diyanet de Belgique pour les questions administratives et juridiques que vous rencontrez en Belgique.', href: 'https://www.diyanet.be/Hizmetlerimiz/Hukuk-Danışmanlığı', eylem: 'Contacter le conseil', disLink: true },
      ],
    },
    {
      baslik: 'Calendrier religieux',
      kartlar: [
        { ikon: 'indir', baslik: 'Calendrier des prières (Marche-en-Famenne)', ozet: 'Téléchargez le calendrier annuel des heures de prière préparé pour notre région, au format PDF.', href: site.imsakiyePdf ?? 'https://www.diyanet.be/imsakiyeler', eylem: 'Télécharger le PDF', disLink: true },
        { ikon: 'kandil', baslik: 'Nuits bénies et fêtes religieuses', ozet: 'Suivez les dates actualisées des nuits bénies, des fêtes et des journées religieuses importantes dans le calendrier de notre page des horaires de prière.', href: yol(dil, 'namaz') + '#dini-gunler', eylem: 'Voir le calendrier' },
      ],
    },
  ] as Grup[],
