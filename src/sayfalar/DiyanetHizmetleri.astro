---
/** Diyanet Hizmetleri — Belçika Diyanet Vakfı (BDV) çatısı altındaki hizmetlere hızlı erişim kartları */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Ikon from '../components/Ikon.astro';
import { ceviri, yol } from '../i18n/utils';
import { siteAyarlari } from '../lib/icerik';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const c = site.cenaze;

interface Kart {
  ikon: 'harita' | 'cenaze' | 'bagis' | 'kurs' | 'takvim' | 'kurban' | 'hukuk';
  baslik: string; ozet: string; href: string; disLink?: boolean;
}

const m = dil === 'tr' ? {
  altBaslik: 'Camimiz, Belçika Diyanet Vakfı (BDV) çatısı altında hizmet veriyor. Hac, umre, cenaze, kurban, zekât-fitre, eğitim, hukuk danışmanlığı ve dinî takvim hizmetlerine buradan ulaşabilirsiniz.',
  kurumsalBaslik: 'Belçika Diyanet Vakfı hakkında',
  kurumsal: 'Belçika Diyanet Vakfı, 3 Eylül 1982 tarihli Belçika Kraliyet Kararnamesi ile onaylanmış bir “Uluslararası Birlik”tir. Bugün kendisine bağlı 73 cami, 1 araştırma merkezi, 1 yatılı-gündüzlü eğitim enstitüsü ve yüzden fazla derneğiyle; aile bazında kayıtlı 38.000 üyesi olan ve yaklaşık 160.000 kişiye hizmet veren Cenaze Nakil, Yardımlaşma ve Dayanışma Fonu ile Belçika’da yaşayan Müslüman Türk toplumuna hizmet vermeye devam ediyor.',
  iletisimBaslik: 'BDV Genel Merkezi',
  disNot: 'Belçika Diyanet Vakfı’nın kendi web sitesine yönlendirir.',
  git: 'İncele',
  cami: 'Camimizin kendi sayfası →',
  kartlar: [
    { ikon: 'harita', baslik: 'Hac Ön Kayıt', ozet: '2027 Hac ön kayıtları başladı. Vekâletiniz, Belçika Diyanet Vakfı’nın deneyimli organizasyonunda güven altında.', href: 'https://www.diyanet.be/onkayit', disLink: true },
    { ikon: 'harita', baslik: 'Umre Turları', ozet: 'Yıl boyunca düzenlenen umre turlarına Belçika Diyanet Vakfı koordinasyonunda katılabilir, kafile ile birlikte yolculuk edebilirsiniz.', href: 'https://www.diyanet.be/umre', disLink: true },
    { ikon: 'cenaze', baslik: 'Cenaze Nakil, Yardımlaşma ve Dayanışma Fonu', ozet: 'Her yıl Ocak ayının ilk haftası üyelere yıllık aidat mektubu gönderilir; 25 Ocak’a kadar mektup ulaşmayan üyelerin fonu bilgilendirmesi gerekir.', href: yol(dil, 'vefat'), disLink: false },
    { ikon: 'kurban', baslik: 'Vekâletle Kurban', ozet: 'Kurbanınızı Belçika Diyanet Vakfı koordinasyonunda veya camimizin kendi organizasyonuyla vekâletle kestirebilirsiniz. Bedel ve son başvuru tarihi her yıl duyurulur.', href: yol(dil, 'bagis', undefined) + '#vekaletle-kurban', disLink: false },
    { ikon: 'bagis', baslik: 'Zekât ve Fitre Fonu', ozet: 'Fitre miktarı en az 10€’dur. BDV Zekât-Fitre Fonu’na (Ass. Inter. Diyanet de Belgique — BE36 4300 8889 0181) açıklama kısmına bağış türünü yazarak gönderebilirsiniz.', href: 'https://www.diyanet.be/Anamenu/Zekat-Fitre-Fonu', disLink: true },
    { ikon: 'kurs', baslik: 'Eğitim Hizmetleri ve UİP Bursu', ozet: 'Kur’an-ı Kerim, dinî bilgiler, dil ve bilgisayar kurslarının yanında; UİP ve diğer öğrencilere Fitre-Zekât Fonu’ndan tek seferlik eğitim bursu sağlanır.', href: 'https://www.diyanet.be/Burs', disLink: true },
    { ikon: 'hukuk', baslik: 'Hukuk Danışmanlığı', ozet: 'Belçika’da yaşarken karşılaşabileceğiniz hukuki konularda Belçika Diyanet Vakfı’nın hukuk danışmanlığı hizmetinden faydalanabilirsiniz.', href: 'https://www.diyanet.be/Hizmetlerimiz/Hukuk-Danışmanlığı', disLink: true },
    { ikon: 'takvim', baslik: 'İmsakiye (Marche-en-Famenne)', ozet: 'Camimizin bulunduğu bölge için hazırlanan yıllık imsakiyeyi PDF olarak indirebilirsiniz.', href: site.imsakiyePdf ?? 'https://www.diyanet.be/imsakiyeler', disLink: true },
    { ikon: 'takvim', baslik: 'Dinî Günler ve Kandiller', ozet: 'Kandil geceleri, bayramlar ve önemli dinî günlerin tarihlerini Belçika Diyanet Vakfı’nın yıllık takviminden takip edebilirsiniz.', href: 'https://www.diyanet.be/imsakiyeler', disLink: true },
  ] as Kart[],
} : {
  altBaslik: 'Notre mosquée est rattachée à la Fondation Diyanet de Belgique (BDV). Retrouvez ici les services liés au hajj, à l’omra, aux funérailles, au sacrifice, à la zakât-fitre, à l’éducation, au conseil juridique et au calendrier religieux.',
  kurumsalBaslik: 'À propos de la Fondation Diyanet de Belgique',
  kurumsal: 'La Fondation Diyanet de Belgique est une « union internationale » agréée par arrêté royal belge du 3 septembre 1982. Elle regroupe aujourd’hui 73 mosquées, un centre de recherche, un institut d’enseignement avec internat, et plus de cent associations ; avec son Fonds funéraire, d’entraide et de solidarité comptant environ 38 000 familles membres et servant près de 160 000 personnes, elle continue de servir la communauté musulmane turque de Belgique.',
  iletisimBaslik: 'Siège de la BDV',
  disNot: 'Vous serez redirigé vers le site de la Fondation Diyanet de Belgique.',
  git: 'Découvrir',
  cami: 'La page de notre mosquée →',
  kartlar: [
    { ikon: 'harita', baslik: 'Préinscription au Hajj', ozet: 'Les préinscriptions au Hajj 2027 ont commencé. Votre procuration est entre de bonnes mains, avec l’expérience de la Fondation Diyanet de Belgique.', href: 'https://www.diyanet.be/onkayit', disLink: true },
    { ikon: 'harita', baslik: 'Voyages d’Omra', ozet: 'Participez aux voyages d’omra organisés toute l’année sous la coordination de la Fondation Diyanet de Belgique, en groupe accompagné.', href: 'https://www.diyanet.be/umre', disLink: true },
    { ikon: 'cenaze', baslik: 'Fonds funéraire, d’entraide et de solidarité', ozet: 'Chaque année, la première semaine de janvier, une lettre de cotisation annuelle est envoyée aux membres ; sans réception avant le 25 janvier, contactez le fonds.', href: yol(dil, 'vefat'), disLink: false },
    { ikon: 'kurban', baslik: 'Sacrifice par procuration (Kurban)', ozet: 'Faites accomplir votre sacrifice par procuration, via la Fondation Diyanet de Belgique ou l’organisation propre de notre mosquée. Montant et date limite annoncés chaque année.', href: yol(dil, 'bagis', undefined) + '#vekaletle-kurban', disLink: false },
    { ikon: 'bagis', baslik: 'Fonds Zakât et Fitre', ozet: 'Le montant du fitre est d’au moins 10 €. Vous pouvez faire un don au Fonds Zakât-Fitre de la BDV (Ass. Inter. Diyanet de Belgique — BE36 4300 8889 0181) en précisant le type de don.', href: 'https://www.diyanet.be/Anamenu/Zekat-Fitre-Fonu', disLink: true },
    { ikon: 'kurs', baslik: 'Services éducatifs et bourse UİP', ozet: 'Cours de Coran, de catéchisme, de langues et d’informatique ; une bourse ponctuelle est aussi accordée aux étudiants UİP via le Fonds Fitre-Zakât.', href: 'https://www.diyanet.be/Burs', disLink: true },
    { ikon: 'hukuk', baslik: 'Conseil juridique', ozet: 'Bénéficiez du service de conseil juridique de la Fondation Diyanet de Belgique pour les questions administratives et juridiques que vous rencontrez en Belgique.', href: 'https://www.diyanet.be/Hizmetlerimiz/Hukuk-Danışmanlığı', disLink: true },
    { ikon: 'takvim', baslik: 'Calendrier des prières (Marche-en-Famenne)', ozet: 'Téléchargez le calendrier annuel des heures de prière préparé pour notre région, au format PDF.', href: site.imsakiyePdf ?? 'https://www.diyanet.be/imsakiyeler', disLink: true },
    { ikon: 'takvim', baslik: 'Nuits bénies et fêtes religieuses', ozet: 'Suivez les dates des nuits bénies, des fêtes et des journées religieuses importantes dans le calendrier annuel de la Fondation Diyanet de Belgique.', href: 'https://www.diyanet.be/imsakiyeler', disLink: true },
  ] as Kart[],
};

const yollarSVG: Record<Kart['ikon'], string> = {
  kurban: '<path d="M4 12a8 4 0 0 0 16 0"/><path d="M4 12V9a8 4 0 0 1 16 0v3"/><path d="M9 6V4M15 6V4M12 5V3"/>',
  hukuk: '<path d="M12 3v18M9 21h6"/><path d="M5 7h14"/><path d="M5 7 2 13a3 3 0 0 0 6 0L5 7Z"/><path d="M19 7l-3 6a3 3 0 0 0 6 0l-3-6Z"/>',
  harita: '', cenaze: '', bagis: '', kurs: '', takvim: '', // Ikon.astro'daki set kullanılacak
};
---
<Base baslik={t('nav.diyanet')} dil={dil} aciklama={m.altBaslik}>
  <SayfaBasligi etiket={t('nav.diyanet')} baslik={t('nav.diyanet')} altBaslik={m.altBaslik} />

  <div class="kapsayici py-10">
    <h2 class="sr-only">{dil === 'tr' ? 'Hizmetler' : 'Services'}</h2>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {m.kartlar.map((k) => (
        <li class="kart p-5 sm:p-6 flex flex-col gap-3">
          <div class="h-11 w-11 grid place-items-center rounded-full bg-(--zemin-3) text-(--vurgu)" aria-hidden="true">
            {(k.ikon === 'kurban' || k.ikon === 'hukuk')
              ? <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={yollarSVG[k.ikon]} />
              : <Ikon ad={k.ikon} class="h-6 w-6" />}
          </div>
          <h3 class="text-lg leading-snug">{k.baslik}</h3>
          <p class="text-sm text-(--metin-2) flex-1">{k.ozet}</p>
          <a href={k.href} target={k.disLink ? '_blank' : undefined} rel={k.disLink ? 'noopener' : undefined} class="dugme dugme-ikincil w-full justify-center text-sm mt-1">
            {m.git}{k.disLink && <span aria-hidden="true"> <span aria-hidden="true"> ↗</span></span>}
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="kart-kagit p-6 sm:p-8">
        <p class="etiket etiket-vurgu mb-2">{m.kurumsalBaslik}</p>
        <p class="text-(--metin-2) max-w-[70ch]">{m.kurumsal}</p>
      </div>
      <div class="kart p-6">
        <p class="etiket etiket-vurgu mb-3">{m.iletisimBaslik}</p>
        <dl class="grid gap-2.5 text-sm">
          <div><dt class="etiket">{dil === 'tr' ? 'Adres' : 'Adresse'}</dt><dd>Chaussée de Haecht 67, 1210 Bruxelles</dd></div>
          <div><dt class="etiket">{dil === 'tr' ? 'E-posta' : 'E-mail'}</dt><dd><a href={`mailto:${c?.fonEposta ?? 'info@diyanet.be'}`}>{c?.fonEposta ?? 'info@diyanet.be'}</a></dd></div>
          <div><dt class="etiket">Web</dt><dd><a href="https://www.diyanet.be" target="_blank" rel="noopener">diyanet.be <span aria-hidden="true"> ↗</span></a></dd></div>
        </dl>
        <p class="mt-4 text-xs text-(--metin-2)">{m.disNot}</p>
        <p class="mt-3 text-sm"><a href={yol(dil, 'iletisim')}>{m.cami}</a></p>
      </div>
    </div>
  </div>
</Base>
