/* Ikon.astro'da bulunmayan dört işaret burada; aynı çizim dili: 24×24, 1.75 kalınlık,
   yuvarlak uç. Önce Hac ile Umre aynı "harita" işaretini, imsakiye ile kandiller aynı
   "takvim" işaretini paylaşıyordu — iki çift ayırt edilemiyordu. */
const ekIkon: Partial<Record<IkonAd, string>> = {
  kurban: '<path d="M4 12a8 4 0 0 0 16 0"/><path d="M4 12V9a8 4 0 0 1 16 0v3"/><path d="M9 6V4M15 6V4M12 5V3"/>',
  hukuk: '<path d="M12 3v18M9 21h6"/><path d="M5 7h14"/><path d="M5 7 2 13a3 3 0 0 0 6 0L5 7Z"/><path d="M19 7l-3 6a3 3 0 0 0 6 0l-3-6Z"/>',
  kabe: '<path d="M5 8.5 12 5l7 3.5v7L12 19l-7-3.5v-7Z"/><path d="M5 8.5 12 12l7-3.5M12 12v7"/><path d="M4 10.5h16"/>',
  yolculuk: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5.5-5.5 2 2-5.5 5.5-2Z"/>',
  indir: '<path d="M6 3h8l4 4v14H6V3Z"/><path d="M14 3v4h4"/><path d="M12 11v6m0 0-2.5-2.5M12 17l2.5-2.5"/>',
  kandil: '<path d="M17.5 15.5A7 7 0 0 1 9 5.2a7.5 7.5 0 1 0 8.5 10.3Z"/><path d="m18 4 .8 1.9L21 6.6l-1.9.9L18 9.4l-.8-1.9L15 6.6l2.2-.7L18 4Z"/>',
};
---
<Base baslik={t('nav.diyanet')} dil={dil} aciklama={m.altBaslik}>
  <SayfaBasligi etiket={m.etiket} baslik={t('nav.diyanet')} altBaslik={m.altBaslik} />

  <div class="kapsayici py-10 flex flex-col gap-12">
    {/* Süreli işlem en üstte: tarihi geçince vurgu kendiliğinden kalkar */}
    <section aria-labelledby="hac-basligi" class={`hac-kart ${hacAcik ? 'hac-acik' : ''} kart p-6 sm:p-8`}>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="hac-ikon grid place-items-center h-11 w-11 rounded-full shrink-0" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={ekIkon.kabe} />
        </span>
        <span class={`rozet ${hacAcik ? 'rozet-acik' : ''}`}>{hacAcik ? m.oneCikanEtiket : m.oneCikanKapaliEtiket}</span>
      </div>

      <h2 id="hac-basligi" class="font-serif text-2xl sm:text-3xl leading-tight mb-2">{m.hac.baslik}</h2>
      <p class="text-(--metin-2) max-w-[62ch]">{hacAcik ? m.hac.ozetAcik : m.hac.ozetKapali}</p>

      {hacAcik && (
        <dl class="hac-kunye mt-5 grid gap-x-10 gap-y-3 sm:grid-cols-[repeat(3,max-content)]">
          <div>
            <dt class="etiket">{m.sonTarihEtiket}</dt>
            <dd class="font-semibold mt-0.5"><time datetime="2026-09-30">{hacSonTarih}</time></dd>
          </div>
          <div>
            <dt class="etiket">{m.kesinKayitEtiket}</dt>
            <dd class="font-semibold mt-0.5">{m.hac.kesinKayit}</dd>
          </div>
          <div>
            <dt class="etiket">{m.ucretEtiket}</dt>
            <dd class="font-semibold mt-0.5">{m.hac.ucret}</dd>
          </div>
        </dl>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="https://www.diyanet.be/onkayit" target="_blank" rel="noopener"
           class={`dugme ${hacAcik ? 'dugme-birincil' : 'dugme-ikincil'} w-full sm:w-auto justify-center`}>
          {m.hac.eylem}<span aria-hidden="true"> ↗</span><span class="sr-only"> ({m.disKaynak})</span>
        </a>
        {hacAcik && (
          <a href={yol(dil, 'duyurular', HAC_DUYURU_SLUG)} class="metin-baglanti text-sm underline underline-offset-4">
            {m.hac.ayrinti} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>

      {/* Umre hac ile aynı aileden ama süreli değil: kendi başına bir kart olsaydı
          üç sütunlu ızgarada yalnız kalırdı. Aynı bölümün alt şeridi olarak duruyor. */}
      <div class="umre-serit mt-7 pt-5">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
          <h3 class="text-base font-semibold">{m.umre.baslik}</h3>
          <p class="text-sm text-(--metin-2) flex-1 min-w-[18ch]">{umreAcik ? m.umre.ozetAcik : m.umre.ozetKapali}</p>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-1">
          {umreAcik && (
            <a href={yol(dil, 'duyurular', UMRE_DUYURU_SLUG)} class="metin-baglanti text-sm underline underline-offset-4">
              {m.umre.ayrinti} <span aria-hidden="true">→</span>
            </a>
          )}
          <a href="https://www.diyanet.be/umre" target="_blank" rel="noopener"
             class="metin-baglanti text-sm underline underline-offset-4 whitespace-nowrap">
            {m.umre.eylem}<span aria-hidden="true"> ↗</span><span class="sr-only"> ({m.disKaynak})</span>
          </a>
        </div>
      </div>
    </section>

    {m.gruplar.map((g) => (
      <section aria-labelledby={`grup-${g.baslik.replace(/[^a-zA-Z0-9]/g, '')}`}>
        <h2 id={`grup-${g.baslik.replace(/[^a-zA-Z0-9]/g, '')}`} class="grup-baslik">{g.baslik}</h2>
        <ul class={`grid gap-5 sm:grid-cols-2 items-stretch ${g.kartlar.length > 2 ? 'lg:grid-cols-3' : ''}`} role="list">
          {g.kartlar.map((k) => (
            <li class="kart p-5 sm:p-6 flex flex-col gap-3 h-full">
              <div class="h-11 w-11 grid place-items-center rounded-full bg-(--zemin-3) text-(--vurgu) shrink-0" aria-hidden="true">
                {ekIkon[k.ikon]
                  ? <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={ekIkon[k.ikon]} />
                  : <Ikon ad={k.ikon as 'harita' | 'cenaze' | 'bagis' | 'kurs' | 'takvim'} class="h-6 w-6" />}
              </div>
              <h3 class="text-lg leading-snug">{k.baslik}</h3>
              <p class="text-sm text-(--metin-2) flex-1">{k.ozet}</p>
              <a href={k.href} target={k.disLink ? '_blank' : undefined} rel={k.disLink ? 'noopener' : undefined}
                 class="dugme dugme-ikincil w-full justify-center text-sm mt-1">
                {k.eylem}{k.disLink && <><span aria-hidden="true"> ↗</span><span class="sr-only"> ({m.disKaynak})</span></>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <section class="kart-kagit p-6 sm:p-8" aria-labelledby="bdv-hakkinda">
        <h2 id="bdv-hakkinda" class="font-serif text-xl leading-tight mb-3">{m.kurumsalBaslik}</h2>
        <p class="text-(--metin-2) max-w-[70ch]">{m.kurumsal}</p>
      </section>
      <section class="kart p-6" aria-labelledby="bdv-merkez">
        <h2 id="bdv-merkez" class="etiket etiket-vurgu mb-3">{m.iletisimBaslik}</h2>
        <dl class="grid gap-3.5 text-sm">
          <div><dt class="etiket">{dil === 'tr' ? 'Adres' : dil === 'en' ? 'Address' : 'Adresse'}</dt><dd>Chaussée de Haecht 67, 1210 Bruxelles</dd></div>
          <div><dt class="etiket">{dil === 'tr' ? 'E-posta' : dil === 'en' ? 'E-mail' : 'E-mail'}</dt><dd><a class="metin-baglanti" href={`mailto:${c?.fonEposta ?? 'info@diyanet.be'}`}>{c?.fonEposta ?? 'info@diyanet.be'}</a></dd></div>
          <div><dt class="etiket">Web</dt><dd><a class="metin-baglanti" href="https://www.diyanet.be" target="_blank" rel="noopener">diyanet.be <span aria-hidden="true"> ↗</span></a></dd></div>
        </dl>
        <p class="mt-4 text-sm"><a class="metin-baglanti" href={yol(dil, 'iletisim')}>{m.cami} <span aria-hidden="true">→</span></a></p>
      </section>
    </div>
  </div>
</Base>

<style>
  /* Grup başlığı: bölümü açar ama kart başlıklarıyla yarışmaz. Üstünde altındakinden
     fazla boşluk bırakılır — başlık altındaki içeriğe aittir. */
  .grup-baslik {
    font-family: var(--font-serif, Lora, Georgia, serif);
    font-size: 1.15rem;
    line-height: 1.25;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--cizgi);
  }

  /* Süreli başvuru kartı: sayfadaki tek "şimdi yapılacak iş". Açıkken kâğıt zemine
     oturur ve vurgu rengiyle çerçevelenir; süre dolunca sıradan bir karta döner. */
  .hac-kart { background: var(--zemin); }
  .hac-kart.hac-acik { border-color: color-mix(in oklab, var(--vurgu, #b5452b) 45%, var(--cizgi)); }
  .hac-ikon { background: var(--zemin-3); color: var(--metin-2); }
  .hac-kart.hac-acik .hac-ikon { background: color-mix(in oklab, var(--vurgu, #b5452b) 14%, transparent); color: var(--vurgu, #b5452b); }

  .rozet {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-etiket, 0.16em);
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--zemin-3);
    color: var(--metin-2);
  }
  .rozet-acik {
    background: color-mix(in oklab, var(--vurgu, #b5452b) 14%, transparent);
    color: var(--vurgu, #b5452b);
    font-weight: 600;
  }

  /* Künye rakamları tabular: son tarih ile ücret alt alta hizalı okunur.
     Etiket ve değer sarmaz — sütunlar içeriğe göre genişlediği için sarmaya gerek
     de yok; sardıklarında (uzun Fransızca etiketler) üç sütunun temel hizası
     birbirini tutmuyordu. */
  .hac-kunye dt,
  .hac-kunye dd { white-space: nowrap; }
  .hac-kunye dd { font-variant-numeric: tabular-nums; }

  /* Umre, hac ile aynı bölümün alt şeridi; ayraç ikisini ayırır ama koparmaz. */
  .umre-serit { border-top: 1px solid var(--cizgi); }

  /* 16-20 px yüksekliğindeki metin bağlantısı parmakla ıskalanır. Dolgu dokunma
     alanını 32 px'e çıkarır, negatif kenar boşluğu düzeni olduğu gibi bırakır. */
  .metin-baglanti {
    display: inline-block;
    padding-block: 0.5rem;
    margin-block: -0.5rem;
  }
</style>
