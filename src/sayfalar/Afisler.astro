---
/** Afişler — kronolojik afiş duvarı: kendi afişlerimiz + Belçika Diyanet Vakfı arşivinden seçmeler */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, tarihBicimle, yol } from '../i18n/utils';
import { yollar } from '../i18n/ui';
import { icerikDili } from '../lib/icerik';
import type { Dil, SayfaAnahtari } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const icDil = icerikDili(dil); // içerik alanları yalnız tr/fr — diğer dillerde Fransızcaya düş

const hepsi = await getCollection('afisler', ({ data }) => !data.taslak);
const liste = hepsi.sort((a, b) => b.data.tarih.getTime() - a.data.tarih.getTime());

const KATEGORI: Record<string, Record<Dil, string>> = {
  kampanya: { tr: 'Kampanya', fr: 'Campagne', en: 'Campaign', nl: 'Campagne', de: 'Kampagne' },
  program: { tr: 'Program', fr: 'Programme', en: 'Programme', nl: 'Programma', de: 'Programm' },
  egitim: { tr: 'Eğitim', fr: 'Éducation', en: 'Education', nl: 'Onderwijs', de: 'Bildung' },
  'hac-umre': { tr: 'Hac ve Umre', fr: 'Hajj et Omra', en: 'Hajj and Omra', nl: 'Hadj en Omra', de: 'Hadsch und Omra' },
  kurban: { tr: 'Kurban', fr: 'Sacrifice (Kurban)', en: 'Sacrifice (Kurban)', nl: 'Offer (Kurban)', de: 'Opfer (Kurban)' },
  zekat: { tr: 'Zekât ve Fitre', fr: 'Zakât et Fitre', en: 'Zakât and Fitr', nl: 'Zakat en Zakat al-Fitr (Fitre)', de: 'Zakat und Zakat al-Fitr (Fitre)' },
  cenaze: { tr: 'Cenaze', fr: 'Funérailles', en: 'Funerals', nl: 'Uitvaart', de: 'Bestattung' },
  ramazan: { tr: 'Ramazan', fr: 'Ramadan', en: 'Ramadan', nl: 'Ramadan', de: 'Ramadan' },
  diger: { tr: 'Diğer', fr: 'Autre', en: 'Other', nl: 'Overige', de: 'Sonstiges' },
};
const KAYNAK: Record<string, Record<Dil, string>> = {
  ulucamii: { tr: 'Ulu Camii', fr: 'Ulu Camii', en: 'Ulu Camii', nl: 'Ulu Camii', de: 'Ulu Camii' },
  bdv: { tr: 'Belçika Diyanet Vakfı', fr: 'Fondation Diyanet de Belgique', en: 'Diyanet Foundation of Belgium', nl: 'Belgische Diyanetstichting', de: 'Belgische Diyanet-Stiftung' },
  diyanet: { tr: 'Diyanet İşleri Başkanlığı', fr: 'Présidence des Affaires religieuses', en: 'Presidency of Religious Affairs', nl: 'Directoraat voor Godsdienstzaken (Diyanet)', de: 'Präsidium für Religiöse Angelegenheiten (Diyanet)' },
  diger: { tr: 'Diğer kaynak', fr: 'Autre source', en: 'Other source', nl: 'Andere bron', de: 'Andere Quelle' },
};

const kategoriler = [...new Set(liste.map((a) => a.data.kategori))].sort((a, b) => (KATEGORI[a]?.[dil] ?? a).localeCompare(KATEGORI[b]?.[dil] ?? b, dil));

const M: Record<Dil, { altBaslik: string; hepsi: string; dis: string; sayfa: string }> = {
  tr: {
    altBaslik: 'Camimizin kampanya ve program afişleri; Belçika Diyanet Vakfı’nın hac, umre, kurban, zekât-fitre ve eğitim afişlerinden bir seçki. Bir afişe dokunarak büyütebilirsiniz.',
    hepsi: 'Tümü', dis: 'Bağlantı ↗', sayfa: 'Sayfaya git →',
  },
  fr: {
    altBaslik: 'Affiches de campagnes et de programmes de notre mosquée, ainsi qu’une sélection d’affiches de la Fondation Diyanet de Belgique (hajj, omra, sacrifice, zakât-fitre, éducation). Touchez une affiche pour l’agrandir.',
    hepsi: 'Toutes', dis: 'Lien ↗', sayfa: 'Voir la page →',
  },
  en: {
    altBaslik: 'Campaign and programme posters from our mosque, alongside a selection of posters from the Diyanet Foundation of Belgium (hajj, omra, sacrifice, zakât-fitre, education). Tap a poster to enlarge it.',
    hepsi: 'All', dis: 'Link ↗', sayfa: 'Go to page →',
  },
  nl: {
    altBaslik: 'Campagne- en programma-affiches van onze moskee, samen met een selectie affiches van de Belgische Diyanetstichting (hadj, omra, offer, zakat-fitre, onderwijs). Tik op een affiche om ze te vergroten.',
    hepsi: 'Alle', dis: 'Link ↗', sayfa: 'Naar de pagina →',
  },
  de: {
    altBaslik: 'Kampagnen- und Programmplakate unserer Moschee sowie eine Auswahl an Plakaten der Belgischen Diyanet-Stiftung (Hadsch, Omra, Opfer, Zakat-Fitre, Bildung). Tippen Sie auf ein Plakat, um es zu vergrößern.',
    hepsi: 'Alle', dis: 'Link ↗', sayfa: 'Zur Seite →',
  },
};
const m = M[dil];
---
<Base baslik={t('nav.afisler')} kapak={liste[0]?.data.gorsel} dil={dil} aciklama={m.altBaslik}>
  <SayfaBasligi etiket={t('nav.afisler')} baslik={t('nav.afisler')} altBaslik={m.altBaslik} />

  <div class="kapsayici py-10">
    <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label={t('nav.afisler')}>
      <button type="button" class="dugme dugme-ikincil !py-1.5 !px-3.5 text-sm afis-filtre" data-kategori="hepsi" aria-pressed="true">{m.hepsi}</button>
      {kategoriler.map((k) => (
        <button type="button" class="dugme dugme-ikincil !py-1.5 !px-3.5 text-sm afis-filtre" data-kategori={k} aria-pressed="false">{KATEGORI[k]?.[dil] ?? k}</button>
      ))}
    </div>

    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" role="list" id="afis-duvari">
      {liste.map((a, i) => (
        <li class="afis-karti reveal" data-kategori={a.data.kategori} style={`--i:${i % 3}`}>
          <a href={a.data.gorsel} class="gorsel-cerceve block overflow-hidden group" data-lightbox="afisler" data-caption={a.data.baslik[icDil] ?? a.data.baslik.tr}>
            <img src={a.data.kucuk ?? a.data.gorsel} alt={a.data.baslik[icDil] ?? a.data.baslik.tr} loading="lazy" width="480" height="640" class="aspect-[3/4] object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]" />
          </a>
          <div class="mt-2">
            <p class="text-sm font-semibold leading-snug">{a.data.baslik[icDil] ?? a.data.baslik.tr}</p>
            <p class="etiket mt-1">
              <time datetime={a.data.tarih.toISOString()}>{tarihBicimle(a.data.tarih, dil, { month: 'short', year: 'numeric' })}</time>
              <span> · {KAYNAK[a.data.kaynak]?.[dil] ?? a.data.kaynak}</span>
            </p>
            {/* Site içi hedef (sayfa anahtarı) dile göre çözülür; dış bağlantı olduğu gibi basılır (4 Eyl 2026). */}
            {a.data.sayfa && a.data.sayfa in yollar && <a href={yol(dil, a.data.sayfa as SayfaAnahtari)} class="text-sm">{m.sayfa}</a>}
            {a.data.link && <a href={a.data.link} target="_blank" rel="noopener" class="text-sm">{m.dis}</a>}
          </div>
        </li>
      ))}
    </ul>
  </div>

  <script>
    const dugmeler = document.querySelectorAll<HTMLButtonElement>('.afis-filtre');
    const kartlar = document.querySelectorAll<HTMLLIElement>('.afis-karti');
    dugmeler.forEach((btn) => {
      btn.addEventListener('click', () => {
        dugmeler.forEach((b) => { b.setAttribute('aria-pressed', 'false'); b.classList.remove('dugme-birincil'); b.classList.add('dugme-ikincil'); });
        btn.setAttribute('aria-pressed', 'true'); btn.classList.remove('dugme-ikincil'); btn.classList.add('dugme-birincil');
        const hedef = btn.dataset.kategori;
        kartlar.forEach((li) => { li.style.display = hedef === 'hepsi' || li.dataset.kategori === hedef ? '' : 'none'; });
      });
    });
  </script>
</Base>
