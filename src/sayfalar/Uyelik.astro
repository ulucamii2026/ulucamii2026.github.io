---
import IcerikSayfasi from '../components/IcerikSayfasi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const M = {
  tr: { aidat: 'Yıllık aidat', aidatTutar: '50 €', hesap: 'Aidat hesabı', iban: 'IBAN', bic: 'BIC', hesapAdi: 'Hesap adı', acik: 'Açıklama', acikOrnek: 'Aidat 2026 – Ad Soyad', portal: 'Üye portalı (hazırlanıyor)', portalA: 'Üyelik bilgileri ve aidat geçmişi için özel alan — bu bölüm daha sonra inşa edilecektir.', basvuru: 'Üyelik başvurusu için', basvuruA: 'Dernek yönetimine ulaşın; başvuru formunu camide doldurabilirsiniz.' },
  fr: { aidat: 'Cotisation annuelle', aidatTutar: '50 €', hesap: 'Compte des cotisations', iban: 'IBAN', bic: 'BIC', hesapAdi: 'Titulaire', acik: 'Communication', acikOrnek: 'Cotisation 2026 – Nom Prénom', portal: 'Portail des membres (en préparation)', portalA: 'Espace réservé aux informations d’adhésion et aux cotisations — cette rubrique sera construite ultérieurement.', basvuru: 'Pour adhérer', basvuruA: 'Contactez le comité ; le formulaire d’adhésion se remplit à la mosquée.' },
  en: { aidat: 'Annual dues', aidatTutar: '€50', hesap: 'Dues account', iban: 'IBAN', bic: 'BIC', hesapAdi: 'Account holder', acik: 'Message', acikOrnek: 'Dues 2026 – Full name', portal: 'Members’ portal (in preparation)', portalA: 'A private area for membership information and dues history — this section will be built later.', basvuru: 'To apply for membership', basvuruA: 'Contact the association committee; the membership form is filled in at the mosque.' },
  nl: { aidat: 'Jaarlijks lidgeld', aidatTutar: '50 €', hesap: 'Rekening voor de lidgelden', iban: 'IBAN', bic: 'BIC', hesapAdi: 'Rekeninghouder', acik: 'Mededeling', acikOrnek: 'Lidgeld 2026 – Naam Voornaam', portal: 'Ledenportaal (in voorbereiding)', portalA: 'Een afgeschermde ruimte voor uw lidmaatschapsgegevens en uw lidgelden — deze rubriek wordt later gebouwd.', basvuru: 'Lid worden', basvuruA: 'Neem contact op met het bestuur van de vereniging; het aansluitingsformulier vult u in de moskee in.' },
  de: { aidat: 'Jahresbeitrag', aidatTutar: '50 €', hesap: 'Konto für die Beiträge', iban: 'IBAN', bic: 'BIC', hesapAdi: 'Kontoinhaber', acik: 'Verwendungszweck', acikOrnek: 'Beitrag 2026 – Name Vorname', portal: 'Mitgliederportal (in Vorbereitung)', portalA: 'Ein geschützter Bereich für Ihre Mitgliedsdaten und Ihre Beiträge — dieser Abschnitt wird später gebaut.', basvuru: 'Mitglied werden', basvuruA: 'Wenden Sie sich an den Vorstand des Vereins; das Beitrittsformular füllen Sie in der Moschee aus.' },
} satisfies Record<Dil, unknown>;
const m = M[dil];
---
<IcerikSayfasi dil={dil} anahtar="uyelik" etiket={t('nav.uyelik')}>
  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.hesap}</p>
    <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
      <div class="col-span-2"><dt class="etiket">{m.aidat}</dt><dd class="font-serif text-2xl font-bold leading-tight">{m.aidatTutar}</dd></div>
      <div class="col-span-2"><dt class="etiket">{m.iban}</dt><dd class="mono text-lg font-medium select-all">{site.banka.iban}</dd></div>
      <div><dt class="etiket">{m.bic}</dt><dd class="mono">{site.banka.bic}</dd></div>
      <div><dt class="etiket">{m.hesapAdi}</dt><dd>{site.banka.hesapAdi}</dd></div>
      <div class="col-span-2"><dt class="etiket">{m.acik}</dt><dd class="mono">{m.acikOrnek}</dd></div>
    </dl>
  </div>
  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.portal}</p>
    <p class="mt-1 text-sm text-(--metin-2)">{m.portalA}</p>
    <a href={yol(dil, 'portal')} class="dugme dugme-ikincil mt-3 w-full justify-center">{t('nav.portal')}</a>
  </div>
  <p slot="yan" class="text-sm"><span class="etiket">{m.basvuru}</span><br />{m.basvuruA}<br /><a href={tel(site.telefon.cami)} class="mono inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.cami}</a></p>
</IcerikSayfasi>
