---
/**
 * Yönetim Kurulu — dernek organları (veri: src/content/ayarlar/kurul.yaml, CMS'ten düzenlenebilir).
 *
 * KURGU (26 Ağustos 2026): önce herkes 48 px'lik yuvarlak avatarlarla iki sütunlu bir
 * listede duruyordu; sekiz kişiden beşinin fotoğrafı yoktu, olanlar da 3-12 KB'lik düşük
 * çözünürlüklü dosyalardı. Sayfa "kim bu insanlar" sorusuna cevap vermiyordu.
 *
 * Şimdi: yönetim kurulu üyeleri 4:5 portrelerle, ızgarada büyük kartlar hâlinde duruyor.
 * Fotoğrafı olmayan üye için aynı orana oturan bir monogram levhası üretiliyor, böylece
 * ızgara ritmi bozulmuyor. Din görevlisi bu sayfada YER ALMIYOR (Rıdvan'ın 26 Ağustos
 * talebi) — kurul.yaml'daki dinGorevlisi verisi başka sayfalarda kullanılmaya devam ediyor.
 */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { kurulBilgisi, siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const k = await kurulBilgisi();
const site = await siteAyarlari();

const m = dil === 'tr' ? {
  alt: 'Camimizi yaşatan derneğin yönetim ve denetim organları. Dernek, genel kurulda üyelerin seçtiği yönetim kuruluyla yönetilir.',
  etiket: 'Dernek',
  giris: 'Marche-en-Famenne Ulu Camii’ni 1979’dan bu yana cemaatin kendi kurduğu dernek yaşatıyor. Derneği, üyelerin genel kurulda seçtiği yönetim kurulu yönetir; gelir-gider ve işleyiş denetim kurulunca denetlenir. Aşağıdaki isimler camimizin günlük işleyişinden sorumludur — bakım ve onarımdan Kur’an kurslarına, cenaze hizmetlerinden bayram programlarına kadar.',
  kurulBaslik: 'Yönetim Kurulu',
  denetimBaslik: 'Denetim Kurulu',
  kunyeBaslik: 'Dernek künyesi',
  adres: 'Adres', kbo: 'KBO/BCE numarası', hukuk: 'Hukukî form', donemEtiket: 'Görev dönemi',
  iletisimBaslik: 'Yönetime ulaşın',
  iletisimAlt: 'Dernek işleri (üyelik, aidat, bağış makbuzu, salon/etkinlik) için:',
  uyeCagri: 'Siz de derneğe üye olarak genel kurulda söz sahibi olabilirsiniz.',
  uyeDugme: 'Dernek üyeliği',
  gorevNot: k.not.tr,
} : dil === 'en' ? {
  alt: 'The governing and audit bodies of the association that runs our mosque. The association is governed by a board elected by the members at the general assembly.',
  etiket: 'Association',
  giris: 'Since 1979 the Ulu Camii of Marche-en-Famenne has been kept alive by an association the community founded itself. It is run by a board elected by the members at the general assembly, and its accounts and operations are reviewed by an audit committee. The people below are responsible for the daily running of our mosque — from maintenance and repairs to Qur’an courses, from funeral services to festival programmes.',
  kurulBaslik: 'Board of Directors',
  denetimBaslik: 'Audit Committee',
  kunyeBaslik: 'Association details',
  adres: 'Address', kbo: 'KBO/BCE number', hukuk: 'Legal form', donemEtiket: 'Term of office',
  iletisimBaslik: 'Contact the board',
  iletisimAlt: 'For association matters (membership, dues, donation receipts, events):',
  uyeCagri: 'You too can have a voice at the general assembly by becoming a member.',
  uyeDugme: 'Membership',
  gorevNot: k.not.en,
} : {
  alt: "Les organes de gestion et de contrôle de l'association qui fait vivre notre mosquée. L'association est dirigée par un conseil élu par les membres lors de l'assemblée générale.",
  etiket: 'Association',
  giris: "Depuis 1979, la mosquée Ulu Camii de Marche-en-Famenne est portée par une association fondée par la communauté elle-même. Elle est dirigée par un conseil d'administration élu par les membres en assemblée générale ; ses comptes et son fonctionnement sont contrôlés par un comité de contrôle. Les personnes ci-dessous assurent la vie quotidienne de notre mosquée : de l'entretien aux cours de Coran, des services funéraires aux programmes de fête.",
  kurulBaslik: "Conseil d'administration",
  denetimBaslik: 'Comité de contrôle',
  kunyeBaslik: "Identité de l'association",
  adres: 'Adresse', kbo: 'Numéro KBO/BCE', hukuk: 'Forme juridique', donemEtiket: 'Mandat',
  iletisimBaslik: 'Contacter le conseil',
  iletisimAlt: "Pour les affaires de l'association (adhésion, cotisation, reçus de dons, activités) :",
  uyeCagri: "Vous aussi, devenez membre et prenez part aux décisions de l'assemblée générale.",
  uyeDugme: 'Adhésion',
  gorevNot: k.not.fr,
};

const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const basHarf = (ad: string) => ad.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toLocaleUpperCase('tr-TR');
---
<Base baslik={t('nav.yonetim')} dil={dil} aciklama={m.alt}>
  <SayfaBasligi etiket={m.etiket} baslik={t('nav.yonetim')} altBaslik={m.alt} />

  <div class="kapsayici py-10 flex flex-col gap-12">
    <p class="max-w-[64ch] text-(--metin-2)">{m.giris}</p>

    <section aria-labelledby="yk-baslik">
      <h2 id="yk-baslik" class="etiket etiket-vurgu text-base cetvel pt-4 mb-5">{m.kurulBaslik}</h2>
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {k.uyeler.map((u, i) => (
          <li class:list={['uye-kart kart-kagit overflow-hidden flex flex-col', i === 0 && 'baskan']}>
            <div class="portre">
              {u.foto
                ? <img src={u.foto} alt="" width="800" height="1000" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                : <span class="monogram" aria-hidden="true">{basHarf(u.ad)}</span>}
            </div>
            <div class="px-4 py-3.5">
              <p class="font-serif text-lg leading-tight">{u.ad}</p>
              <p class:list={['etiket normal-case tracking-normal mt-1', i === 0 && 'etiket-vurgu']}>{u.gorev[dil]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Denetim kurulu da yönetim kuruluyla aynı boyutta portre kartlarında duruyor
        (Rıdvan'ın isteği). Aynı ızgara ölçüsü kullanıldığı için kartlar üstteki bölümle
        hizalı çıkıyor; iki kişi olduğu için son sütun boş kalıyor. */}
    <section aria-labelledby="dk-baslik">
      <h2 id="dk-baslik" class="etiket etiket-vurgu text-base cetvel pt-4 mb-5">{m.denetimBaslik}</h2>
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {k.denetim.map((u) => (
          <li class="uye-kart kart-kagit overflow-hidden flex flex-col">
            <div class="portre">
              {u.foto
                ? <img src={u.foto} alt="" width="800" height="1000" loading="lazy" decoding="async" />
                : <span class="monogram denetim" aria-hidden="true">{basHarf(u.ad)}</span>}
            </div>
            <div class="px-4 py-3.5">
              <p class="font-serif text-lg leading-tight">{u.ad}</p>
              <p class="etiket normal-case tracking-normal mt-1">{u.gorev[dil]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <section class="kart-kagit p-6" aria-labelledby="kunye-baslik">
        <h2 id="kunye-baslik" class="etiket etiket-vurgu mb-4">{m.kunyeBaslik}</h2>
        <dl class="grid gap-3 sm:grid-cols-2 text-sm">
          <div class="sm:col-span-2"><dt class="etiket">{m.etiket}</dt><dd class="mt-0.5">{site.dernekAdi} ({site.kisaltma})</dd></div>
          <div><dt class="etiket">{m.hukuk}</dt><dd class="mt-0.5">{site.hukukiForm}</dd></div>
          <div><dt class="etiket">{m.kbo}</dt><dd class="mt-0.5 mono">{site.kbo}</dd></div>
          <div class="sm:col-span-2"><dt class="etiket">{m.adres}</dt><dd class="mt-0.5">{site.adres.sokak}, {site.adres.posta} {site.adres.sehir}, {site.adres.ulke}</dd></div>
        </dl>
        <p class="mt-5 text-sm text-(--metin-2)">{m.gorevNot}</p>
      </section>

      <aside class="grid gap-5 content-start">
        <div class="kart p-5">
          <p class="etiket etiket-vurgu">{m.iletisimBaslik}</p>
          <p class="mt-1 text-sm text-(--metin-2)">{m.iletisimAlt}</p>
          <dl class="mt-3 grid gap-2 text-sm">
            <div><dt class="etiket">{t('footer.cami')}</dt><dd><a href={tel(site.telefon.cami)} class="mono inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.cami}</a></dd></div>
            {site.eposta && <div><dt class="etiket">{t('genel.eposta')}</dt><dd><a href={`mailto:${site.eposta}`} class="inline-flex items-center min-h-11 -my-2 py-2">{site.eposta}</a></dd></div>}
          </dl>
        </div>
        <div class="kart-kagit p-5">
          <p class="text-sm">{m.uyeCagri}</p>
          <a href={yol(dil, 'uyelik')} class="dugme dugme-birincil mt-3 w-full justify-center">{m.uyeDugme}</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  /* Portreler tek orana (4:5) oturur — fotoğraflar farklı makinelerden geldiği için
     ızgarayı hizada tutan şey bu oran. Hafif sepya, setteki ton farklarını yumuşatır. */
  .portre {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--zemin-3);
    overflow: hidden;
  }
  .portre img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Dosyalar zaten 4:5 kırpıldı; kutu da 4:5. Yüzde konumlandırma yuvarlama
       farklarında başın üstünü kırpabiliyordu — ortalamak yeterli. */
    object-position: center;
    filter: sepia(0.05) saturate(1.02);
  }

  /* Fotoğrafı olmayan üye: boş kutu bırakmak yerine aynı orana oturan monogram levhası. */
  .monogram {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif, Lora, Georgia, serif);
    font-size: clamp(2.6rem, 7vw, 3.6rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--vurgu, #b5452b) 70%, var(--metin-2));
    background:
      radial-gradient(circle at 50% 38%, color-mix(in oklab, var(--vurgu, #b5452b) 11%, transparent), transparent 62%),
      var(--zemin-3);
  }

  /* Denetim kurulu levhaları İznik mavisi tonunda: aynı biçim, farklı organ. */
  .monogram.denetim {
    color: color-mix(in oklab, var(--vurgu-2, #1f5f8b) 72%, var(--metin-2));
    background:
      radial-gradient(circle at 50% 38%, color-mix(in oklab, var(--vurgu-2, #1f5f8b) 11%, transparent), transparent 62%),
      var(--zemin-3);
  }

  /* Başkanın kartı ızgarada aynı boyutta kalır ama çerçevesiyle öne çıkar. */
  .uye-kart.baskan { border-color: color-mix(in oklab, var(--vurgu, #b5452b) 45%, var(--cizgi)); }
</style>
