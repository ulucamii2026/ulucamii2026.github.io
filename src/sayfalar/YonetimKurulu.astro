---
/**
 * Yönetim Kurulu — dernek organları (veri: src/content/ayarlar/kurul.yaml, CMS'ten düzenlenebilir).
 *
 * KURGU (26 Ağustos 2026): önce herkes 48 px'lik yuvarlak avatarlarla iki sütunlu bir
 * listede duruyordu; sekiz kişiden beşinin fotoğrafı yoktu. Sayfa "kim bu insanlar"
 * sorusuna cevap vermiyordu. O yüzden portreler öne çıkarıldı.
 *
 * TASARIM REVİZYONU (27 Ağustos 2026): portreler 4:5 oranında ve 455 px yüksekliğinde
 * duruyordu. Sekiz fotoğraf sekiz ayrı makineden geldiği için — stüdyo çekimi, pasaport
 * fotoğrafı, dantel perde önünde selfie, montlu enstantane — bu ölçek her farkı
 * büyütüyordu; ızgara bir kurul değil, uyumsuz bir kolaj gibi okunuyordu. Üç değişiklik:
 *   1) kare kadraj — gereksiz arka planı ve gövdeyi kesiyor, yüzü aynı boyda bırakıyor;
 *   2) sıcak nötr monokrom — ışık, renk sıcaklığı ve arka plan farklarını tek tona
 *      indiriyor (denendi: saf s/b soğuk, sepya "hatıra fotoğrafı" gibi duruyordu);
 *   3) kartlar .kart-kagit yerine .kart — sayfa zemini de kâğıt olduğu için kartlar
 *      yalnız saç teli çizgiyle ayrılıyordu, artık krem zeminle levha gibi duruyorlar.
 * Denetim kurulu iki kişi: üç sütunlu ızgarada sağda boş sütun kalıyordu, iki kart
 * yönetim kurulununkiyle aynı genişlikte tutulup ortalandı.
 *
 * Din görevlisi bu sayfada YER ALMIYOR (Rıdvan'ın 26 Ağustos talebi) — kurul.yaml'daki
 * dinGorevlisi verisi başka sayfalarda kullanılmaya devam ediyor.
 */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { kurulBilgisi, siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
/* Portre kutusu mobilde iki sütunda ~165px, tablette ~250px, masaüstünde 370px'te
   sabitleniyor (kapsayıcı 72rem'de duruyor). 400px'lik eş varsa srcset'e giriyor;
   dosya yoksa öznitelik hiç yazılmıyor — eksik bir kaynak yüzünden görsel kırılmasın. */
import { existsSync } from 'node:fs';
const srcSet = (f?: string) => {
  if (!f) return undefined;
  const k = f.replace(/\.webp$/, '-kucuk.webp');
  return existsSync('public' + k) ? `${k} 400w, ${f} 800w` : undefined;
};
const OLCU = '(min-width: 1280px) 370px, (min-width: 640px) 30vw, 45vw';

const { dil } = Astro.props; const t = ceviri(dil);
const k = await kurulBilgisi();
const site = await siteAyarlari();

const m = dil === 'tr' ? {
  alt: 'Camimizi yaşatan derneğin yönetim ve denetim organları. Dernek, genel kurulda üyelerin seçtiği yönetim kuruluyla yönetilir.',
  etiket: 'Dernek',
  giris: 'Marche-en-Famenne Ulu Camii’ni 1979’dan bu yana cemaatin kendi kurduğu dernek yaşatıyor. Derneği, üyelerin genel kurulda seçtiği yönetim kurulu yönetir; gelir-gider ve işleyiş denetim kurulunca denetlenir. Aşağıdaki isimler camimizin günlük işleyişinden sorumludur — bakım ve onarımdan Kur’an kurslarına, cenaze hizmetlerinden bayram programlarına kadar.',
  kurulBaslik: 'Yönetim Kurulu',
  denetimBaslik: 'Denetim Kurulu',
  kunyeBaslik: 'Dernek künyesi',
  adres: 'Adres', kbo: 'KBO/BCE numarası', hukuk: 'Hukukî form',
  iletisimBaslik: 'Yönetime ulaşın',
  iletisimAlt: 'Dernek işleri (üyelik, aidat, bağış makbuzu, salon/etkinlik) için:',
  uyeCagri: 'Siz de derneğe üye olarak genel kurulda söz sahibi olabilirsiniz.',
  uyeDugme: 'Dernek üyeliği',
  sukranBaslik: 'Şükran ve tebrik',
  sukranGiris: 'Bu cami tek bir elin değil, 1979’dan bu yana birbirine kenetlenen ellerin eseridir.',
  sukran1: 'Bugün açık duran bu kapıyı, adları bu sayfada yazmayan pek çok insan açtı. 1979’dan bu yana yönetim ve denetim kurullarında görev almış bütün büyüklerimize — camimizi kuranlara, büyütenlere, yıllarca karşılık beklemeden emek verenlere — cemaatimiz adına şükranlarımızı sunuyoruz. Bugün işleyen ne varsa, onların bıraktığı emanetin üzerine kuruldu.',
  sukran2: '9 Ocak 2026 Genel Kurulu’nda seçilen yönetim kurulumuzu tebrik ediyor, göreve başladığı günden bu yana ortaya koyduğu gayreti takdirle karşılıyoruz. Camimizin bakımından Kur’an kursuna, cenaze hizmetlerinden bayram ve kandil programlarına kadar bu işlerin çoğu görünmeden, mesai sonrasında ve gönüllülükle yürüyor. Rabbimiz gayretlerini kabul etsin, işlerini kolaylaştırsın.',
  sukran3: 'Bu yük tek başına taşınmıyor. Din görevlilerimizin, Kur’an kursu hocalarımızın ve her hafta safları dolduran cemaatimizin katkısı olmasa bu kapılar açık kalmazdı. Yönetim kurulu, din görevlisi, hocalarımız ve cemaat: dördü birlikte yürüdüğünde cami yaşıyor, biri eksildiğinde hepsi zorlanıyor. Bizi ayakta tutan şey birliğimizdir.',
  hadisMeal: '“Mü’minin mü’mine karşı durumu, bir parçası diğer parçasını sımsıkı kenetleyip tutan binalar gibidir.”',
  hadisNot: 'Hz. Peygamber bunu söylerken iki elinin parmaklarını birbirine geçirdi.',
  hadisKaynak: 'Buhârî, Salât 88 · Müslim, Birr 65',
  gorevNot: k.not.tr,
} : dil === 'en' ? {
  alt: 'The governing and audit bodies of the association that runs our mosque. The association is governed by a board elected by the members at the general assembly.',
  etiket: 'Association',
  giris: 'Since 1979 the Ulu Camii of Marche-en-Famenne has been kept alive by an association the community founded itself. It is run by a board elected by the members at the general assembly, and its accounts and operations are reviewed by an audit committee. The people below are responsible for the daily running of our mosque — from maintenance and repairs to Qur’an courses, from funeral services to festival programmes.',
  kurulBaslik: 'Board of Directors',
  denetimBaslik: 'Audit Committee',
  kunyeBaslik: 'Association details',
  adres: 'Address', kbo: 'KBO/BCE number', hukuk: 'Legal form',
  iletisimBaslik: 'Contact the board',
  iletisimAlt: 'For association matters (membership, dues, donation receipts, events):',
  uyeCagri: 'You too can have a voice at the general assembly by becoming a member.',
  uyeDugme: 'Membership',
  sukranBaslik: 'Gratitude and congratulations',
  sukranGiris: 'This mosque is not the work of a single pair of hands, but of hands that have held on to one another since 1979.',
  sukran1: 'The door that stands open today was opened by many people whose names do not appear on this page. To everyone who has served on the board or the audit committee since 1979 — those who founded our mosque, those who helped it grow, those who gave years of their lives expecting nothing in return — we offer our thanks on behalf of our community. Whatever works today rests on what they entrusted to us.',
  sukran2: 'We congratulate the board elected at the General Assembly of 9 January 2026, and we gratefully recognise the effort it has made since taking office. From the upkeep of the mosque to the Qur’an courses, from funeral services to the programmes of festivals and holy nights, most of this work is done quietly, after working hours and on a voluntary basis. May God accept their efforts and make their task easy.',
  sukran3: 'This burden is not carried alone. Without our imams, without our Qur’an course teachers, and without the congregation that fills the rows week after week, these doors would not stay open. Board, imam, teachers and congregation: when the four walk together the mosque lives; when one is missing, all of them struggle. What keeps us standing is our unity.',
  hadisMeal: '“The believer is to the believer like a building, each part supporting the other.”',
  hadisNot: 'As he said this, the Prophet interlaced the fingers of his two hands.',
  hadisKaynak: 'Bukhari, Salat 88 · Muslim, Birr 65',
  gorevNot: k.not.en,
} : {
  alt: "Les organes de gestion et de contrôle de l'association qui fait vivre notre mosquée. L'association est dirigée par un conseil élu par les membres lors de l'assemblée générale.",
  etiket: 'Association',
  giris: "Depuis 1979, la mosquée Ulu Camii de Marche-en-Famenne est portée par une association fondée par la communauté elle-même. Elle est dirigée par un conseil d'administration élu par les membres en assemblée générale ; ses comptes et son fonctionnement sont contrôlés par un comité de contrôle. Les personnes ci-dessous assurent la vie quotidienne de notre mosquée : de l'entretien aux cours de Coran, des services funéraires aux programmes de fête.",
  kurulBaslik: "Conseil d'administration",
  denetimBaslik: 'Comité de contrôle',
  kunyeBaslik: "Identité de l'association",
  adres: 'Adresse', kbo: 'Numéro KBO/BCE', hukuk: 'Forme juridique',
  iletisimBaslik: 'Contacter le conseil',
  iletisimAlt: "Pour les affaires de l'association (adhésion, cotisation, reçus de dons, activités) :",
  uyeCagri: "Vous aussi, devenez membre et prenez part aux décisions de l'assemblée générale.",
  uyeDugme: 'Adhésion',
  sukranBaslik: 'Reconnaissance et félicitations',
  sukranGiris: "Cette mosquée n'est pas l'œuvre d'une seule paire de mains, mais de mains qui se tiennent depuis 1979.",
  sukran1: "La porte qui est ouverte aujourd'hui a été ouverte par bien des personnes dont le nom ne figure pas sur cette page. À toutes celles et ceux qui ont siégé au conseil d'administration ou au comité de contrôle depuis 1979 — ceux qui ont fondé notre mosquée, ceux qui l'ont fait grandir, ceux qui ont donné des années sans rien attendre en retour — nous exprimons, au nom de notre communauté, notre profonde reconnaissance. Tout ce qui fonctionne aujourd'hui repose sur ce qu'ils nous ont confié.",
  sukran2: "Nous félicitons le conseil d'administration élu lors de l'Assemblée générale du 9 janvier 2026 et saluons avec gratitude l'effort qu'il fournit depuis son entrée en fonction. De l'entretien de la mosquée aux cours de Coran, des services funéraires aux programmes des fêtes et des nuits bénies, l'essentiel de ce travail se fait discrètement, après les heures de travail et bénévolement. Que Dieu agrée leurs efforts et facilite leur tâche.",
  sukran3: "Cette charge ne se porte pas seul. Sans nos imams, sans nos enseignantes et enseignants de l'école coranique, sans les fidèles qui remplissent les rangs chaque semaine, ces portes ne resteraient pas ouvertes. Conseil, imam, enseignants et communauté : quand les quatre avancent ensemble, la mosquée vit ; dès que l'un manque, tous peinent. Ce qui nous tient debout, c'est notre unité.",
  hadisMeal: "« Le croyant est pour le croyant comme un édifice dont les parties se soutiennent l'une l'autre. »",
  hadisNot: "En prononçant ces mots, le Prophète entrelaça les doigts de ses deux mains.",
  hadisKaynak: 'Bukhârî, Salât 88 · Muslim, Birr 65',
  gorevNot: k.not.fr,
};

const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const basHarf = (ad: string) => ad.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toLocaleUpperCase('tr-TR');
---
<Base baslik={t('nav.yonetim')} dil={dil} aciklama={m.alt}>
  <SayfaBasligi etiket={m.etiket} baslik={t('nav.yonetim')} altBaslik={m.alt} />

  <div class="kapsayici py-10 flex flex-col gap-12">
    <p class="giris">{m.giris}</p>

    <section aria-labelledby="yk-baslik">
      <h2 id="yk-baslik" class="etiket etiket-vurgu text-base cetvel pt-4 mb-5">{m.kurulBaslik}</h2>
      <ol class="kurul-izgara" role="list">
        {k.uyeler.map((u, i) => (
          <li class:list={['uye-kart kart', i === 0 && 'baskan']}>
            <div class="portre">
              {u.foto
                ? <img src={u.foto} srcset={srcSet(u.foto)} sizes={OLCU} alt="" width="800" height="1000" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                : <span class="monogram" aria-hidden="true">{basHarf(u.ad)}</span>}
            </div>
            <div class="uye-kunye">
              <p class="uye-ad">{u.ad}</p>
              <p class:list={['uye-gorev', i === 0 && 'birincil']}>{u.gorev[dil]}</p>
              {u.eposta && <p class="uye-eposta"><a href={`mailto:${u.eposta}`}>{u.eposta.split('@')[0]}@<wbr />{u.eposta.split('@')[1]}</a></p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Denetim kurulu da yönetim kuruluyla aynı boyutta portre kartlarında duruyor
        (Rıdvan'ın isteği). Kart genişliği üstteki ızgaranın sütun genişliğine eşit
        tutuluyor, iki kart da ortalanıyor — sağda boş sütun kalmıyor. */}
    <section aria-labelledby="dk-baslik">
      <h2 id="dk-baslik" class="etiket etiket-vurgu text-base cetvel pt-4 mb-5">{m.denetimBaslik}</h2>
      <ol class="kurul-izgara ikili" role="list">
        {k.denetim.map((u) => (
          <li class="uye-kart kart">
            <div class="portre">
              {u.foto
                ? <img src={u.foto} srcset={srcSet(u.foto)} sizes={OLCU} alt="" width="800" height="1000" loading="lazy" decoding="async" />
                : <span class="monogram denetim" aria-hidden="true">{basHarf(u.ad)}</span>}
            </div>
            <div class="uye-kunye">
              <p class="uye-ad">{u.ad}</p>
              <p class="uye-gorev">{u.gorev[dil]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Şükran ve tebrik (27 Ağustos 2026, Rıdvan'ın isteği). Sayfa buraya kadar
        "kim bu insanlar" sorusuna cevap veriyordu; bu bölüm "bu iş nasıl yürüyor"
        sorusuna cevap veriyor: önceki kurullara teşekkür, mevcut kurula takdir ve
        tebrik, dört tarafa (kurul · din görevlisi · hocalar · cemaat) birliktelik
        vurgusu. Hadis kaynağından doğrulandı: Buhârî 481 (Salât 88), Müslim 2585
        (Birr 65) — sunnah.com. */}
    <section aria-labelledby="sukran-baslik">
      <h2 id="sukran-baslik" class="etiket etiket-vurgu text-base cetvel pt-4 mb-5">{m.sukranBaslik}</h2>
      <div class="sukran kart p-6 sm:p-8">
        <p class="sukran-giris">{m.sukranGiris}</p>
        <div class="sukran-metin">
          <p>{m.sukran1}</p>
          <p>{m.sukran2}</p>
          <p>{m.sukran3}</p>
        </div>
        <figure class="hadis cetvel">
          <p class="arabic" lang="ar" dir="rtl">الْمُؤْمِنُ لِلْمُؤْمِنِ كَالْبُنْيَانِ يَشُدُّ بَعْضُهُ بَعْضًا</p>
          <blockquote>{m.hadisMeal}</blockquote>
          <p class="mt-2 text-sm text-(--metin-2)">{m.hadisNot}</p>
          <figcaption class="etiket normal-case tracking-normal mt-3">{m.hadisKaynak}</figcaption>
        </figure>
      </div>
    </section>

    {/* items-start olmasa künye kartı yandaki sütunun boyuna geriliyor ve altında
        130 px'lik boş bir alan kalıyordu. */}
    <div class="grid gap-6 items-start lg:grid-cols-[minmax(0,1fr)_340px]">
      <section class="kart-kagit p-6" aria-labelledby="kunye-baslik">
        <h2 id="kunye-baslik" class="etiket etiket-vurgu mb-4">{m.kunyeBaslik}</h2>
        <dl class="grid gap-3 sm:grid-cols-2 text-sm">
          <div class="sm:col-span-2"><dt class="etiket">{m.etiket}</dt><dd class="mt-0.5">{site.dernekAdi} ({site.kisaltma})</dd></div>
          <div><dt class="etiket">{m.hukuk}</dt><dd class="mt-0.5">{site.hukukiForm}</dd></div>
          <div><dt class="etiket">{m.kbo}</dt><dd class="mt-0.5 mono">{site.kbo}</dd></div>
          <div class="sm:col-span-2"><dt class="etiket">{m.adres}</dt><dd class="mt-0.5">{site.adres.sokak}, {site.adres.posta} {site.adres.sehir}, {site.adres.ulke}</dd></div>
        </dl>
        <p class="mt-5 text-sm text-(--metin-2)">{m.gorevNot}</p>
      </section>

      <aside class="grid gap-5 content-start">
        <div class="kart p-5">
          <p class="etiket etiket-vurgu">{m.iletisimBaslik}</p>
          <p class="mt-1 text-sm text-(--metin-2)">{m.iletisimAlt}</p>
          <dl class="mt-3 grid gap-2 text-sm">
            <div><dt class="etiket">{t('footer.cami')}</dt><dd><a href={tel(site.telefon.cami)} class="mono inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.cami}</a>{site.eposta && <><br /><a href={`mailto:${site.eposta}`} class="inline-flex items-center min-h-11 -my-2 py-2">{site.eposta}</a></>}</dd></div>
            <div><dt class="etiket">{t('footer.dingorevlisi')}</dt><dd><a href={tel(site.telefon.dinGorevlisi)} class="mono inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.dinGorevlisi}</a>{site.epostaDinGorevlisi && <><br /><a href={`mailto:${site.epostaDinGorevlisi}`} class="inline-flex items-center min-h-11 -my-2 py-2">{site.epostaDinGorevlisi}</a></>}</dd></div>
          </dl>
        </div>
        <div class="kart-kagit p-5">
          <p class="text-sm">{m.uyeCagri}</p>
          <a href={yol(dil, 'uyelik')} class="dugme dugme-birincil mt-3 w-full justify-center">{m.uyeDugme}</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  /* Sayfa girişi bir standfirst: gövde metninden bir tık büyük ve tam kontrastlı,
     çünkü sayfanın "dernek nasıl işliyor" cevabının tamamı bu paragrafta. */
  .giris {
    max-width: 62ch;
    font-size: clamp(1.02rem, 0.98rem + 0.28vw, 1.15rem);
    line-height: 1.75;
    color: var(--metin);
  }

  /* Kurul ızgarası. Mobilde iki sütun: sekiz portre tek sütunda dizilince sayfa
     390 px'lik ekranda 8259 px'e uzuyordu, iki sütunda 5114 px'e indi. --bosluk
     değişken, çünkü denetim kurulunun sütun genişliği ondan hesaplanıyor. */
  .kurul-izgara {
    --bosluk: 0.85rem;
    display: grid;
    gap: var(--bosluk);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) {
    .kurul-izgara {
      --bosluk: 1.25rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* İki kart, üstteki ızgaranın sütun genişliğinde ve ortalanmış. */
    .kurul-izgara.ikili {
      grid-template-columns: repeat(2, calc((100% - 2 * var(--bosluk)) / 3));
      justify-content: center;
    }
  }

  .uye-kart {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* KARE KADRAJ: kaynak dosyalar 4:5. Kutu 1:1 olunca cover, alt kenardan yaklaşık
     %20 kırpıyor — yüz aynı boyda kalırken dantel perde, mont ve gömlek kadraj dışına
     çıkıyor. Hiza 'top': sekiz portrenin birkaçında baş zaten kaynak dosyanın üst
     kenarına yakın, %8 ve %22 denendi, ikisinde de Volkan Kutlu'nun saçının üstü
     kesiliyordu. Üstten hiç kırpmamak tek güvenli seçenek. */
  .portre {
    position: relative;
    aspect-ratio: 1;
    background: var(--zemin-3);
    overflow: hidden;
    border-bottom: 1px solid var(--cizgi);
  }
  .portre img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    /* SICAK NÖTR MONOKROM: sekiz fotoğrafın ışığını, renk sıcaklığını ve arka planını
       tek tona indirir. Saf siyah-beyaz denendi, klinik duruyordu; sepya oranı 0.4'e
       çıkınca "hatıra fotoğrafı" tonuna kaçıyordu. 0.22 sıcak ama canlı kalıyor. */
    --portre-parlaklik: 1.02;
    --portre-kontrast: 1.06;
    filter: grayscale(1) contrast(var(--portre-kontrast)) brightness(var(--portre-parlaklik))
            sepia(0.22) saturate(1.2) hue-rotate(-8deg);
  }
  /* Koyu temada fotoğrafların açık arka planları ceviz zeminde parlıyor; bir tık
     kısılınca levhaya monte edilmiş baskı gibi duruyorlar. İki seçici de gerekli:
     biri işletim sistemi tercihi, öteki sitedeki tema düğmesi. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .portre img { --portre-parlaklik: 0.9; --portre-kontrast: 1.04; }
  }
  :root[data-theme="dark"] .portre img { --portre-parlaklik: 0.9; --portre-kontrast: 1.04; }

  /* Fotoğrafı olmayan üye: boş kutu bırakmak yerine aynı orana oturan monogram levhası. */
  .monogram {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif, Lora, Georgia, serif);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--vurgu, #b5452b) 70%, var(--metin-2));
    background:
      radial-gradient(circle at 50% 38%, color-mix(in oklab, var(--vurgu, #b5452b) 11%, transparent), transparent 62%),
      var(--zemin-3);
  }

  /* Ad ve görev: portrenin altında, levhanın künye satırı gibi. */
  .uye-kunye { padding: 0.7rem 0.8rem 0.85rem; }
  .uye-ad {
    font-family: var(--font-serif, Lora, Georgia, serif);
    font-size: clamp(0.95rem, 0.88rem + 0.34vw, 1.15rem);
    line-height: 1.28;
    color: var(--metin);
    text-wrap: balance;
