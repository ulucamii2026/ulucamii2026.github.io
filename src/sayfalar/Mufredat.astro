        <p class="pdf-alt">{m.pdfAlt(meta.pdfSayfa, mbBicim)}</p>
        <a href={HTML} class="dugme dugme-ikincil mt-2 w-full justify-center" target="_blank" rel="noopener">{m.yazdir}<span aria-hidden="true"> ↗</span></a>
        <a href={PLAN} class="dugme dugme-ikincil mt-2 w-full justify-center">{t('nav.yillikplan')}</a>
        <p class="surum"><span class="etiket">{m.surum}</span> <time datetime={meta.belgeSurumu}>{surumMetni}</time></p>
      </div>
      <p class="kitap-not">{m.kitapNot} — <a href={yol(dil, 'kurankursu') + m.kitapCapa}>{m.kitapBag}</a></p>
      <a href={yol(dil, 'kurankursu')} class="dugme dugme-ikincil w-full justify-center">{m.kayit}</a>
    </aside>
  </div>
</Base>

<script>
  /* Kaydırma takibi: görünürdeki bölüm içindekilerde işaretlenir (aria-current), dar ekranda özet
     satırına yazılır. Site başlığı yapışkan olduğundan yüksekliği ölçülüp --mf-ust'a yazılır
     (scroll-margin-top bunu kullanır); mobil menü açılınca da değiştiği için ResizeObserver. */
  const govde = document.querySelector<HTMLElement>('[data-govde]');
  const mobil = document.querySelector<HTMLDetailsElement>('[data-toc-mobil]');
  if (govde) {
    const basliklar = [...govde.querySelectorAll<HTMLElement>('h2[id], h3[id]')];
    const bagler = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')];
    const simdi = document.querySelector<HTMLElement>('[data-toc-simdi]');
    const kok = document.documentElement;
    let ust = 79, ek = 0;
    const olc = () => {
      const bas = document.querySelector<HTMLElement>('body > header');
      ust = bas ? bas.offsetHeight : 79;
      const ozet = mobil?.querySelector<HTMLElement>('summary');
      ek = ozet ? ozet.offsetHeight : 0;          // lg'de details gizli → 0
      kok.style.setProperty('--mf-ust', ust + 'px');
      kok.style.setProperty('--mf-toc', ek + 'px');
    };
    let simdiki = '';
    const guncelle = () => {
      const esik = ust + ek + 24;
      let i = -1;
      for (let k = 0; k < basliklar.length; k++) if (basliklar[k].getBoundingClientRect().top <= esik) i = k;
      const id = i >= 0 ? basliklar[i].id : '';
      if (id === simdiki) return;
      simdiki = id;
      let ad = '';
      for (const a of bagler) {
        const su = a.getAttribute('href') === '#' + id;
        if (su) { a.setAttribute('aria-current', 'true'); ad = a.dataset.ad ?? ''; } else a.removeAttribute('aria-current');
      }
      if (simdi) simdi.textContent = ad;
    };
    let bekliyor = false;
    const tetik = () => { if (bekliyor) return; bekliyor = true; requestAnimationFrame(() => { bekliyor = false; guncelle(); }); };
    olc(); guncelle();
    addEventListener('scroll', tetik, { passive: true });
    const bas = document.querySelector<HTMLElement>('body > header');
    if (bas && 'ResizeObserver' in window) new ResizeObserver(() => { olc(); tetik(); }).observe(bas);
    addEventListener('resize', () => { olc(); tetik(); }, { passive: true });
    if (mobil) {
      mobil.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) mobil.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mobil.open) { mobil.open = false; mobil.querySelector<HTMLElement>('summary')?.focus(); } });
      document.addEventListener('click', (e) => { if (mobil.open && !mobil.contains(e.target as Node)) mobil.open = false; });
    }
  }
</script>

