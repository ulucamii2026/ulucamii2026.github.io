---
/**
 * Kur'an Kursu 2026-2027 Müfredat ve Yıllık Ders Planı — «program rehberi».
 *
 * Gövde (src/data/mufredat-2026-2027.html) elle yazılmaz: OneDrive'daki Word belgesinden
 * D:\app\marche-cami-sitesi\mufredat\mufredat-uret.py üretir. Sitede 1. ve 2. bölüm belgeden gelir;
 * 3. bölümün 261 satırlık tablosu sitede basılmaz (gün gün sayfa + PDF var) — yerine
 * src/data/yillik-plan-2026-2027.json'dan «ay ay bakış» kurulur. Ders dağılımı, içindekiler ve PDF
 * düğmesindeki sayfa sayısı da üretilmiş verilerden okunur (mufredat-meta.json); elle sayı yazılmaz.
 * Belge Türkçedir; FR/EN sayfalar yerelleştirilmiş çerçeve + kısa not verip gövdeyi lang="tr" ile gösterir.
 */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import govdeHam from '../data/mufredat-2026-2027.html?raw';
import plan from '../data/yillik-plan-2026-2027.json';
import meta from '../data/mufredat-meta.json';
interface Props { dil: Dil }
const { dil } = Astro.props;
const t = ceviri(dil);

const PDF = '/belgeler/kuran-kursu/Ulu-Camii-Kuran-Kursu-Mufredat-2026-2027.pdf';
const HTML = '/belgeler/kuran-kursu/mufredat-2026-2027.html';
const PLAN = yol(dil, 'yillikplan');

type Rozet = { tur: string; metin: string };
type Ders = { sira: number; no: number; saat: string; alan: string; kod: string; konu: string };
type Gun = { tarih: string; hafta: number; gun: string; not: string; rozetler: Rozet[]; saatModu: string; dersler: Ders[] };
const gunler = plan.gunler as Gun[];

/* ——— Gövde: bölüm 1 ve 2 belgeden; bölüm 3'ün yalnız başlığı alınır, içeriği aşağıda kurulur ——— */
const govdeTam = govdeHam.replace(/<div class="tablo-kaydir">/g, '<div class="tablo-kaydir" tabindex="0">');
const kes2 = govdeTam.indexOf('<h2 id="ders-alanlarina-gore-mufredat"');
const kes3 = govdeTam.indexOf('<h2 id="yillik-ders-plani"');
if (kes2 < 0 || kes3 < 0) throw new Error('Müfredat gövdesinde beklenen bölüm başlıkları yok — mufredat-uret.py yeniden çalıştırılmalı');
const bolum1 = govdeTam.slice(0, kes2);
const bolum2 = govdeTam.slice(kes2, kes3);
const h2b = bolum2.match(/<h2[^>]*>.*?<\/h2>/s)![0];
const bolum2Govde = bolum2.slice(h2b.length);
const h3b = govdeTam.slice(kes3).match(/<h2[^>]*>.*?<\/h2>/s)![0];

/* ——— İçindekiler: gövdedeki başlıklardan (numara, ad, ek bilgi ayrı) ——— */
type Baslik = { seviye: 2 | 3; id: string; no: string; ad: string; meta: string };
const basliklar: Baslik[] = [];
for (const e of govdeTam.matchAll(/<h([23]) id="([^"]+)">(.*?)<\/h\1>/gs)) {
  const ic = e[3];
  basliklar.push({
    seviye: Number(e[1]) as 2 | 3, id: e[2],
    no: ic.match(/<span class="no">(.*?)<\/span>/)?.[1] ?? '',
    meta: ic.match(/<span class="meta">(.*?)<\/span>/)?.[1] ?? '',
    ad: ic.replace(/<span class="(?:no|meta)">.*?<\/span>/g, '').replace(/<[^>]+>/g, '').trim(),
  });
}
const bolumler = basliklar.reduce((l: { ust: Baslik; alt: Baslik[] }[], b) => {
  if (b.seviye === 2) l.push({ ust: b, alt: [] }); else l.at(-1)?.alt.push(b);
  return l;
}, []);

/* ——— Ders dağılımı: 2. bölüm alt başlıklarındaki «toplam N ders saati · genel program M ders» ——— */
const KODLAR = ['kuran', 'itikat', 'ibadet', 'siyer', 'ahlak'] as const;
type Kod = (typeof KODLAR)[number];
const KIMLIK: Record<Kod, string> = { kuran: 'kuran-i-kerim', itikat: 'itikat', ibadet: 'ibadet', siyer: 'siyer', ahlak: 'ahlak' };
const kodu = (id: string): Kod | undefined => KODLAR.find((k) => KIMLIK[k] === id);
const dagilim = KODLAR.map((kod) => {
  const b = basliklar.find((x) => x.id === KIMLIK[kod]);
  const e = b?.meta.match(/toplam (\d+) ders saati · genel program (\d+) ders/);
  return { kod, id: KIMLIK[kod], toplam: e ? Number(e[1]) : 0, genel: e ? Number(e[2]) : 0 };
});
const toplamSaat = dagilim.reduce((n, d) => n + d.toplam, 0);
/* Belge ↔ gün gün plan tutarlılığı: sapma varsa derleme günlüğüne düşer (sayfa yine üretilir). */
for (const d of dagilim) {
  const planda = gunler.reduce((n, g) => n + g.dersler.filter((x) => x.kod === d.kod).length, 0);
  if (d.toplam !== planda) console.warn(`[mufredat] ${d.kod}: belgede ${d.toplam}, yıllık planda ${planda} ders`);
}

/* ——— Ay ay bakış (gün gün plan verisinden) ——— */
const yerel = dil === 'tr' ? 'tr-TR' : dil === 'en' ? 'en-GB' : 'fr-BE';
const bicim = (iso: string, secenek: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(yerel, { timeZone: 'UTC', ...secenek }).format(new Date(iso + 'T12:00:00Z'));
/* Derleme anındaki Brüksel tarihi; site her gün 03:30 UTC yeniden derlenir. */
const bugun = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const dersGunleri = gunler.filter((g) => g.dersler.length > 0);
const sonraki = dersGunleri.find((g) => g.tarih >= bugun);

const ROZET: Record<string, { fr: string; en: string }> = {
  "Sonbahar tatili (Congé d'automne)": { fr: "Congé d'automne", en: 'Autumn break' },
  "Kış tatili (Vacances d'hiver / Noël)": { fr: "Vacances d'hiver", en: 'Winter break' },
  'Dinlenme tatili (Congé de détente / Carnaval)': { fr: 'Congé de détente', en: 'Carnival break' },
  'İlkbahar tatili (Vacances de printemps / Pâques)': { fr: 'Vacances de printemps', en: 'Spring break' },
  'Ramazan programı': { fr: 'Programme du Ramadan', en: 'Ramadan programme' },
  'Ramazan hazırlığı': { fr: 'Préparation au Ramadan', en: 'Ramadan preparation' },
  'Kurban Bayramı arifesi': { fr: "Veille de l'Aïd al-Adha", en: 'Eve of Eid al-Adha' },
  'Bayram tatili': { fr: "Congé de l'Aïd", en: 'Eid holiday' },
};
const rozetAdi = (r: Rozet) => (dil === 'tr' ? r.metin.replace(/\s*\([^)]*\)\s*$/, '') : (ROZET[r.metin]?.[dil] ?? r.metin));

const m = dil === 'tr' ? {
  baslik: 'Müfredat ve Yıllık Ders Planı 2026-2027',
  alt: 'Kur’an-ı Kerim, İtikat, İbadet, Siyer ve Ahlak derslerinin konuları, kaynak kitapları, kazanımları ve gün gün yıllık planı.',
  aciklama: 'Ulu Camii Kur’an Kursu 2026-2027 müfredatı ve yıllık ders planı: 87 ders günü, 261 ders saati, beş ders alanı.',
  not: '',
  ozet: [
    ['Ders başlangıcı', '5 Eylül 2026 Cumartesi'], ['Ders bitişi', '6 Haziran 2027 Pazar'],
    ['Ders günleri', 'Cumartesi ve Pazar · tatil haftalarında Pazartesi de'],
    ['Kış / yaz saati', '10:00–12:40 · 11:00–13:40'], ['Toplam', '87 ders günü · 261 ders saati'],
  ],
  sonrakiEt: 'Sıradaki ders günü', bitti: 'Ders yılı tamamlandı', bugunEt: 'bugün',
  icindekiler: 'İçindekiler', tocAlt: 'Bölüme git',
  pdf: 'PDF indir', pdfAlt: (s: number, mb: string) => `A4 · ${s} sayfa · ${mb} MB`, yazdir: 'Yazdırılabilir sürüm',
  kayit: 'Kayıt sayfası', surum: 'Belge sürümü',
  kitapNot: 'Ders kitapları velilerce temin edilir', kitapBag: 'temin bilgileri', kitapCapa: '#ders-kitaplari',
  dagilimBaslik: 'Ders dağılımı',
  dagilimAlt: `Yıl boyunca ${toplamSaat} ders saatinin alanlara dağılımı. Özel program: Ramazan ayı (2.6) ve Kurban Bayramı arifesi (2.7) dersleri.`,
  saat: 'ders', genel: 'genel', ozel: 'özel',
  alanAd: { kuran: 'Kur’an-ı Kerim', itikat: 'İtikat', ibadet: 'İbadet', siyer: 'Siyer', ahlak: 'Ahlak' } as Record<Kod, string>,
  ayGiris: 'Her ayın ders günleri, tatilleri ve özel programları bir bakışta. Saat saat konular, kaynaklar ve kazanımlar için gün gün sayfasına geçin; bir güne dokunmak o günü açar.',
  dersGunu: (n: number) => `${n} ders günü`, ders: (n: number) => `${n} ders`,
  pazartesi: (n: number) => `İlâve Pazartesi ×${n}`,
  saatGecis: (mod: string, d: string) => `${mod}ne geçiş: ${d}`,
  gunGun: 'Gün gün gör', buAy: 'Bu ay', gecti: 'geçti', dersYok: 'ders yok',
  lejant: [['Cumartesi / Pazar', 'g-normal'], ['İlâve Pazartesi', 'g-pazartesi'], ['Ramazan programı', 'g-ramazan'], ['Bayram / ders yok', 'g-tatil']],
  planCta: 'Gün gün yıllık plan',
  planCtaAlt: 'Her ders gününün saatleri, konuları, kaynakları ve kazanımları; ay ve ders alanı filtresiyle.',
} : dil === 'en' ? {
  baslik: 'Curriculum & Yearly Lesson Plan 2026-2027',
  alt: 'Topics, textbooks, learning outcomes and the day-by-day yearly plan for Qur’an, Creed, Worship, Sīrah and Ethics.',
  aciklama: 'Ulu Camii Qur’an School 2026-2027 curriculum and yearly lesson plan: 87 teaching days, 261 lessons, five subjects.',
  not: 'The full document is in Turkish, the language of instruction. The key facts, the subject breakdown and the month-by-month overview are given in English; for questions, contact the imam.',
  ozet: [
    ['Lessons start', 'Saturday 5 September 2026'], ['Lessons end', 'Sunday 6 June 2027'],
    ['Teaching days', 'Saturday and Sunday · also Monday during school holiday weeks'],
    ['Winter / summer hours', '10:00–12:40 · 11:00–13:40'], ['Total', '87 teaching days · 261 lessons'],
  ],
  sonrakiEt: 'Next teaching day', bitti: 'School year completed', bugunEt: 'today',
  icindekiler: 'Contents', tocAlt: 'Go to section',
  pdf: 'Download PDF', pdfAlt: (s: number, mb: string) => `A4 · ${s} pages · ${mb} MB`, yazdir: 'Printable version',
  kayit: 'Registration page', surum: 'Document version',
  kitapNot: 'Textbooks are obtained by the parents', kitapBag: 'how to obtain', kitapCapa: '#manuels',
  dagilimBaslik: 'Subject breakdown',
  dagilimAlt: `How the ${toplamSaat} lessons of the year are shared between subjects. Special programme: Ramadan (2.6) and the eve of Eid al-Adha (2.7).`,
  saat: 'lessons', genel: 'general', ozel: 'special',
  alanAd: { kuran: 'Qur’an', itikat: 'Creed', ibadet: 'Worship', siyer: 'Sīrah', ahlak: 'Ethics' } as Record<Kod, string>,
  ayGiris: 'Teaching days, holidays and special programmes of each month at a glance. For the hour-by-hour topics, sources and outcomes open the day-by-day page; tapping a day opens that day.',
  dersGunu: (n: number) => `${n} teaching day${n === 1 ? '' : 's'}`, ders: (n: number) => `${n} lesson${n === 1 ? '' : 's'}`,
  pazartesi: (n: number) => `Extra Monday ×${n}`,
  saatGecis: (mod: string, d: string) => `${mod} from ${d}`,
  gunGun: 'See day by day', buAy: 'This month', gecti: 'past', dersYok: 'no lessons',
  lejant: [['Saturday / Sunday', 'g-normal'], ['Extra Monday', 'g-pazartesi'], ['Ramadan programme', 'g-ramazan'], ['Eid / no lessons', 'g-tatil']],
  planCta: 'Day-by-day yearly plan',
  planCtaAlt: 'Hours, topics, sources and outcomes of every teaching day, with month and subject filters.',
} : {
  baslik: 'Programme et plan annuel des cours 2026-2027',
  alt: 'Sujets, manuels, acquis d’apprentissage et plan annuel jour par jour pour le Coran, la croyance, le culte, la Sīra et la morale.',
  aciklama: 'École coranique Ulu Camii, programme et plan annuel 2026-2027 : 87 jours de cours, 261 leçons, cinq matières.',
  not: 'Le document complet est en turc, langue d’enseignement. L’essentiel, la répartition des matières et l’aperçu mois par mois sont donnés en français ; pour toute question, contactez l’imam.',
  ozet: [
    ['Début des cours', 'samedi 5 septembre 2026'], ['Fin des cours', 'dimanche 6 juin 2027'],
    ['Jours de cours', 'samedi et dimanche · le lundi aussi pendant les semaines de congé scolaire'],
    ['Horaire hiver / été', '10h00–12h40 · 11h00–13h40'], ['Total', '87 jours de cours · 261 leçons'],
  ],
  sonrakiEt: 'Prochain jour de cours', bitti: 'Année de cours terminée', bugunEt: 'aujourd’hui',
  icindekiler: 'Sommaire', tocAlt: 'Aller à la section',
  pdf: 'Télécharger le PDF', pdfAlt: (s: number, mb: string) => `A4 · ${s} pages · ${mb} Mo`, yazdir: 'Version imprimable',
  kayit: 'Page d’inscription', surum: 'Version du document',
  kitapNot: 'Les manuels sont à la charge des parents', kitapBag: 'où se les procurer', kitapCapa: '#manuels',
  dagilimBaslik: 'Répartition des matières',
  dagilimAlt: `Répartition des ${toplamSaat} leçons de l’année entre les matières. Programme spécial : Ramadan (2.6) et veille de l’Aïd al-Adha (2.7).`,
  saat: 'leçons', genel: 'général', ozel: 'spécial',
  alanAd: { kuran: 'Coran', itikat: 'Croyance', ibadet: 'Culte', siyer: 'Sīra', ahlak: 'Morale' } as Record<Kod, string>,
  ayGiris: 'Jours de cours, congés et programmes spéciaux de chaque mois en un coup d’œil. Pour les sujets, sources et acquis heure par heure, ouvrez la page jour par jour ; toucher un jour ouvre ce jour.',
  dersGunu: (n: number) => `${n} jour${n === 1 ? '' : 's'} de cours`, ders: (n: number) => `${n} leçon${n === 1 ? '' : 's'}`,
  pazartesi: (n: number) => `Lundi supplémentaire ×${n}`,
  saatGecis: (mod: string, d: string) => `${mod} dès le ${d}`,
  gunGun: 'Voir jour par jour', buAy: 'Ce mois-ci', gecti: 'passé', dersYok: 'pas de cours',
  lejant: [['samedi / dimanche', 'g-normal'], ['lundi supplémentaire', 'g-pazartesi'], ['programme du Ramadan', 'g-ramazan'], ['Aïd / pas de cours', 'g-tatil']],
  planCta: 'Plan annuel jour par jour',
  planCtaAlt: 'Horaires, sujets, sources et acquis de chaque jour de cours, avec filtres par mois et par matière.',
};
const SAAT_MODU: Record<string, Record<Dil, string>> = {
  'Kış saati': { tr: 'Kış saati', fr: 'Horaire d’hiver', en: 'Winter hours' },
  'Yaz saati': { tr: 'Yaz saati', fr: 'Horaire d’été', en: 'Summer hours' },
};

type AyGun = { tarih: string; tur: 'normal' | 'pazartesi' | 'ramazan' | 'tatil'; ad: string; gecti: boolean; bugun: boolean; dersYok: boolean };
type Ay = { anahtar: string; ad: string; dersGunu: number; ders: number; pazartesi: number; buAy: boolean;
  rozetler: { tur: string; ad: string }[]; saatGecis?: string; gunler: AyGun[] };
const aylar: Ay[] = [];
let oncekiMod = '';
for (const g of gunler) {
  const anahtar = g.tarih.slice(0, 7);
  let ay = aylar.at(-1);
  if (!ay || ay.anahtar !== anahtar) {
    ay = { anahtar, ad: bicim(g.tarih, { month: 'long', year: 'numeric' }), dersGunu: 0, ders: 0, pazartesi: 0,
      buAy: bugun.slice(0, 7) === anahtar, rozetler: [], gunler: [] };
    aylar.push(ay);
  }
  const dersVar = g.dersler.length > 0;
  if (dersVar) ay.dersGunu++;
  ay.ders += g.dersler.length;
  if (dersVar && g.gun === 'Pazartesi') ay.pazartesi++;
  for (const r of g.rozetler) {
    if (r.tur === 'pazartesi') continue;
    const ad = rozetAdi(r);
    if (!ay.rozetler.some((x) => x.ad === ad)) ay.rozetler.push({ tur: r.tur, ad });
  }
  if (oncekiMod && g.saatModu !== oncekiMod) ay.saatGecis = m.saatGecis(SAAT_MODU[g.saatModu]?.[dil] ?? g.saatModu, bicim(g.tarih, { day: 'numeric', month: 'long' }));
  oncekiMod = g.saatModu;
  const tur: AyGun['tur'] = !dersVar ? 'tatil' : g.rozetler.some((r) => r.tur === 'ramazan') ? 'ramazan' : g.gun === 'Pazartesi' ? 'pazartesi' : 'normal';
  ay.gunler.push({ tarih: g.tarih, tur, ad: bicim(g.tarih, { weekday: 'long', day: 'numeric', month: 'long' }), gecti: g.tarih < bugun, bugun: g.tarih === bugun, dersYok: !dersVar });
}
const mbBicim = new Intl.NumberFormat(yerel, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(meta.pdfKB / 1024);
const surumMetni = bicim(meta.belgeSurumu, { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base baslik={m.baslik} dil={dil} aciklama={m.aciklama}>
  <SayfaBasligi etiket={t('nav.kurankursu')} baslik={m.baslik} altBaslik={m.alt}>
    <dl class="kunye">
      {m.ozet.map(([k, v]) => <div><dt class="etiket">{k}</dt><dd>{v}</dd></div>)}
      <div class="kunye-simdi">
        <dt class="etiket etiket-vurgu">{m.sonrakiEt}</dt>
        <dd>
          {sonraki ? (
            <a href={`${PLAN}#g-${sonraki.tarih}`}>
              <time datetime={sonraki.tarih}>{bicim(sonraki.tarih, { weekday: 'long', day: 'numeric', month: 'long' })}</time>
              {sonraki.tarih === bugun && <> ({m.bugunEt})</>} · {m.ders(sonraki.dersler.length)}
            </a>
          ) : m.bitti}
        </dd>
      </div>
    </dl>
  </SayfaBasligi>

  {/* Tek sütunlu ızgarada da minmax(0,1fr): aksi hâlde geniş tablolar sütunu içerik
      genişliğine açıp sayfayı yatay kaydırıyordu (mobilde 449 px taşma). */}
  <div class="kapsayici py-10 grid gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_300px]">
    <article class="mufredat min-w-0" lang="tr" data-govde>
      {m.not && <p class="not" lang={dil}>{m.not}</p>}

      {/* Dar ekran: yapışkan, katlanır içindekiler; mevcut bölümün adı özet satırında güncellenir. */}
      <details class="toc-mobil lg:hidden" data-toc-mobil lang={dil}>
        <summary>
          <span class="etiket">{m.icindekiler}</span>
          <span class="toc-simdi" data-toc-simdi aria-hidden="true"></span>
          <span class="cevir" aria-hidden="true">⌄</span>
        </summary>
        <nav aria-label={m.icindekiler} data-toc>
          <ol class="toc-liste">
            {bolumler.map((b) => (
              <li>
                <a href={'#' + b.ust.id} data-ad={`${b.ust.no} ${b.ust.ad}`}><span class="no">{b.ust.no}</span>{b.ust.ad}</a>
                {b.alt.length > 0 && (
                  <ol>
                    {b.alt.map((a) => (
                      <li><a href={'#' + a.id} data-ad={`${a.no} ${a.ad}`}><span class="no">{a.no}</span>{kodu(a.id) && <i class={'nokta n-' + kodu(a.id)} aria-hidden="true"></i>}{a.ad}</a></li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
          <p class="toc-eylem">
            <a href={PDF} download>{m.pdf}</a> · <a href={HTML} target="_blank" rel="noopener">{m.yazdir}</a> · <a href={PLAN}>{t('nav.yillikplan')}</a>
          </p>
        </nav>
      </details>

      <Fragment set:html={bolum1} />

      <Fragment set:html={h2b} />
      <figure class="dagilim" lang={dil}>
        <figcaption><b>{m.dagilimBaslik}.</b> {m.dagilimAlt}</figcaption>
        <div class="cubuk" role="img" aria-label={dagilim.map((d) => `${m.alanAd[d.kod]}: ${d.toplam}`).join(', ')}>
          {dagilim.map((d) => <span class={'seg s-' + d.kod} style={`flex-grow:${d.toplam}`}>{d.toplam}</span>)}
        </div>
        <ul class="lejant">
          {dagilim.map((d) => (
            <li>
              <a href={'#' + d.id}>
                <i class={'nokta n-' + d.kod} aria-hidden="true"></i>
                <span class="ad">{m.alanAd[d.kod]}</span>
                <span class="say">{d.toplam} {m.saat} · {d.genel} {m.genel} + {d.toplam - d.genel} {m.ozel}</span>
              </a>
            </li>
          ))}
        </ul>
      </figure>
      <Fragment set:html={bolum2Govde} />

      <Fragment set:html={h3b} />
      <section class="aylar" lang={dil} aria-label={m.planCta}>
        <p class="ay-giris">{m.ayGiris}</p>
        <ul class="gun-lejant" aria-hidden="true">
          {m.lejant.map(([ad, sinif]) => <li><i class={'g ' + sinif}></i>{ad}</li>)}
        </ul>
        <ol class="ay-liste">
          {aylar.map((a) => (
            <li class:list={['ay', { 'ay-bu': a.buAy }]}>
              <a class="ay-bas" href={`${PLAN}#ay-${a.anahtar}`}>
                <span class="ay-ad">{a.ad}</span>
                {a.buAy && <span class="ay-bu-et">{m.buAy}</span>}
              </a>
              <p class="ay-say"><b>{m.dersGunu(a.dersGunu)}</b> · {m.ders(a.ders)}</p>
              <ol class="gunler">
                {a.gunler.map((g) => (
                  <li>
                    <a class:list={['g', 'g-' + g.tur, { 'g-gecti': g.gecti, 'g-bugun': g.bugun }]} href={`${PLAN}#g-${g.tarih}`}
                       aria-label={`${g.ad}${g.dersYok ? ' · ' + m.dersYok : ''}${g.bugun ? ' · ' + m.bugunEt : g.gecti ? ' · ' + m.gecti : ''}`} title={g.ad}>
                      {Number(g.tarih.slice(8))}
                    </a>
                  </li>
                ))}
              </ol>
              {(a.rozetler.length > 0 || a.pazartesi > 0 || a.saatGecis) && (
                <ul class="ay-rozetler">
                  {a.rozetler.map((r) => <li class={'rozet r-' + r.tur}>{r.ad}</li>)}
                  {a.pazartesi > 0 && <li class="rozet r-pazartesi">{m.pazartesi(a.pazartesi)}</li>}
                  {a.saatGecis && <li class="rozet r-saat">{a.saatGecis}</li>}
                </ul>
              )}
              <a class="ay-git" href={`${PLAN}#ay-${a.anahtar}`}>{m.gunGun}<span aria-hidden="true"> →</span></a>
            </li>
          ))}
        </ol>
        <div class="cta kart">
          <div>
            <p class="cta-b">{m.planCta}</p>
            <p class="cta-a">{m.planCtaAlt}</p>
          </div>
          <div class="cta-d">
            <a href={PLAN} class="dugme dugme-birincil">{t('nav.yillikplan')}</a>
            <a href={PDF} class="dugme dugme-ikincil" download>{m.pdf}</a>
          </div>
        </div>
      </section>
    </article>

    <aside class="yan" lang={dil}>
      <nav class="kart-kagit toc hidden lg:block" aria-labelledby="toc-b" data-toc>
        <p id="toc-b" class="etiket">{m.icindekiler}</p>
        <ol class="toc-liste">
          {bolumler.map((b) => (
            <li>
              <a href={'#' + b.ust.id} data-ad={`${b.ust.no} ${b.ust.ad}`}><span class="no">{b.ust.no}</span>{b.ust.ad}</a>
              {b.alt.length > 0 && (
                <ol>
                  {b.alt.map((a) => (
                    <li><a href={'#' + a.id} data-ad={`${a.no} ${a.ad}`}><span class="no">{a.no}</span>{kodu(a.id) && <i class={'nokta n-' + kodu(a.id)} aria-hidden="true"></i>}{a.ad}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
