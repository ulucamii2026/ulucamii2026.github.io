const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const kayitWeb = c?.fonKayitWeb ?? 'https://www.diyanet.be/cenaze';
const M = {
  tr: {
  baslik: 'Cenaze Hizmetleri',
  alt: 'Vefat hâlinde ne yapılır? BDV Cenaze Fonu, aranacak numaralar, adım adım süreç ve fona kayıt.',
  hizmetBaslik: 'Cenaze hizmetleri kimin sorumluluğunda?',
  hizmet: ['Gasil (yıkama), techiz-tekfin, Türkiye’ye nakil veya Belçika’da defin ve bütün resmî cenaze işlemleri: Belçika Diyanet Vakfı Cenaze Nakil, Yardımlaşma ve Dayanışma Fonu (1982’den beri). Vefat hâlinde ilk aranacak yer fondur.', 'Camimizin görevi: cenaze namazının kıldırılması, vefat haberinin cemaate duyurulması (cami, web sitesi, WhatsApp) ve taziye/mevlid programları.', 'Din görevlimiz, cenaze camimize getirilip namazı kılınacağı zaman devreye girer; yıkama ve nakil işlemlerini yürütmez.'],
  hizmetNot: 'Fonun bilgisi dışında yapılan cenaze işlemleri için fon yardımı yapılmaz. Cenaze namazı için camimizle din görevlimiz üzerinden irtibat kurulur.',
  nakil: 'Cenaze ve Türkiye’ye nakil işlemleri →',
  acilBaslik: 'Vefat anında aranacak numaralar',
  acil1: 'BDV Cenaze Fonu — vefat hattı', acil1b: 'hafta içi 10.30–12.30 ve 14.00–17.00', acil2: 'Din görevlimiz — cenaze namazı', acil3: 'Başkonsolosluk nöbetçi hattı',
  surecBaslik: 'Adım adım süreç',
  surec: ['Vefatı doktora tespit ettirin (ölüm raporu).', 'Hemen BDV Cenaze Fonu’nu arayın: yıkama, kefenleme, nakil veya defin ve cenaze firmasıyla bütün işlemleri fon yürütür. Fonun yazılı onayı olmadan başka firma kullanılırsa masraflar karşılanmaz.', 'Fonun cenaze firmasına verilecek belgeler (vefat edene ait): Belçika oturum kartının aslı, pasaport, nüfus cüzdanının aslı ve doktorun ölüm raporu.', 'Cenaze namazı camimizde kılınacaksa din görevlimizi arayın; namazın günü ve vakti kararlaştırılır, cemaate duyurulur.', 'Belediyeye (Marche-en-Famenne nüfus servisi) ölüm bildirimi yapılır (genellikle cenaze firması yürütür).', 'Türkiye’ye nakil: Başkonsolosluk cenaze nakil belgesi + Saniport “laissez-passer mortuaire” — fon ve cenaze firması takip eder.', 'Belçika’da defin tercih edilirse: Marche-en-Famenne/Aye çok dinli mezarlığı (Müslüman parseli) veya Namur, Liège, Charleroi.'],
  karsilarBaslik: 'Fon neleri karşılar?',
  karsilar: ['Belçika’da tabut, yıkama, techiz ve tekfin masrafları.', 'Türkiye’ye nakil: defin yerine en yakın havalimanına kadar uçakla, oradan defin yerine kadar Türkiye Diyanet Vakfı ve anlaşmalı araçlarla; ayrıca iki refakatçinin ekonomi sınıfı gidiş-dönüş uçak bileti (aynı anda birden fazla vefatta bir refakatçi).', 'Belçika’da defin tercih edilirse faturalı harcamalara karşılık en fazla 3.000 € yardım; bu durumda refakatçi bileti verilmez.', 'Vefat Türkiye’de olursa iki refakatçinin gidiş-dönüş bileti; faturalar vefattan sonra en geç 3 ay içinde fona ulaştırılmalıdır.', 'Belçika ve Türkiye dışında vefatta: o ülkede Diyanet cenaze fonu varsa işlemleri o fon yürütür; yoksa faturaya karşılık en fazla 3.000 € yardım yapılır.', 'Fon Yönetiminin onayı alınmadan yapılan hiçbir harcama karşılanmaz.'],
  uyeBaslik: 'Kimler üye olabilir, kimler yararlanır?',
  uye: ['Dosya sahibi (aile reisi): Belçika’da oturumu olan Müslüman T.C. vatandaşı. Yalnız Belçika vatandaşı olan kişi dosya sahibi olamaz; turistler ve sığınmacılar üye olamaz. 1 Ocak 2005’ten önce üye olmuş yabancı uyrukluların hakkı saklıdır. Balkan ülkeleri vatandaşı Türk ve akraba topluluklara mensup Müslümanlar da Belçika’da oturumları varsa üye olabilir (nakil, defin yerine en yakın havalimanına kadar yapılır).', 'Aynı dosyadan yararlananlar: birlikte yaşayan resmî nikâhlı eş (T.C. vatandaşı olmasa da) ve 18 yaşını doldurmamış çocuklar. Yükseköğrenim gören çocuklar öğrenimleri süresince, engellilik derecesi en az 3 puan olan çocuklar (Belçika Sağlık Bakanlığı belgesi beş yılda bir fona verilir) 28 yaşına kadar kapsamda kalır.', 'Ayrı kayıt gerekir: bakmakla yükümlü olunan anne, baba, kayınvalide ve kayınpeder; yasal olarak ayrı yaşayan eşler; 18 yaşını doldurup öğrenimi sona eren çocuklar.', 'Aile reisi vefat ederse üyeliği eşi ya da dosyadaki yakınlarından biri sürdürebilir.'],
  kayitBaslik: 'Fona çevrim içi kayıt, adım adım',
  kayit: ['Fonun çevrim içi kayıt formunu açın (aşağıdaki düğme).', 'Dosya sahibinin bilgilerini girin: ad-soyad, doğum yeri ve tarihi, Belçika kimlik veya oturum kartı numarası, baba adı, cep telefonu, e-posta, Belçika adresi ve Türkiye’deki il, ilçe ve adres. Eş ve 18 yaş altı çocuklar aynı formda eklenir.', 'Belçika kimlik veya oturum kartının ön ve arka yüzünün fotoğrafını yükleyin.', 'Yönetmeliği okuyup onaylayın; imzanızı ekranda parmakla ya da fareyle atın.', 'Gönderince ekranda kayıt ücreti (yaşa göre değişir, form kendiliğinden hesaplar), fonun banka hesabı ve size özel yapılandırılmış iletişim numarası (+++…+++) çıkar; formun ve havale bilgisinin PDF’i iner. Bunları saklayın.', 'Kayıt ücretini bu yapılandırılmış iletişim numarasıyla havale edin. Başvurunun ulaştığı size e-postayla bildirilir.', 'Üyelik, para fon hesabına geçtikten 60 tam gün sonra başlar; kaza sonucu vefatlarda bu süre aranmaz.'],
  kayitNot: 'Avrupa’daki başka bir Diyanet cenaze fonundan Belçika’ya resmen taşınanlar eski üyeliklerini belgelerse 60 günlük bekleme süresi aranmaz.',
  aidatBaslik: 'Yıllık aidat',
  aidat: ['Yıllık aidatı Fon Yönetimi her yıl belirler; ödeme mektubu Ocak ayının ilk haftasında fondaki adresinize gönderilir. 25 Ocak’a kadar mektup ulaşmazsa fona haber verin.', 'Aidatı mektup elinize geçtikten sonra en geç 10 gün içinde ödeyin; ödeme belgesini en az bir yıl saklayın.', 'Aidatı 31 Mart’tan sonra ödeyenler için 30 tam gün bekleme süresi uygulanır. İki yıllık borcu olan üye, borcunu masraflarıyla ödedikten 30 gün sonra yeniden yararlanır; iki yıldan fazla borcu olan üyelikten çıkmış sayılır ve yeniden kaydolması gerekir.'],
  degisiklikBaslik: 'Kayıttan sonra bildirilecek değişiklikler',
  degisiklik: ['Doğan çocuk: fonun «Eş ve Çocuk Kaydı» çevrim içi formundan, üye numaranızla kaydedilir.', 'Eş kaydı: belediyeden aile kompozisyonu belgesi (composition de ménage) alın, üzerine üye numaranızı yazıp fona posta ({adres}) ya da faksla ({faks}) gönderin.', 'Adres değişikliği: fonun «Adres Değişikliği» çevrim içi formundan bildirilir.', 'Evlenme, boşanma, öğrenciliğe başlama veya öğrenciliğin bitmesi gibi değişiklikler de zamanında yazılı olarak bildirilir; bildirilmeyen değişikliklerden doğan sorunlardan fon sorumlu değildir.'],
