---
/** Cenaze Hizmetleri — BDV Cenaze Fonu, vefat anında aranacak numaralar ve adım adım süreç (bilgilendirme) */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const c = site.cenaze;
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const m = dil === 'tr' ? {
  baslik: 'Cenaze Hizmetleri',
  alt: 'Vefat hâlinde ne yapılır? BDV Cenaze Fonu, aranacak numaralar ve adım adım süreç.',
  hizmetBaslik: 'Cenaze hizmetleri kimin sorumluluğunda?',
  hizmet: ['Gasil (yıkama), techiz-tekfin, Türkiye’ye nakil veya Belçika’da defin ve bütün resmî cenaze işlemleri: Belçika Diyanet Vakfı Cenaze Nakil, Yardımlaşma ve Dayanışma Fonu (1982’den beri). Vefat hâlinde ilk aranacak yer fondur.', 'Camimizin görevi: cenaze namazının kıldırılması, vefat haberinin cemaate duyurulması (cami, web sitesi, WhatsApp) ve taziye/mevlid programları.', 'Din görevlimiz, cenaze camimize getirilip namazı kılınacağı zaman devreye girer; yıkama ve nakil işlemlerini yürütmez.'],
  hizmetNot: 'Fonun bilgisi dışında yapılan cenaze işlemleri için fon yardımı yapılmaz. Cenaze namazı için camimizle din görevlimiz üzerinden irtibat kurulur.',
  nakil: 'Cenaze ve Türkiye’ye nakil işlemleri →',
  acilBaslik: 'Vefat anında aranacak numaralar',
  acil1: 'BDV Cenaze Fonu — vefat hattı', acil1b: 'hafta içi mesai saatinde', acil2: 'Din görevlimiz — cenaze namazı', acil3: 'Başkonsolosluk nöbetçi hattı',
  surecBaslik: 'Adım adım süreç',
  surec: ['Vefatı doktora tespit ettirin (ölüm raporu).', 'Hemen BDV Cenaze Fonu’nu arayın: yıkama, kefenleme, nakil veya defin ve cenaze firmasıyla bütün işlemleri fon yürütür. Fon onayı olmadan başka firma kullanılırsa masraflar karşılanmaz.', 'Cenaze namazı camimizde kılınacaksa din görevlimizi arayın; namazın günü ve vakti kararlaştırılır, cemaate duyurulur.', 'Belediyeye (Marche-en-Famenne nüfus servisi) ölüm bildirimi yapılır (genellikle cenaze firması yürütür).', 'Türkiye’ye nakil: Başkonsolosluk cenaze nakil belgesi + Saniport “laissez-passer mortuaire” — fon ve cenaze firması takip eder.', 'Belçika’da defin tercih edilirse: Marche-en-Famenne/Aye çok dinli mezarlığı (Müslüman parseli) veya Namur, Liège, Charleroi.'],
  fonBaslik: 'Fon üyeliği hakkında',
  fonNot: 'Fon üyeliği: Belçika’da en az 1 yıl daimî oturumu olan T.C. vatandaşları; eş ve 18 yaş altı çocuklar kapsamda; üyelik ödeme sonrası 60 gün içinde başlar (kaza hariç). Her yıl Ocak ayının ilk haftası aidat mektubu gönderilir; 25 Ocak’a kadar mektup gelmezse fona bilgi verilmelidir. Aidat, mektup ulaştıktan sonra en geç 10 gün içinde ödenir; doğum, evlenme, boşanma ve adres değişiklikleri fona bildirilir.',
  belediye: 'Belediye nüfus servisi', mezarlik: 'Mezarlık', fonSayfa: 'Fon bilgi sayfası ↗',
  vefatSayfa: 'Vefat duyuruları ve Rahmetle Anıyoruz sayfası →',
} : dil === 'en' ? {
  baslik: 'Funeral Services',
  alt: 'What to do in the event of a death: the BDV Funeral Fund, the numbers to call, and the step-by-step process.',
  hizmetBaslik: 'Who is responsible for funeral services?',
  hizmet: ['Ritual washing (ghusl), shrouding, transfer to Turkey or burial in Belgium, and all official funeral procedures: the Diyanet Foundation of Belgium’s Funeral, Mutual Aid and Solidarity Fund (since 1982). In the event of a death, the fund is the first point of contact.', 'The mosque’s role: leading the funeral prayer, announcing the death to the community (mosque, website, WhatsApp), and organising condolence and mevlid programmes.', 'Our imam becomes involved once the deceased is brought to our mosque for the funeral prayer; he does not carry out the washing or the transfer.'],
  hizmetNot: 'No assistance is provided by the fund for funeral arrangements made without its knowledge. For the funeral prayer, please contact our mosque through our imam.',
  nakil: 'Death and transfer to Turkey →',
  acilBaslik: 'Numbers to call at the time of a death',
  acil1: 'BDV Funeral Fund — death line', acil1b: 'weekday office hours', acil2: 'Our imam — funeral prayer', acil3: 'Consulate General — duty line',
  surecBaslik: 'Step-by-step process',
  surec: ['Have the death certified by a doctor (death report).', 'Call the BDV Funeral Fund immediately: washing, shrouding, transfer or burial, and all arrangements with the funeral company are handled by the fund. If another company is used without the fund’s approval, costs will not be covered.', 'If the funeral prayer is to be performed at our mosque, call our imam; the day and time are agreed and announced to the community.', 'The death is reported to the municipality (Marche-en-Famenne population department) — usually handled by the funeral company.', 'Transfer to Turkey: a Consulate transfer certificate plus a Saniport “laissez-passer mortuaire”, followed up by the fund and the funeral company.', 'If burial in Belgium is preferred: the multi-faith cemetery of Marche-en-Famenne/Aye (Muslim section), or Namur, Liège, Charleroi.'],
  fonBaslik: 'About fund membership',
  fonNot: 'Fund membership: Turkish citizens with at least 1 year of permanent residence in Belgium; spouses and children under 18 are covered; membership takes effect 60 days after payment (except in case of accident). An annual dues letter is sent in the first week of January each year; if it has not arrived by 25 January, the fund should be informed. Dues must be paid within 10 days of receiving the letter; births, marriages, divorces and address changes must be reported to the fund.',
  belediye: 'Municipal population department', mezarlik: 'Cemetery', fonSayfa: 'Fund information page ↗',
  vefatSayfa: 'Obituaries — In Memoriam page →',
} : {
  baslik: 'Services funéraires',
  alt: 'Que faire en cas de décès ? Le Fonds funéraire BDV, les numéros à appeler et les démarches étape par étape.',
  hizmetBaslik: 'Qui est responsable des funérailles ?',
  hizmet: ['Toilette mortuaire (ghusl), linceul, rapatriement en Turquie ou inhumation en Belgique et toutes les démarches officielles : le Fonds funéraire de la Fondation Diyanet de Belgique (depuis 1982). En cas de décès, c’est le premier numéro à appeler.', 'Rôle de la mosquée : célébrer la prière funéraire, annoncer le décès à la communauté (mosquée, site web, WhatsApp) et organiser les programmes de condoléances et de mevlid.', 'Notre imam intervient lorsque le défunt est amené à la mosquée pour la prière funéraire ; il ne s’occupe ni de la toilette ni du transport.'],
  hizmetNot: 'Aucune aide n’est accordée par le fonds pour des démarches entreprises à son insu. Pour la prière funéraire, contactez la mosquée via notre imam.',
  nakil: 'Décès et rapatriement en Turquie →',
  acilBaslik: 'Numéros à appeler en cas de décès',
  acil1: 'Fonds funéraire BDV — ligne décès', acil1b: 'heures de bureau en semaine', acil2: 'Notre imam — prière funéraire', acil3: 'Consulat général — permanence',
  surecBaslik: 'Démarches étape par étape',
  surec: ['Faire constater le décès par un médecin (certificat de décès).', 'Appeler immédiatement le Fonds funéraire BDV : toilette, linceul, rapatriement ou inhumation et toutes les démarches avec l’entreprise funéraire sont pris en charge par le fonds. Sans son accord, les frais d’une autre entreprise ne sont pas remboursés.', 'Si la prière funéraire a lieu à la mosquée, appeler notre imam : le jour et l’heure sont fixés et annoncés à la communauté.', 'Déclarer le décès à la commune (service population de Marche-en-Famenne) — généralement effectué par l’entreprise funéraire.', 'Rapatriement en Turquie : attestation de transport du Consulat + laissez-passer mortuaire (Saniport), suivis par le fonds et l’entreprise funéraire.', 'Inhumation en Belgique : cimetière multiconfessionnel de Marche-en-Famenne/Aye (parcelle musulmane) ou Namur, Liège, Charleroi.'],
  fonBaslik: 'À propos de l’affiliation au fonds',
  fonNot: 'Affiliation au fonds : citoyens turcs résidant en Belgique depuis au moins 1 an ; conjoint et enfants de moins de 18 ans couverts ; la couverture débute 60 jours après le paiement (sauf accident). Chaque année, la lettre de cotisation est envoyée la première semaine de janvier ; si elle n’est pas reçue avant le 25 janvier, prévenir le fonds. La cotisation se paie dans les 10 jours suivant la réception ; naissances, mariages, divorces et changements d’adresse doivent être signalés au fonds.',
  belediye: 'Service population de la commune', mezarlik: 'Cimetière', fonSayfa: 'Page d’information du fonds ↗',
  vefatSayfa: 'Avis de décès — page In memoriam →',
};
---
<Base baslik={m.baslik} dil={dil} aciklama={m.alt}>
  <SayfaBasligi etiket={dil === 'tr' ? 'Hizmetler' : dil === 'en' ? 'Services' : 'Services'} baslik={m.baslik} altBaslik={m.alt} />
  <div class="kapsayici py-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px]">
    <section>
      <div class="kart p-5 sm:p-6">
        <h2 class="etiket etiket-vurgu text-base">{m.hizmetBaslik}</h2>
        <ul class="mt-3 grid gap-2 list-[square] pl-4 max-w-[70ch]">{m.hizmet.map((h) => <li>{h}</li>)}</ul>
        <p class="mt-4 text-sm text-(--metin-2) max-w-[70ch]">{m.hizmetNot}</p>
      </div>
      <div class="mt-8 kart-kagit p-5 sm:p-6">
        <h2 class="etiket etiket-vurgu text-base">{m.surecBaslik}</h2>
        <ol class="mt-3 grid gap-2 list-decimal pl-5 max-w-[70ch]">{m.surec.map((x) => <li>{x}</li>)}</ol>
      </div>
      <div class="mt-8 cetvel pt-4">
        <h2 class="etiket etiket-vurgu text-base">{m.fonBaslik}</h2>
        <p class="mt-2 text-sm text-(--metin-2) max-w-[70ch]">{m.fonNot}</p>
      </div>
      <p class="mt-6"><a href={yol(dil, 'konsolosluk') + '#cenaze'}>{m.nakil}</a></p>
      <p class="mt-2"><a href={yol(dil, 'vefat')}>{m.vefatSayfa}</a></p>
    </section>
    <aside class="grid gap-5 content-start lg:sticky lg:top-24">
      {c && (
        <div class="kart p-5 border-(--vurgu)">
          <p class="etiket etiket-vurgu">{m.acilBaslik}</p>
          <ol class="mt-3 grid gap-3 text-sm list-decimal pl-5">
            <li><span class="etiket block">{m.acil1}</span><a href={tel(c.fonAcil)} class="mono text-base font-semibold inline-flex items-center min-h-11 -my-2 py-2">{c.fonAcil}</a><span class="block text-(--metin-2)">{m.acil1b}: <a href={tel(c.fonMesai)} class="mono">{c.fonMesai}</a></span></li>
            <li><span class="etiket block">{m.acil2}</span><a href={tel(site.telefon.dinGorevlisi)} class="mono text-base font-semibold inline-flex items-center min-h-11 -my-2 py-2">{site.telefon.dinGorevlisi}</a></li>
            <li><span class="etiket block">{m.acil3}</span><a href={tel(site.konsolosluk.acil)} class="mono text-base font-semibold inline-flex items-center min-h-11 -my-2 py-2">{site.konsolosluk.acil}</a></li>
          </ol>
          <dl class="mt-4 grid gap-2 text-sm cetvel pt-3">
            <div><dt class="etiket">{m.belediye}</dt><dd><a href={tel(c.belediyeNufus)} class="mono">{c.belediyeNufus}</a> · <a href={`mailto:${c.belediyeEposta}`}>{c.belediyeEposta}</a></dd></div>
            <div><dt class="etiket">{m.mezarlik}</dt><dd>{c.mezarlikAd}<br /><span class="text-(--metin-2)">{c.mezarlikAdres}</span></dd></div>
            <div><dt class="etiket">{c.fonAd}</dt><dd><span class="text-(--metin-2)">{c.fonAdres}</span> · <a href={`mailto:${c.fonEposta}`}>{c.fonEposta}</a><br /><a href={c.fonWeb} target="_blank" rel="noopener">{m.fonSayfa}</a></dd></div>
          </dl>
        </div>
      )}
    </aside>
  </div>
</Base>
