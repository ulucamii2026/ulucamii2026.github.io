---
/**
 * Ders materyalleri — Kur'an kursunun günlük ders belgeleri + kalıcı materyaller.
 * (6 Eyl 2026 ilk düzen; 8 Eyl 2026 yeniden düzenleme: tarih karmaşası + ölçeklenme.)
 *
 * Kaynaklar:
 *  - src/data/ders-materyalleri.json — ders günleri (plan PDF + sesli pptx + sessiz PDF + ekler). ELLE YAZILMAZ: kurs projesindeki
 *    scripts/site-materyal-yayinla.py dosyaları GitHub Releases'a (ders-<tarih>) yükler ve bu dosyayı günceller.
 *  - src/content/materyaller/*.md — güne bağlı olmayan kalıcı materyaller (ezber kartı, alıştırma, tablo, rehber…), Sveltia'dan girilir.
 *  - src/data/yillik-plan-2026-2027.json — «sıradaki ders günü» satırı.
 *
 * ── Neden bu düzen (8 Eyl 2026) ──────────────────────────────────────────────
 * Eski düzende her ders günü açık kart olarak basılıyordu: 8 günde mobil sayfa 9.900 px (≈12 ekran),
 * 56 indirme düğmesi. Ders yılı sonunda 87 gün olacak → ≈118 ekran, 600+ düğme. Ayrıca «Güncel dersler»
 * başlığı altında üst sınırsız süzgeç yüzünden altı gün birden duruyordu ve en yeni gün en alttaydı.
 *
 * Yeni düzen üç katmanlı:
 *   1. ÖNE ÇIKAN HAFTA SONU — bugün veya sonrası ilk ders günü (hepsi geçmişse en son gün) ve onun
 *      Pazartesi–Pazar haftasındaki diğer günü. İlk gün açık gelir: aranan şey sıfır tıkla ekranda.
 *   2. DİĞER DERS GÜNLERİ — yeniden eskiye, ay ay katlanır (<details>). Ay kapalıyken tek satır, gün
 *      kapalıyken ≈64 px: tarih + ders başlıkları + dosya sayısı. Dosyalar gün açılınca gelir.
 *   3. KALICI MATERYALLER — güne bağlı olmayanlar.
 * Arama kutusu ve alan çipleri iki katmanı birden süzer; eşleşen aylar kendiliğinden açılır.
 * Site her gece yeniden yayımlandığı için «bugün» hesabı derleme anında yapılır.
 */
import { statSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import DersGunuKarti from '../components/DersGunuKarti.astro';
import type { Gun, Metin } from '../components/DersGunuKarti.astro';
import { ceviri, tarihBicimle, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import veri from '../data/ders-materyalleri.json';
import plan from '../data/yillik-plan-2026-2027.json';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);

/* Yeniden eskiye: en güncel gün her zaman en üstte. */
const gunler = ([...(veri.gunler as unknown as Gun[])]).sort((a, b) => b.tarih.localeCompare(a.tarih));

/* «bugün» Brüksel saatiyle. */
const bugun = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels' }).format(new Date());

/* Öne çıkan gün: bugün veya sonrası ilk ders günü; yoksa en son yayımlanan gün.
   Eski düzendeki «altı gün birden güncel» karmaşası, üst sınırı olmayan bir hafta süzgecinden çıkıyordu. */
const yaklasan = [...gunler].reverse().find((g) => g.tarih >= bugun);
const oneCikan = yaklasan ?? gunler[0] ?? null;
const oneCikanBaslik = !oneCikan ? '' : oneCikan.tarih === bugun ? 'bugunDers' : oneCikan.tarih > bugun ? 'yaklasan' : 'sonDers';

/* Dersler hafta sonu çifti hâlinde işleniyor (Cumartesi + Pazar). Öne çıkan günün Pazartesi–Pazar haftasındaki
   bütün günler birlikte gösterilir; yoksa Cumartesi öne çıkarken Pazar listenin dibinde kalıyor. Kronolojik
   sıra: hafta sonu okunduğu gibi Cumartesi → Pazar. Yalnız öne çıkan gün açık gelir. */
const haftaAraligi = (iso: string) => {
  const d = new Date(iso + 'T12:00:00');
  const pzt = new Date(d); pzt.setDate(pzt.getDate() - ((pzt.getDay() + 6) % 7));
  const paz = new Date(pzt); paz.setDate(paz.getDate() + 6);
  return [pzt.toISOString().slice(0, 10), paz.toISOString().slice(0, 10)] as const;
};
const [haftaBasi, haftaSonu] = oneCikan ? haftaAraligi(oneCikan.tarih) : ['', ''];
const oneCikanGrup = oneCikan
  ? gunler.filter((g) => g.tarih >= haftaBasi && g.tarih <= haftaSonu).sort((a, b) => a.tarih.localeCompare(b.tarih))
  : [];
const grupTarihleri = new Set(oneCikanGrup.map((g) => g.tarih));

/* Kalan günler ay ay: anahtar YYYY-MM, yeniden eskiye. */
const kalanGunler = gunler.filter((g) => !grupTarihleri.has(g.tarih));
const aylar = [...new Set(kalanGunler.map((g) => g.tarih.slice(0, 7)))];
const buAy = bugun.slice(0, 7);
const acikAy = new Set([aylar[0], buAy].filter(Boolean));

/* sıradaki ders günü (yıllık plandan): bugünden sonraki ilk gün; materyali henüz yoksa not düşülür */
type PlanGun = { tarih: string; gun: string; dersler: { no?: number; sira?: number; alan: string; kod: string; konu: string }[] };
const planGunleri = (plan as { gunler: PlanGun[] }).gunler;
const siradaki = planGunleri.find((g) => g.tarih > bugun);
const siradakiHazir = siradaki ? gunler.some((g) => g.tarih === siradaki.tarih) : false;

/* kalıcı materyaller (Sveltia) */
const kalici = (await getCollection('materyaller', ({ data }) => !data.taslak)).sort((a, b) => b.data.tarih.getTime() - a.data.tarih.getTime());
const dosyaBoyutu = (d?: string, verilen?: number) => {
  if (verilen) return verilen;
  if (!d) return 0;
  try { return statSync(new URL('../../public' + d, import.meta.url)).size; } catch { return 0; }
};

const alanAdi: Record<Dil, Record<string, string>> = {
  tr: { kuran: 'Kur’an-ı Kerim', itikat: 'İtikat', ibadet: 'İbadet', siyer: 'Siyer', ahlak: 'Ahlak', genel: 'Genel' },
  fr: { kuran: 'Le Saint Coran', itikat: 'Croyance', ibadet: 'Adoration', siyer: 'Vie du Prophète', ahlak: 'Morale', genel: 'Général' },
  en: { kuran: 'The Qur’an', itikat: 'Creed', ibadet: 'Worship', siyer: 'Life of the Prophet', ahlak: 'Ethics', genel: 'General' },
};
const kategoriAdi: Record<Dil, Record<string, string>> = {
  tr: { ezber: 'Ezber kartı', alistirma: 'Alıştırma', tablo: 'Tablo', rehber: 'Rehber', sinav: 'Sınav', ses: 'Ses', video: 'Video', diger: 'Diğer' },
  fr: { ezber: 'Carte de mémorisation', alistirma: 'Exercice', tablo: 'Tableau', rehber: 'Guide', sinav: 'Évaluation', ses: 'Audio', video: 'Vidéo', diger: 'Autre' },
  en: { ezber: 'Memorisation card', alistirma: 'Exercise', tablo: 'Table', rehber: 'Guide', sinav: 'Test', ses: 'Audio', video: 'Video', diger: 'Other' },
};
const filtreKodlari = ['kuran', 'itikat', 'ibadet', 'siyer', 'ahlak'].filter((k) =>
  gunler.some((g) => g.sunumlar.some((s) => s.kod === k)) || kalici.some((e) => e.data.alan === k));

const m = dil === 'tr' ? {
  altBaslik: 'Kur’an kursumuzda her ders günü için hazırlanan belgeler: hocaların ders planı (PDF) ve sınıfta kullanılan sesli, iki dilli PowerPoint sunumları. Veliler evde tekrar için, öğrenciler ders öncesi hazırlık için indirebilir.',
  nasil: 'Nasıl kullanılır?',
  nasilListe: [
    'Ders planı PDF’dir; telefon ve bilgisayarda doğrudan açılır.',
    'Her sunumun iki hâli var: «PDF» sessiz, küçük ve her cihazda açılır; «PowerPoint (sesli)» ise .pptx dosyasıdır — her slaytta önce Türkçe, sonra Fransızca kısa anlatım kendiliğinden çalar, Arapça kartlarda hoparlör düğmesine dokununca Türk hafız kıraati veya dua dinlenir. Telefonda ücretsiz Microsoft PowerPoint uygulamasıyla, bilgisayarda Slayt Gösterisi (F5) ile açın.',
    'Sunumlardaki videolar YouTube’dan oynar; internet bağlantısı gerekir.',
    'Materyaller Diyanet İşleri Başkanlığı kaynaklarına dayanır; Peygamberimiz, ailesi ve sahâbe tasvir edilmez.',
  ],
  bugunDers: 'Bugünün dersleri', yaklasan: 'Yaklaşan dersler', sonDers: 'Son dersler',
  siradaki: 'Sıradaki ders günü', siradakiNot: 'Materyaller ders gününden önce bu sayfada yayımlanır.', planBag: 'Yıllık planda gör',
  digerGunler: 'Diğer ders günleri', gunSay: (n: number) => `${n} ders günü`, dosyaSay: (n: number) => `${n} dosya`,
  filtre: 'Alana göre süz', tumu: 'Tümü', filtreBos: 'Aramanıza uyan ders günü yok.',
  ara: 'Ara', araIpucu: 'Konu, tarih veya alan ara…', temizle: 'Temizle',
  kalici: 'Kalıcı materyaller', kaliciA: 'Güne bağlı olmayan yardımcı belgeler: ezber kartları, alıştırma sayfaları, tablolar, rehberler.',
  ac: 'Aç', indir: 'İndir',
  plan: 'Ders planı', sayfa: (n: number) => `${n} sayfa`, slayt: (n: number) => `${n} slayt`, ders: (n: number) => `${n}. ders`,
  pptxSesli: 'PowerPoint (sesli)', pdfSessiz: 'PDF', hafta: (h: number) => `${h}. hafta`, planGun: 'Yıllık planda bu gün', ekler: 'Ek belgeler', bugun: 'bugün',
  bos: 'Henüz yayımlanmış materyal yok; ilk ders gününden sonra burada görünecek.',
  kaynak: 'Dosyalar caminin GitHub deposunun sürüm eklerinde barındırılır; boyutlar yaklaşık değerlerdir. Kısa adres: ulucamii.be/materyal',
  mufredat: 'Müfredat ve yıllık plan', kurs: 'Kur’an kursu sayfası',
} : dil === 'en' ? {
  altBaslik: 'Documents prepared for every lesson day of our Qur’an school: the teachers’ lesson plan (PDF) and the bilingual PowerPoint decks with audio used in class. Parents can download them for revision at home, students to prepare before the lesson.',
  nasil: 'How to use',
  nasilListe: [
    'The lesson plan is a PDF; it opens directly on phones and computers.',
    'Every deck comes in two forms: “PDF” is silent, small and opens on any device; “PowerPoint (audio)” is the .pptx file — on every slide a short narration plays automatically, first in Turkish then in French, and on the Arabic cards tapping the speaker plays a Turkish reciter or a prayer. Open it with the free Microsoft PowerPoint app on a phone, or in Slide Show mode (F5) on a computer.',
    'Videos inside the decks play from YouTube and need an internet connection.',
    'The materials follow the sources of the Turkish Presidency of Religious Affairs (Diyanet); the Prophet, his family and the Companions are never depicted.',
  ],
  bugunDers: 'Today’s lessons', yaklasan: 'Upcoming lessons', sonDers: 'Latest lessons',
  siradaki: 'Next lesson day', siradakiNot: 'Materials are published on this page before the lesson day.', planBag: 'See in the yearly plan',
  digerGunler: 'Other lesson days', gunSay: (n: number) => `${n} lesson day${n === 1 ? '' : 's'}`, dosyaSay: (n: number) => `${n} file${n === 1 ? '' : 's'}`,
  filtre: 'Filter by subject', tumu: 'All', filtreBos: 'No lesson day matches your search.',
  ara: 'Search', araIpucu: 'Search a topic, date or subject…', temizle: 'Clear',
  kalici: 'Permanent materials', kaliciA: 'Supporting documents not tied to a lesson day: memorisation cards, exercise sheets, tables, guides.',
  ac: 'Open', indir: 'Download',
  plan: 'Lesson plan', sayfa: (n: number) => `${n} pages`, slayt: (n: number) => `${n} slides`, ders: (n: number) => `Lesson ${n}`,
  pptxSesli: 'PowerPoint (audio)', pdfSessiz: 'PDF', hafta: (h: number) => `Week ${h}`, planGun: 'This day in the yearly plan', ekler: 'Extra documents', bugun: 'today',
  bos: 'No materials published yet; they will appear here after the first lesson day.',
  kaynak: 'Files are hosted as release assets of the mosque’s GitHub repository; sizes are approximate. Short address: ulucamii.be/materyal',
  mufredat: 'Curriculum and yearly plan', kurs: 'Qur’an school page',
} : {
  altBaslik: 'Les documents préparés pour chaque jour de cours de notre école coranique : le plan de cours des enseignants (PDF) et les présentations PowerPoint bilingues et sonores utilisées en classe. Les parents peuvent les télécharger pour réviser à la maison, les élèves pour se préparer avant le cours.',
  nasil: 'Comment les utiliser ?',
  nasilListe: [
    'Le plan de cours est un PDF ; il s’ouvre directement sur téléphone et ordinateur.',
    'Chaque présentation existe en deux versions : « PDF », silencieuse, légère et lisible sur tout appareil ; « PowerPoint (sonore) », le fichier .pptx — sur chaque diapositive, une courte narration démarre toute seule, d’abord en turc puis en français, et sur les cartes en arabe le bouton haut-parleur fait entendre un récitateur turc ou une invocation. Ouvrez-le avec l’application gratuite Microsoft PowerPoint sur téléphone, ou en mode Diaporama (F5) sur ordinateur.',
    'Les vidéos des présentations sont lues depuis YouTube ; une connexion internet est nécessaire.',
    'Les supports suivent les sources de la Présidence des Affaires religieuses de Turquie (Diyanet) ; le Prophète, sa famille et les Compagnons ne sont jamais représentés.',
  ],
  bugunDers: 'Les cours d’aujourd’hui', yaklasan: 'Prochains cours', sonDers: 'Derniers cours',
  siradaki: 'Prochain jour de cours', siradakiNot: 'Les supports sont publiés sur cette page avant le jour du cours.', planBag: 'Voir dans le plan annuel',
  digerGunler: 'Autres jours de cours', gunSay: (n: number) => `${n} jour${n === 1 ? '' : 's'} de cours`, dosyaSay: (n: number) => `${n} fichier${n === 1 ? '' : 's'}`,
  filtre: 'Filtrer par matière', tumu: 'Toutes', filtreBos: 'Aucun jour de cours ne correspond à votre recherche.',
  ara: 'Rechercher', araIpucu: 'Rechercher un thème, une date, une matière…', temizle: 'Effacer',
  kalici: 'Supports permanents', kaliciA: 'Documents d’appui non liés à un jour de cours : cartes de mémorisation, fiches d’exercices, tableaux, guides.',
  ac: 'Ouvrir', indir: 'Télécharger',
  plan: 'Plan de cours', sayfa: (n: number) => `${n} pages`, slayt: (n: number) => `${n} diapositives`, ders: (n: number) => `Cours ${n}`,
  pptxSesli: 'PowerPoint (sonore)', pdfSessiz: 'PDF', hafta: (h: number) => `Semaine ${h}`, planGun: 'Ce jour dans le plan annuel', ekler: 'Documents complémentaires', bugun: 'aujourd’hui',
  bos: 'Aucun support publié pour l’instant ; ils apparaîtront ici après le premier jour de cours.',
  kaynak: 'Les fichiers sont hébergés dans les publications (releases) du dépôt GitHub de la mosquée ; les tailles sont approximatives. Adresse courte : ulucamii.be/materyal',
  mufredat: 'Programme et plan annuel', kurs: 'Page de l’école coranique',
};
const kartMetni: Metin = m;
const mb = (b: number) => new Intl.NumberFormat(dil, { maximumFractionDigits: 1 }).format(b / 1048576) + ' MB';
const tarih = (iso: string, secenek: Intl.DateTimeFormatOptions) => tarihBicimle(new Date(iso + 'T12:00:00'), dil, secenek);
const uclu = (o: { tr?: string; fr?: string; en?: string } | undefined) => (o ? (dil === 'tr' ? o.tr : dil === 'en' ? (o.en || o.fr || o.tr) : (o.fr || o.tr)) || '' : '');

/* Öne çıkan grubun başlık tarihi: tek gün ise «12 Eylül Cumartesi», iki gün ise «12 – 13 Eylül».
   Ay sınırını aşan hafta sonlarında (30 Eylül – 1 Ekim) iki ay adı da yazılır. */
const grupTarihi = (() => {
  if (oneCikanGrup.length === 0) return '';
  const ilk = oneCikanGrup[0].tarih, son = oneCikanGrup[oneCikanGrup.length - 1].tarih;
  if (ilk === son) return tarih(ilk, { weekday: 'long', day: 'numeric', month: 'long' });
  const ayniAy = ilk.slice(0, 7) === son.slice(0, 7);
  return `${tarih(ilk, ayniAy ? { day: 'numeric' } : { day: 'numeric', month: 'long' })} – ${tarih(son, { day: 'numeric', month: 'long' })}`;
})();
---
<Base baslik={t('nav.dersmateryalleri')} dil={dil} aciklama={m.altBaslik}>
  <SayfaBasligi etiket={t('nav.kurankursu')} baslik={t('nav.dersmateryalleri')} altBaslik={m.altBaslik} />

  <div class="kapsayici py-10" data-materyal>
    {gunler.length === 0 && <p class="not">{m.bos}</p>}

    {/* ——— 1. Öne çıkan hafta sonu: ilk gün açık, çifti hemen altında ——— */}
    {oneCikan && (
      <section class="bolum one-cikan" data-bolum>
        <h2 class="bolum-baslik">
          {oneCikanBaslik === 'bugunDers' ? m.bugunDers : oneCikanBaslik === 'yaklasan' ? m.yaklasan : m.sonDers}
          <span class="bolum-tarih">{grupTarihi}</span>
        </h2>
        <div class="one-cikan-liste">
          {oneCikanGrup.map((g) => <DersGunuKarti g={g} dil={dil} m={kartMetni} bugun={bugun} acik={g.tarih === oneCikan.tarih} />)}
        </div>
      </section>
    )}

    {siradaki && !siradakiHazir && (
      <p class="siradaki">
        <span class="etiket etiket-vurgu">{m.siradaki}</span>
        <b>{tarih(siradaki.tarih, { weekday: 'long', day: 'numeric', month: 'long' })}</b>
        <span class="siradaki-konu">{siradaki.dersler.map((d) => `${d.sira ?? d.no}. ${alanAdi[dil][d.kod] || d.alan}`).join(' · ')}</span>
        <span class="kucuk">{m.siradakiNot}</span>
        <a href={`${yol(dil, 'yillikplan')}#g-${siradaki.tarih}`} class="plan-bag">{m.planBag} →</a>
      </p>
    )}

    {/* ——— 2. Tüm ders günleri: ay ay katlanır, yeniden eskiye ——— */}
    {kalanGunler.length > 0 && (
      <section class="bolum" id="gunler" data-bolum>
        <h2 class="bolum-baslik">{m.digerGunler} <span class="kucuk">· {m.gunSay(kalanGunler.length)}</span></h2>

        {/* Süzgeç kutusu: JS olmadan çalışmayacağı için JS ile açılır. */}
        <div class="suzgec" hidden data-suzgec>
          <div class="ara" role="search">
            <label class="etiket" for="materyal-ara">{m.ara}</label>
            <input type="search" id="materyal-ara" placeholder={m.araIpucu} autocomplete="off"
                   enterkeyhint="search" data-ara-alan />
            <button type="button" class="ara-sil" data-ara-sil hidden aria-label={m.temizle}>×</button>
          </div>
          {filtreKodlari.length > 1 && (
            <div class="cipler" role="group" aria-label={m.filtre}>
              <button type="button" class="cip" data-alan="tumu" aria-pressed="true">{m.tumu}</button>
              {filtreKodlari.map((k) => (
                <button type="button" class={'cip cip-' + k} data-alan={k} aria-pressed="false">
                  <span class="cip-nokta" aria-hidden="true"></span>{alanAdi[dil][k]}
                </button>
              ))}
            </div>
          )}
        </div>

        <p class="not" data-filtre-bos hidden>{m.filtreBos}</p>

        {aylar.map((ay) => {
          const ayGunleri = kalanGunler.filter((g) => g.tarih.startsWith(ay));
          return (
            <details class="ay" id={`ay-${ay}`} data-ay open={acikAy.has(ay)}>
              <summary>
                <span class="ay-ad">{tarih(ay + '-01', { month: 'long', year: 'numeric' })}</span>
                <span class="kucuk" data-ay-say data-varsayilan={m.gunSay(ayGunleri.length)}>{m.gunSay(ayGunleri.length)}</span>
              </summary>
              <div class="ay-icerik">
                {ayGunleri.map((g) => <DersGunuKarti g={g} dil={dil} m={kartMetni} bugun={bugun} />)}
              </div>
            </details>
          );
        })}
      </section>
    )}

    {/* ——— 3. Kalıcı materyaller ——— */}
    {kalici.length > 0 && (
      <section class="bolum" id="kalici" data-bolum>
        <h2 class="bolum-baslik">{m.kalici}</h2>
        <p class="bolum-alt">{m.kaliciA}</p>
        <ul class="kalici-liste kart-kagit" role="list">
          {kalici.map((e) => {
            const href = e.data.dosya || e.data.link || '#';
            const boyut = dosyaBoyutu(e.data.dosya, e.data.boyut);
            const disBag = !e.data.dosya;
            return (
              <li class="satir" data-satir="kalici" data-kod={e.data.alan}>
                <span class="satir-ad">
                  <span class="tur">{kategoriAdi[dil][e.data.kategori]}</span>
                  <b>{uclu(e.data.baslik)}</b>
                  {e.data.alan !== 'genel' && <span class="konu">{alanAdi[dil][e.data.alan]}</span>}
                  {uclu(e.data.aciklama) && <span class="konu">{uclu(e.data.aciklama)}</span>}
                  <span class="kucuk">{tarih(e.data.tarih.toISOString().slice(0, 10), { day: 'numeric', month: 'short', year: 'numeric' })}{boyut > 0 && ` · ${mb(boyut)}`}</span>
                </span>
                <a href={href} class="dugme dugme-ikincil dugme-kucuk" download={!disBag} target={disBag ? '_blank' : undefined} rel={disBag ? 'noopener' : undefined}>{disBag ? m.ac : m.indir}</a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {/* ——— Nasıl kullanılır: ilk ekranı işgal etmesin diye kapalı ——— */}
    <details class="nasil kart-kagit">
      <summary><span class="etiket etiket-vurgu">{m.nasil}</span></summary>
      <ul class="liste">{m.nasilListe.map((s) => <li>{s}</li>)}</ul>
    </details>

    <p class="kaynak-not">{m.kaynak}</p>
    <p class="alt-baglantilar">
      <a href={yol(dil, 'mufredat')} class="dugme dugme-ikincil">{m.mufredat}</a>
      <a href={yol(dil, 'kurankursu')} class="dugme dugme-ikincil">{m.kurs}</a>
    </p>
  </div>
</Base>

<script>
  /* Süzgeç (alan çipleri + serbest arama) ve çapa açma.
     JS yoksa: süzgeç kutusu gizli kalır, bütün günler ve dosyalar erişilebilir durur. */
  const kok = document.querySelector('[data-materyal]');
  if (kok) {
    const suzgec = kok.querySelector<HTMLElement>('[data-suzgec]');
    const alanKutusu = kok.querySelector<HTMLInputElement>('[data-ara-alan]');
    const silDugme = kok.querySelector<HTMLButtonElement>('[data-ara-sil]');
    const bosNot = kok.querySelector<HTMLElement>('[data-filtre-bos]');
    const gunler = [...kok.querySelectorAll<HTMLElement>('[data-gun]')];
    const aylar = [...kok.querySelectorAll<HTMLDetailsElement>('[data-ay]')];
    /* Ay kendiliğinden açıldığında eski hâli hatırlanır; süzgeç boşalınca geri konur. */
    const ilkAcik = new Map(aylar.map((a) => [a, a.open]));

    let alan = 'tumu';
    let sorgu = '';

    const uygula = () => {
      const suzuluyor = alan !== 'tumu' || sorgu !== '';
      let gorunen = 0;

      for (const g of gunler) {
        const kodUyar = alan === 'tumu' || (g.dataset.kodlar || '').split(' ').includes(alan);
        const metinUyar = sorgu === '' || (g.dataset.ara || '').includes(sorgu);
        const gorunur = kodUyar && metinUyar;
        g.hidden = !gorunur;
        if (gorunur) gorunen++;
        /* Gün içinde: alan seçiliyken yalnız o alanın sunumu; plan ve ekler tüm alanlarla ilgili. */
        for (const s of g.querySelectorAll<HTMLElement>('[data-satir][data-kod]')) {
          s.hidden = alan !== 'tumu' && s.dataset.kod !== alan && s.dataset.kod !== 'genel';
        }
        for (const s of g.querySelectorAll<HTMLElement>('[data-satir="plan"], [data-satir="ek"]')) {
          s.hidden = alan !== 'tumu';
        }
      }

      /* Kalıcı materyaller de alana göre süzülür (arama onları kapsamaz). */
      for (const s of kok.querySelectorAll<HTMLElement>('[data-satir="kalici"]')) {
        s.hidden = alan !== 'tumu' && s.dataset.kod !== alan && s.dataset.kod !== 'genel';
      }

      for (const ay of aylar) {
        const dolu = !!ay.querySelector('[data-gun]:not([hidden])');
        ay.hidden = !dolu;
        if (suzuluyor) { if (dolu) ay.open = true; } else { ay.open = ilkAcik.get(ay) ?? false; }
        const say = ay.querySelector<HTMLElement>('[data-ay-say]');
        if (say) {
          const n = ay.querySelectorAll('[data-gun]:not([hidden])').length;
          say.textContent = suzuluyor ? say.dataset.varsayilan!.replace(/\d+/, String(n)) : say.dataset.varsayilan!;
        }
      }

      for (const b of kok.querySelectorAll<HTMLElement>('[data-bolum]')) {
        b.hidden = suzuluyor && !b.querySelector('[data-gun]:not([hidden]), [data-satir="kalici"]:not([hidden])');
      }
      /* Süzgeç kutusunun kendisi hiçbir zaman gizlenmesin: bölüm gizlenirse çıkış yolu kapanır. */
      if (suzgec) { const bolum = suzgec.closest<HTMLElement>('[data-bolum]'); if (bolum) bolum.hidden = false; }

      if (bosNot) bosNot.hidden = !(suzuluyor && gorunen === 0);
      if (silDugme) silDugme.hidden = sorgu === '';
    };

    if (suzgec) {
      suzgec.hidden = false;
      suzgec.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-alan]');
        if (!b) return;
        alan = b.dataset.alan || 'tumu';
        for (const d of suzgec.querySelectorAll<HTMLButtonElement>('[data-alan]')) {
          d.setAttribute('aria-pressed', String(d === b));
        }
        uygula();
      });
    }
    alanKutusu?.addEventListener('input', () => {
      sorgu = alanKutusu.value.trim().toLocaleLowerCase(document.documentElement.lang || 'tr');
      uygula();
    });
    silDugme?.addEventListener('click', () => {
      if (!alanKutusu) return;
      alanKutusu.value = ''; sorgu = ''; uygula(); alanKutusu.focus();
    });

    /* #g-<tarih> çapası: kapalı ayı ve kapalı günü açar, sonra kaydırır. */
    const capa = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const hedef = id && document.getElementById(id);
      if (!hedef) return;
      const ay = hedef.closest<HTMLDetailsElement>('details[data-ay]');
      if (ay) ay.open = true;
      if (hedef instanceof HTMLDetailsElement) hedef.open = true;
      requestAnimationFrame(() => hedef.scrollIntoView({ block: 'start' }));
    };
    capa(); addEventListener('hashchange', capa);
  }
</script>

