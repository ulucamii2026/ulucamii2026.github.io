---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import NamazVakitleri from '../components/NamazVakitleri';
import { ceviri, tarihBicimle } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { namazVakitleri, siteAyarlari, bugunBrussels } from '../lib/icerik';
import { hicriCevir } from '../i18n/hicri';
import { SIRA } from '../lib/namaz';
import { yaklasanDiniGunler } from '../lib/dinigunler';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const namaz = namazVakitleri(); const site = await siteAyarlari();
const bugun = bugunBrussels();
const tablo = namaz.gunler.filter((g) => g.tarih >= bugun);
const etiketler = { imsak: t('namaz.imsak'), gunes: t('namaz.gunes'), ogle: t('namaz.ogle'), ikindi: t('namaz.ikindi'), aksam: t('namaz.aksam'), yatsi: t('namaz.yatsi'), siradaki: t('namaz.siradaki'), kalan: t('namaz.kalan'), hicri: t('namaz.hicri') };
const not = dil === 'tr'
  ? 'Vakitler Diyanet İşleri Başkanlığı takvimine göre Marche-en-Famenne için hesaplanmıştır. Cemaatle kılınan namaz saatleri (özellikle yatsı ve sabah) mevsime göre cami ilan panosunda duyurulur.'
  : dil === 'en'
  ? 'Prayer times are calculated for Marche-en-Famenne according to the calendar of the Presidency of Religious Affairs (Diyanet). Congregational prayer times (especially isha and fajr) are announced on the mosque noticeboard according to the season.'
  : 'Les horaires sont calculés pour Marche-en-Famenne selon le calendrier de la Diyanet. Les heures des prières en congrégation (notamment isha et fajr) sont affichées à la mosquée selon la saison.';

const gunlerListe = yaklasanDiniGunler(bugun);
const dg = dil === 'tr'
  ? { baslik: 'Dinî Günler ve Kandiller', alt: 'Diyanet İşleri Başkanlığı’nın resmî takvimine göre yaklaşan kandil geceleri, bayramlar ve önemli günler.', yaklasan: 'Yaklaşan', kaynakNot: 'Kaynak: Diyanet İşleri Başkanlığı dinî günler takvimi', kandil: 'Kandil', bayram: 'Bayram', gun: 'Önemli gün' }
  : dil === 'en'
  ? { baslik: 'Religious Days and Holy Nights', alt: 'Upcoming holy nights, festivals and significant days according to the official calendar of the Turkish Presidency of Religious Affairs (Diyanet).', yaklasan: 'Next', kaynakNot: 'Source: Diyanet official calendar of religious days', kandil: 'Holy night', bayram: 'Festival', gun: 'Significant day' }
  : { baslik: 'Jours religieux et nuits bénies', alt: 'Les nuits bénies, fêtes et jours importants à venir selon le calendrier officiel de la Présidence des Affaires religieuses (Diyanet).', yaklasan: 'Prochain', kaynakNot: 'Source : calendrier officiel des jours religieux de la Diyanet', kandil: 'Nuit bénie', bayram: 'Fête', gun: 'Jour important' };
---
<Base baslik={t('nav.namaz')} dil={dil} aciklama={t('namaz.kaynak')}>
  <SayfaBasligi etiket="Marche-en-Famenne" baslik={t('nav.namaz')} altBaslik={t('namaz.kaynak')} />
  <div class="kapsayici py-10">
    <NamazVakitleri client:load gunler={namaz.gunler} dil={dil} etiketler={etiketler} />
    {site.cumaSaati && <p class="bilgi mt-6"><strong>{t('namaz.cuma')}:</strong> {site.cumaSaati}</p>}
    <p class="mt-6 text-(--metin-2) max-w-prose">{not}</p>
    <h2 class="mt-12 mb-4">{t('ana.tumvakitler')}</h2>
    <!-- Mobil: gün kartları (tablo dar ekrana sığmaz); sm ve üstü: tablo -->
    <ol id="vakit-kartlari" class="sm:hidden grid gap-2" role="list">
      {tablo.map((g) => (
        <li data-tarih={g.tarih} class:list={['kart-kagit px-3 py-2.5', g.tarih === bugun && 'border-(--vurgu) bg-(--vurgu)/6']}>
          <div class="flex items-baseline justify-between gap-2 mb-1.5">
            <span class="font-serif font-semibold capitalize">{tarihBicimle(g.tarih + 'T12:00:00', dil, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
            <span class="etiket normal-case tracking-normal text-right">{hicriCevir(g.hicri, dil)}</span>
          </div>
          <dl class="grid grid-cols-3 gap-x-2 gap-y-1">
            {SIRA.map((v) => (
              <div class="flex items-baseline justify-between gap-1 border-t border-(--cizgi) pt-1"><dt class="etiket">{t(`namaz.${v}` as any)}</dt><dd class="mono text-[0.95rem] tabular-nums">{g[v]}</dd></div>
            ))}
          </dl>
        </li>
      ))}
    </ol>
    <div class="hidden sm:block overflow-x-auto kart-kagit">
      <table id="vakit-tablosu" class="text-[0.92rem] md:text-base [&_th]:px-2 [&_td]:px-2 md:[&_th]:px-3 md:[&_td]:px-3">
        <caption class="sr-only">{t('ana.tumvakitler')}</caption>
        <thead><tr><th scope="col">{t('namaz.tarih')}</th><th scope="col" class="hidden md:table-cell">{t('namaz.hicri')}</th><th scope="col">{t('namaz.imsak')}</th><th scope="col">{t('namaz.gunes')}</th><th scope="col">{t('namaz.ogle')}</th><th scope="col">{t('namaz.ikindi')}</th><th scope="col">{t('namaz.aksam')}</th><th scope="col">{t('namaz.yatsi')}</th></tr></thead>
        <tbody>
          {tablo.map((g) => (
            <tr data-tarih={g.tarih} class:list={[g.tarih === bugun && 'bg-(--vurgu)/8 font-semibold']}>
              <td class="whitespace-nowrap">{tarihBicimle(g.tarih + 'T12:00:00', dil, { weekday: 'short', day: 'numeric', month: 'short' })}</td>
              <td class="hidden md:table-cell text-(--metin-2) text-sm">{hicriCevir(g.hicri, dil)}</td>
              <td class="mono">{g.imsak}</td><td class="mono">{g.gunes}</td><td class="mono">{g.ogle}</td><td class="mono">{g.ikindi}</td><td class="mono">{g.aksam}</td><td class="mono">{g.yatsi}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="etiket mt-4">{t('genel.guncelleme')}: {tarihBicimle(namaz.guncelleme, dil)} · {namaz.kaynak}</p>

    <section id="dini-gunler" class="mt-14" aria-label={dg.baslik}>
      <h2 class="mb-1 cetvel pt-4">{dg.baslik}</h2>
      <p class="text-(--metin-2) mb-5 max-w-prose">{dg.alt}</p>
      <ol class="grid gap-2 sm:grid-cols-2" role="list">
        {gunlerListe.map((g, i) => (
          <li class:list={['kart-kagit px-4 py-3 flex items-center gap-4', i === 0 && 'border-(--vurgu) bg-(--vurgu)/6']}>
            <div class="text-center shrink-0 w-16">
              <span class="block font-serif text-[1.65rem] font-bold leading-none tabular-nums">
                {new Date(g.tarih + 'T12:00:00').getDate()}{g.bitis ? '–' + new Date(g.bitis + 'T12:00:00').getDate() : ''}
              </span>
              <span class="block etiket mt-1">{tarihBicimle(g.tarih + 'T12:00:00', dil, { month: 'short', year: 'numeric' })}</span>
            </div>
            <div class="min-w-0 border-l border-(--cizgi) pl-4">
              <p class="font-semibold leading-snug">{g.ad[dil]}</p>
              <p class="etiket normal-case tracking-normal mt-0.5">{tarihBicimle(g.tarih + 'T12:00:00', dil, { weekday: 'long' })} · {hicriCevir(g.hicri, dil)}</p>
            </div>
            {i === 0 && <span class="etiket etiket-vurgu ml-auto shrink-0">{dg.yaklasan}</span>}
          </li>
        ))}
      </ol>
      <p class="etiket mt-4">{dg.kaynakNot}</p>
    </section>
  </div>
</Base>
<script>
  // Tablo her gün kendini tazeler: Brüksel saatine göre bugünden önceki satırlar gizlenir, bugün vurgulanır (derleme eski kalsa bile)
  const bugun = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  document.querySelectorAll<HTMLElement>('#vakit-tablosu tr[data-tarih], #vakit-kartlari li[data-tarih]').forEach((tr) => {
    const d = tr.dataset.tarih || '';
    if (d < bugun) tr.hidden = true;
    const kart = tr.tagName === 'LI';
    tr.classList.toggle(kart ? 'bg-(--vurgu)/6' : 'bg-(--vurgu)/8', d === bugun); tr.classList.toggle(kart ? 'border-(--vurgu)' : 'font-semibold', d === bugun);
  });
</script>
