      surec: [
        { b: 'Aanvraag', a: 'Vul het online formulier in of bel gewoon onze imam. Gratis en vrijblijvend.' },
        { b: 'Kennismakingsgesprek', a: 'Wij luisteren naar uw vragen en leggen de procedure uit — in het Frans of het Turks.' },
