---
/** İhtida (İslam'a giriş) bilgi sayfası — gövde src/content/sayfalar/{dil}/ihtida.md,
    yan sütunda süreç zaman çizelgesi + gerekli belgeler + iletişim kartı + online başvuru düğmesi. */
import IcerikSayfasi from '../components/IcerikSayfasi.astro';
import DiyanetPortallari from '../components/DiyanetPortallari.astro';
import TorenKonusmasi from '../components/TorenKonusmasi.astro';
import KutuphaneBandi from '../components/KutuphaneBandi.astro';
import DiyanetVideolari from '../components/DiyanetVideolari.astro';
import WhatsappBaglanti from '../components/WhatsappBaglanti.astro';
import Ikon from '../components/Ikon.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const site = await siteAyarlari();
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');

const m = dil === 'tr'
  ? {
      surecBaslik: 'Süreç Nasıl İşler?',
      surec: [
        { b: 'Başvuru', a: 'Online formu doldurun veya doğrudan din görevlimizi arayın. Ücretsiz, bağlayıcılığı yok.' },
        { b: 'Tanışma görüşmesi', a: 'Sorularınızı dinleriz, süreci anlatırız. Türkçe veya Fransızca.' },
        { b: 'Tören günü', a: 'Gün ve saat sizin uygunluğunuza göre birlikte belirlenir.' },
        { b: 'İhtida töreni', a: 'Tilavet, telkin, hür irade sorusu, kelime-i şehadet, tekbir ve tebrik.' },
        { b: 'Belge takdimi', a: 'Kuşe kâğıda basılan İhtida Belgesi nüshası aynı gün size verilir.' },
        { b: 'Resmî kayıt ve sonrası', a: 'Resmî nüsha Müşavirlik kanalıyla kayda geçer (birkaç hafta); rehberlik ve dersler devam eder.' },
      ],
      belgelerBaslik: 'Gerekli Belgeler',
      belgeler: [
        'Başvuru formunda: 1 adet vesikalık fotoğraf — İhtida Belgesi’nin üzerine basılır',
        'Başvuru formunda: kimlik kartınızın ön ve arka yüzü (pasaportta bilgi sayfası yeter)',
        'Başvuru formunda: imzanız — ekrana çizersiniz; dilerseniz tören günü kalemle atarsınız',
        'Tören günü: kimliğinizin ya da pasaportunuzun aslı — görevliye gösterilir',
        'Tören günü: 2 şahit (yoksa camimiz sağlar) ve kâğıt üzerinde imzalanan EK-10 açık rıza metni',
      ],
      iletisimBaslik: 'Randevu ve Sorularınız İçin',
      iletisimAlt: 'Süreç hakkında konuşmak isterseniz din görevlimizi arayabilir veya e-posta gönderebilirsiniz.',
      basvuruBaslik: 'Online Başvuru',
      basvuruAlt: 'Formu birkaç adımda doldurun; başvurunuz camimize ve size PDF olarak iletilsin.',
      basvuruButon: 'Online başvuru yapın',
      indirBaslik: 'Belgeler',
      ek9: 'İhtida Belgesi (EK-9) — resmî örnek',
      ek10: 'KVKK Açık Rıza Metni (EK-10) — tam metin',
      ucretsiz: 'Süreç tamamen ücretsizdir.',
      kaynakBaslik: 'Diyanet Kütüphanesi',
      kaynakAlt: 'Diyanet’in ücretsiz e-kitapları — tanıtım broşürleri, ibadet rehberi, kırk hadis, fetvalar, mealler. Kırktan fazla dilde, beş yüzün üzerinde kitap.',
      kaynakButon: 'Kütüphaneye git',
    }
  : dil === 'en'
  ? {
      surecBaslik: 'How Does the Process Work?',
      surec: [
        { b: 'Application', a: 'Fill in the online form or simply call our imam. Free, and it commits you to nothing.' },
        { b: 'Meeting', a: 'We listen to your questions and explain the process — in French or Turkish.' },
        { b: 'Setting the date', a: 'The day and time are agreed together, around your availability.' },
        { b: 'Conversion ceremony', a: 'Recitation, a short address, the question of free will, the shahada, takbir and congratulations.' },
        { b: 'Presentation of the certificate', a: 'A copy printed on glossy paper is handed to you the same day.' },
        { b: 'Official record and after', a: 'The official copy is registered through the Counsellor’s office (a few weeks); guidance and lessons continue.' },
      ],
      belgelerBaslik: 'Documents Required',
      belgeler: [
        'With the form: 1 passport-style photo — printed on the conversion certificate',
        'With the form: the front and back of your ID card (for a passport, the data page is enough)',
        'With the form: your signature — drawn on screen; you may also sign in pen on the day',
        'On the day: the original of your ID card or passport — shown to the imam',
        'On the day: 2 witnesses (our mosque provides them if needed) and the EK-10 consent form, signed on paper',
      ],
      iletisimBaslik: 'For Appointments and Questions',
      iletisimAlt: 'If you would like to discuss the process, you can call our imam or send an e-mail.',
      basvuruBaslik: 'Online Application',
      basvuruAlt: 'Fill in the form in a few steps; your application is sent to our mosque and to you as a PDF.',
      basvuruButon: 'Apply online',
      indirBaslik: 'Documents',
      ek9: 'Conversion Certificate (EK-9) — official template',
      ek10: 'GDPR Explicit Consent Text (EK-10) — full text',
      ucretsiz: 'The process is entirely free of charge.',
      kaynakBaslik: 'Diyanet Library',
      kaynakAlt: 'Diyanet’s free e-books — introductory booklets, worship guide, forty hadiths, fatwas, Qur’an translations. Over five hundred books in more than forty languages.',
      kaynakButon: 'Go to the library',
    }
  : {
      surecBaslik: 'Comment se déroule la démarche ?',
      surec: [
        { b: 'Demande', a: 'Formulaire en ligne ou appel direct à l’imam. Gratuit et sans engagement.' },
        { b: 'Entretien', a: 'Nous écoutons vos questions et expliquons la démarche — en français ou en turc.' },
        { b: 'Choix de la date', a: 'Le jour et l’heure sont fixés ensemble, selon vos disponibilités.' },
        { b: 'Cérémonie de conversion', a: 'Récitation, discours, question du libre arbitre, chahada, takbir et félicitations.' },
        { b: 'Remise de l’attestation', a: 'L’exemplaire imprimé sur papier glacé vous est remis le jour même.' },
        { b: 'Enregistrement et suite', a: 'L’exemplaire officiel est enregistré via le Conseiller (plusieurs semaines) ; l’accompagnement continue.' },
      ],
      belgelerBaslik: 'Documents nécessaires',
      belgeler: [
        'Dans le formulaire : 1 photo d’identité — imprimée sur l’attestation de conversion',
        'Dans le formulaire : le recto et le verso de votre carte d’identité (pour un passeport, la page de données suffit)',
        'Dans le formulaire : votre signature — tracée à l’écran ; vous pouvez aussi signer au stylo le jour même',
        'Le jour de la cérémonie : l’original de votre carte d’identité ou passeport — présenté à l’imam',
        'Le jour de la cérémonie : 2 témoins (la mosquée en fournit si nécessaire) et le consentement EK-10, signé sur papier',
      ],
      iletisimBaslik: 'Rendez-vous et questions',
      iletisimAlt: 'Pour échanger sur la démarche, vous pouvez appeler notre imam ou lui envoyer un e-mail.',
      basvuruBaslik: 'Demande en ligne',
      basvuruAlt: 'Complétez le formulaire en quelques étapes ; votre demande est transmise à la mosquée et vous parvient en PDF.',
      basvuruButon: 'Faire une demande en ligne',
      indirBaslik: 'Documents',
      ek9: 'Attestation de conversion (EK-9) — modèle officiel',
      ek10: 'Consentement RGPD (EK-10) — texte complet',
      ucretsiz: 'La démarche est entièrement gratuite.',
      kaynakBaslik: 'Bibliothèque Diyanet',
      kaynakAlt: 'Les livres numériques gratuits du Diyanet — brochures d’introduction, guide du culte, quarante hadiths, fatwas, traductions du Coran. Plus de cinq cents ouvrages en plus de quarante langues.',
      kaynakButon: 'Aller à la bibliothèque',
    };
---
<IcerikSayfasi dil={dil} anahtar="ihtida" etiket={t('nav.ihtida')} icindekiler>
  <div slot="yan" class="kart-kagit p-5 border-(--vurgu-2)">
    <p class="etiket etiket-vurgu">{m.basvuruBaslik}</p>
    <p class="mt-2 text-sm text-(--metin-2)">{m.basvuruAlt}</p>
    <a href={yol(dil, 'ihtidaBasvuru')} class="dugme dugme-birincil mt-4 w-full justify-center">{m.basvuruButon}</a>
    <p class="mt-3 text-sm etiket-vurgu">{m.ucretsiz}</p>
  </div>

  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.surecBaslik}</p>
    <ol class="mt-3 grid gap-3 text-sm list-decimal pl-5">
      {m.surec.map((s) => <li><span class="font-semibold text-(--metin)">{s.b}</span><br /><span class="text-(--metin-2)">{s.a}</span></li>)}
    </ol>
  </div>

  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.belgelerBaslik}</p>
    <ul class="mt-3 grid gap-2 text-sm list-[square] pl-4">
      {m.belgeler.map((b) => <li>{b}</li>)}
    </ul>
  </div>

  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.iletisimBaslik}</p>
    <p class="mt-2 text-sm text-(--metin-2)">{m.iletisimAlt}</p>
    <ul class="mt-3 grid gap-2 text-sm">
      <li class="flex items-center gap-2"><Ikon ad="telefon" class="h-5 w-5 shrink-0 text-(--vurgu)" /><WhatsappBaglanti site={site} /></li>
      {(site.epostaDinGorevlisi ?? site.eposta) && <li class="flex items-center gap-2"><Ikon ad="iletisim" class="h-5 w-5 shrink-0 text-(--vurgu)" /><a href={`mailto:${site.epostaDinGorevlisi ?? site.eposta}`}>{site.epostaDinGorevlisi ?? site.eposta}</a></li>}
    </ul>
  </div>

  <div slot="yan" class="kart p-5">
    <p class="etiket etiket-vurgu">{m.kaynakBaslik}</p>
    <p class="mt-2 text-sm text-(--metin-2)">{m.kaynakAlt}</p>
    <a href={yol(dil, 'kutuphane')} class="dugme dugme-ikincil mt-4 w-full justify-center">{m.kaynakButon}</a>
  </div>

  <div slot="yan" class="kart-kagit p-5">
    <p class="etiket etiket-vurgu">{m.indirBaslik}</p>
    <ul class="mt-3 grid gap-2 text-sm">
      <li><a href="/belgeler/ihtida/ihtida-belgesi-ek9-ornek.pdf" target="_blank" rel="noopener">{m.ek9}<span aria-hidden="true"> ↗</span></a></li>
      <li><a href="/belgeler/ihtida/ek10-kvkk-acik-riza-metni.pdf" target="_blank" rel="noopener">{m.ek10}<span aria-hidden="true"> ↗</span></a></li>
    </ul>
  </div>

  <TorenKonusmasi slot="alt" dil={dil} />
  <DiyanetPortallari slot="alt" dil={dil} />
  <DiyanetVideolari slot="alt" dil={dil} />
  <KutuphaneBandi slot="alt" dil={dil} />
</IcerikSayfasi>
