<script>
  // Bölüm çubuğu: içindekiler kartı görünür alandan çıkınca site başlığının altında belirir; kaydırdıkça
  // bulunulan bölümün numarası/adı güncellenir ve her iki listede aria-current işaretlenir (scroll-spy).
  // Site başlığının yüksekliği dile/genişliğe göre değiştiği için ölçülüp --yp-ust'a yazılır
  // (aynı desen: src/sayfalar/YillikPlan.astro). JS yoksa çubuk hiç görünmez; içindekiler kartı yeter.
  const cubuk = document.querySelector<HTMLElement>('[data-uip-cubuk]');
  const kart = document.querySelector<HTMLElement>('[data-icindekiler]');
  if (cubuk && kart) {
    const kok = document.documentElement;
    const listeler = Array.from(document.querySelectorAll<HTMLElement>('[data-bolum-listesi]'));
    const bagler = listeler.map((l) => Array.from(l.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')));
    const bolumler = bagler[0].map((a) => document.getElementById(a.getAttribute('href')!.slice(1))).filter((e): e is HTMLElement => !!e);
    const no = cubuk.querySelector<HTMLElement>('[data-cubuk-no]');
    const ad = cubuk.querySelector<HTMLElement>('[data-cubuk-ad]');
    const menu = cubuk.querySelector<HTMLDetailsElement>('[data-bolum-menu]');
    let ust = 79;
    const olc = () => {
      const bas = document.querySelector<HTMLElement>('body > header');
      ust = bas ? bas.offsetHeight : 79;
      kok.style.setProperty('--yp-ust', ust + 'px');
    };
    let simdiki = -2;
    const guncelle = () => {
      cubuk.dataset.gorunur = kart.getBoundingClientRect().bottom < ust ? '1' : '0';
      if (cubuk.dataset.gorunur === '0' && menu?.open) menu.open = false; // gizlenirken açık menü de kapanır (odak body'ye düşmesin)
      const esik = ust + cubuk.offsetHeight + 12;
      // Eşiği geçmiş en aşağıdaki bölüm; masaüstünde yan yana duran Şartlar/Takvim gibi eşit üst
      // kenarlı bölümlerde ilki kazanır (katı büyüktür), yoksa sağdaki sütun soldakini gölgeler.
      let i = -1, enUst = -Infinity;
      bolumler.forEach((b, k) => { const t = b.getBoundingClientRect().top; if (t <= esik && t > enUst) { enUst = t; i = k; } });
      if (i === simdiki) return;
      simdiki = i;
      const g = Math.max(i, 0);
      if (no) no.textContent = String(g + 1).padStart(2, '0');
      if (ad) ad.textContent = bagler[0][g]?.dataset.ad ?? '';
      bagler.forEach((liste) => liste.forEach((a, k) => { if (k === i) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); }));
    };
    let bekliyor = false;
    const tetik = () => { if (bekliyor) return; bekliyor = true; requestAnimationFrame(() => { bekliyor = false; guncelle(); }); };
    olc(); guncelle();
    addEventListener('scroll', tetik, { passive: true });
    // Site başlığının yüksekliği yalnız pencere boyutuyla değil, mobil menü açılınca da değişir (resize olayı
    // gelmez) → ResizeObserver; desteklenmeyen tarayıcıda resize dinleyicisi.
    const bas = document.querySelector<HTMLElement>('body > header');
    if (bas && 'ResizeObserver' in window) new ResizeObserver(() => { olc(); tetik(); }).observe(bas);
    else addEventListener('resize', () => { olc(); tetik(); }, { passive: true });
    if (menu) {
      // Açılır liste: bağlantıya tıklayınca, Escape'te ve dışına tıklayınca kapanır.
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) menu.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector<HTMLElement>('summary')?.focus(); } });
      document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
    }
  }
</script>
<style>
  /* Bölüm çubuğu sabit (fixed) ve site başlığının hemen altında; --yp-ust script'te ölçülür. Gizliyken
     yukarı kayar ve görünmez olur (visibility: sekme sırasından da çıkar). */
  .uip-cubuk { top: var(--yp-ust, 79px); transition: transform .25s ease, visibility .25s; }
  .uip-cubuk[data-gorunur="0"] { transform: translateY(-110%); visibility: hidden; }
  @media (prefers-reduced-motion: reduce) { .uip-cubuk { transition: none; } }
  .bolum-menu > summary::-webkit-details-marker { display: none; }
  /* Açılır liste sabit çubuğun içinde; kısa/yatay ekranlarda görünür alanı aşmasın, kendi içinde kaysın. */
  .bolum-menu > div { max-height: calc(100dvh - var(--yp-ust, 79px) - 4.5rem); overflow-y: auto; }
  .bolum-menu[open] > summary .cevir { transform: rotate(180deg); }
  [data-bolum-listesi] a[aria-current="true"] { color: var(--vurgu); font-weight: 600; }
  /* Tıklanan bölüm başlığı site başlığının ve çubuğun (48 px + pay) arkasında kalmasın. */
  #video, #nedir, #imkanlar, #fakulteler, #sartlar, #takvim, #basvuru, #belcika, #belgeler, #kariyer, #sss, #ekler, #iletisim {
    scroll-margin-top: calc(var(--yp-ust, 79px) + 56px);
  }
  /* Yazdırmada sabit başlık/altbilgi, video ve sekme-nav kaldırılır; şartlar/takvim/belgeler bölünmeden kalır.
     Header/Footer Base.astro'da render edildiğinden (bu sayfanın kendi kapsamı dışında), :global() gerekir. */
  @media print {
    :global(header.vt-baslik), :global(footer.vt-altbilgi), :global(.kilim-serit), :global(#tema-dugme), :global(#menu-dugme) { display: none !important; }
    /* İçindekiler kartı yazdırmada kalır (baskıda genel bakış işe yarar); sabit çubuk ve video kaldırılır. */
    #video, .uip-cubuk { display: none !important; }
    #sartlar, #takvim, #belgeler { break-inside: avoid; }
  }
</style>
