---
/** Uluslararası İlahiyat Programı (UİP) — tanıtım, şartlar, takvim, başvuru adımları, belgeler.
 *
 * Metin: src/i18n/uip.ts (tr) + uip-fr.ts + uip-en.ts — kılavuz sayfa atıflı, tutar/2027 tarihi yazılmaz.
 * Dönem tarihleri: src/lib/etkinlik-tarihleri.ts (UIP_*) — sayfa her gece yeniden derlendiği için
 * "başvurular açık / kapandı / yakında" bandı kendiliğinden değişir.
 * Video: UİP tanıtım filmi Belçika Diyanet Vakfı'nın (diyanet.be) sunucusundan dış kaynak olarak
 * akıtılır (1080p, ~560 MB) — Pages trafiğini korumak için kopyası barındırılmaz; tıkla-yükle
 * cephesi (VideoCephe) sayesinde oynatılmadan tek bayt inmez. YouTube'daki diğer iki video da aynı
 * cepheyle gömülür.
 * Sayfa içi gezinme: «BU SAYFADA» içindekiler kartı + kart geçilince beliren sabit bölüm çubuğu. */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import VideoCephe from '../components/VideoCephe.astro';
import Ikon from '../components/Ikon.astro';
import { yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { uipMetin } from '../i18n/uip';
import { siteAyarlari, bugunBrussels } from '../lib/icerik';
import { UIP_DONEM, UIP_BASVURU_BASLANGIC, UIP_BASVURU_SON } from '../lib/etkinlik-tarihleri';
interface Props { dil: Dil }
const { dil } = Astro.props;
const m = uipMetin[dil];
const site = await siteAyarlari();
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const yerel = dil === 'tr' ? 'tr-TR' : dil === 'en' ? 'en-GB' : 'fr-BE';
const tarihUzun = (iso: string) => new Intl.DateTimeFormat(yerel, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso + 'T12:00:00'));
const bugun = bugunBrussels();
const durum: 'yakinda' | 'acik' | 'kapandi' = bugun < UIP_BASVURU_BASLANGIC ? 'yakinda' : bugun <= UIP_BASVURU_SON ? 'acik' : 'kapandi';
const doldur = (s: string) => s.replace(/\{\{donem\}\}/g, String(UIP_DONEM)).replace(/\{\{son\}\}/g, tarihUzun(UIP_BASVURU_SON)).replace(/\{\{baslangic\}\}/g, tarihUzun(UIP_BASVURU_BASLANGIC));
const durumMetni = doldur(m.durum[durum]);
const BASVURU = 'https://dibbys.diyanet.gov.tr/IKYS/Sinav/KurumDisi/DisIliskiler/UIPBasvuru.aspx';
const KILAVUZ = '/belgeler/uip/uip-tanitim-ve-basvuru-kilavuzu-2026.pdf';
const OG = `/media/uip/uip-og-${dil}.webp`;
const BDV_TEL = '+32 2 218 57 55', BDV_EPOSTA = 'info@diyanet.be', MUSAVIRLIK_TEL = '+32 2 506 11 73';
const kanonikUrl = new URL(Astro.url.pathname, Astro.site).toString();
const waMetin = `${m.baslik} — ${kanonikUrl}`;
const waEtiket = dil === 'tr' ? "WhatsApp'ta paylaş" : dil === 'en' ? 'Share on WhatsApp' : 'Partager sur WhatsApp';
const kariyerIkon = ['cami', 'kurs', 'dunya', 'belge', 'mezuniyet', 'kurs'] as const;
/** Tanıtım filmi — Belçika Diyanet Vakfı'nın ana sayfasındaki dosya (1080p, ~560 MB, moov sonda; sunucu Range destekliyor) */
const FILM = 'https://www.diyanet.be/portals/0/uip/sinevizyon.mov';
const bolumBag = 'inline-flex min-h-9 w-full items-center gap-3 no-underline text-(--metin) hover:text-(--vurgu) hover:underline';
const bolumler: Array<[string, string]> = [
  ['video', m.video.baslik], ['nedir', m.nedir.baslik], ['imkanlar', m.imkan.baslik], ['fakulteler', m.fakulte.baslik],
  ['sartlar', m.sart.baslik], ['takvim', doldur(m.takvim.baslik)], ['basvuru', m.adim.baslik], ['belcika', m.belcika.baslik],
  ['belgeler', m.belge.baslik], ['kariyer', m.kariyer.baslik], ['sss', m.sss.baslik], ['ekler', m.ekler.baslik], ['iletisim', m.iletisim.baslik],
];
const sssJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: m.sss.liste.map((x) => ({ '@type': 'Question', name: x.s, acceptedAnswer: { '@type': 'Answer', text: x.c } })),
};
const afisler = [
  { href: '/media/afisler/bdv-2026-uip-basvurulari.webp', kucuk: '/media/afisler/bdv-2026-uip-basvurulari-thumb.webp', alt: m.ekler.afisUip, w: 480, h: 256 },
  { href: `/media/uip/diyanet-burslari-2026-${dil}.webp`, kucuk: `/media/uip/diyanet-burslari-2026-${dil}-thumb.webp`, alt: m.ekler.afisBurs, w: 448, h: 640 },
];
---
<Base baslik={m.baslik} dil={dil} aciklama={m.metaAciklama} kapak={OG} kapakAlt={m.baslik} ekJsonLd={[sssJsonLd]}>
  <SayfaBasligi etiket={m.etiket} baslik={m.baslik} altBaslik={m.alt} kapak="/media/uip/uip-kapak.webp" />

  <div class="kapsayici py-8 sm:py-10 reveal">
    <div class={durum === 'acik' ? 'uyari' : 'bilgi'} role="status">
      <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
        <p class="m-0"><Ikon ad="takvim" class="mr-1.5 inline h-5 w-5 -mt-0.5 text-(--vurgu)" />{durumMetni}</p>
        <div class="flex flex-wrap gap-2">
          {durum === 'acik' && <a href={BASVURU} target="_blank" rel="noopener" class="dugme dugme-birincil">{m.durum.basvuruDugmesi}<span aria-hidden="true"> ↗</span></a>}
          <a href={KILAVUZ} class="dugme dugme-ikincil" target="_blank" rel="noopener"><Ikon ad="belge" class="h-4 w-4" />{m.durum.kilavuz}</a>
          <a href="https://www.diyanet.be" target="_blank" rel="noopener" class="dugme dugme-ikincil">{m.durum.takip}<span aria-hidden="true"> ↗</span></a>
          <a href={`https://wa.me/?text=${encodeURIComponent(waMetin)}`} target="_blank" rel="noopener" class="dugme dugme-ikincil">{waEtiket}<span aria-hidden="true"> ↗</span></a>
        </div>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {/* dl/dt/dd değil: her kart gerçek bir terim/tanım çifti değil, tek bir istatistik birimi
          (sayı + etiket + not) — düz paragraflarla işaretlemek dt/dd sıra kuralını (HTML Living
          Standard) ihlal etme riskini kökten kaldırır. */}
      {m.ozet.map((o) => <div class="kart-kagit px-4 py-4"><p class="font-serif text-3xl font-bold leading-none text-(--vurgu)">{o.sayi}</p><p class="mt-1.5 font-semibold">{o.ad}</p><p class="text-sm text-(--metin-2)">{o.not}</p></div>)}
    </div>
    {/* İçindekiler kartı (3 Eyl 2026): eski yatay kaydırmalı şerit 13 öğeyi sığdıramıyor, kaydırma çubuğu
        çirkin duruyordu (Rıdvan). Yerine sütunlu numaralı liste; kart görünümden çıkınca aşağıdaki ince
        çubuk belirir (bulunulan bölüm + aynı listeyi açan menü + başa dön). */}
    <nav id="icindekiler" class="kart-kagit mt-6 px-5 py-4 sm:px-6" aria-labelledby="icindekiler-baslik" data-icindekiler>
      <p id="icindekiler-baslik" class="mono text-xs tracking-[0.18em] text-(--vurgu)">{m.nav.buSayfada}</p>
      {/* CSS çok sütun (grid değil): grid'de iki satıra sarılan bir başlık aynı satırdaki kısa komşuların altında
          boşluk bırakıyordu; sütunlar bağımsız akar ve numaralı liste kitap içindekileri gibi yukarıdan aşağı okunur. */}
      <ol class="mt-2 columns-1 gap-x-8 text-sm sm:columns-2 lg:columns-3" data-bolum-listesi>
        {bolumler.map(([id, ad], i) => <li class="break-inside-avoid"><a href={`#${id}`} data-ad={ad} class={bolumBag}><span aria-hidden="true" class="mono w-5 shrink-0 text-xs text-(--vurgu)">{String(i + 1).padStart(2, '0')}</span>{ad}</a></li>)}
      </ol>
    </nav>
  </div>

  <div class="uip-cubuk fixed inset-x-0 z-20 border-b border-(--cizgi) bg-(--zemin)/95 backdrop-blur" data-uip-cubuk data-gorunur="0">
    <div class="kapsayici flex items-center justify-between gap-3 py-1">
      <details class="bolum-menu relative min-w-0" data-bolum-menu>
        <summary class="inline-flex min-h-10 max-w-full cursor-pointer list-none items-center gap-2 text-sm">
          <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-(--vurgu)"><path d="M3 5h14M3 10h14M3 15h9"/></svg>
          <span class="mono shrink-0 text-xs text-(--vurgu)" data-cubuk-no>01</span>
          <span class="truncate font-medium" data-cubuk-ad>{bolumler[0][1]}</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cevir shrink-0 transition-transform"><path d="M5 8l5 5 5-5"/></svg>
          <span class="sr-only">· {m.nav.icindekiler}</span>
        </summary>
        <div class="kart-kagit absolute left-0 top-full mt-2 w-[min(calc(100vw-2rem),40rem)] p-4 shadow-xl">
          <p class="mono text-xs tracking-[0.18em] text-(--vurgu)">{m.nav.buSayfada}</p>
          <ol class="mt-2 columns-1 gap-x-6 text-sm sm:columns-2" data-bolum-listesi>
            {bolumler.map(([id, ad], i) => <li class="break-inside-avoid"><a href={`#${id}`} data-ad={ad} class={bolumBag}><span aria-hidden="true" class="mono w-5 shrink-0 text-xs text-(--vurgu)">{String(i + 1).padStart(2, '0')}</span>{ad}</a></li>)}
          </ol>
        </div>
      </details>
      {/* Dar ekranda yalnız ok (40×40 dokunma hedefi); etiket ekran okuyucuya kalır, sm+ görünür — bölüm adına yer açar. */}
      <a href="#top" class="inline-flex min-h-10 min-w-10 shrink-0 items-center justify-center gap-1 text-sm text-(--metin-2) no-underline hover:text-(--vurgu) hover:underline"><span aria-hidden="true">↑</span><span class="sr-only sm:not-sr-only">{m.nav.basaDon}</span></a>
    </div>
  </div>

  <section id="video" class="kapsayici pb-10 sm:pb-14 reveal" aria-labelledby="video-baslik">
    <h2 id="video-baslik">{m.video.baslik}</h2>
    <p class="mt-2 max-w-[70ch] text-(--metin-2)">{m.video.alt}</p>
    <div class="mt-5">
      {/* Kapak: filmin kütüphane karesi üstüne tasarlanmış üç dilli kapak (scratchpad uip_kapak.py); başlık kapakta olduğu için kapakYazili */}
      {/* Film diyanet.be'nin sunucusundan (Rıdvan, 3 Eyl 2026: kendi 33 MB'lık 540p kopyamız Pages trafiğimizi tüketmesin);
          .mov (H.264/AAC, Range destekli) Chromium/Firefox/WebKit'te doğrulandı. Kapak bizde kalır. */}
      <VideoCephe src={FILM} baslik={`${m.baslik} · ${m.video.baslik}`} poster={`/media/uip/video-kapak-${dil}.webp`} dil={dil} altyazi={m.video.kaynak} not={m.video.sunucu} kapakYazili />
    </div>
    <h3 class="mt-8 text-xl">{m.video.digerBaslik}</h3>
    <div class="mt-3 grid gap-5 md:grid-cols-2">
      <VideoCephe id="jS8tgY_R9_w" baslik={m.video.tdv} poster="/media/uip/video-tdv-uip.webp" dil={dil} altyazi="2014 · 3:31" />
      <VideoCephe id="hLeGbadVi58" baslik={m.video.diyanettv} poster="/media/uip/video-diyanettv-yeni-donem.webp" dil={dil} altyazi="2015 · 2:26" />
    </div>
    <p class="mt-3 text-sm"><a href="https://www.youtube.com/watch?v=oxK8DyQ2N44" target="_blank" rel="noopener">{m.video.eksen}<span aria-hidden="true"> ↗</span></a></p>
  </section>

  <section id="nedir" class="bg-(--zemin-2) border-y border-(--cizgi) reveal" aria-labelledby="nedir-baslik">
    <div class="kapsayici py-10 sm:py-14 grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div>
        <h2 id="nedir-baslik">{m.nedir.baslik}</h2>
        <p class="mt-3 max-w-[70ch]">{m.nedir.p1}</p>
        <p class="mt-3 max-w-[70ch]">{m.nedir.p2}</p>
      </div>
      <div class="kart p-5 sm:p-6">
        <h3 class="text-lg">{m.nedir.amacBaslik}</h3>
        <ol class="mt-3 grid gap-2.5 list-decimal pl-5 text-sm">{m.nedir.amaclar.map((a) => <li>{a}</li>)}</ol>
      </div>
    </div>
  </section>

  <section id="imkanlar" class="kapsayici py-10 sm:py-14 reveal" aria-labelledby="imkan-baslik">
    <h2 id="imkan-baslik">{m.imkan.baslik}</h2>
    <p class="mt-2 max-w-[70ch] text-(--metin-2)">{m.imkan.alt}</p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {m.imkan.kartlar.map((k, i) => <li class="kart p-4"><Ikon ad={(['bagis', 'cami', 'kurs', 'belge'] as const)[i]} class="h-6 w-6 text-(--vurgu)" /><h3 class="mt-2 text-lg">{k.baslik}</h3><p class="mt-1 text-sm text-(--metin-2)">{k.metin}</p></li>)}
    </ul>
    <p class="mt-4 text-sm"><strong>{m.imkan.kapsamDisi}</strong></p>
    <p class="bilgi mt-3 text-sm">{m.imkan.teminat}</p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div><h3 class="text-lg">{m.imkan.stajBaslik}</h3><ul class="mt-2 grid gap-1.5 list-disc pl-5 text-sm">{m.imkan.staj.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3 class="text-lg">{m.imkan.tamamlayiciBaslik}</h3><ul class="mt-2 grid gap-1.5 list-disc pl-5 text-sm">{m.imkan.tamamlayici.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3 class="text-lg">{m.imkan.sosyalBaslik}</h3><ul class="mt-2 grid gap-1.5 list-disc pl-5 text-sm">{m.imkan.sosyal.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section id="fakulteler" class="bg-(--zemin-2) border-y border-(--cizgi) reveal" aria-labelledby="fakulte-baslik">
    <div class="kapsayici py-10 sm:py-14">
      <h2 id="fakulte-baslik">{m.fakulte.baslik}</h2>
      <p class="mt-2 max-w-[75ch] text-(--metin-2)">{m.fakulte.alt}</p>
      <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {m.fakulte.liste.map((f) => <li class="kart-kagit flex gap-3 p-4"><Ikon ad="mezuniyet" class="h-6 w-6 shrink-0 text-(--vurgu)" /><div><p class="font-semibold leading-snug">{f.ad}</p><p class="mt-1 text-sm text-(--metin-2)">{f.sehir} · <span class="mono" title={m.fakulte.katilim}>{f.yil}</span></p></div></li>)}
      </ol>
      <p class="mt-4 max-w-[75ch] text-sm">{m.fakulte.diploma}</p>
    </div>
  </section>

  {/* Şartlar ve Takvim, tek section içinde iki h2 taşıyordu ama section'ın aria-labelledby'si
      yalnız birini kapsıyordu (WCAG 1.3.1); iki bölüm artık kendi section+aria-labelledby'sine
      sahip, iki-sütunlu kilim ızgarası dış div'de aynen korunuyor. */}
  <div class="kapsayici py-10 sm:py-14 grid gap-8 lg:grid-cols-2 reveal">
    <section id="sartlar" class="min-w-0" aria-labelledby="sart-baslik">
      <h2 id="sart-baslik">{m.sart.baslik}</h2>
      <p class="mt-2 text-(--metin-2)">{m.sart.alt}</p>
      <ol class="mt-4 grid gap-2.5 list-decimal pl-5">{m.sart.liste.map((x) => <li>{doldur(x)}</li>)}</ol>
      <p class="uyari mt-4 text-sm">{m.sart.not}</p>
    </section>
    <section id="takvim" class="min-w-0" aria-labelledby="takvim-baslik">
      <h2 id="takvim-baslik">{doldur(m.takvim.baslik)}</h2>
      <p class="mt-2 text-(--metin-2)">{m.takvim.alt}</p>
      <div class="kart mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="bg-(--zemin-2) text-left"><th scope="col" class="px-4 py-2.5 font-semibold">{m.takvim.islem}</th><th scope="col" class="px-4 py-2.5 font-semibold">{m.takvim.tarih}</th></tr></thead>
          <tbody>{m.takvim.satirlar.map(([a, b]) => <tr class="border-t border-(--cizgi)"><td class="px-4 py-2.5">{a}</td><td class="px-4 py-2.5 mono whitespace-nowrap">{b}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </div>

  <section id="basvuru" class="bg-(--zemin-2) border-y border-(--cizgi) reveal" aria-labelledby="adim-baslik">
    <div class="kapsayici py-10 sm:py-14">
      <h2 id="adim-baslik">{m.adim.baslik}</h2>
      <p class="mt-2 max-w-[70ch] text-(--metin-2)">{m.adim.alt}</p>
      <ol class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {m.adim.liste.map((a, i) => <li class="kart p-5 flex gap-4"><span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-(--vurgu) font-serif text-xl font-bold text-(--color-krem)">{i + 1}</span><div><h3 class="text-lg leading-tight">{a.baslik}</h3><p class="mt-1.5 text-sm text-(--metin-2)">{a.metin}</p></div></li>)}
      </ol>
      <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
        <div><h3 class="text-xl">{m.adim.mulakatBaslik}</h3><p class="mt-2 max-w-[70ch]">{m.adim.mulakat}</p><p class="mt-2 text-sm text-(--metin-2)">{m.adim.sonuc}</p></div>
        <div class="kart-kagit p-5"><h3 class="text-lg">{m.adim.konuBaslik}</h3><ul class="mt-2 grid gap-1.5 list-disc pl-5 text-sm">{m.adim.konular.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section id="belcika" class="kapsayici py-10 sm:py-14 reveal" aria-labelledby="belcika-baslik">
    <h2 id="belcika-baslik">{m.belcika.baslik}</h2>
    <div class="mt-4 grid gap-8 lg:grid-cols-2">
      <div>
        <p class="max-w-[70ch]">{m.belcika.p1}</p>
        <ol class="mt-3 grid gap-2 list-decimal pl-5">{m.belcika.adimlar.map((x) => <li>{x}</li>)}</ol>
        <address class="kart-kagit mt-5 p-4 not-italic text-sm">
          <p class="font-semibold">{m.belcika.musavirlik.ad}</p>
          <p class="mt-1">{m.belcika.musavirlik.adres}</p>
          <p class="mt-1">{m.belcika.musavirlik.telEtiket}: <a href={tel(MUSAVIRLIK_TEL)} class="mono">{MUSAVIRLIK_TEL}</a></p>
          <p class="mt-2 text-(--metin-2)">{m.belcika.musavirlik.not}</p>
        </address>
      </div>
      <div class="kart p-5 sm:p-6">
        <h3 class="text-xl">{m.belcika.camiBaslik}</h3>
        <ul class="mt-3 grid gap-2.5">{m.belcika.cami.map((x) => <li class="flex gap-3"><Ikon ad="ok" class="mt-1 h-4 w-4 shrink-0 text-(--vurgu)" /><span>{x}</span></li>)}</ul>
        <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <a href={tel(site.telefon.dinGorevlisi)} class="inline-flex min-h-11 items-center gap-1.5 no-underline"><Ikon ad="telefon" class="h-4 w-4" /><span class="mono">{site.telefon.dinGorevlisi}</span></a>
          <a href={`mailto:${site.epostaDinGorevlisi ?? site.eposta}`} class="inline-flex min-h-11 items-center">{site.epostaDinGorevlisi ?? site.eposta}</a>
        </p>
      </div>
    </div>
  </section>

  <section id="belgeler" class="bg-(--zemin-2) border-y border-(--cizgi) reveal" aria-labelledby="belge-baslik">
    <div class="kapsayici py-10 sm:py-14">
      <h2 id="belge-baslik">{m.belge.baslik}</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        <div class="kart p-5"><h3 class="text-lg">{m.belge.basvuruBaslik}</h3><ul class="mt-3 grid gap-2 list-disc pl-5 text-sm">{m.belge.basvuru.map((x) => <li>{x}</li>)}</ul></div>
        <div class="kart p-5"><h3 class="text-lg">{m.belge.kayitBaslik}</h3><ul class="mt-3 grid gap-2 list-disc pl-5 text-sm">{m.belge.kayit.map((x) => <li>{x}</li>)}</ul></div>
      </div>
      <p class="uyari mt-4 text-sm">{m.belge.not}</p>
      <div id="taahhutname" class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
