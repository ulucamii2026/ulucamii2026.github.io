---
/**
 * Veli portalı — /tr/veli-portali/ · /fr/portail-parents/ · /en/parents-portal/ (noindex).
 * Kimlik: Firebase Authentication (e-posta bağlantısı → şifre belirleme; sonra e-posta + şifre). Veri: Cloud Firestore,
 * kurallar firebase/firestore.rules (veli yalnız kendi öğrencilerini okur). Uygulama: src/scripts/veli-portali.ts.
 * Sunucu tarafı yok; bu sayfa yalnız kabuk + yıllık planın küçültülmüş hâli (ders günleri, ezberler, materyal günleri).
 */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { veliMetni } from '../i18n/veli';
import plan from '../data/yillik-plan-2026-2027.json';
import materyal from '../data/ders-materyalleri.json';
interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil); const m = veliMetni(dil);

type PlanGun = { tarih: string; hafta: number; gun: string; dersler: { no?: number; sira?: number; alan: string; kod: string; konu: string; ezber?: string[] }[] };
const gunler = (plan as { gunler: PlanGun[] }).gunler.map((g) => ({
  tarih: g.tarih, hafta: g.hafta,
  dersler: g.dersler.map((d) => ({ no: d.sira ?? d.no ?? 0, kod: d.kod, alan: d.alan, konu: d.konu, ezber: d.ezber || [] })),
}));
const materyalGunleri = (materyal.gunler as { tarih: string }[]).map((g) => g.tarih);
const veri = { donem: (plan as { donem: string }).donem, gunler, materyalGunleri, materyalYolu: yol(dil, 'dersmateryalleri'), gizlilikYolu: yol(dil, 'gizlilik'), kursYolu: yol(dil, 'kurankursu'),
  dilYollari: { tr: yol('tr', 'veli'), fr: yol('fr', 'veli'), en: yol('en', 'veli') } };
---
<Base baslik={t('nav.veli')} dil={dil} aciklama={m.altBaslik} noindex>
  {/* Portal telefona kurulabilir olsun: her dilin kendi manifesti (start_url + kapsam o dilin yolu). */}
  <link slot="head" rel="manifest" href={`/portal/veli-${dil}.webmanifest`} />
  <link slot="head" rel="apple-touch-icon" href="/portal/ikon-192.png" />
  <meta slot="head" name="mobile-web-app-capable" content="yes" />
  <meta slot="head" name="apple-mobile-web-app-capable" content="yes" />
  <meta slot="head" name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta slot="head" name="apple-mobile-web-app-title" content={m.kisaAd} />
  <SayfaBasligi etiket={t('nav.kurankursu')} baslik={t('nav.veli')} altBaslik={m.altBaslik} />
  <div class="kapsayici py-10">
    {/* Duyurular yalnız bu küçük bölgeden yapılır; panonun tamamı canlı bölge olursa
        her yeniden çizimde tüm içerik baştan okunur (7 Eyl 2026 erişilebilirlik düzeltmesi). */}
    <div id="veli-durum" role="status" aria-live="polite" class="ekran-okuyucu"></div>
    <div id="veli-portal" data-dil={dil} class="portal">
      <p class="not">{m.yukleniyor}</p>
      <noscript><p class="not">Bu sayfa JavaScript gerektirir. · Cette page nécessite JavaScript. · This page requires JavaScript.</p></noscript>
    </div>
    <script is:inline type="application/json" id="veli-veri" set:html={JSON.stringify(veri)} />
    <p class="alt-baglantilar">
      <a href={yol(dil, 'kurankursu')} class="dugme dugme-ikincil">{m.kurs}</a>
      <a href={yol(dil, 'gizlilik')} class="dugme dugme-ikincil">{m.gizlilik}</a>
    </p>
  </div>
</Base>

<script>
  import { veliPortali } from '../scripts/veli-portali';
  veliPortali();
</script>

<style is:global>
  /* ============================================================ Veli portalı — Kilim Kartografyası
     Tasarım: ailenin kişisel «kurs defteri». Sıcak kilim paleti, Lora başlıklar, keskin 2px köşe,
     çizili tek-çizgi ikonlar. Durum renkleri tema-uyumlu (color-mix ile açık/koyu ikisinde de okunur). */
  .portal { --ay: 1.5rem;
    /* Bölüm renkleri: her kart kendi kilim rengini taşır (7 Eyl 2026 — «kutucuklar daha renkli olsun»).
       Renk kimliği yalnız şerit/başlık/ikon üzerindedir; gövde nötr kalır ki metin okunaklılığı düşmesin. */
    --r-kiremit: var(--vurgu); --r-iznik: var(--vurgu-2);
    --r-ochre: var(--color-ochre); --r-adacayi: var(--color-adacayi-koyu); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .portal { --r-ochre: var(--color-ochre-acik); --r-adacayi: var(--color-adacayi-acik); }
  }
  :root[data-theme="dark"] .portal { --r-ochre: var(--color-ochre-acik); --r-adacayi: var(--color-adacayi-acik); }

  /* yalnız ekran okuyucu için (canlı bölge) */
  .ekran-okuyucu { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  .portal .simge { width: 1.15em; height: 1.15em; flex: none; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; vertical-align: -0.16em; }

  /* --- bildirim satırları --- */
  .portal .not { margin: 0 0 1rem; padding: 0.8rem 1rem; background: var(--zemin-2); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); color: var(--metin-2); font-size: 0.92rem; }
  .portal .hata { border-color: color-mix(in oklab, var(--color-kiremit) 42%, var(--cizgi)); color: color-mix(in oklab, var(--color-kiremit) 72%, var(--metin)); background: color-mix(in oklab, var(--color-kiremit) 9%, var(--zemin)); }
  .portal .basari { border-color: color-mix(in oklab, var(--color-adacayi) 44%, var(--cizgi)); color: color-mix(in oklab, var(--color-adacayi) 66%, var(--metin)); background: color-mix(in oklab, var(--color-adacayi) 12%, var(--zemin)); }

  /* --- formlar --- */
  .portal label { display: block; font-size: 0.82rem; font-weight: 600; margin: 0.75rem 0 0.3rem; color: var(--metin); }
  .portal input[type=email], .portal input[type=password], .portal input[type=text], .portal input[type=date], .portal select, .portal textarea {
    width: 100%; padding: 0.62rem 0.8rem; border: 1px solid var(--cizgi-etkilesim); border-radius: var(--radius-kose); background: var(--zemin); color: var(--metin); font: inherit; transition: border-color .15s, box-shadow .15s; }
  .portal input:focus-visible, .portal select:focus-visible, .portal textarea:focus-visible { outline: none; border-color: var(--vurgu-2); box-shadow: 0 0 0 3px color-mix(in oklab, var(--vurgu-2) 26%, transparent); }
  .portal textarea { min-height: 5.5rem; resize: vertical; }
  .portal .dugme { cursor: pointer; }
  .portal .dugme[disabled] { opacity: 0.55; cursor: wait; }
  .portal .satir-dugmeler { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }

  /* --- giriş ekranı --- */
  .portal .giris-sar { max-width: 34rem; margin-inline: auto; }
  .portal .giris-hos { text-align: center; margin: 0 0 1.5rem; }
  .portal .giris-hos .simge-cerceve { display: inline-flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; border: 1px solid var(--cizgi); border-radius: 50%; background: var(--zemin-2); color: var(--vurgu); margin-bottom: 0.75rem; box-shadow: var(--shadow-kart); }
  .portal .giris-hos .simge { width: 1.5rem; height: 1.5rem; }
  .portal .giris-hos p { margin: 0.4rem 0 0; color: var(--metin-2); font-size: 0.95rem; line-height: 1.6; }
  .portal .giris-kart { background: var(--zemin); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); box-shadow: var(--shadow-kart); padding: 1.5rem 1.4rem; }
  .portal .giris-kart > h2 { display: flex; align-items: center; gap: 0.55rem; font-size: 1.2rem; margin: 0 0 0.3rem; }
  .portal .giris-kart > h2 .simge { color: var(--vurgu); }
  .portal .ayrac { display: flex; align-items: center; gap: 0.9rem; margin: 1.5rem 0 0; color: var(--metin-2); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: var(--tracking-etiket); text-transform: uppercase; }
  .portal .ayrac::before, .portal .ayrac::after { content: ""; flex: 1; height: 1px; background: var(--cizgi); }
  .portal .ilk-giris { margin-top: 1.25rem; }
  .portal .ilk-giris summary { cursor: pointer; font-weight: 600; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0; list-style: none; }
  .portal .ilk-giris summary::-webkit-details-marker { display: none; }
  .portal .ilk-giris summary .simge { color: var(--vurgu-2); transition: transform .2s; }
  .portal .ilk-giris[open] summary .simge { transform: rotate(90deg); }
  .portal .ilk-giris .giris-kart { margin-top: 0.2rem; box-shadow: none; background: var(--zemin-2); }
  .portal .ilk-giris .govde { padding-top: 0.6rem; }
  .portal .ilk-giris .govde p.kucuk { margin-top: 0; }

  /* --- pano başlığı (hero) --- */
  .portal .pano-hero { position: relative; overflow: hidden; background: var(--zemin-2); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); box-shadow: var(--shadow-kart); padding: 1.35rem 1.4rem 1.25rem; margin-bottom: var(--ay); }
  .portal .pano-hero .hero-serit { position: absolute; inset: 0 0 auto 0; height: 5px; background-image: linear-gradient(45deg, var(--vurgu) 25%, transparent 25%, transparent 50%, var(--vurgu) 50%, var(--vurgu) 75%, transparent 75%, transparent); background-size: 9px 9px; opacity: 0.85; }
  .portal .pano-hero .hero-ust { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 0.5rem 1rem; }
  .portal .pano-hero .selam { margin: 0.35rem 0 0; }
  .portal .pano-hero .selam small { display: block; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: var(--tracking-etiket); text-transform: uppercase; color: var(--metin-2); margin-bottom: 0.15rem; }
  .portal .pano-hero .cocuk-adi { font-family: var(--font-serif); font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.015em; margin: 0; }
  .portal .kunye-serit { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; margin-top: 1rem; padding-top: 0.95rem; border-top: 1px solid var(--cizgi); }
  .portal .kunye { display: flex; align-items: center; gap: 0.5rem; }
  .portal .kunye .simge { color: var(--vurgu-2); width: 1.25rem; height: 1.25rem; }
  .portal .kunye .k-deger { font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .portal .kunye .k-etiket { display: block; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--metin-2); }

  /* --- öğrenci değiştirici (segmentli) --- */
  .portal .cocuk-sec { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; background: var(--zemin-3); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); margin: 0 0 var(--ay); }
  .portal .cocuk-dugme { font: inherit; font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; border: 0; border-radius: 1px; background: transparent; color: var(--metin-2); cursor: pointer; transition: background .15s, color .15s; }
  .portal .cocuk-dugme:hover { color: var(--metin); }
  .portal .cocuk-dugme[aria-selected=true] { background: var(--zemin); color: var(--vurgu); box-shadow: var(--shadow-kart); }
  .portal .cocuk-dugme .simge { width: 1rem; height: 1rem; }

  /* --- bölümler --- */
  .portal .bolumler { display: grid; gap: var(--ay); grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  .portal .bolum { --br: var(--cizgi-etkilesim); position: relative; overflow: hidden; background: var(--zemin); border: 1px solid color-mix(in oklab, var(--br) 34%, var(--cizgi)); border-radius: var(--radius-kose); box-shadow: var(--shadow-kart); padding: 1.2rem 1.3rem; }
  .portal .bolum.r-kiremit { --br: var(--r-kiremit); }
  .portal .bolum.r-iznik { --br: var(--r-iznik); }
  .portal .bolum.r-ochre { --br: var(--r-ochre); }
  .portal .bolum.r-adacayi { --br: var(--r-adacayi); }
  /* kilim şeridi: kartın üst kenarında, bölümün rengiyle */
  .portal .bolum::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background-image: linear-gradient(45deg, var(--br) 25%, transparent 25%, transparent 50%, var(--br) 50%, var(--br) 75%, transparent 75%, transparent); background-size: 8px 8px; opacity: 0.9; }
  .portal .bolum.genis { grid-column: 1 / -1; }
  .portal .bolum-bas { display: flex; align-items: center; gap: 0.55rem; margin: -1.2rem -1.3rem 0.95rem; padding: 0.95rem 1.3rem 0.7rem; background: color-mix(in oklab, var(--br) 15%, var(--zemin)); border-bottom: 1px solid color-mix(in oklab, var(--br) 34%, var(--cizgi)); }
  .portal .bolum-bas .simge { width: 1.2rem; height: 1.2rem; color: var(--br); }
  .portal .bolum-bas h2 { font-size: 1.08rem; margin: 0; line-height: 1.2; color: color-mix(in oklab, var(--br) 68%, var(--metin)); }
  .portal .bolum-bas .sag { margin-left: auto; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in oklab, var(--br) 45%, var(--metin-2)); }
  /* yanıt bekleyen / öncelikli kart: kendi renginin daha güçlü hâli */
  .portal .bolum.oncelik { border-color: color-mix(in oklab, var(--br) 42%, var(--cizgi)); box-shadow: var(--shadow-kart), 0 0 0 1px color-mix(in oklab, var(--br) 18%, transparent); }
  .portal .bolum.oncelik::before { height: 6px; opacity: 1; }
  .portal .bolum.oncelik .bolum-bas { background: color-mix(in oklab, var(--br) 24%, var(--zemin)); }
  .portal .bolum h3 { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: var(--tracking-etiket); text-transform: uppercase; color: var(--metin-2); margin: 1.15rem 0 0.45rem; }
  .portal .bolum h3:first-of-type { margin-top: 0.6rem; }

  /* --- listeler --- */
  .portal .liste { list-style: none; margin: 0; padding: 0; }
  .portal .liste li { padding: 0.6rem 0; border-top: 1px solid var(--cizgi); display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; align-items: baseline; }
  .portal .liste li:first-child { border-top: 0; padding-top: 0; }
  .portal .kucuk { font-size: 0.85rem; color: var(--metin-2); }
  /* Ders kitabı / materyal kartı: yanıt bekleyen öğrenci varsa .oncelik ile vurgulanır. */
  .portal .kitap-satir { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; padding: 0.7rem 0; border-top: 1px solid var(--cizgi); }
  .portal .kitap-satir:first-of-type { border-top: none; }
  .portal .kitap-satir .ks-ad { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 11rem; }
  .portal .kitap-satir .ks-ad .simge { width: 1.05rem; height: 1.05rem; color: var(--vurgu-2); }
  .portal .ks-secenek { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .portal .ks-yanit { display: inline-flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .portal .ks-dugme { font-size: 0.85rem; font-weight: 600; line-height: 1.25; min-height: 2.35rem; padding: 0.4rem 0.8rem;
    border: 1px solid var(--cizgi-etkilesim); border-radius: var(--radius-kose); background: var(--zemin);
    color: var(--metin); cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
  .portal .ks-dugme:hover { border-color: var(--vurgu); color: var(--vurgu); background: color-mix(in oklab, var(--vurgu) 7%, var(--zemin)); }
  .portal .ks-dugme:focus-visible { outline: none; border-color: var(--vurgu-2); box-shadow: 0 0 0 3px color-mix(in oklab, var(--vurgu-2) 26%, transparent); }
  .portal .kitap-bilgi { margin-top: 0.9rem; padding-top: 0.85rem; border-top: 1px solid var(--cizgi); display: grid; gap: 0.5rem; }
  .portal .kitap-baglar { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; }
  .portal a.ic-bag { font-weight: 600; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 0.3rem; }

  /* --- bu hafta --- */
  .portal .hafta-gun { display: flex; flex-wrap: wrap; gap: 0.3rem 0.7rem; align-items: baseline; padding: 0.65rem 0; border-top: 1px solid var(--cizgi); }
  .portal .hafta-gun:first-child { border-top: 0; padding-top: 0; }
  .portal .hafta-gun .g-tarih { font-weight: 700; min-width: 6.5rem; }
  .portal .hafta-gun .g-dersler { flex: 1; min-width: 12rem; }
  .portal .hafta-gun .g-ders { display: block; padding: 0.1rem 0; }
  .portal .hafta-gun .g-ders .g-no { font-family: var(--font-mono); font-size: 0.7rem; color: var(--vurgu); font-weight: 600; }

  /* --- durum rozetleri (tema-uyumlu) --- */
  .portal .rozet { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 500; padding: 0.16rem 0.5rem; border-radius: var(--radius-kose); white-space: nowrap;
    --dr: var(--cizgi-etkilesim); background: color-mix(in oklab, var(--dr) 13%, var(--zemin)); color: color-mix(in oklab, var(--dr) 70%, var(--metin)); border: 1px solid color-mix(in oklab, var(--dr) 32%, var(--cizgi)); }
  .portal .rozet.var, .portal .rozet.ogrendi { --dr: var(--color-adacayi); }
  .portal .rozet.yok { --dr: var(--color-kiremit); }
  .portal .rozet.mazeret, .portal .rozet.tekrar { --dr: var(--color-ochre); }
  .portal .rozet.gec { --dr: var(--color-iznik); }
  .portal .rozet.baslamadi { --dr: var(--metin-2); }
  .portal .rozet.derece { --dr: var(--vurgu-2); }

  /* --- devam durumu --- */
  .portal .yoklama-liste { display: flex; flex-direction: column; margin-top: 0.3rem; }
  .portal .yoklama-gun { padding: 0.6rem 0; border-top: 1px solid var(--cizgi); }
  .portal .yoklama-gun:first-child { border-top: 0; padding-top: 0; }
  .portal .yoklama-gun .yg-tarih { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .portal .yoklama-gun .yg-dersler { display: flex; flex-direction: column; gap: 0.3rem; }
  .portal .ders-kayit { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
  .portal .ders-kayit .dk-ad { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--metin); }
  .portal .ders-kayit .dk-no { display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; flex: none; border-radius: var(--radius-kose); background: var(--zemin-3); border: 1px solid var(--cizgi); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; color: var(--metin-2); }
  .portal .yoklama-gun .yg-not { display: flex; align-items: flex-start; gap: 0.4rem; margin: 0.5rem 0 0 1.85rem; font-size: 0.85rem; color: var(--metin-2); }
  .portal .yoklama-gun .yg-not .simge { width: 0.9rem; height: 0.9rem; flex: none; margin-top: 0.12rem; color: var(--metin-2); }
  .portal .devam-ozet { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0 0 0.9rem; }
  .portal .devam-ozet span { display: inline-flex; align-items: baseline; gap: 0.3rem; font-size: 0.85rem; color: var(--metin-2); }
  .portal .devam-ozet span b { font-size: 1.05rem; color: var(--metin); font-variant-numeric: tabular-nums; }

  /* --- ilerleme --- */
  .portal .ilerleme-not { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.4rem; }
  .portal .ilerleme-not b { font-family: var(--font-serif); font-size: 1.05rem; }
  .portal .cubuk { height: 0.5rem; background: var(--zemin-3); border-radius: 999px; overflow: hidden; border: 1px solid var(--cizgi); }
  .portal .cubuk > span { display: block; height: 100%; background: linear-gradient(90deg, var(--vurgu), color-mix(in oklab, var(--vurgu) 60%, var(--color-ochre))); border-radius: 999px; }
  .portal .dereceler { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 0.6rem; }
  .portal .derece { padding: 0.6rem 0.7rem; border: 1px solid var(--cizgi); border-radius: var(--radius-kose); background: var(--zemin-2); }
  .portal .derece b { display: block; font-size: 0.9rem; margin-bottom: 0.35rem; }
  .portal .pipler { display: inline-flex; gap: 3px; vertical-align: middle; }
  .portal .pip { width: 0.9rem; height: 0.32rem; border-radius: 1px; background: var(--zemin-3); border: 1px solid var(--cizgi); }
  .portal .pip.dolu { background: var(--vurgu); border-color: transparent; }
