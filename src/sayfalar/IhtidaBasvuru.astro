---
/** İhtida online başvuru sayfası — 30 Ağustos 2026 v2: Preact adası yerine statik Astro bileşeni
    (src/components/formlar/IhtidaFormu.astro) + hafif betik. PDF sunucuda (Apps Script) üretilir. */
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import IhtidaFormu from '../components/formlar/IhtidaFormu.astro';
import { ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { formMetinleri } from '../i18n/formlar';
import { siteAyarlari } from '../lib/icerik';
import '../styles/formlar.css';

interface Props { dil: Dil }
const { dil } = Astro.props; const t = ceviri(dil);
const m = formMetinleri(dil);
const site = await siteAyarlari();
---
<Base baslik={t('nav.ihtidaBasvuru')} dil={dil} aciklama={m.ihtida.sayfaAciklama} noindex>
  <SayfaBasligi etiket={t('nav.ihtida')} baslik={m.ihtida.sayfaBaslik} />
  <section class="kapsayici py-10 sm:py-14" style="max-width: 52rem">
    <IhtidaFormu dil={dil} uc={site.servisler.basvuru} eposta={site.epostaDinGorevlisi ?? site.eposta ?? 'info@ulucamii.be'}
      telefon={site.telefon.dinGorevlisi} ek10Yolu="/belgeler/ihtida/ek10-kvkk-acik-riza-metni.pdf" />
  </section>
</Base>
