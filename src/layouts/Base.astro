---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { dilBul, ceviri, digerDilYolu, dilListesi, hreflangKodu } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { siteAyarlari } from '../lib/icerik';

interface Props {
  baslik: string;
  aciklama?: string;
  dil?: Dil;
  kapak?: string;
  /** Arama motorları için gizle (portal, admin) */
  noindex?: boolean;
  /** Sayfanın dilini ziyaretçinin tercihi olarak kaydet. /kayit/ hariç her sayfada açık:
      orada iskelet her zaman Türkçe derlenir, dil formun kendi anahtarıyla yönetilir. */
  dilHatirla?: boolean;
  /** og:type — duyuru/etkinlik detay sayfaları "article" ister, geri kalan "website". */
  ogTuru?: 'website' | 'article';
  /** Sayfaya özel yapısal veri (Event/NewsArticle/BreadcrumbList…) — kurumJsonLd'nin yanına eklenir. */
  ekJsonLd?: object[];
}
const dil: Dil = Astro.props.dil ?? dilBul(Astro.url);
const t = ceviri(dil);
/* Paylaşım görseli (WhatsApp/Facebook): sayfanın kendi görseli varsa o, yoksa camimizin
   logolu kartı (public/media/og/, 1200x630, üç dil). 27 Ağustos 2026'ya kadar varsayılan
   ana sayfanın cami fotoğrafıydı; bu yüzden yönetim kurulu gibi ilgisiz sayfaların
   önizlemesinde de o fotoğraf çıkıyordu. */
const ogKart = `/media/og/ulu-camii-${dil}.png`;
const { baslik, aciklama = t('site.slogan'), kapak = ogKart, noindex = false, dilHatirla = true, ogTuru = 'website', ekJsonLd = [] } = Astro.props;
/** Yalnız ana sayfada masaüstü hero görselini erkenden bildir (LCP); afis/1600px görsel büyük olduğu için mobil kırpmasını değil bunu hedefler. */
const anaSayfaMi = /^\/(tr|fr|en)\/$/.test(Astro.url.pathname);
const tamBaslik = baslik === t('site.ad') ? baslik : `${baslik} — ${t('site.ad')}`;
/** Arama motoru açıklaması: 155 karakteri aşarsa kelime sınırında kısalt */
const metaAciklama = aciklama.length <= 155 ? aciklama : aciklama.slice(0, 152).replace(/\s+\S*$/, '') + '…';
const kanonik = new URL(Astro.url.pathname, Astro.site);
const kapakUrl = new URL(kapak, Astro.site);
const ogKartMi = kapak === ogKart;
const atlaEtiketi: Record<Dil, string> = { tr: 'İçeriğe atla', fr: 'Aller au contenu', en: 'Skip to content' };
/* Kurumsal kimlik (schema.org) — her sayfada. Derneğin BCE/KBO numarası, hukuki formu ve
   resmî sicil kaydı makine tarafından okunabilir olsun diye eklendi (30 Ağu 2026): güvenlik
   süzgeçleri ve arama motorları için "kayıtlı, gerçek kurum" kanıtı. Değerler site.yaml'dan. */
const a = await siteAyarlari();
const kboSade = a.kbo.replace(/\D/g, '');
const kurumJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'NGO', 'ReligiousOrganization'],
  '@id': new URL('/#kurum', Astro.site).toString(),
  name: t('site.ad'),
  legalName: `${a.dernekAdi} ${a.hukukiForm}`,
  description: t('site.slogan'),
  url: Astro.site?.toString(),
  logo: new URL('/media/og/ulu-camii-tr.png', Astro.site).toString(),
  foundingDate: '1979-12-19',
  identifier: [
    { '@type': 'PropertyValue', name: 'BCE/KBO', value: a.kbo, description: "Banque-Carrefour des Entreprises (Belgique) — numéro d'entreprise" },
  ],
  address: { '@type': 'PostalAddress', streetAddress: a.adres.sokak, postalCode: a.adres.posta, addressLocality: a.adres.sehir, addressCountry: 'BE' },
  telephone: a.telefon.cami,
  email: a.eposta,
  sameAs: [
    `https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html?ondernemingsnummer=${kboSade}`,
    a.sosyal?.facebook,
  ].filter(Boolean),
};
---
<!doctype html>
<html lang={hreflangKodu(dil)} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="YI2ycuDYGGMjh_ifF9tQWyxzhsnnBQBfCoB1gUQQApA" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={metaAciklama} />
    <link rel="canonical" href={kanonik} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {dilListesi.map((d) => <link rel="alternate" hreflang={hreflangKodu(d)} href={new URL(digerDilYolu(Astro.url, d), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(digerDilYolu(Astro.url, 'tr'), Astro.site)} />
    {/* Simge zinciri. SVG simgeyi desteklemeyen istemciler (WhatsApp, eski tarayıcılar,
        besleme okuyucuları, yer imi araçları) doğrudan /favicon.ico ister; 27 Ağustos
        2026'ya kadar orada Astro şablonunun kendi simgesi duruyordu ve paylaşım
        önizlemelerinde bağlantının yanında o çıkıyordu. apple-touch-icon da opak
        olmalı — iOS saydam pikselleri siyaha çeviriyor. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {anaSayfaMi && (
      <>
        {/* HeroSlayt.astro'daki <picture>/<source> ile birebir eşleşen iki preload:
            mobil dikey kırpma vs. diğer tüm durumlar (masaüstü kırpma). srcset yok
            çünkü gerçek <picture> de kullanmıyor — tek href, gerçek seçimle örtüşüyor. */}
        <link rel="preload" as="image" href="/media/hero/hero-1-m.webp" fetchpriority="high"
              media="(max-width: 720px) and (orientation: portrait)" />
        <link rel="preload" as="image" href="/media/hero/hero-1.webp" fetchpriority="high"
              media="not ((max-width: 720px) and (orientation: portrait))" />
      </>
    )}
    <meta name="theme-color" content="#b5452b" />
    <meta property="og:type" content={ogTuru} />
    <meta property="og:site_name" content={t('site.ad')} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={metaAciklama} />
    <meta property="og:image" content={kapakUrl} />
    {ogKartMi && (
      <Fragment>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t('site.ad')} />
      </Fragment>
    )}
    <meta property="og:url" content={kanonik} />
    <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : dil === 'en' ? 'en_GB' : 'fr_BE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={kapakUrl} />
    <noscript><style>.reveal, .serit, .hero-giris > * { opacity: 1 !important; transform: none !important; animation: none !important; }</style></noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(kurumJsonLd)} />
    {ekJsonLd.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
    <script is:inline>
      // Tema tercihi (localStorage) — sayfa boyanmadan önce uygula
      document.documentElement.classList.add('js');
      try { const t = localStorage.getItem('tema'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch {}
    </script>
    {dilHatirla && (
      <script is:inline define:vars={{ sayfaDili: dil }}>
        /* Ziyaretçinin en son hangi dilde gezdiğini saklar; kök adres (/) bunu tarayıcı
           dilinden önce dikkate alır. Böylece Fransızca gezen biri /'ye dönünce Türkçe'ye
           düşmez (26 Ağu 2026). */
        try { localStorage.setItem('uluCamiiSiteDili', sayfaDili); } catch (e) { /* depolama kapalı */ }
      </script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-(--zemin) focus:px-4 focus:py-2 focus:border focus:border-(--cizgi)">{atlaEtiketi[dil]}</a>
    <Header dil={dil} />
    <main id="icerik" class="flex-1">
      <slot />
    </main>
    <Footer dil={dil} />
    <Lightbox dil={dil} />
    <!-- Menü/tema, lightbox ve bölüm-reveal mantığı: tek harici dosya, tarayıcı önbelleğe alır
         (400 sayfada birebir aynı inline betiği tekrarlamamak için, performans denetimi Eylül 2026). -->
    <script is:inline defer src="/vendor/govde.js"></script>
    <!-- Çerezsiz, anonim ziyaret sayacı (GoatCounter) — ayrıntı gizlilik sayfasında -->
    <script is:inline data-goatcounter="https://ulucamii.goatcounter.com/count" async src="/vendor/sayac.js"></script>
  </body>
</html>
