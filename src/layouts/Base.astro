---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { dilBul, ceviri, digerDilYolu, dilListesi, hreflangKodu } from '../i18n/utils';
import type { Dil } from '../i18n/ui';

interface Props {
  baslik: string;
  aciklama?: string;
  dil?: Dil;
  kapak?: string;
  /** Arama motorları için gizle (portal, admin) */
  noindex?: boolean;
  /** Sayfanın dilini ziyaretçinin tercihi olarak kaydet. /kayit/ hariç her sayfada açık:
      orada iskelet her zaman Türkçe derlenir, dil formun kendi anahtarıyla yönetilir. */
  dilHatirla?: boolean;
}
const dil: Dil = Astro.props.dil ?? dilBul(Astro.url);
const t = ceviri(dil);
/* Paylaşım görseli (WhatsApp/Facebook): sayfanın kendi görseli varsa o, yoksa camimizin
   logolu kartı (public/media/og/, 1200x630, üç dil). 27 Ağustos 2026'ya kadar varsayılan
   ana sayfanın cami fotoğrafıydı; bu yüzden yönetim kurulu gibi ilgisiz sayfaların
   önizlemesinde de o fotoğraf çıkıyordu. */
const ogKart = `/media/og/ulu-camii-${dil}.png`;
const { baslik, aciklama = t('site.slogan'), kapak = ogKart, noindex = false, dilHatirla = true } = Astro.props;
const tamBaslik = baslik === t('site.ad') ? baslik : `${baslik} — ${t('site.ad')}`;
/** Arama motoru açıklaması: 155 karakteri aşarsa kelime sınırında kısalt */
const metaAciklama = aciklama.length <= 155 ? aciklama : aciklama.slice(0, 152).replace(/\s+\S*$/, '') + '…';
const kanonik = new URL(Astro.url.pathname, Astro.site);
const kapakUrl = new URL(kapak, Astro.site);
const ogKartMi = kapak === ogKart;
const atlaEtiketi: Record<Dil, string> = { tr: 'İçeriğe atla', fr: 'Aller au contenu', en: 'Skip to content' };
---
<!doctype html>
<html lang={hreflangKodu(dil)} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="YI2ycuDYGGMjh_ifF9tQWyxzhsnnBQBfCoB1gUQQApA" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={metaAciklama} />
    <link rel="canonical" href={kanonik} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {dilListesi.map((d) => <link rel="alternate" hreflang={hreflangKodu(d)} href={new URL(digerDilYolu(Astro.url, d), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(digerDilYolu(Astro.url, 'tr'), Astro.site)} />
    {/* Simge zinciri. SVG simgeyi desteklemeyen istemciler (WhatsApp, eski tarayıcılar,
        besleme okuyucuları, yer imi araçları) doğrudan /favicon.ico ister; 27 Ağustos
        2026'ya kadar orada Astro şablonunun kendi simgesi duruyordu ve paylaşım
        önizlemelerinde bağlantının yanında o çıkıyordu. apple-touch-icon da opak
        olmalı — iOS saydam pikselleri siyaha çeviriyor. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#b5452b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.ad')} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={metaAciklama} />
    <meta property="og:image" content={kapakUrl} />
    {ogKartMi && (
      <Fragment>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t('site.ad')} />
      </Fragment>
    )}
    <meta property="og:url" content={kanonik} />
    <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : dil === 'en' ? 'en_GB' : 'fr_BE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={kapakUrl} />
    <noscript><style>.reveal, .hero-giris > * { opacity: 1 !important; transform: none !important; animation: none !important; }</style></noscript>
    <slot name="head" />
    <script is:inline>
      // Tema tercihi (localStorage) — sayfa boyanmadan önce uygula
      document.documentElement.classList.add('js');
      try { const t = localStorage.getItem('tema'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch {}
    </script>
    {dilHatirla && (
      <script is:inline define:vars={{ sayfaDili: dil }}>
        /* Ziyaretçinin en son hangi dilde gezdiğini saklar; kök adres (/) bunu tarayıcı
           dilinden önce dikkate alır. Böylece Fransızca gezen biri /'ye dönünce Türkçe'ye
           düşmez (26 Ağu 2026). */
        try { localStorage.setItem('uluCamiiSiteDili', sayfaDili); } catch (e) { /* depolama kapalı */ }
      </script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-(--zemin) focus:px-4 focus:py-2 focus:border focus:border-(--cizgi)">{atlaEtiketi[dil]}</a>
    <Header dil={dil} />
    <main id="icerik" class="flex-1">
      <slot />
    </main>
    <Footer dil={dil} />
    <Lightbox dil={dil} />
    <script>
      // Bölüm reveal: görünür olunca .gorunur; reduced-motion'da CSS zaten devre dışı, JS yalnız sınıfı ekler
      const r = document.querySelectorAll('.reveal');
      if (r.length) {
        // emniyet: gözlemci ne olursa olsun 2,5 sn içinde her şey görünür
        setTimeout(() => r.forEach((e) => e.classList.add('gorunur')), 2500);
        if (!('IntersectionObserver' in window)) r.forEach((e) => e.classList.add('gorunur'));
        else { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('gorunur'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }); r.forEach((e) => io.observe(e)); }
      }
    </script>
    <!-- Çerezsiz, anonim ziyaret sayacı (GoatCounter) — ayrıntı gizlilik sayfasında -->
    <script is:inline data-goatcounter="https://ulucamii.goatcounter.com/count" async src="/vendor/sayac.js"></script>
  </body>
</html>
