---
/**
 * Din görevlisinin WhatsApp bağlantısı. Sitede telefon NUMARASI gösterilmez; yalnız WhatsApp
 * kullanıcı adı (@…) görünür. WhatsApp kullanıcı adlarının herkese açık tıklanabilir bağlantısı
 * olmadığı için (kullanıcı adları yalnız uygulama içinde aranır), tıklama wa.me/<numara> ile
 * sohbeti açar — numara yalnız bağlantı hedefinde bulunur, sayfada yazılı gösterilmez.
 * Veri: site.yaml → whatsapp { kullanici, numara }.
 */
interface Props { site: any; buyuk?: boolean; class?: string }
const { site, buyuk = false, class: cls = '' } = Astro.props;
const wa = site?.whatsapp;
const url = wa?.numara ? 'https://wa.me/' + String(wa.numara).replace(/\D/g, '') : null;
const kullanici = wa?.kullanici ? '@' + String(wa.kullanici).replace(/^@/, '') : null;
const boyut = buyuk ? 20 : 17;
// Yedek: whatsapp tanımlı değilse eski telefon bağlantısına düş (numara bir daha kaybolmasın).
const tel = site?.telefon?.dinGorevlisi;
---
{url && kullanici ? (
  <a
    href={url}
    target="_blank"
    rel="noopener"
    title={`WhatsApp: ${kullanici}`}
    class:list={['wa-bag', buyuk ? 'wa-bag--buyuk' : '', cls]}
  >
    <svg viewBox="0 0 24 24" width={boyut} height={boyut} fill="#25D366" aria-hidden="true" focusable="false">
      <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.02ZM12.05 20.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.98-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.48-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.41-.56-.42l-.48-.01c-.16 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
    </svg>
    <span>{kullanici}</span>
  </a>
) : tel ? (
  <a href={'tel:' + tel.replace(/\s+/g, '')} class:list={['mono', cls]}>{tel}</a>
) : null}

<style>
  .wa-bag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-block: -0.5rem;
    padding-block: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .wa-bag--buyuk { font-size: 1.125rem; }
  .wa-bag svg { flex-shrink: 0; }
  .wa-bag span { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  .wa-bag:hover span { text-decoration: none; }
</style>
