---
/** Çok kanallı bağış bandı: IBAN + QR + amaç bağlantıları — dürüst (hedef/ilerleme çubuğu yok) */
import QRCode from 'qrcode';
import Ikon from './Ikon.astro';
import { yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil; banka: { iban: string; bic: string; banka: string; hesapAdi: string } }
const { dil, banka } = Astro.props;
const ibanDuz = banka.iban.replace(/\s+/g, '');
const aciklama = dil === 'tr' ? 'Bagis Ulu Camii Marche' : 'Don Ulu Camii Marche';
const epc = ['BCD', '002', '1', 'SCT', banka.bic, banka.hesapAdi.normalize('NFD').replace(/[̀-ͯ]/g, '').slice(0, 70), ibanDuz, '', '', '', aciklama].join('\n');
const qr = await QRCode.toString(epc, { type: 'svg', errorCorrectionLevel: 'M', margin: 0, color: { dark: '#2f221a', light: '#0000' } });
const m = dil === 'tr' ? {
  baslik: 'Camimiz cemaatin bağışlarıyla ayakta', alt: 'Elektrik, ısınma, bakım ve Kur’an kursu giderleri yalnızca sizin katkılarınızla karşılanıyor. Bankacılık uygulamanızla kodu okutun ya da IBAN’ı kopyalayın.',
  kopyala: 'IBAN’ı kopyala', kopyalandi: 'Kopyalandı ✓', qr: 'Bankacılık uygulamasıyla okutun', acik: 'Açıklama',
  yollar: [{ a: 'Genel bağış', s: 'Caminin aylık giderleri', h: yol(dil, 'bagis') }, { a: 'Vekâletle kurban', s: 'Her yıl Kurban Bayramı öncesi', h: yol(dil, 'bagis') + '#vekaletle-kurban' }, { a: 'Kütüphaneye kitap', s: 'TDV ve Diyanet yayınları', h: yol(dil, 'bagis') + '#kitap-bagisi' }, { a: 'Dernek üyeliği', s: 'Yıllık aidatla destek', h: yol(dil, 'uyelik') }],
  hepsi: 'Bağış sayfası',
} : {
  baslik: 'Notre mosquée vit des dons de la communauté', alt: 'Électricité, chauffage, entretien et école coranique ne sont financés que par vos contributions. Scannez le code avec votre application bancaire ou copiez l’IBAN.',
  kopyala: 'Copier l’IBAN', kopyalandi: 'Copié ✓', qr: 'Scannez avec votre application bancaire', acik: 'Communication',
  yollar: [{ a: 'Don général', s: 'Frais mensuels de la mosquée', h: yol(dil, 'bagis') }, { a: 'Sacrifice par procuration', s: 'Chaque année avant l’Aïd al-Adha', h: yol(dil, 'bagis') + '#vekaletle-kurban' }, { a: 'Livres pour la bibliothèque', s: 'Éditions TDV et Diyanet', h: yol(dil, 'bagis') + '#kitap-bagisi' }, { a: 'Adhésion', s: 'Soutien par la cotisation annuelle', h: yol(dil, 'uyelik') }],
  hepsi: 'Page des dons',
};
---
<section class="relative overflow-hidden bg-(--color-ceviz-koyu) text-(--color-krem)" aria-labelledby="bagis-baslik">
  <div class="kilim-serit" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none [background-image:radial-gradient(var(--color-ochre-acik)_1px,transparent_1px)] [background-size:14px_14px]" aria-hidden="true"></div>
  <div class="kapsayici relative py-14 sm:py-20 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-center">
    <div>
      <h2 id="bagis-baslik" class="text-(--color-krem) max-w-[22ch]">{m.baslik}</h2>
      <p class="mt-4 max-w-[58ch] text-(--color-krem)/80">{m.alt}</p>
      <ul class="mt-8 grid sm:grid-cols-2 gap-3" role="list">
        {m.yollar.map((y) => (
          <li><a href={y.h} class="group flex items-center gap-3 border border-(--color-krem)/25 rounded-(--radius-kose) px-4 py-3 no-underline text-(--color-krem) hover:border-(--color-ochre-acik) hover:bg-(--color-krem)/5 transition-colors">
            <Ikon ad="bagis" class="h-5 w-5 shrink-0 text-(--color-ochre-acik)" />
            <span class="min-w-0"><span class="block font-semibold">{y.a}</span><span class="block text-sm text-(--color-krem)/70">{y.s}</span></span>
            <Ikon ad="ok" class="ml-auto h-4 w-4 shrink-0 opacity-60 transition-transform group-hover:translate-x-1" />
          </a></li>
        ))}
      </ul>
    </div>
    <div class="grid sm:grid-cols-[auto_minmax(0,1fr)] gap-6 items-center bg-(--color-krem) text-(--color-murekkep) rounded-(--radius-kose) p-5 sm:p-6 shadow-[0_24px_48px_-24px_rgba(0,0,0,.6)]">
      <figure class="mx-auto w-40 sm:w-44 [&_svg]:w-full [&_svg]:h-auto" role="img" aria-label={m.qr} set:html={qr} />
      <div class="min-w-0">
        <p class="etiket">IBAN</p>
        <p class="mono text-lg sm:text-xl font-medium select-all break-words" id="bagis-iban">{banka.iban}</p>
        <p class="mt-1 text-sm text-(--metin-2)">{banka.banka} · BIC <span class="mono">{banka.bic}</span></p>
        <p class="mt-1 text-sm text-(--metin-2)">{m.acik}: <span class="mono">{aciklama}</span></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" class="dugme dugme-birincil iban-kopyala" data-iban={ibanDuz} data-kopyalandi={m.kopyalandi}>{m.kopyala}</button>
          <a href={yol(dil, 'bagis')} class="dugme dugme-ikincil">{m.hepsi}</a>
        </div>
        <p class="etiket mt-3">{m.qr}</p>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.iban-kopyala').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.iban ?? ''); const eski = b.textContent; b.textContent = b.dataset.kopyalandi ?? 'OK'; setTimeout(() => (b.textContent = eski), 2000); } catch {}
  }));
</script>
