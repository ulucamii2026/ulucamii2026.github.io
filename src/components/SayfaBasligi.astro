---
/** Sayfa üst bloğu: etiket, başlık, alt başlık; isteğe bağlı arka plan görseli */
interface Props { etiket?: string; baslik: string; altBaslik?: string; kapak?: string; kapakAlt?: string }
const { etiket, baslik, altBaslik, kapak, kapakAlt = '' } = Astro.props;
---
<header class="relative border-b border-(--cizgi) bg-(--zemin-2) overflow-hidden">
  {kapak && <img src={kapak} alt={kapakAlt} class="absolute inset-0 h-full w-full object-cover opacity-20 [filter:sepia(.3)_saturate(1.1)]" loading="eager" />}
  <div class="kapsayici relative py-12 sm:py-16">
    {etiket && <p class="etiket etiket-vurgu mb-2">{etiket}</p>}
    <h1>{baslik}</h1>
    <span class="serit" aria-hidden="true"></span>
    {altBaslik && <p class="mt-3 text-lg text-(--metin-2) max-w-[60ch]">{altBaslik}</p>}
    <slot />
  </div>
  <div class="kilim-serit" aria-hidden="true"></div>
</header>
