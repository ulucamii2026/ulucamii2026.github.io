---
/** Sayfa üst bloğu: etiket, başlık, alt başlık; isteğe bağlı arka plan görseli */
/** icerikDil: başlık/alt başlık sayfa dilinden farklı bir dilde yazılmışsa (ör. en/nl/de duyuru sayfasında Fransızca) BCP 47 kodu, örn. «fr-BE» */
interface Props { etiket?: string; baslik: string; altBaslik?: string; kapak?: string; kapakAlt?: string; icerikDil?: string }
const { etiket, baslik, altBaslik, kapak, kapakAlt = '', icerikDil } = Astro.props;
---
<header class="relative border-b border-(--cizgi) bg-(--zemin-2) overflow-hidden">
  {kapak && (kapakAlt ? (
    <img src={kapak} alt={kapakAlt} class="absolute inset-0 h-full w-full object-cover opacity-20 [filter:sepia(.3)_saturate(1.1)]" loading="eager" fetchpriority="high" />
  ) : (
    <img src={kapak} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-20 [filter:sepia(.3)_saturate(1.1)]" loading="eager" fetchpriority="high" />
  ))}
  <div class="kapsayici relative py-12 sm:py-16">
    {etiket && <p class="etiket etiket-vurgu mb-2">{etiket}</p>}
    <h1 lang={icerikDil}>{baslik}</h1>
    <span class="serit" aria-hidden="true"></span>
    {altBaslik && <p class="mt-3 text-lg text-(--metin-2) max-w-[60ch]" lang={icerikDil}>{altBaslik}</p>}
    <slot />
  </div>
  <div class="kilim-serit" aria-hidden="true"></div>
</header>
