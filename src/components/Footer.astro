---
import { getEntry } from 'astro:content';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;
const t = ceviri(dil);
const site = (await getEntry('ayarlar', 'site'))!.data;
const yil = new Date().getFullYear();
const adresSatir = `${site.adres.sokak}, ${site.adres.posta} ${site.adres.sehir}`;
const haritaUrl = `https://www.openstreetmap.org/?mlat=${site.gps.enlem}&mlon=${site.gps.boylam}#map=17/${site.gps.enlem}/${site.gps.boylam}`;
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
---
<footer class="mt-16 border-t border-(--cizgi) bg-(--zemin-2)">
  <div class="kilim-serit kilim-serit-iznik" aria-hidden="true"></div>
  <div class="kapsayici py-12 grid gap-10 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src="/media/logo/ulu-camii-logo.svg" alt="" width="56" height="56" class="h-14 w-14" />
        <div>
          <p class="font-serif font-semibold text-lg leading-tight">{t('site.ad')}</p>
          <p class="etiket">1979 · 1986 · {yil}</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-(--metin-2) max-w-prose">{t('site.slogan')}</p>
      {site.sosyal.facebook && <p class="mt-3 text-sm"><a href={site.sosyal.facebook} rel="noopener" target="_blank">Facebook<span aria-hidden="true"> ↗</span></a></p>}
    </div>
    <div>
      <h2 class="etiket etiket-vurgu mb-3 text-base">{t('footer.iletisim')}</h2>
      <address class="not-italic text-sm leading-7">
        <span class="block"><span class="etiket">{t('footer.adres')}</span><br />{adresSatir}, {site.adres.ulke} · <a href={haritaUrl} rel="noopener" target="_blank">{t('genel.harita')}</a></span>
        <span class="block mt-2"><span class="etiket">{t('footer.dingorevlisi')}</span><br /><a href={tel(site.telefon.dinGorevlisi)} class="mono">{site.telefon.dinGorevlisi}</a></span>
        <span class="block mt-2"><span class="etiket">{t('footer.cami')}</span><br /><a href={tel(site.telefon.cami)} class="mono">{site.telefon.cami}</a></span>
        {site.eposta && <span class="block mt-2"><span class="etiket">{t('genel.eposta')}</span><br /><a href={`mailto:${site.eposta}`}>{site.eposta}</a></span>}
      </address>
    </div>
    <div>
      <h2 class="etiket etiket-vurgu mb-3 text-base">{t('footer.yasal')}</h2>
      <p class="text-sm leading-7">
        <strong>{site.dernekAdi}</strong> ({site.kisaltma})<br />
        {site.hukukiForm} · KBO/BCE <span class="mono">{site.kbo}</span><br />
        {adresSatir}, {site.adres.ulke}
      </p>
      <ul class="mt-3 text-sm leading-8">
        <li><a href={yol(dil, 'vefat')}>{t('vefat.baslik')}</a></li>
        <li><a href={yol(dil, 'kunye')}>{t('footer.kunye')}</a></li>
        <li><a href={yol(dil, 'gizlilik')}>{t('footer.gizlilik')}</a></li>
        <li><a href={yol(dil, 'portal')}>{t('nav.portal')}</a></li>
        <li><a href="/admin/" rel="nofollow">{t('footer.yonetim')}</a></li>
      </ul>
    </div>
  </div>
  <div class="cetvel">
    <p class="kapsayici py-4 etiket flex flex-wrap justify-between gap-2">
      <span>© {yil} {site.kisaltma} · {t('footer.hak')}</span>
      <span>Marche-en-Famenne · Belgique</span>
    </p>
  </div>
</footer>
