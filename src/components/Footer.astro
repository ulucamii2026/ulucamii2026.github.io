---
import { getEntry } from 'astro:content';
import { ceviri, yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;
const t = ceviri(dil);
const site = (await getEntry('ayarlar', 'site'))!.data;
const yil = new Date().getFullYear();
const adresSatir = `${site.adres.sokak}, ${site.adres.posta} ${site.adres.sehir}`;
const haritaUrl = `https://www.openstreetmap.org/?mlat=${site.gps.enlem}&mlon=${site.gps.boylam}#map=17/${site.gps.enlem}/${site.gps.boylam}`;
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const diyanetBaslik = dil === 'tr' ? 'Diyanet' : dil === 'en' ? 'Diyanet' : 'Diyanet';
const diyanetLinkler = [
  { h: 'https://www.diyanet.tv/canli-izle', ad: dil === 'tr' ? 'Diyanet TV canlı yayın' : dil === 'en' ? 'Diyanet TV live' : 'Diyanet TV en direct', logo: '/media/dis-logolar/diyanet-tv.png', g: 135, y: 36 },
  { h: 'https://www.diyanet.gov.tr', ad: dil === 'tr' ? 'Diyanet İşleri Başkanlığı' : dil === 'en' ? 'Presidency of Religious Affairs (Türkiye)' : 'Présidence des Affaires religieuses (Türkiye)', logo: '/media/dis-logolar/diyanet.png', g: 36, y: 36 },
  { h: 'https://www.diyanet.be', ad: dil === 'tr' ? 'Belçika Diyanet Vakfı' : dil === 'en' ? 'Diyanet Foundation of Belgium' : 'Fondation Diyanet de Belgique', logo: '/media/dis-logolar/bdv.png', g: 143, y: 36 },
];
const siteLinkleri = [
  { h: yol(dil, 'vefat'), ad: t('vefat.baslik') },
  { h: yol(dil, 'kunye'), ad: t('footer.kunye') },
  { h: yol(dil, 'gizlilik'), ad: t('footer.gizlilik') },
  { h: yol(dil, 'portal'), ad: t('nav.portal') },
];
---
<footer class="vt-altbilgi mt-14 border-t border-(--cizgi) bg-(--zemin-2)">
  <div class="kilim-serit kilim-serit-iznik" aria-hidden="true"></div>
  <div class="kapsayici py-8 grid gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <div class="flex items-center gap-3">
        <img src="/media/logo/ulu-camii-logo.svg" alt="" width="44" height="44" class="logo-amblem h-11 w-11" />
        <div>
          <p class="font-serif font-semibold leading-tight">{t('site.ad')}</p>
          <p class="etiket mt-0.5">1979 · 1986 · {yil}</p>
        </div>
      </div>
      <p class="mt-3 text-sm text-(--metin-2)">{site.dernekAdi} ({site.kisaltma}) · {site.hukukiForm} · KBO/BCE <span class="mono">{site.kbo}</span></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {site.sosyal.facebook && (
          <a href={site.sosyal.facebook} rel="noopener" target="_blank" aria-label="Facebook" title="Facebook"
             class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#1877F2] hover:opacity-85 transition-opacity shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M13.5 21v-7.4h2.5l.4-2.9h-2.9V8.85c0-.84.23-1.41 1.44-1.41h1.54V4.85c-.27-.04-1.18-.11-2.24-.11-2.22 0-3.74 1.35-3.74 3.83v2.14H8v2.9h2.44V21h3.06Z"/></svg>
          </a>
        )}
        {diyanetLinkler.map((l) => (
          <a href={l.h} rel="noopener" target="_blank" title={l.ad}
             class="flex items-center rounded-lg border border-(--cizgi) bg-[#f7f3ea] px-2 py-1 no-underline hover:border-(--vurgu) hover:-translate-y-px transition-all">
            <img src={l.logo} alt={l.ad} width={l.g} height={l.y} class="h-6 w-auto" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
    <address class="not-italic text-sm leading-6">
      <p class="etiket etiket-vurgu mb-2">{t('footer.iletisim')}</p>
      <p>{adresSatir} · <a href={haritaUrl} rel="noopener" target="_blank">{t('genel.harita')}</a></p>
      <p class="mt-1.5"><span class="etiket">{t('footer.dingorevlisi')}</span> <a href={tel(site.telefon.dinGorevlisi)} class="mono">{site.telefon.dinGorevlisi}</a>{site.epostaDinGorevlisi && <><br /><a href={`mailto:${site.epostaDinGorevlisi}`}>{site.epostaDinGorevlisi}</a></>}</p>
      <p class="mt-1.5"><span class="etiket">{t('footer.cami')}</span> <a href={tel(site.telefon.cami)} class="mono">{site.telefon.cami}</a>{site.eposta && <><br /><a href={`mailto:${site.eposta}`}>{site.eposta}</a></>}</p>
    </address>
    <nav class="text-sm leading-6" aria-label={t('footer.yasal')}>
      <p class="etiket etiket-vurgu mb-2">{t('footer.baglantilar')}</p>
      <ul class="grid grid-cols-2 gap-x-4" role="list">
        {siteLinkleri.map((l) => <li><a href={l.h} rel={l.h === '/admin/' ? 'nofollow' : undefined}>{l.ad}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="cetvel">
    <p class="kapsayici py-3 etiket flex flex-wrap justify-between gap-2">
      <span>© {yil} {site.kisaltma} · {t('footer.hak')}</span>
      <span>Marche-en-Famenne · Belgique</span>
    </p>
  </div>
</footer>
