---
import { getCollection } from 'astro:content';
import { duyurular, icerikDili } from '../lib/icerik';
import { vitrinSec, type VitrinAdayi } from '../lib/vitrin-secimi';
import { yol, tarihBicimle } from '../i18n/utils';
import { yollar, type Dil, type SayfaAnahtari } from '../i18n/ui';
import Ikon from './Ikon.astro';
interface Props { dil: Dil; siteAdi: string }
const { dil, siteAdi } = Astro.props;
const m = {
  tr: { baslik: 'Camimizden güncel haberler', tumu: 'Tüm duyurular', afisler: 'Afişler', incele: 'Duyuruyu incele', afis: 'Afişi aç', detay: 'Bilgi ve başvuru', once: 'Önceki yayın', sonra: 'Sonraki yayın', durdur: 'Otomatik geçişi durdur', oynat: 'Otomatik geçişi başlat', sec: 'Yayın seç', grup: 'Güncel duyuru ve afişler', tur: { duyuru: 'Duyuru', afis: 'Afiş' }, not: '', bos: 'Camimizde ibadet, eğitim ve buluşmalar.', ziyaret: 'Camimizi tanıyın' },
  fr: { baslik: 'À la une de notre mosquée', tumu: 'Toutes les annonces', afisler: 'Affiches', incele: 'Lire l’annonce', afis: 'Voir l’affiche', detay: 'Infos et inscription', once: 'Publication précédente', sonra: 'Publication suivante', durdur: 'Arrêter le défilement automatique', oynat: 'Reprendre le défilement automatique', sec: 'Choisir une publication', grup: 'Annonces et affiches à la une', tur: { duyuru: 'Annonce', afis: 'Affiche' }, not: '', bos: 'Prière, apprentissage et rencontres à la mosquée.', ziyaret: 'Découvrir notre mosquée' },
  en: { baslik: 'Latest from our mosque', tumu: 'All announcements', afisler: 'Posters', incele: 'Read announcement', afis: 'View poster', detay: 'Details and registration', once: 'Previous publication', sonra: 'Next publication', durdur: 'Stop the automatic slideshow', oynat: 'Start the automatic slideshow', sec: 'Choose a publication', grup: 'Latest announcements and posters', tur: { duyuru: 'Announcement', afis: 'Poster' }, not: 'These publications are available in French; posters may also contain Turkish.', bos: 'Prayer, learning and community at our mosque.', ziyaret: 'Discover our mosque' },
}[dil];
const haberler = await duyurular(dil);
const afisler = await getCollection('afisler', ({ data }) => !data.taslak);
const adaylar: VitrinAdayi[] = [
  ...haberler.map(d => ({ ...d.data, id: d.id, baslik: d.data.baslik, ozet: d.data.ozet ?? '', gorsel: d.data.kapak ?? '', href: yol(dil, 'duyurular', d.slug), tur: 'duyuru' as const, dil: icerikDili(dil) })),
  ...afisler.map(a => ({ ...a.data, id: a.id, baslik: a.data.baslik[icerikDili(dil)] ?? a.data.baslik.tr, ozet: '', gorsel: a.data.gorsel,
    href: a.data.sayfa && a.data.sayfa in yollar ? yol(dil, a.data.sayfa as SayfaAnahtari) : a.data.link ?? a.data.gorsel,
    tur: 'afis' as const, dil: a.data.baslik[icerikDili(dil)] ? icerikDili(dil) : 'tr' })),
];
const secilenler = vitrinSec(adaylar);
const egitimPortalIlgiliMi = (y: VitrinAdayi) => {
  const metin = `${y.baslik} ${y.ozet} ${y.href} ${y.id}`.toLowerCase();
  return /(e[gğ]itim|kuran\s*kursu|kur['’]an\s*kursu|veli|portal|m[uü]fredat|\b(cours|formation|portail|parent|apprentissage|scolaire)\b)/i.test(metin);
};
const yayinlar = secilenler.map(y => {
  if (y.tur === 'duyuru' && !y.gorsel && egitimPortalIlgiliMi(y)) {
    return { ...y, gorsel: '/media/vitrin/egitim-veli-portali.webp' };
  }
  return y;
});
const kareler = yayinlar.length ? yayinlar : [{ id: 'cami', baslik: siteAdi, ozet: m.bos, gorsel: '/media/hero/hero-1.webp', href: yol(dil, 'hakkimizda'), tarih: new Date(), tur: 'duyuru' as const, dil }];
---
<section id="hero-slayt" class="vitrin" aria-label={m.grup} aria-roledescription="carousel">
  <header class="vitrin-baslik">
    <h1>{siteAdi}</h1>
    <p>{m.baslik}</p>
  </header>
  {m.not && <p class="vitrin-dil-notu">{m.not}</p>}
  <div class="vitrin-sahne">
    {kareler.map((k, i) => (
      <article id={`vitrin-yayin-${i}`} class:list={['hero-kare', i === 0 && 'aktif']} data-slayt={i} hidden={i !== 0} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${kareler.length}`}>
        <a class:list={['vitrin-gorsel', !k.gorsel && 'vitrin-gorsel-bos']} href={k.gorsel || k.href} aria-label={`${m.afis}: ${k.baslik}`}>
          {k.gorsel ? <img src={k.gorsel} alt={k.baslik} width="800" height="900" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" /> : <Ikon ad="belge" boyut={96} />}
          {k.gorsel && <span>{m.afis} <Ikon ad="ok" boyut={16} /></span>}
        </a>
        <div class="vitrin-metin">
          <h2 lang={k.dil}><a href={k.href}>{k.baslik}</a></h2>
          <p class="vitrin-tarih">{m.tur[k.tur]} <span aria-hidden="true">·</span> <time datetime={k.tarih.toISOString()}>{tarihBicimle(k.tarih, dil)}</time></p>
          {k.ozet && <p class="vitrin-ozet" lang={k.dil}>{k.ozet}</p>}
          <a class="vitrin-baglanti" href={k.href}>{yayinlar.length ? k.tur === 'duyuru' ? m.incele : m.detay : m.ziyaret}<Ikon ad="ok" boyut={20} /></a>
        </div>
      </article>
    ))}
  </div>
  {kareler.length > 1 && <div class="vitrin-denetim" hidden data-denetim>
    <div class="vitrin-oklar">
      <button type="button" data-once aria-label={m.once}><Ikon ad="ok" class="ters" boyut={20} /></button>
      <span id="vitrin-sayac" aria-live="off">1 / {kareler.length}</span>
      <button type="button" data-sonra aria-label={m.sonra}><Ikon ad="ok" boyut={20} /></button>
    </div>
    <button type="button" id="hero-duraklat" data-durdur={m.durdur} data-oynat={m.oynat} aria-label={m.durdur} aria-pressed="false">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path data-pause d="M8 5v14M16 5v14"/><path data-play style="display:none" d="m8 5 11 7-11 7Z"/></svg>
    </button>
  </div>}
  <nav class="vitrin-secimler" aria-label={m.sec}>
    {kareler.map((k, i) => <a href={k.href} data-nokta={i} aria-controls={`vitrin-yayin-${i}`} aria-current={i === 0 ? 'true' : undefined}><span class="vitrin-sira" aria-hidden="true">{i + 1}</span><span lang={k.dil}>{k.baslik}</span></a>)}
  </nav>
  <footer class="vitrin-alt"><a href={yol(dil, 'duyurular')}>{m.tumu} <Ikon ad="ok" boyut={16} /></a><a href={yol(dil, 'afisler')}>{m.afisler} <Ikon ad="galeri" boyut={16} /></a></footer>
  <p class="sr-only" data-bildirim aria-live="polite" aria-atomic="true"></p>
</section>
<style>
  .vitrin { width: 100%; min-width: 0; container-type: inline-size; background: var(--zemin); color: var(--metin); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); overflow: hidden; }
  .vitrin-baslik { padding: 1.2rem 1.5rem; background: #163e53; color: #f7f3ea; }
  .vitrin-baslik h1 { font-size: clamp(1.15rem, 2.6cqw, 1.6rem); line-height: 1.3; color: inherit; }
  .vitrin-baslik p { margin-top: .35rem; font-size: .9rem; }
  .vitrin-dil-notu { padding: .7rem 1.5rem; font-size: .85rem; border-bottom: 1px solid var(--cizgi); }
  .vitrin-sahne { touch-action: pan-y pinch-zoom; position: relative; }
  .hero-kare { display: grid; grid-template-columns: 1.1fr 1fr; min-height: 25rem; }
  .hero-kare[hidden], [hidden] { display: none !important; }
  .vitrin-gorsel { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1rem; background: var(--zemin-2); text-decoration: none; }
  .vitrin-gorsel img { width: 100%; height: 23rem; object-fit: contain; }
  .vitrin-gorsel span { display: flex; gap: .5rem; align-items: center; margin-top: .6rem; font-size: .8rem; font-weight: 600; }
  .vitrin-metin { padding: 1.5rem; display: flex; flex-direction: column; align-items: start; justify-content: center; min-width: 0; }
  .vitrin-metin h2 { font-size: clamp(1.25rem, 3.5cqw, 1.8rem); line-height: 1.25; overflow-wrap: anywhere; text-wrap: balance; }
  .vitrin-metin h2 a { color: var(--metin); text-decoration: none; }
  .vitrin-metin h2 a:hover { text-decoration: underline; }
  .vitrin-tarih { margin-top: .8rem; font-size: .8rem; color: var(--metin-2); }
  .vitrin-ozet { font-size: .95rem; line-height: 1.6; margin-top: 1rem; }
  .vitrin-baglanti { margin-top: 1.3rem; display: inline-flex; gap: .6rem; align-items: center; min-height: 44px; padding: .65rem .9rem; background: #1f5f8b; color: #fff; text-decoration: none; font-weight: 600; font-size: .88rem; border-radius: var(--radius-kose); }
  .vitrin-baglanti:hover { background: #174a6c; color: #fff; }
  .vitrin-denetim { display: flex; justify-content: space-between; align-items: center; padding: .35rem 1rem; border-block: 1px solid var(--cizgi); }
  .vitrin-oklar { display: flex; align-items: center; gap: .65rem; font-size: .85rem; font-variant-numeric: tabular-nums; }
  .vitrin-denetim button { display: grid; place-items: center; width: 44px; height: 44px; cursor: pointer; border-radius: var(--radius-kose); color: var(--metin); }
  .vitrin-denetim button:hover { background: var(--zemin-3); }
  .vitrin :global(.ters) { transform: rotate(180deg); }
  .vitrin-secimler { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; padding: .5rem; gap: .35rem; position: relative; }
  .vitrin-secimler a { flex: 0 0 11rem; display: flex; align-items: start; gap: .6rem; min-height: 64px; padding: .65rem; font-size: .8rem; line-height: 1.4; text-decoration: none; color: var(--metin); border-radius: var(--radius-kose); border: 1px solid transparent; }
  .vitrin-secimler a[aria-current='true'] { background: var(--zemin-2); border-color: var(--vurgu-2); }
  .vitrin-secimler a:hover { background: var(--zemin-2); }
  .vitrin-sira { font-weight: 700; color: var(--vurgu-2); }
  .vitrin-alt { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--cizgi); padding: .4rem 1.3rem; }
  .vitrin-alt a { display: flex; align-items: center; gap: .4rem; min-height: 44px; font-size: .8rem; font-weight: 600; text-decoration: none; }
  .vitrin a:focus-visible, .vitrin button:focus-visible { outline: 2px solid var(--vurgu-2); outline-offset: -3px; }
  @container (max-width: 540px) {
    .hero-kare { grid-template-columns: minmax(0, 1fr); }
    .vitrin-gorsel img { height: 19rem; }
    .vitrin-gorsel { padding: .8rem; }
    .vitrin-metin { padding: 1.2rem; }
    .vitrin-metin h2 { font-size: 1.35rem; }
    .vitrin-baslik { padding: 1rem 1.2rem; }
    .vitrin-secimler a { flex-basis: 10rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-kare.aktif { animation: vitrin-acil .35s cubic-bezier(.16,1,.3,1); }
    :root[data-hareket='durdu'] .hero-kare.aktif { animation: none; }
    @keyframes vitrin-acil { from { opacity: .65; } to { opacity: 1; } }
  }
</style>
<script>
  const kok = document.getElementById('hero-slayt');
  if (kok) {
    const kareler = [...kok.querySelectorAll<HTMLElement>('[data-slayt]')];
    const secimler = [...kok.querySelectorAll<HTMLAnchorElement>('[data-nokta]')];
    const duraklat = kok.querySelector<HTMLButtonElement>('#hero-duraklat');
    const azalt = matchMedia('(prefers-reduced-motion: reduce)');
    const belge = document.documentElement;
    let aktif = 0; let zaman = 0; let uzerinde = false; let odak = false;
    const sahne = kok.querySelector<HTMLElement>('.vitrin-sahne')!;

    // Base.astro localStorage tercihi olmasa da dataset.hareket='acik' yazdığı için
    // açık kullanıcı tercihini doğrudan localStorage üzerinden ayrı takip et:
    let acikSecim = false;
    try {
      acikSecim = localStorage.getItem('uluCamiiHareket') === 'acik';
    } catch {}

    // reduce aktif ve açık seçim yoksa dur; veya kullanıcı durdurmuşsa dur
    const durdu = () => belge.dataset.hareket === 'durdu' || (azalt.matches && !acikSecim);

    const buton = () => {
      if (!duraklat) return;
      const d = durdu();
      duraklat.setAttribute('aria-pressed', String(d));
      const metin = (d ? duraklat.dataset.oynat : duraklat.dataset.durdur)!;
      duraklat.title = metin;
      duraklat.setAttribute('aria-label', metin);
      duraklat.querySelector('[data-play]')?.setAttribute('style', d ? '' : 'display:none');
      duraklat.querySelector('[data-pause]')?.setAttribute('style', d ? 'display:none' : '');
    };

    const planla = () => {
      clearTimeout(zaman);
      if (kareler.length < 2 || durdu() || uzerinde || odak || document.hidden) return;
      zaman = window.setTimeout(() => { goster(aktif + 1); planla(); }, 10000);
    };

    const olc = () => {
      let mY = 0;
      kareler.forEach(k => {
        const h = k.hidden;
        if (h) {
          k.hidden = false;
          k.style.position = 'absolute';
          k.style.visibility = 'hidden';
          k.style.width = '100%';
        }
        mY = Math.max(mY, k.offsetHeight);
        if (h) {
          k.hidden = true;
          k.style.position = '';
          k.style.visibility = '';
          k.style.width = '';
        }
      });
      if (mY > 0) sahne.style.minHeight = `${mY}px`;
    };

    const goster = (sira: number, kullanici = false) => {
      aktif = (sira + kareler.length) % kareler.length;
      kareler.forEach((k, i) => { k.hidden = i !== aktif; k.classList.toggle('aktif', i === aktif); });
      secimler.forEach((b, i) => i === aktif ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current'));
      const sayac = kok.querySelector('#vitrin-sayac'); if (sayac) sayac.textContent = `${aktif + 1} / ${kareler.length}`;
      const img = kareler[aktif].querySelector('img'); if (img) img.loading = 'eager';
      const secim = secimler[aktif];
      const kaps = secim.parentElement;
      if (kaps) {
        if (!kaps.style.position) kaps.style.position = 'relative';
        kaps.scrollTo({
          left: secim.offsetLeft - (kaps.clientWidth - secim.offsetWidth) / 2,
          behavior: azalt.matches ? 'auto' : 'smooth',
        });
      }
      if (kullanici) kok.querySelector('[data-bildirim]')!.textContent = `${aktif + 1} / ${kareler.length}: ${secim.textContent?.trim()}`;
    };

    kok.querySelector('[data-denetim]')?.removeAttribute('hidden');
    secimler.forEach((b, i) => {
      b.setAttribute('role', 'button');
      b.addEventListener('click', e => { e.preventDefault(); goster(i, true); planla(); });
      b.addEventListener('keydown', e => { if (e.key === ' ') { e.preventDefault(); goster(i, true); planla(); } });
    });
    kok.querySelector('[data-once]')?.addEventListener('click', () => { goster(aktif - 1, true); planla(); });
    kok.querySelector('[data-sonra]')?.addEventListener('click', () => { goster(aktif + 1, true); planla(); });
    kok.addEventListener('keydown', e => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key) || !(e.target instanceof Element) || !e.target.closest('.vitrin-secimler')) return;
      e.preventDefault(); const i = e.key === 'Home' ? 0 : e.key === 'End' ? kareler.length - 1 : aktif + (e.key === 'ArrowRight' ? 1 : -1);
      goster(i, true); secimler[aktif].focus(); planla();
    });
    let dokunus: {x: number; y: number} | null = null;
    sahne.addEventListener('touchstart', e => { const t = e.touches[0]; dokunus = {x:t.clientX, y:t.clientY}; }, {passive:true});
    sahne.addEventListener('touchend', e => { if (!dokunus) return; const t=e.changedTouches[0]; const dx=t.clientX-dokunus.x; const dy=t.clientY-dokunus.y; if (Math.abs(dx)>60 && Math.abs(dx)>Math.abs(dy)*1.5) { goster(aktif+(dx<0?1:-1), true); planla(); } dokunus=null; }, {passive:true});

    duraklat?.addEventListener('click', () => {
      const yeniDuruyor = !durdu();
      acikSecim = !yeniDuruyor;
      const yeni = yeniDuruyor ? 'durdu' : 'acik';
      belge.dataset.hareket = yeni;
      try { localStorage.setItem('uluCamiiHareket', yeni); } catch {}
      document.dispatchEvent(new CustomEvent('ulucamii:hareket', { detail: { duruyor: yeniDuruyor } }));
    });

    document.addEventListener('ulucamii:hareket', (e: Event) => {
      const cust = e as CustomEvent<{ duruyor?: boolean }>;
      if (cust.detail && typeof cust.detail.duruyor === 'boolean') {
        const d = cust.detail.duruyor;
        acikSecim = !d;
        belge.dataset.hareket = d ? 'durdu' : 'acik';
      }
      buton();
      planla();
    });

    kok.addEventListener('mouseenter', () => { uzerinde=true; planla(); });
    kok.addEventListener('mouseleave', () => { uzerinde=false; planla(); });
    kok.addEventListener('focusin', () => { odak=true; planla(); });
    kok.addEventListener('focusout', e => { odak=!!e.relatedTarget && kok.contains(e.relatedTarget as Node); planla(); });
    document.addEventListener('visibilitychange', planla);

    azalt.addEventListener('change', () => {
      if (azalt.matches) {
        acikSecim = false;
        belge.dataset.hareket = 'durdu';
        try { localStorage.removeItem('uluCamiiHareket'); } catch {}
        document.dispatchEvent(new CustomEvent('ulucamii:hareket', { detail: { duruyor: true } }));
      } else {
        buton();
        planla();
      }
    });

    window.addEventListener('resize', olc);

    // lazy resim load promise tüm resimleri yüklenene dek beklemesin, her img load/error sonrası olc çağrılsın
    kok.querySelectorAll('img').forEach(img => {
      if (!img.complete) {
        img.addEventListener('load', olc, { once: true });
        img.addEventListener('error', olc, { once: true });
      }
    });
    if (document.fonts) document.fonts.ready.then(olc);
    if (durdu()) belge.dataset.hareket = 'durdu';
    olc();
    buton(); planla();
  }
</script>
