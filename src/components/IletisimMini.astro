---
/** Ana sayfa alt bölümü: adres + telefonlar + harita, footer'a inmeden ulaşım */
import Ikon from './Ikon.astro';
import Harita from './Harita.astro';
import { yol, ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil; site: any }
const { dil, site } = Astro.props; const t = ceviri(dil);
const tel = (s: string) => 'tel:' + s.replace(/\s+/g, '');
const m = dil === 'tr'
  ? { baslik: 'Bize ulaşın', alt: 'Marche-en-Famenne’in merkezinde, tren garına yürüme mesafesinde. Ziyaret, cenaze, nikâh ve her türlü soru için kapımız açık.', sayfa: 'İletişim sayfası', facebook: 'Facebook sayfamız', disKaynak: '(dış bağlantı)' }
  : dil === 'en'
  ? { baslik: 'Contact us', alt: 'In the centre of Marche-en-Famenne, a short walk from the train station. For visits, funerals, weddings or any question — our door is open.', sayfa: 'Contact page', facebook: 'Our Facebook page', disKaynak: '(external link)' }
  : { baslik: 'Nous contacter', alt: 'Au centre de Marche-en-Famenne, à quelques minutes à pied de la gare. Visite, funérailles, mariage ou toute question : notre porte est ouverte.', sayfa: 'Page de contact', facebook: 'Notre page Facebook', disKaynak: '(lien externe)' };
---
<section class="bg-(--zemin-2) border-y border-(--cizgi) reveal" aria-labelledby="iletisim-baslik">
  <div class="kapsayici py-12 sm:py-16 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] items-start">
    <div>
      <h2 id="iletisim-baslik">{m.baslik}</h2>
      <p class="mt-3 text-(--metin-2) max-w-[48ch]">{m.alt}</p>
      <ul class="mt-6 grid gap-4 dokun" role="list">
        <li class="flex gap-3"><Ikon ad="harita" class="h-6 w-6 shrink-0 text-(--vurgu)" /><span><span class="etiket block">{t('footer.adres')}</span>{site.adres.sokak}, {site.adres.posta} {site.adres.sehir}</span></li>
        <li class="flex gap-3"><Ikon ad="telefon" class="h-6 w-6 shrink-0 text-(--vurgu)" /><span><span class="etiket block">{t('footer.dingorevlisi')}</span><a href={tel(site.telefon.dinGorevlisi)} class="mono text-lg">{site.telefon.dinGorevlisi}</a>{site.epostaDinGorevlisi && <><br /><a href={`mailto:${site.epostaDinGorevlisi}`}>{site.epostaDinGorevlisi}</a></>}</span></li>
        <li class="flex gap-3"><Ikon ad="telefon" class="h-6 w-6 shrink-0 text-(--vurgu)" /><span><span class="etiket block">{t('footer.cami')}</span><a href={tel(site.telefon.cami)} class="mono text-lg">{site.telefon.cami}</a>{site.eposta && <><br /><a href={`mailto:${site.eposta}`}>{site.eposta}</a></>}</span></li>
        {site.sosyal?.facebook && <li class="flex gap-3"><Ikon ad="facebook" class="h-6 w-6 shrink-0 text-(--vurgu)" /><span><span class="etiket block">Facebook</span><a href={site.sosyal.facebook} target="_blank" rel="noopener">{m.facebook}<span aria-hidden="true"> ↗</span><span class="sr-only"> {m.disKaynak}</span></a></span></li>}
      </ul>
      <p class="mt-6"><a href={yol(dil, 'iletisim')} class="dugme dugme-ikincil">{m.sayfa}</a></p>
    </div>
    <Harita enlem={site.gps.enlem} boylam={site.gps.boylam} baslik={t('genel.harita')} yoltarifi={t('genel.yoltarifi')} disKaynak={m.disKaynak} />
  </div>
</section>
