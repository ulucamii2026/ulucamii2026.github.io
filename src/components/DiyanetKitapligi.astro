---
/**
 * Diyanet Dijital kütüphanesi — kendi sayfasındaki (sayfalar/Kutuphane.astro) tam katalog.
 *
 * Veri: src/data/diyanet-yayinlar.json — dijital.diyanet.gov.tr site haritasındaki 959
 * e-kitap kaydı tarandı, yalnız ÜCRETSİZ PDF'i olanlar alındı ve yayın diline göre kümelendi.
 * Bakım: `npm run denetim:diyanet` (scripts/diyanet-kontrol.mjs).
 *
 * ── Neden dosyalar bizde durmuyor ────────────────────────────────────────────
 * PDF'ler Diyanet İşleri Başkanlığı'nın kendi sunucusunda kalır; biz yalnız bağlantı
 * veriyoruz. Böylece (1) telif ve yayın hakkı Diyanet'te kalır, (2) yayın güncellenince
 * bizim kopyamız eskimez, (3) depoya gigabaytlarca PDF girmez. Bedeli: bağlantılar
 * Diyanet tarafında ölebilir — site haritasındaki kayıtların yarısına yakını ölü ya da
 * yalnız satılık, cami broşürü (id=510) ise 1,7 MB bildirip 21 KB gövde döndürüyordu.
 * Bu yüzden denetim betiği HTTP kodunun yanında gövdenin gerçekten tam bir PDF olduğunu
 * da kontrol eder; HEAD isteği bu sunucuda 405 döner.
 *
 * ── Başlıklar ────────────────────────────────────────────────────────────────
 * Diyanet'in ürün sayfaları başlığı YALNIZ Türkçe verir («İSLAM NEDİR (FRANSIZCA BROŞÜR)»).
 * Bu, Fransızca okuyan biri için işe yaramaz; bu yüzden yabancı dildeki yayınların PDF'leri
 * indirilip ilk sayfalarından kendi dillerindeki başlıkları çıkarıldı. Türkçe künye ikinci
 * satırda kalır — otomatik çıkarım kusurlu olsa bile okuyucu hangi kitap olduğunu görür.
 *
 * Süzgeç ilerlemeli iyileştirmedir: JS yokken bütün başlıklar okunur durumda kalır.
 */
import veri from '../data/diyanet-yayinlar.json';
import KitapSatiri from './KitapSatiri.astro';
import type { Kitap } from './KitapSatiri.astro';
import type { Dil } from '../i18n/ui';

interface Props {
  dil: Dil;
  /** Kendi sayfasında (Kutuphane.astro) sayfa başlığı zaten aynı şeyi söylüyor: bölümün
      kendi etiketi/başlığı/girişi bastırılır, yerine kısa bir bölüm başlığı konur. */
  sayfaModu?: boolean;
}
const { dil, sayfaModu = false } = Astro.props;

const M = {
  tr: {
    etiket: 'Ücretsiz kütüphane',
    baslik: 'Diyanet Yayınları — Ücretsiz Kütüphane',
    giris:
      'Diyanet İşleri Başkanlığı’nın ücretsiz e-kitapları: İslam’ı tanıtan broşürlerden ibadet rehberine, kırk hadis kitapçıklarından fetvalara ve ders kitaplarına kadar. Dosyalar Diyanet’in kendi sunucusunda durur; bağlantıya tıklayınca oradan açılır veya indirilir.',
    ara: 'Kütüphanede ara',
    dilSerit: 'Diller',
    tumu: 'Bütün yayınlar',
    dahaFazla: (n: number) => `${n} yayın daha göster`,
    bulunanTek: '{n} yayın bulundu', bulunanCok: '{n} yayın bulundu',
    sizinDil: 'sayfanın dili',
    araYer: 'Başlık, konu veya dil — örnek: prière, Coran, namaz…',
    sonucYok: 'Aramanıza uyan yayın yok.',
    adet: (n: number) => `${n} yayın`,
    toplam: (n: number, d: number) => `${n} yayın · ${d} dil`,
    sayfaKisa: 'sayfa', pdfAc: 'Oku (PDF)', epub: 'İndir (EPUB)', kunye: 'Diyanet sayfası', dis: 'yeni sekmede açılır',
    kaynakNot:
      'Kaynak: dijital.diyanet.gov.tr — T.C. Diyanet İşleri Başkanlığı. Dosyalar Diyanet’in kendi sunucusunda durur, biz kopya tutmayız: «Oku (PDF)» tarayıcınızın okuyucusunda açar (oradaki indirme düğmesi ya da Ctrl+S ile kaydedersiniz), «İndir (EPUB)» doğrudan indirir. Bağlantılar {tarih} tarihinde doğrulandı; çalışmayan bir bağlantı görürseniz lütfen bize bildirin.',
    gruplar: {
      baslangic: 'Yeni başlayanlar için', ibadet: 'İbadeti öğrenmek', hadis: 'Kırk hadis kitapçıkları',
      aile: 'Aile ve hayat', derinlesme: 'Derinleşmek isteyenler için', cocuk: 'Çocuklar için',
      istismar: 'Din istismarı ve aşırılık',
    },
  },
  fr: {
    etiket: 'Bibliothèque gratuite',
    baslik: 'Publications du Diyanet — bibliothèque gratuite',
    giris:
      'Les livres numériques gratuits de la Présidence des Affaires religieuses : brochures de présentation de l’islam, guide du culte, recueils de quarante hadiths, fatwas et manuels scolaires. Les fichiers restent sur le serveur du Diyanet et s’ouvrent directement depuis là.',
    ara: 'Rechercher dans la bibliothèque',
    dilSerit: 'Langues',
    tumu: 'Tous les ouvrages',
    dahaFazla: (n: number) => `Afficher ${n} ouvrages de plus`,
    bulunanTek: '{n} ouvrage trouvé', bulunanCok: '{n} ouvrages trouvés',
    sizinDil: 'langue de la page',
    araYer: 'Titre, thème ou langue — ex. : prière, Coran, famille…',
    sonucYok: 'Aucune publication ne correspond à votre recherche.',
    adet: (n: number) => `${n} ouvrage${n > 1 ? 's' : ''}`,
    toplam: (n: number, d: number) => `${n} ouvrages · ${d} langues`,
    sayfaKisa: 'pages', pdfAc: 'Lire (PDF)', epub: 'Télécharger (EPUB)', kunye: 'Fiche Diyanet', dis: 'ouvre dans un nouvel onglet',
    kaynakNot:
      'Source : dijital.diyanet.gov.tr — Présidence des Affaires religieuses (Diyanet). Les fichiers restent sur le serveur du Diyanet, nous n’en gardons aucune copie : « Lire (PDF) » ouvre le document dans la visionneuse de votre navigateur (son bouton de téléchargement ou Ctrl+S l’enregistre), « Télécharger (EPUB) » le télécharge directement. Liens vérifiés le {tarih} ; merci de nous signaler tout lien inactif.',
    gruplar: {
      baslangic: 'Pour commencer', ibadet: 'Apprendre à pratiquer', hadis: 'Recueils de quarante hadiths',
      aile: 'Famille et vie quotidienne', derinlesme: 'Pour approfondir', cocuk: 'Pour les enfants',
      istismar: 'Religion, extrémisme et terrorisme',
    },
  },
  en: {
    etiket: 'Free library',
    baslik: 'Diyanet Publications — Free Library',
    giris:
      'Free e-books from the Presidency of Religious Affairs: introductory booklets on Islam, a practical worship guide, forty-hadith collections, fatwas and school textbooks. The files stay on Diyanet’s own server and open directly from there.',
    ara: 'Search the library',
    dilSerit: 'Languages',
    tumu: 'All publications',
    dahaFazla: (n: number) => `Show ${n} more books`,
    bulunanTek: '{n} book found', bulunanCok: '{n} books found',
    sizinDil: 'page language',
    araYer: 'Title, topic or language — e.g. prière, Coran, prayer…',
    sonucYok: 'No publication matches your search.',
    adet: (n: number) => `${n} book${n > 1 ? 's' : ''}`,
    toplam: (n: number, d: number) => `${n} books · ${d} languages`,
    sayfaKisa: 'pages', pdfAc: 'Read (PDF)', epub: 'Download (EPUB)', kunye: 'Diyanet page', dis: 'opens in a new tab',
    kaynakNot:
      'Source: dijital.diyanet.gov.tr — Presidency of Religious Affairs (Diyanet). The files stay on Diyanet’s own server and we keep no copy: “Read (PDF)” opens the document in your browser’s viewer (its download button, or Ctrl+S, saves it), “Download (EPUB)” downloads it directly. Links verified on {tarih}; please tell us if a link stops working.',
    gruplar: {
      baslangic: 'To begin with', ibadet: 'Learning to worship', hadis: 'Forty-hadith booklets',
      aile: 'Family and daily life', derinlesme: 'Going deeper', cocuk: 'For children',
      istismar: 'Religion, extremism and terrorism',
    },
  },
} as const;

const m = M[dil];
const yayinlar = veri.yayinlar as Kitap[];

/* Dil sırası bilinçlidir: Marche-en-Famenne'de İslam'ı araştıran biri büyük ihtimalle
   Fransızca, sonra Felemenkçe ya da İngilizce okur. Sayfanın kendi dili en öne alınır. */
const ONCELIK = ['fr', 'nl', 'en', 'de', 'ar', 'tr', 'es', 'it'];
const dilSirasi = (kod: string) => (kod === dil ? -1 : ONCELIK.indexOf(kod) === -1 ? 99 : ONCELIK.indexOf(kod));

/* Yalnız Fransızca yayınlar konu konu kümelenmiştir (`grup` alanı); diğer diller tek liste. */
const TEMA_SIRA = ['baslangic', 'ibadet', 'hadis', 'aile', 'cocuk', 'derinlesme', 'istismar'] as const;

const dilKumeleri = veri.diller
  .map((d) => ({ ...d, kitaplar: yayinlar.filter((y) => y.dilKodu === d.kod) }))
  .filter((d) => d.kitaplar.length > 0)
  .sort((a, b) => dilSirasi(a.kod) - dilSirasi(b.kod) || a.ad.localeCompare(b.ad, 'fr'));

/* Varsayılan açık: sayfanın kendi dili (Rıdvan'ın isteği, 8 Eyl 2026). Türkçe bölüm 162
   kitapla tümü açık gelince sayfa 24.500 px oluyordu; bu yüzden uzun listeler ilk KIRPMA
   kadarını gösterir, kalanı iç içe bir <details> içinde durur — JS gerekmez. */
const ACIK = (kod: string) => kod === dil;
const KIRPMA = 40;

const temaliKume = (kitaplar: Kitap[]) => {
  const gruplu = TEMA_SIRA.map((g) => ({ anahtar: g, kitaplar: kitaplar.filter((k) => k.grup === g) }))
    .filter((g) => g.kitaplar.length > 0);
  if (!gruplu.length) return null;
  const kalan = kitaplar.filter((k) => !k.grup);
  return { gruplu, kalan };
};

const tarihMetni = new Intl.DateTimeFormat(dil === 'tr' ? 'tr-TR' : dil === 'fr' ? 'fr-BE' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(veri.guncelleme + 'T12:00:00Z'));
---

<section id="diyanet-kutuphanesi" class="kitaplik">
  <div class="kapsayici">
    {sayfaModu ? (
      <h2 class="baslik baslik-sade">{m.tumu}</h2>
    ) : (
      <>
        <p class="etiket etiket-vurgu">{m.etiket}</p>
        <h2 class="baslik">{m.baslik}</h2>
        <p class="giris">{m.giris}</p>
      </>
    )}
    <p class="etiket sayac">{m.toplam(yayinlar.length, dilKumeleri.length)}</p>

    <div class="ara-kutu">
      <label class="etiket" for="kitap-ara">{m.ara}</label>
      <input id="kitap-ara" type="search" placeholder={m.araYer} autocomplete="off" spellcheck="false" />
    </div>
    <p id="kitap-sonuc" class="sonuc-yok" role="status" aria-live="polite" hidden
       data-tek={m.bulunanTek} data-cok={m.bulunanCok} data-dil={dil}></p>
    <p id="kitap-sonuc-yok" class="sonuc-yok" hidden>{m.sonucYok}</p>

    <nav class="dil-serit" aria-label={m.dilSerit}>
      <ul>
        {dilKumeleri.map((d) => (
          <li>
            <a class="dil-cip" href={`#kitaplik-${d.kod}`} data-dil-cip aria-current={d.kod === dil ? 'true' : undefined}>
              <span lang={d.kod}>{d.ad}</span> <span class="cip-adet">{d.kitaplar.length}</span>
              {d.kod === dil && <span class="sr-only"> — {m.sizinDil}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {dilKumeleri.map((d) => {
      const tema = temaliKume(d.kitaplar);
      const satirMetni = { sayfaKisa: m.sayfaKisa, pdfAc: m.pdfAc, epub: m.epub, kunye: m.kunye, dis: m.dis };
      return (
        <details class="grup" data-grup data-dil-kodu={d.kod} id={`kitaplik-${d.kod}`} open={ACIK(d.kod)}>
          <summary>
            <span class="grup-ad" lang={d.kod}>{d.ad}</span>
            {d.adTr !== d.ad && <span class="etiket grup-alt">{d.adTr}</span>}
            <span class="etiket grup-adet">{m.adet(d.kitaplar.length)}</span>
          </summary>

          {tema ? (
            <div class="temalar">
              {tema.gruplu.map((g) => (
                <section class="tema">
                  <h3 class="tema-ad">{m.gruplar[g.anahtar]}</h3>
                  <ul class="liste">
                    {g.kitaplar.map((k) => <KitapSatiri kitap={k} dil={dil} metin={satirMetni} />)}
                  </ul>
                </section>
              ))}
              {tema.kalan.length > 0 && (
                <section class="tema">
                  <ul class="liste">
                    {tema.kalan.map((k) => <KitapSatiri kitap={k} dil={dil} metin={satirMetni} />)}
                  </ul>
                </section>
              )}
            </div>
          ) : (
            <>
              <ul class="liste">
                {d.kitaplar.slice(0, KIRPMA).map((k) => <KitapSatiri kitap={k} dil={dil} metin={satirMetni} />)}
              </ul>
              {d.kitaplar.length > KIRPMA && (
                <details class="kalan" data-grup>
                  <summary><span class="kalan-ad">{m.dahaFazla(d.kitaplar.length - KIRPMA)}</span></summary>
                  <ul class="liste">
                    {d.kitaplar.slice(KIRPMA).map((k) => <KitapSatiri kitap={k} dil={dil} metin={satirMetni} />)}
                  </ul>
                </details>
              )}
            </>
          )}
        </details>
      );
    })}

    <p class="kaynak-not">{m.kaynakNot.replace('{tarih}', tarihMetni)}</p>
  </div>
</section>

<script>
  /* Süzgeç: başlık + Türkçe künye + açıklama + dil adı üzerinde, aksan duyarsız. */
  const kutu = document.getElementById('kitap-ara') as HTMLInputElement | null;
  if (kutu) {
    const sade = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const kitaplar = Array.from(document.querySelectorAll<HTMLElement>('[data-kitap]'));
    /* Dil adı satırın kendi metninde yok: «français» aramasının çalışması için üst kümenin
       başlığı anahtarın önüne eklenir. Uzun listelerin taşan kısmı da bir <details> olduğu
       için dil adı [data-dil-kodu] ile aranır — yoksa «40 yayın daha göster» yazısı geliyordu. */
    const dilAdi = (k: HTMLElement) =>
      k.closest('details[data-dil-kodu]')?.querySelector('summary')?.textContent ?? '';
    const gruplar = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-grup]'));
    const temalar = Array.from(document.querySelectorAll<HTMLElement>('.tema'));
    const acikBaslangic = gruplar.map((g) => g.open);
    const sonucYok = document.getElementById('kitap-sonuc-yok');
    const sonuc = document.getElementById('kitap-sonuc');
    const anahtar = new Map(
      kitaplar.map((k) => [k, sade(`${dilAdi(k)} ${k.querySelector('.kitap-metin')?.textContent ?? ''}`)]),
    );
    const doluMu = (el: Element) =>
      Array.from(el.querySelectorAll<HTMLElement>('[data-kitap]')).some((k) => !k.hidden);
    /* Yalnız değişeni yaz: 529 satırda her tuş vuruşunda hepsine yazmak yerleşimi tetikliyor. */
    const gizle = (el: HTMLElement, deger: boolean) => { if (el.hidden !== deger) el.hidden = deger; };

    const sonucYaz = (n: number | null) => {
      if (!sonuc) return;
      if (n === null) { sonuc.hidden = true; return; }
      const kalip = (n === 1 ? sonuc.dataset.tek : sonuc.dataset.cok) || '{n}';
      sonuc.textContent = kalip.replace('{n}', new Intl.NumberFormat(sonuc.dataset.dil || 'tr').format(n));
      sonuc.hidden = false;
    };

    const uygula = () => {
      const q = sade(kutu.value.trim());
      if (!q) {
        kitaplar.forEach((k) => gizle(k, false));
        temalar.forEach((t) => gizle(t, false));
        gruplar.forEach((g, i) => { gizle(g, false); g.open = acikBaslangic[i]; });
        gizle(sonucYok as HTMLElement, true);
        sonucYaz(null);
        return;
      }
      let toplam = 0;
      kitaplar.forEach((k) => {
        const uyar = (anahtar.get(k) ?? '').includes(q);
        gizle(k, !uyar);
        if (uyar) toplam++;
      });
      temalar.forEach((t) => gizle(t, !doluMu(t)));
      gruplar.forEach((g) => { const v = doluMu(g); gizle(g, !v); g.open = v; });
      if (sonucYok) gizle(sonucYok, toplam > 0);
      sonucYaz(toplam || null);
    };

    kutu.addEventListener('input', uygula);
    uygula();
  }

  /* Açık bölümler hatırlanır: okuyucu Felemenkçe bölümünü açıp gittiyse dönüşte açık bulur.
     Kayıt yoksa sunucunun verdiği hâl geçerlidir (sayfanın kendi dili açık gelir). */
  /* Anahtar sayfanın diline bağlıdır: Fransızca sayfada Fransızcayı açan biri, Türkçe
     sayfaya geçtiğinde Türkçe bölümü kapalı bulmasın. */
  const ANAHTAR = `ulucamii:kutuphane:acik:${document.documentElement.lang || 'tr'}`;
  const dilGruplari = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-dil-kodu]'));
  try {
    const kayit = localStorage.getItem(ANAHTAR);
    if (kayit) {
      const acik = new Set(JSON.parse(kayit) as string[]);
      for (const g of dilGruplari) g.open = acik.has(g.dataset.dilKodu || '');
    }
  } catch { /* özel pencere ya da kapalı depolama: sunucunun verdiği hâl kalsın */ }
  const hatirla = () => {
    try {
      localStorage.setItem(ANAHTAR, JSON.stringify(
        dilGruplari.filter((g) => g.open).map((g) => g.dataset.dilKodu),
      ));
    } catch { /* yok say */ }
  };
  for (const g of dilGruplari) g.addEventListener('toggle', hatirla);

  /* Dil şeridi ve dış bağlantılar: adres çubuğundaki #kitaplik-nl kapalı bir <details>'i
     kendiliğinden AÇMAZ, o yüzden elle açılır. JS yoksa bağlantı yine doğru başlığa
     kaydırır, kullanıcı başlığa dokunup açar. */
  const hedefiAc = (secici: string) => {
    if (!secici || !secici.startsWith('#kitaplik-')) return;
    const hedef = document.querySelector<HTMLDetailsElement>(secici);
    if (hedef) hedef.open = true;
    return hedef;
  };
  for (const cip of document.querySelectorAll<HTMLAnchorElement>('[data-dil-cip]')) {
    cip.addEventListener('click', () => hedefiAc(cip.getAttribute('href') || ''));
  }
  window.addEventListener('hashchange', () => hedefiAc(location.hash));
  if (location.hash) {
    const hedef = hedefiAc(location.hash);
    /* Açılınca yükseklik değiştiği için tarayıcının ilk kaydırması yanlış yere düşüyor. */
    if (hedef) requestAnimationFrame(() => hedef.scrollIntoView({ block: 'start' }));
  }
</script>

<style>
  .kitaplik { background: var(--zemin-2); border-top: 1px solid var(--cizgi); padding: 3.5rem 0 4rem; }
  .kitaplik .baslik { font-family: var(--font-serif, Lora, serif); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2rem); margin-top: 0.4rem; }
  .kitaplik .giris { max-width: 68ch; margin-top: 0.8rem; color: var(--metin-2); }
  .sayac { margin-top: 0.7rem; }
  .baslik-sade { margin-top: 0; }

  .ara-kutu { margin-top: 1.6rem; display: grid; gap: 0.4rem; max-width: 30rem; }
  .ara-kutu input { width: 100%; min-height: 48px; padding: 0.65rem 0.9rem; border: 1px solid var(--cizgi-etkilesim); border-radius: var(--radius-kose); background: var(--zemin); color: var(--metin); font: inherit; }
  .ara-kutu input:focus-visible { outline: 2px solid var(--vurgu); outline-offset: 1px; }
  .sonuc-yok { margin-top: 1.2rem; color: var(--metin-2); }

  .dil-serit { margin-top: 1.6rem; }
  .dil-serit ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .dil-cip { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 36px; padding: 0.35rem 0.7rem;
    border: 1px solid var(--cizgi-etkilesim); border-radius: 999px; background: var(--zemin);
    color: var(--metin); text-decoration: none; font-size: 0.88rem; }
  .dil-cip:hover { border-color: var(--vurgu); color: var(--vurgu); }
  /* Sayfanın kendi dili: bölümü zaten açık gelir, şeritte de belli olsun. */
  .dil-cip[aria-current] { border-color: var(--vurgu); color: var(--vurgu); font-weight: 600; }
  .dil-cip:focus-visible { outline: 2px solid var(--vurgu); outline-offset: 2px; }
  .cip-adet { font-family: var(--font-mono); font-size: 0.74rem; color: var(--metin-2); }
  .dil-cip:hover .cip-adet { color: inherit; }

  .grup { border-top: 1px solid var(--cizgi); scroll-margin-top: 5rem; }
  .grup:first-of-type { margin-top: 1.6rem; }
  .grup[hidden] { display: none; }
  .grup > summary { display: flex; align-items: baseline; gap: 0.9rem; padding: 0.95rem 0.2rem; cursor: pointer; list-style: none; min-height: 48px; }
  .grup > summary::-webkit-details-marker { display: none; }
  .grup > summary::before { content: ''; flex: none; width: 9px; height: 9px; align-self: center; margin-right: 0.35rem;
    border-right: 2px solid var(--vurgu); border-bottom: 2px solid var(--vurgu); transform: rotate(-45deg); transition: transform 0.15s; }
