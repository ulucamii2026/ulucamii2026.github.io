---
/** Kur'an kursu online kayıt bandı — ana sayfada sürekli görünür (kayıt yıl boyunca açık).
 *  Ders başlangıcından önce/sonra alt metin otomatik değişir; elle kaldırma gerekmez.
 *
 *  `ikincil`: aynı anda süreli ve acil BAŞKA bir bant (hac ön kaydı) yayındayken bu bant tam dolgu
 *  kiremit yerine nötr zemin + kiremit kenar biçimine geçer. İki tam dolgu bandın (İznik mavisi +
 *  kiremit) hero'nun hemen altında üst üste çarpışması hem göze vuruyor hem aciliyet farkını
 *  siliyordu (4 Eylül 2026 tasarım denetimi). Kayıt yıl boyunca açık, hac ön kaydının son günü var:
 *  görsel ağırlık bu farkı yansıtır. */
import type { Dil } from '../i18n/ui';
import { kayitBaglantisi } from '../i18n/utils';
import { DERS_YILI_ETIKETI } from '../lib/etkinlik-tarihleri';
interface Props { dil: Dil; link?: string; ikincil?: boolean }
const { dil, link, ikincil = false } = Astro.props;
/* Dil tercihi her zaman açıkça taşınır: parametresiz gidilirse formun localStorage'daki eski
   tercihi (çoğu kez fr) galip gelir ve TR sayfadan gelen veli Fransızca form görür. */
const kayitLink = link ? kayitBaglantisi(link, dil) : link;
const DERS_BASLANGIC = new Date('2026-09-05T00:00:00+02:00');
const baslamadi = Date.now() < DERS_BASLANGIC.getTime();
const m = dil === 'tr' ? {
  baslik: `Kur’an Kursu ${DERS_YILI_ETIKETI} — kayıtlar açık`,
  alt: baslamadi
    ? 'Dersler 5 Eylül Cumartesi başlıyor · Kayıt telefonunuzdan 5 dakika sürer'
    : 'Dersler başladı · Kayıt telefonunuzdan 5 dakika sürer',
  dugme: 'Öğrenci Kaydı Yap',
} : dil === 'en' ? {
  baslik: `Qur’an School ${DERS_YILI_ETIKETI} — enrolment open`,
  alt: baslamadi
    ? 'Classes start Saturday 5 September · Registration takes 5 minutes on your phone'
    : 'Classes have started · Registration takes 5 minutes on your phone',
  dugme: 'Register a student',
} : {
  baslik: `Cours de Coran ${DERS_YILI_ETIKETI} — inscriptions ouvertes`,
  alt: baslamadi
    ? 'Rentrée le samedi 5 septembre · Inscription en 5 minutes depuis votre téléphone'
    : 'Les cours ont commencé · Inscription en 5 minutes depuis votre téléphone',
  dugme: 'Inscrire un élève',
};
---
{link && (
  <aside
    class:list={[ikincil ? 'kayit-ikincil' : 'bg-(--color-kiremit) border-y border-(--color-kiremit-koyu)']}
    aria-label={m.baslik}
  >
    <div class:list={['kapsayici flex flex-wrap items-center justify-between gap-x-6 gap-y-3', ikincil ? 'py-3' : 'py-4 sm:py-5']}>
      <p class:list={['min-w-0', ikincil ? 'text-(--metin)' : 'text-(--color-krem)']}>
        <strong class:list={['block font-serif leading-snug', ikincil ? 'text-base sm:text-lg' : 'text-lg sm:text-xl']}>{m.baslik}</strong>
        <span class:list={['block mt-0.5 text-sm', ikincil && 'text-(--metin-2)']}>{m.alt}</span>
      </p>
      <a
        href={kayitLink}
        class:list={['dugme font-bold shrink-0', ikincil ? 'dugme-birincil' : 'bg-(--color-krem) text-(--color-kiremit-koyu) hover:bg-white hover:text-(--color-kiremit-koyu)']}
      >
        {m.dugme}<span aria-hidden="true">&#160;→</span>
      </a>
    </div>
  </aside>
)}

<style>
  /* İkincil biçim: kâğıt zemin, üstte ince kiremit çizgi — bant hâlâ görünür ama sıra beklediği
     bellidir. Renk bağını üst çizgi ve kiremit düğme kuruyor; sol kenara kalın şerit konmuyor:
     bant tam genişlikte olduğu için o şerit ekranın en solunda içerikten kopuk bir çubuk olarak
     duruyordu (VefatBandi ile aynı bant dili: üst çizgi + kâğıt zemin). */
  .kayit-ikincil {
    background: var(--zemin-2);
    border-top: 2px solid var(--color-kiremit);
    border-bottom: 1px solid var(--cizgi);
  }
</style>
