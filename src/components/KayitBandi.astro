---
/** Kur'an kursu online kayıt bandı — ana sayfada sürekli görünür (kayıt yıl boyunca açık).
 *  Ders başlangıcından önce/sonra alt metin otomatik değişir; elle kaldırma gerekmez. */
import type { Dil } from '../i18n/ui';
import { kayitBaglantisi } from '../i18n/utils';
interface Props { dil: Dil; link?: string }
const { dil, link } = Astro.props;
/* Dil tercihi her zaman açıkça taşınır: parametresiz gidilirse formun localStorage'daki eski
   tercihi (çoğu kez fr) galip gelir ve TR sayfadan gelen veli Fransızca form görür. */
const kayitLink = link ? kayitBaglantisi(link, dil) : link;
const DERS_BASLANGIC = new Date('2026-09-05T00:00:00+02:00');
const baslamadi = Date.now() < DERS_BASLANGIC.getTime();
const m = dil === 'tr' ? {
  baslik: 'Kur’an Kursu 2026–2027 — kayıtlar açık',
  alt: baslamadi
    ? 'Dersler 5 Eylül Cumartesi başlıyor · Kayıt telefonunuzdan 5 dakika sürer'
    : 'Dersler başladı · Kayıt telefonunuzdan 5 dakika sürer',
  dugme: 'Öğrenci Kaydı Yap',
} : dil === 'en' ? {
  baslik: 'Qur’an School 2026–2027 — enrolment open',
  alt: baslamadi
    ? 'Classes start Saturday 5 September · Registration takes 5 minutes on your phone'
    : 'Classes have started · Registration takes 5 minutes on your phone',
  dugme: 'Register a student',
} : {
  baslik: 'Cours de Coran 2026–2027 — inscriptions ouvertes',
  alt: baslamadi
    ? 'Rentrée le samedi 5 septembre · Inscription en 5 minutes depuis votre téléphone'
    : 'Les cours ont commencé · Inscription en 5 minutes depuis votre téléphone',
  dugme: 'Inscrire un élève',
};
---
{link && (
  <aside class="bg-(--color-kiremit) border-y border-(--color-kiremit-koyu)" aria-label={m.baslik}>
    <div class="kapsayici py-4 sm:py-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <p class="min-w-0 text-(--color-krem)">
        <strong class="block font-serif text-lg sm:text-xl leading-snug">{m.baslik}</strong>
        <span class="block mt-0.5 text-sm">{m.alt}</span>
      </p>
      <a href={kayitLink} class="dugme bg-(--color-krem) text-(--color-kiremit-koyu) font-bold hover:bg-white hover:text-(--color-kiremit-koyu) shrink-0">
        {m.dugme}<span aria-hidden="true"> →</span>
      </a>
    </div>
  </aside>
)}
