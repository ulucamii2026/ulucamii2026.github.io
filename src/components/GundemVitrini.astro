---
import { getCollection } from 'astro:content';
import { duyurular, icerikDili } from '../lib/icerik';
import { vitrinSec, type VitrinAdayi } from '../lib/vitrin-secimi';
import { yol, tarihBicimle } from '../i18n/utils';
import { yollar, type Dil, type SayfaAnahtari } from '../i18n/ui';
import Ikon from './Ikon.astro';
import { gorselOlcu, kucukSurum } from '../lib/gorsel';
import '../styles/gundem-vitrini.css';

interface Props { dil: Dil; siteAdi: string; }
const { dil, siteAdi } = Astro.props;

const m = {
  tr: {
    baslik: 'Camimizde Gündem',
    afis: 'Afişi büyüt',
    kapat: 'Kapat',
    detay: 'Detayları Gör',
    incele: 'İncele',
    once: 'Önceki',
    sonra: 'Sonraki',
    durdur: 'Otomatik geçişi durdur',
    oynat: 'Otomatik geçişi başlat',
    tur: { duyuru: 'Duyuru', afis: 'Afiş' },
    fallbackOzet: 'Camimizde ibadet, eğitim ve buluşmalar.',
  },
  fr: {
    baslik: 'Actualités',
    afis: 'Agrandir l’affiche',
    kapat: 'Fermer',
    detay: 'Détails',
    incele: 'Voir plus',
    once: 'Précédent',
    sonra: 'Suivant',
    durdur: 'Arrêter le défilement',
    oynat: 'Démarrer le défilement',
    tur: { duyuru: 'Annonce', afis: 'Affiche' },
    fallbackOzet: 'Prières, enseignement et rassemblements dans notre mosquée.',
  },
  en: {
    baslik: 'Latest News',
    afis: 'Enlarge poster',
    kapat: 'Close',
    detay: 'View Details',
    incele: 'Read more',
    once: 'Previous',
    sonra: 'Next',
    durdur: 'Stop autoplay',
    oynat: 'Start autoplay',
    tur: { duyuru: 'Announcement', afis: 'Poster' },
    fallbackOzet: 'Worship, education, and community gatherings at our mosque.',
  },
}[dil];

const enKaynakMetni = dil === 'en' ? 'These publications are available in French; posters may also contain Turkish.' : '';

const haberler = await duyurular(dil);
const afisler = await getCollection('afisler', ({ data }) => !data.taslak);
const adaylar: VitrinAdayi[] = [
  ...haberler.map(d => ({ ...d.data, id: d.id, baslik: d.data.baslik, ozet: d.data.ozet ?? '', gorsel: d.data.kapak ?? '', href: yol(dil, 'duyurular', d.slug), tur: 'duyuru' as const, dil: icerikDili(dil) })),
  ...afisler.map(a => ({ ...a.data, id: a.id, baslik: a.data.baslik[icerikDili(dil)] ?? a.data.baslik.tr, ozet: '', gorsel: a.data.gorsel,
    href: a.data.sayfa && a.data.sayfa in yollar ? yol(dil, a.data.sayfa as SayfaAnahtari) : a.data.link ?? a.data.gorsel,
    tur: 'afis' as const, dil: a.data.baslik[icerikDili(dil)] ? icerikDili(dil) : 'tr' })),
];
const secilenler = vitrinSec(adaylar);
const egitimPortalIlgiliMi = (y: VitrinAdayi) => {
  const metin = `${y.baslik} ${y.ozet} ${y.href} ${y.id}`.toLowerCase();
  return /(e[gğ]itim|kuran\s*kursu|kur['’]an\s*kursu|veli|portal|m[uü]fredat|\b(cours|formation|portail|parent|apprentissage|scolaire)\b)/i.test(metin);
};
const yayinlar = secilenler.map(y => {
  if (y.tur === 'duyuru' && !y.gorsel && egitimPortalIlgiliMi(y)) {
    return { ...y, gorsel: '/media/vitrin/egitim-veli-portali.webp' };
  }
  return y;
});
const hamKareler = yayinlar.length ? yayinlar : [{ id: 'cami', baslik: siteAdi, ozet: m.fallbackOzet, gorsel: '/media/hero/hero-1.webp', href: yol(dil, 'hakkimizda'), tarih: new Date(), tur: 'duyuru' as const, dil }];

const kareler = await Promise.all(hamKareler.map(async (k) => {
  const olcu = k.gorsel ? await gorselOlcu(k.gorsel) : null;
  const thumbGorsel = k.gorsel ? (kucukSurum(k.gorsel) ?? k.gorsel) : null;
  return {
    ...k,
    genislik: olcu?.genislik ?? 800,
    yukseklik: olcu?.yukseklik ?? 1131,
    thumbGorsel,
  };
}));
---

<section class="gv-kapsayici" role="region" aria-roledescription="carousel" aria-label={m.baslik}>
  <div class="gv-ust sr-only">
    <h1>{siteAdi}</h1>
  </div>
  {enKaynakMetni && <p class="gv-dil-notu">{enKaynakMetni}</p>}

  <div class="gv-kontrol-satiri">
    <div class="gv-kontrol-baslik">
      <span>{m.baslik}</span>
    </div>
    {kareler.length > 1 && (
      <div class="gv-kontroller">
        <button class="gv-play-pause" id="gv-play-pause" type="button" aria-label={m.durdur} data-oynat={m.oynat} data-durdur={m.durdur}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="gv-icon-pause"><path d="M8 5v14M16 5v14"/></svg>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="gv-icon-play" style="display:none;"><path d="m8 5 11 7-11 7Z"/></svg>
        </button>
        <button type="button" class="gv-prev" aria-label={m.once}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="gv-next" aria-label={m.sonra}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    )}
  </div>

  <div class="gv-sahne" id="gv-main-embla">
    <div class="gv-sahne__container">
      {kareler.map((k, idx) => {
        const slideBaslikLang = k.dil && k.dil !== dil ? k.dil : undefined;
        return (
          <article class="gv-sahne__slide" role="group" aria-roledescription="slide" aria-label={`${idx+1} / ${kareler.length}`} data-index={idx} aria-hidden={idx !== 0 ? 'true' : 'false'} inert={idx !== 0 ? true : undefined}>
            <div class="gv-sahne-icerik">
              <div class="gv-metin">
                <h2 lang={slideBaslikLang} class="gv-baslik">{k.baslik}</h2>
                <p class="gv-tarih">{m.tur[k.tur]} <span aria-hidden="true">·</span> <time datetime={k.tarih.toISOString()}>{tarihBicimle(k.tarih, dil)}</time></p>
                {k.ozet && <p class="gv-ozet" lang={k.dil}>{k.ozet}</p>}
                <div class="gv-aksiyonlar">
                  <a href={k.href} class="gv-detay-btn">{k.tur === 'duyuru' ? m.detay : m.incele}</a>
                </div>
              </div>
              <div class="gv-gorsel-kutu" style={idx === 0 && k.gorsel ? `--gv-afis-bg: url('${k.gorsel}')` : undefined}>
                {k.gorsel ? (
                  <div class="gv-gorsel-wrapper">
                    <img
                      src={idx === 0 ? k.gorsel : 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs='}
                      data-afis-src={idx === 0 ? undefined : k.gorsel}
                      alt={k.baslik}
                      class="gv-afis"
                      width={k.genislik}
                      height={k.yukseklik}
                      fetchpriority={idx === 0 ? "high" : "low"}
                      loading={idx === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <a
                      href={k.gorsel}
                      class="gv-afis-btn"
                      aria-label={m.afis}
                      data-afis-url={k.gorsel}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                    </a>
                  </div>
                ) : (
                  <div class="gv-bos-gorsel"><Ikon ad="belge" boyut={96} /></div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  {kareler.length > 1 && (
    <div class="gv-alt-serit">
      <div class="gv-filmseridi" id="gv-thumbs-embla">
        <div class="gv-filmseridi__container">
          {kareler.map((k, idx) => (
            <a
              href={k.href}
              class="gv-thumb"
              data-index={idx}
              aria-current={idx === 0 ? 'true' : undefined}
            >
              <div class="gv-thumb-gorsel-kutu">
                {k.thumbGorsel ? (
                  <img
                    src={k.thumbGorsel}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    width="40"
                    height="56"
                  />
                ) : (
                  <Ikon ad="belge" boyut={24} />
                )}
              </div>
              <span class="gv-thumb-baslik" lang={k.dil !== dil ? k.dil : undefined}>{k.baslik}</span>
              <div class="gv-thumb-cizgi"></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <dialog id="gv-dialog" class="gv-dialog" aria-label={m.afis}>
    <div class="gv-dialog-icerik">
      <form method="dialog" class="gv-dialog-form">
        <button type="submit" class="gv-kapat-btn" aria-label={m.kapat}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </form>
      <img id="gv-dialog-img" src={kareler[0]?.gorsel || '/media/hero/hero-1.webp'} alt={kareler[0]?.baslik || siteAdi} />
    </div>
  </dialog>

  <div class="sr-only" aria-live="polite" aria-atomic="true" id="gv-aria-live"></div>
</section>

<script src="../scripts/gundem-vitrini.ts"></script>
