---
import { tarihBicimle, yol, ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
import { gorselOlcu, cerceve, oranCss, kucukSurum } from '../lib/gorsel';
/** `sira`: ızgaradaki kardeş sırası — verilirse kart kaydırma-belirmeye katılır (60 ms basamak). */
interface Props {
  dil: Dil; slug: string; baslik: string; baslangic: Date; bitis?: Date; saat?: string; yer?: string;
  afis?: string; afisKucuk?: string; galeri?: Array<{ dosya: string; kucuk?: string; alt?: string }>;
  ozet?: string; kategori?: string; sira?: number;
  /** Tek etkinlik varken ızgara yerine geniş, yatay kart (afiş solda) */
  yatay?: boolean;
  /** Başlık düzeyi: kart bir h3 alt bölümün İÇİNDEyse h4 olmalı (hiyerarşi düzleşmesin) */
  baslikSeviye?: 'h3' | 'h4';
}
const { dil, slug, baslik, baslangic, bitis, saat, yer, afis, afisKucuk, galeri, ozet, kategori, sira, yatay = false, baslikSeviye = 'h3' } = Astro.props;
const t = ceviri(dil);
const href = yol(dil, 'etkinlikler', slug);
const tamKapak = afis ?? galeri?.[0]?.dosya;
const kapak = afisKucuk ?? galeri?.[0]?.kucuk ?? kucukSurum(tamKapak) ?? tamKapak;
/* Afişler neredeyse hep DİKEYdir (A4 ≈ 0,71 · sosyal medya 4:5). Sabit 16:9 kutu + object-contain
   afişi minicik bırakıp iki yanında geniş boşluk açıyordu (4 Eylül 2026 ekran denetimi). Çerçeve
   artık görselin kendi oranını alır: ne kırpma ne boşluk. Ölçülemezse eski davranış (16:9) sürer. */
const olcu = await gorselOlcu(kapak);
const kutu = cerceve(olcu);
const Baslik = baslikSeviye;
const tarihStr = bitis && bitis.getTime() !== baslangic.getTime()
  ? `${tarihBicimle(baslangic, dil, { day: 'numeric', month: 'long' })} – ${tarihBicimle(bitis, dil)}`
  : tarihBicimle(baslangic, dil);
---
<article
  class:list={['kart overflow-hidden', yatay ? 'grid sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] items-start sm:items-center' : 'flex flex-col', sira !== undefined && 'reveal']}
  style={sira === undefined ? undefined : `--i:${sira % 3}`}
>
  {kapak && (
    <a
      href={href}
      class:list={['block bg-(--zemin-3) overflow-hidden border-(--cizgi)', yatay ? 'border-b sm:border-b-0 sm:border-e' : 'border-b']}
      style={`aspect-ratio:${oranCss(kutu.oran)}`}
    >
      <img src={kapak} alt={baslik} loading="lazy" decoding="async"
        width={olcu?.genislik} height={olcu?.yukseklik}
        class:list={['w-full h-full', kutu.oturma === 'cover' ? 'object-cover' : 'object-contain']} />
    </a>
  )}
  <div class="p-5 flex flex-col gap-2 flex-1">
    <p class="etiket">{kategori && kategori !== 'genel' && <span class="etiket-vurgu">{t(`kategori.${kategori}` as any)} · </span>}<time datetime={baslangic.toISOString()}>{tarihStr}</time>{saat && <span> · {saat}</span>}</p>
    <Baslik class="leading-snug"><a href={href} class="no-underline text-(--metin) hover:text-(--vurgu)">{baslik}</a></Baslik>
    {yer && <p class="text-sm text-(--metin-2)">{t('etkinlik.yer')}: {yer}</p>}
    {ozet && <p class:list={['text-sm text-(--metin-2)', yatay ? 'line-clamp-4' : 'line-clamp-3']}>{ozet}</p>}
    <a href={href} class="mt-auto pt-2 min-h-11 inline-flex items-center text-sm font-semibold no-underline hover:underline">{t('genel.daha')}<span aria-hidden="true">&#160;→</span></a>
  </div>
</article>
