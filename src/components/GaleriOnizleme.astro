---
/** Ana sayfa galeri mozaiği: 5 fotoğraf, ilki büyük */
import Ikon from './Ikon.astro';
import { yol, ceviri } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil; fotolar: { data: { dosya: string; kucuk?: string; alt: { tr: string; fr: string } } }[] }
const { dil, fotolar } = Astro.props; const t = ceviri(dil);
const secim = fotolar.slice(0, 5);
const baslik = dil === 'tr' ? 'Camimizden kareler' : 'Images de la mosquée';
const hepsi = dil === 'tr' ? 'Tüm galeri' : 'Toute la galerie';
---
<section class="kapsayici py-12 sm:py-16" aria-labelledby="galeri-baslik">
  <div class="flex items-end justify-between gap-3 mb-6 cetvel pt-4">
    <h2 id="galeri-baslik">{baslik}</h2>
    <a href={yol(dil, 'galeri')} class="inline-flex items-center gap-1.5 text-sm font-semibold no-underline hover:underline">{hepsi} <Ikon ad="ok" class="h-4 w-4" /></a>
  </div>
  <ul class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 gap-2 sm:gap-3" role="list">
    {secim.map((g, i) => (
      <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
        <a href={g.data.dosya} target="_blank" rel="noopener" class="gorsel-cerceve block h-full overflow-hidden group" aria-label={g.data.alt[dil]}>
          <img src={i === 0 ? g.data.dosya : (g.data.kucuk ?? g.data.dosya)} alt={g.data.alt[dil]} loading="lazy" decoding="async" width={i === 0 ? 1600 : 480} height={i === 0 ? 1200 : 360} class="h-full w-full object-cover aspect-[4/3] transition-transform duration-500 ease-out group-hover:scale-[1.03]" />
        </a>
      </li>
    ))}
  </ul>
</section>
