---
/**
 * Dil bayrağı — küçük inline SVG: tr → Türkiye, fr → Belçika, en → Birleşik Krallık.
 * Dekoratif kullanım (aria-hidden); erişilebilir ad her zaman metinle birlikte verilir.
 */
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil; class?: string }
const { dil, class: sinif = 'h-3.5 w-5' } = Astro.props;
---
{dil === 'tr' && (
  <svg class={sinif} viewBox="0 0 30 20" aria-hidden="true" focusable="false">
    <rect width="30" height="20" fill="#E30A17" />
    <circle cx="11" cy="10" r="5" fill="#fff" />
    <circle cx="12.25" cy="10" r="4" fill="#E30A17" />
    <polygon fill="#fff" points="19.70,10.00 17.97,10.56 17.97,12.38 16.90,10.91 15.18,11.47 16.25,10.00 15.18,8.53 16.90,9.09 17.97,7.62 17.97,9.44" />
  </svg>
)}
{dil === 'fr' && (
  <svg class={sinif} viewBox="0 0 30 20" aria-hidden="true" focusable="false">
    <rect width="10" height="20" fill="#2D2926" />
    <rect x="10" width="10" height="20" fill="#FFCD00" />
    <rect x="20" width="10" height="20" fill="#C8102E" />
  </svg>
)}
{dil === 'en' && (
  <svg class={sinif} viewBox="0 0 30 20" aria-hidden="true" focusable="false">
    <rect width="30" height="20" fill="#012169" />
    <path d="M0,0 30,20 M30,0 0,20" stroke="#fff" stroke-width="4" />
    <path d="M0,0 30,20 M30,0 0,20" stroke="#C8102E" stroke-width="1.6" />
    <path d="M15,0 V20 M0,10 H30" stroke="#fff" stroke-width="6.6" />
    <path d="M15,0 V20 M0,10 H30" stroke="#C8102E" stroke-width="4" />
  </svg>
)}
