        giris: 'Kur’an’dan fetvaya, elifbâdan ansiklopediye — Diyanet İşleri Başkanlığı’nın herkese açık ve ücretsiz portalları. Her kartta içeriğin dili yazılıdır.',
        dilEtiketi: 'Dil', dis: 'yeni sekmede açılır' },
  fr: { etiket: 'Ressources du Diyanet', baslik: 'Les services en ligne du Diyanet',
        giris: 'Du Coran aux fatwas, de l’alphabet arabe à l’encyclopédie — les portails publics et gratuits de la Présidence des Affaires religieuses. La langue du contenu est indiquée sur chaque carte.',
        dilEtiketi: 'Langue', dis: 'ouvre dans un nouvel onglet' },
  en: { etiket: 'Diyanet resources', baslik: 'Diyanet’s Online Services',
        giris: 'From the Qur’an to fatwas, from the Arabic alphabet to the encyclopaedia — the free public portals of the Presidency of Religious Affairs. Each card states the language of the content.',
        dilEtiketi: 'Language', dis: 'opens in a new tab' },
  nl: { etiket: 'Bronnen van het Diyanet', baslik: 'De onlinediensten van het Diyanet',
        giris: 'Van de Koran tot de fatwa’s, van het Arabische alfabet tot de encyclopedie — de gratis en voor iedereen toegankelijke portalen van het Presidium voor Religieuze Zaken. Op elke kaart staat in welke taal de inhoud is.',
        dilEtiketi: 'Taal', dis: 'opent in een nieuw tabblad' },
  de: { etiket: 'Quellen des Diyanet', baslik: 'Die Onlinedienste des Diyanet',
        giris: 'Vom Koran bis zu den Fatwas, vom arabischen Alphabet bis zur Enzyklopädie — die kostenlosen, öffentlich zugänglichen Portale des Präsidiums für Religiöse Angelegenheiten. Auf jeder Karte steht, in welcher Sprache der Inhalt ist.',
        dilEtiketi: 'Sprache', dis: 'öffnet in einem neuen Tab' },
};

const m = M[dil];
const alan = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

<section id="diyanet-hizmetleri" class="hizmetler">
  <div class="kapsayici">
    <p class="etiket etiket-vurgu">{m.etiket}</p>
    <h2 class="baslik">{m.baslik}</h2>
    <p class="giris">{m.giris}</p>

    <ul class="izgara">
      {HIZMETLER.map((h) => (
        <li class="kart">
          <a href={h.url} target="_blank" rel="noopener noreferrer">
            <h3>{h.ad[dil]}<span aria-hidden="true"> ↗</span><span class="sr-only"> — {m.dis}</span></h3>
            <p class="aciklama">{h.aciklama[dil]}</p>
            <p class="etiket meta">
              <span class="diller">{h.diller.join(' · ')}</span>
              <span class="alan">{alan(h.url)}</span>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hizmetler { border-top: 1px solid var(--cizgi); padding: 3.5rem 0 1rem; }
  .hizmetler .baslik { font-family: var(--font-serif, Lora, serif); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2rem); margin-top: 0.4rem; }
  .hizmetler .giris { max-width: 68ch; margin-top: 0.8rem; color: var(--metin-2); }

  .izgara { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.85rem; }
  @media (min-width: 40rem) { .izgara { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .izgara { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .kart { display: flex; min-width: 0; }
  .kart > a { display: flex; flex-direction: column; min-width: 0; width: 100%; padding: 1.05rem 1.15rem 0.9rem; text-decoration: none; color: inherit; border-radius: inherit; }
  .kart > a:hover h3 { color: var(--vurgu); }
  .kart > a:focus-visible { outline: 2px solid var(--vurgu); outline-offset: 2px; }
  .kart h3 { font-family: var(--font-serif, Lora, serif); font-size: 1.02rem; line-height: 1.35; margin: 0; }
  .aciklama { margin: 0.5rem 0 0; font-size: 0.92rem; color: var(--metin-2); }
  .meta { margin-top: auto; padding-top: 0.9rem; display: flex; gap: 0.75rem; align-items: baseline; }
  .diller { color: var(--vurgu); }
  .alan { margin-left: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
