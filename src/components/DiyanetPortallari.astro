---
/**
 * Diyanet'in çevrimiçi hizmetleri — ihtida sayfasının altındaki bağlantı kartları.
 *
 * NEDEN AYRI BİR BÖLÜM: kütüphanedeki PDF'ler tek tek yayınlar; burada ise sürekli
 * güncellenen portallar var (mushaf, elifbâ, radyo, fetva, ansiklopedi). Yeni Müslüman
 * olan biri «namazı nasıl kılacağım / bu soruyu kime soracağım» diye baktığında bunlar
 * kitaptan daha hızlı cevap verir.
 *
 * DİL ETİKETİ ZORUNLU: bu portalların neredeyse tamamı YALNIZ TÜRKÇE. Fransızca konuşan
 * bir ziyaretçiyi etiketsiz Türkçe siteye göndermek kötü bir deneyim; her kartta hangi
 * dilde olduğu yazıyor. Diyanet'in diyanet.gov.tr/fr-FR, /en-US, /nl-NL adresleri
 * 8 Eyl 2026'da Türkçe ana sayfaya yönleniyordu — bu yüzden listede yoklar.
 *
 * Bağlantılar `npm run denetim:baglanti` kapsamındadır (dijital.diyanet.gov.tr hariç,
 * o `npm run denetim:diyanet` ile denetlenir).
 */
import type { Dil } from '../i18n/ui';

interface Props { dil: Dil }
const { dil } = Astro.props;

type Metin = Record<Dil, string>;
interface Hizmet { url: string; ad: Metin; aciklama: Metin; diller: string[] }

