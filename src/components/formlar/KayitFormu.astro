        <label for={`k-g-kimlik-${id}`}>{ad}{id === 'on' ? <span class="zorunlu" aria-hidden="true"> *</span> : <span class="k-istege">{o.istegeBagli}</span>}</label>
        <input id={`k-kimlik-${id}`} type="hidden" name={`kimlik.${id}`} value="" />
