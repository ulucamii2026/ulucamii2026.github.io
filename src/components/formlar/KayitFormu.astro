            </div>
          </div>
          <p id={`k-kimlik-${id}-durum`} class="g-durum" aria-live="polite"><svg class="k-alindi-ikon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span data-durum></span></p>
        </div>
        <div class="g-eylem"><input id={`k-g-kimlik-${id}`} type="file" accept="image/*" class="sr-only" aria-describedby={`k-kimlik-${id}-durum k-kimlik-${id}-hata`} /><label class:list={['dugme', id === 'on' ? 'dugme-birincil' : 'dugme-ikincil', 'g-sec']} for={`k-g-kimlik-${id}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ikonlar.kamera} /><span data-sec={v3.sec} data-degistir={v3.degistir}>{v3.sec}</span></label><button type="button" class="dugme dugme-ikincil" data-kaldir hidden>{v3.kaldir}</button></div>
        <p id={`k-kimlik-${id}-hata`} class="hata" aria-live="polite" hidden></p>
      </div>)}
      <p class="yardim tam">{v3.yenile}</p>
    </div>
