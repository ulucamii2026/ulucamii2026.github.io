  <div class="k-sonraki"><h3>{v3.adimlar}</h3><ol>
    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={ikonlar.eposta} /><div><strong>{v3.tasarim.epostaKontrol}</strong><p data-eposta-metin></p><p class="yardim">{o.basari.spamNotu}</p></div></li>
    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><circle cx="8" cy="10" r="2" /><path d="M4 17c0-6 8-6 8 0m3-7h4m-4 5h4" /></svg><div><p data-kimlik-adim></p><a class="dugme dugme-ikincil" data-kimlik-baglanti hidden></a><p class="yardim" data-kimlik-sonradan>{v3.sonradan}</p></div></li>
    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={ikonlar.kitap} /><p>{k.basari.sonrakiAdimlar}</p></li>
  </ol></div>
  <p class="text-sm" style="color: var(--metin-2)">{doldur(o.basari.iletisim, { eposta, telefon })} · {o.basari.whatsappImam}: <WhatsappBaglanti site={waSite} /></p>
