      <div class="k-ilerleme-cubuk" role="progressbar" aria-label={v3.ray} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
      <p class="k-tesvik" data-tesvik aria-live="polite"></p>
    </nav>
    <div class="k-ray-destek">
      <h3>{v3.tasarim.nasil}</h3>
      <ol class="k-nasil">{(['doldur', 'gonder', 'pdf'] as const).map((ad, i) => <li><span aria-hidden="true">{i + 1}</span>{v3.tasarim[ad]}</li>)}</ol>
      <div class="k-guvence"><h3>{v3.tasarim.guvence}</h3><ul>{[v3.tasarim.ucretsiz, v3.tasarim.sure, v3.tasarim.veri].map(ad => <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>{ad}</li>)}</ul><a href={yol(dil, 'gizlilik')} target="_blank" rel="noopener">{o.gizlilikKutu.gizlilikSayfa}</a></div>
      <div class="k-ray-iletisim"><h3>{v3.tasarim.iletisim}</h3><a href={`mailto:${eposta}`}>{eposta}</a><a href={`tel:${telefon.replace(/[^+\d]/g, '')}`}>{telefon}</a><span class="k-ray-wa"><span>{o.basari.whatsappImam}</span><WhatsappBaglanti site={waSite} /></span></div>
    </div>
  </aside>
</form>

