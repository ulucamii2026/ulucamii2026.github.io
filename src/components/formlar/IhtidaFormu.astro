---
/** İhtida başvuru formu (v3, 8 Eylül 2026) — tek sayfa, yedi bölüm, sunucu tarafı PDF.
    EK-9 belgesinin gerektirdiği alanlar (Diyanet şablonu) toplanır. 30 Ağustos 2026'da kaldırılan
    görsel/imza toplama 8 Eylül 2026'da Rıdvan'ın kararıyla YALNIZ BU FORMA geri kondu: vesikalık,
    kimlik belgesinin ön/arka yüzü ve ekranda çizilen imza (5. bölüm). Kimlik NUMARASI hâlâ
    sorulmaz; MRZ/OCR okuyucu geri gelmedi. Çocuk kayıt formu eski kuralda kalır.
    Davranış: src/scripts/ihtida-form.ts + src/scripts/ihtida-gorseller.ts */
import type { Dil } from '../../i18n/ui';
import { yol } from '../../i18n/utils';
import { formMetinleri, doldur } from '../../i18n/formlar';
import IhtidaCamiSecimi from './IhtidaCamiSecimi.astro';
import { camiMetinleri } from '../../i18n/cami-secimi';
import IhtidaAdimlar from './IhtidaAdimlar.astro';
import { ihtidaAdimMetinleri } from '../../i18n/ihtida-adimlari';
import '../../styles/ihtida-adimlari.css';

interface Props { dil: Dil; uc: string; eposta: string; telefon: string; ek10Yolu: string }
const { dil, uc, eposta, telefon, ek10Yolu } = Astro.props;
const m = formMetinleri(dil);
const h = m.ihtida, o = m.ortak;
const adimMetin = ihtidaAdimMetinleri[dil];

const bugun = new Date();
const tarihStr = (d: Date) => d.toISOString().slice(0, 10);
const dogumMin = tarihStr(new Date(bugun.getFullYear() - 110, 0, 1));
const dogumMax = tarihStr(new Date(bugun.getFullYear() - 16, bugun.getMonth(), bugun.getDate()));

const metinJson = JSON.stringify({
  hata: o.hata, basari: { gonderiliyor: o.gonderiliyor, epostaGitti: h.paketBildirimi },
  taslakGeriYuklendi: o.taslakGeriYuklendi, taslakSilindi: o.taslakSilindi, evet: o.evet, hayir: o.hayir, bosDeger: o.bosDeger,
});

const b = h.belgeler;
// Görsel yükleyicinin ihtiyaç duyduğu metinler (ihtida-gorseller.ts → BelgeMetinleri).
const belgeJson = JSON.stringify({
  isleniyor: b.isleniyor, hazir: b.hazir,
  hataTur: b.hataTur, hataBoyut: b.hataBoyut, hataOkunamadi: b.hataOkunamadi, hataImza: b.hataImza, hataEksik: b.hataEksik,
  vesikalik: b.vesikalik, kimlikOn: b.kimlikOn, kimlikArka: b.kimlikArka, imza: b.imza, onizleme: b.onizleme,
});

/** Üç yükleme kutusu aynı iskeleti paylaşır; arka yüz yalnız kimlik kartı seçiliyken görünür. */
const gorselKutulari = [
  { anahtar: 'vesikalik', id: 'i-g-vesikalik', etiket: b.vesikalik, yardim: b.vesikalikYardim, kosul: undefined },
  { anahtar: 'kimlikOn', id: 'i-g-kimlik-on', etiket: b.kimlikOn, yardim: b.kimlikOnYardim, kosul: undefined },
  { anahtar: 'kimlikArka', id: 'i-g-kimlik-arka', etiket: b.kimlikArka, yardim: b.kimlikArkaYardim, kosul: 'belgeTuru=kimlik' },
] as const;
---
<div class="ucf-giris" data-form-ust>
  <p>{adimMetin.bilgi}</p>
  <details class="ucf-hazirlik"><summary>{adimMetin.hazirlik}</summary><p>{adimMetin.hazirlikNotu}</p><p>{h.kimlikNotu}</p></details>
</div>

<form class="ucf mt-8" data-form="ihtida" data-dil={dil} data-uc={uc} data-sir="ULUCAMII-IHTIDA-2026"
      data-asgari-servis-surumu="27"
      data-taslak="ulucamii:ihtida:v2" data-eposta-alani="basvuran.eposta" data-evet={o.evet} data-hayir={o.hayir}
      novalidate autocomplete="on" aria-describedby="i-giris-not">
  <script type="application/json" data-metin set:html={metinJson} />
  <script type="application/json" data-metin-belge set:html={belgeJson} />

  <!-- Honeypot: botlara görünür, gerçek kullanıcıya görünmez alan (spam süzgeci) -->
  <div style="position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
    <label for="i-web">Web sitenizi bırakmayın</label>
    <input type="text" id="i-web" name="web" tabindex="-1" autocomplete="off" />
  </div>

  <div class="ucf-taslak" data-taslak-not hidden>
    <span>{o.taslakGeriYuklendi}</span>
    <button type="button" data-taslak-sil>{o.taslakSil}</button>
  </div>
  <div class="ucf-mesaj" data-mesaj data-tur="hata" role="alert" hidden></div>

  <IhtidaAdimlar dil={dil} />

  <IhtidaCamiSecimi dil={dil} />

  <!-- 1 · Kişisel bilgiler -->
  <section class="ucf-bolum" id="b-kisi" aria-labelledby="h-kisi">
    <h2 id="h-kisi"><span class="no">1</span>{h.bolum.kisi}</h2>
    <p id="i-giris-not" class="bolum-not"><span class="zorunlu">*</span> {o.zorunluIsaret}</p>
    <div class="ucf-izgara">
      <div data-alan class="tam">
        <label for="i-ad">{h.kisi.adSoyad} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-ad" name="basvuran.adSoyad" type="text" required maxlength="80" autocomplete="name" autocapitalize="words" />
        <p class="yardim">{h.kisi.adSoyadYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <fieldset data-alan>
        <legend>{h.kisi.cinsiyet} <span class="zorunlu" aria-hidden="true">*</span></legend>
        <div class="secenekler">
          <span class="secenek"><input id="i-cins-kadin" type="radio" name="basvuran.cinsiyet" value="kadin" required /><label for="i-cins-kadin">{h.kisi.kadin}</label></span>
          <span class="secenek"><input id="i-cins-erkek" type="radio" name="basvuran.cinsiyet" value="erkek" /><label for="i-cins-erkek">{h.kisi.erkek}</label></span>
        </div>
        <p class="hata" aria-live="polite" hidden></p>
      </fieldset>
      <div data-alan>
        <label for="i-dogum">{h.kisi.dogumTarihi} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-dogum" name="basvuran.dogumTarihi" type="date" required data-tur="tarih" data-yas-min="16" data-yas-max="110" min={dogumMin} max={dogumMax} autocomplete="bday" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-dogum-yeri">{h.kisi.dogumYeri} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-dogum-yeri" name="basvuran.dogumYeri" type="text" required maxlength="80" placeholder={h.kisi.dogumYeriYardim} />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-uyruk">{h.kisi.uyruk} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-uyruk" name="basvuran.uyruk" type="text" required maxlength="60" autocomplete="country-name" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-anne">{h.kisi.anneAdi} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-anne" name="basvuran.anneAdi" type="text" required maxlength="80" autocomplete="off" autocapitalize="words" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-baba">{h.kisi.babaAdi} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-baba" name="basvuran.babaAdi" type="text" required maxlength="80" autocomplete="off" autocapitalize="words" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- 2 · Durum -->
  <section class="ucf-bolum" id="b-durum" aria-labelledby="h-durum">
    <h2 id="h-durum"><span class="no">2</span>{h.bolum.durum}</h2>
    <div class="ucf-izgara">
      <div data-alan>
        <label for="i-medeni">{h.durum.medeniHali} <span class="zorunlu" aria-hidden="true">*</span></label>
        <select id="i-medeni" name="basvuran.medeniHali" required>
          <option value="">{o.seciniz}</option>
          <option value="bekar">{h.durum.bekar}</option>
          <option value="evli">{h.durum.evli}</option>
          <option value="dul">{h.durum.dul}</option>
          <option value="bosanmis">{h.durum.bosanmis}</option>
        </select>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-ogrenim">{h.durum.ogrenim} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-ogrenim" name="basvuran.ogrenimDurumu" type="text" required maxlength="80" placeholder={h.durum.ogrenimYardim} />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <label for="i-meslek">{h.durum.meslek} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-meslek" name="basvuran.meslek" type="text" required maxlength="80" autocomplete="organization-title" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- 3 · İletişim -->
  <section class="ucf-bolum" id="b-iletisim" aria-labelledby="h-iletisim">
    <h2 id="h-iletisim"><span class="no">3</span>{h.bolum.iletisim}</h2>
    <div class="ucf-izgara">
      <div data-alan>
        <label for="i-eposta">{h.iletisim.eposta} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-eposta" name="basvuran.eposta" type="email" required data-tur="eposta" maxlength="120" autocomplete="email" inputmode="email" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-telefon">{h.iletisim.telefon} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-telefon" name="basvuran.telefon" type="tel" required data-tur="telefon" maxlength="24" autocomplete="tel" inputmode="tel" placeholder="+32 470 12 34 56" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <label for="i-adres">{h.iletisim.adres} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-adres" name="basvuran.adres" type="text" required maxlength="200" autocomplete="street-address" placeholder={h.iletisim.adresYardim} />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      {([
        ['posta-kodu', 'postaKodu', h.iletisim.postaKodu, 'postal-code', 20],
        ['sehir', 'sehir', h.iletisim.sehir, 'address-level2', 80],
        ['ulke', 'ulke', h.iletisim.ulke, 'country-name', 60],
      ] as const).map(([id, ad, etiket, otomatik, uzunluk]) => (
        <div data-alan>
          <label for={`i-${id}`}>{etiket} <span class="zorunlu" aria-hidden="true">*</span></label>
          <input id={`i-${id}`} name={`basvuran.${ad}`} type="text" required maxlength={uzunluk} autocomplete={otomatik} />
          <p class="hata" aria-live="polite" hidden></p>
        </div>
      ))}
      <fieldset data-alan class="tam">
        <legend>{h.teslimat.baslik} <span class="zorunlu" aria-hidden="true">*</span></legend>
        <p class="yardim">{h.teslimat.aciklama}</p>
        <div class="secenekler">
          <span class="secenek"><input id="i-teslim-cami" type="radio" name="teslimat.yontem" value="cami" required checked /><label for="i-teslim-cami">{h.teslimat.cami}</label></span>
          <span class="secenek"><input id="i-teslim-adres" type="radio" name="teslimat.yontem" value="adres" /><label for="i-teslim-adres">{h.teslimat.adres}</label></span>
        </div>
        <p class="yardim" data-kosul="teslimat.yontem=adres" hidden>{h.teslimat.adresNotu}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </fieldset>
    </div>
  </section>

  <!-- 4 · İhtida ve tören -->
  <section class="ucf-bolum" id="b-ihtida" aria-labelledby="h-ihtida">
    <h2 id="h-ihtida"><span class="no">4</span>{h.bolum.ihtida}</h2>
    <div class="ucf-izgara">
      <div data-alan>
        <label for="i-onceki-din">{h.ihtida.oncekiDin} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-onceki-din" name="basvuran.oncekiDin" type="text" required maxlength="80" placeholder={h.ihtida.oncekiDinYardim} />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-yeni-isim">{h.ihtida.yeniIsim} <span class="istege">({o.istegeBagli})</span></label>
        <input id="i-yeni-isim" name="basvuran.yeniIsim" type="text" maxlength="60" autocapitalize="words" />
        <p class="yardim">{h.ihtida.yeniIsimYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <label for="i-sebep">{h.ihtida.sebep} <span class="istege">({o.istegeBagli})</span></label>
        <textarea id="i-sebep" name="basvuran.ihtidaSebebi" maxlength="600" rows="4"></textarea>
        <p class="yardim">{h.ihtida.sebepYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-toren-dili">{h.ihtida.torenDili} <span class="zorunlu" aria-hidden="true">*</span></label>
        <select id="i-toren-dili" name="basvuran.torenDili" required>
          <option value="">{o.seciniz}</option>
          <option value="fr" selected={dil === 'fr'}>{h.ihtida.dilFr}</option>
          <option value="tr" selected={dil === 'tr'}>{h.ihtida.dilTr}</option>
          <option value="en" selected={dil === 'en'}>{h.ihtida.dilEn}</option>
          <option value="ar">{h.ihtida.dilAr}</option>
        </select>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan>
        <label for="i-toren-tarihi">{h.ihtida.torenTarihi} <span class="istege">({o.istegeBagli})</span></label>
        <input id="i-toren-tarihi" name="basvuran.torenTarihi" type="text" maxlength="80" placeholder={h.ihtida.torenTarihiYardim} />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <fieldset class="tam">
        <legend>{h.ihtida.sahitler} <span class="istege" data-sahit-istege>({o.istegeBagli})</span></legend>
        <div class="onay-kutu mt-1" data-sahit-secim>
          <input id="i-sahit-ekle" type="checkbox" name="sahitEkle" aria-controls="i-sahit-alanlari" aria-describedby="i-sahit-yardim" />
          <label for="i-sahit-ekle">{h.ihtida.sahitEkle}</label>
        </div>
        <p class="yardim" id="i-sahit-yardim">{h.ihtida.sahitlerYardim}</p>
        <p class="yardim" data-sahit-cami data-kosul="sahitEkle=false">{h.ihtida.sahitCami}</p>
        <div id="i-sahit-alanlari" class="ucf-izgara mt-1" data-kosul="sahitEkle=true" hidden>
          <div data-alan>
            <label for="i-sahit-1">{h.ihtida.sahit1} <span class="zorunlu" aria-hidden="true">*</span></label>
            <input id="i-sahit-1" name="sahit.1" type="text" required disabled maxlength="80" autocomplete="off" autocapitalize="words" />
            <p class="hata" aria-live="polite" hidden></p>
          </div>
          <div data-alan>
            <label for="i-sahit-2">{h.ihtida.sahit2} <span class="istege" data-sahit-istege>({o.istegeBagli})</span><span class="zorunlu" data-sahit-2-zorunlu aria-hidden="true" hidden>*</span></label>
            <input id="i-sahit-2" name="sahit.2" type="text" disabled maxlength="80" autocomplete="off" autocapitalize="words" />
            <p class="hata" aria-live="polite" hidden></p>
          </div>
        </div>
      </fieldset>
      <div data-alan>
        <label for="i-haberdar">{h.ihtida.nasilHaberdar} <span class="istege">({o.istegeBagli})</span></label>
        <input id="i-haberdar" name="basvuran.nasilHaberdar" type="text" maxlength="120" />
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <label for="i-not">{h.ihtida.ekNot} <span class="istege">({o.istegeBagli})</span></label>
        <p class="yardim" id="i-not-yardim">{h.ihtida.ekNotYardim}</p>
        <textarea id="i-not" name="basvuran.ekNot" maxlength="600" rows="3" aria-describedby="i-not-yardim"></textarea>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- 5 · Belgeler ve imza (8 Eylül 2026) -->
  <section class="ucf-bolum" id="b-belgeler" aria-labelledby="h-belgeler" data-belgeler>
    <h2 id="h-belgeler"><span class="no">5</span>{h.bolum.belgeler}</h2>
    <p class="bolum-not">{b.aciklama}</p>
    <div class="ucf-izgara">
      <fieldset data-alan class="tam">
        <legend>{b.belgeTuru} <span class="zorunlu" aria-hidden="true">*</span></legend>
        <div class="secenekler">
          <span class="secenek"><input id="i-belge-kimlik" type="radio" name="belgeTuru" value="kimlik" required checked /><label for="i-belge-kimlik">{b.kimlikKarti}</label></span>
          <span class="secenek"><input id="i-belge-pasaport" type="radio" name="belgeTuru" value="pasaport" /><label for="i-belge-pasaport">{b.pasaport}</label></span>
        </div>
        <p class="hata" aria-live="polite" hidden></p>
      </fieldset>

      {gorselKutulari.map((k) => (
        <div data-alan class="ucf-gorsel" data-gorsel={k.anahtar} data-kosul={k.kosul}>
          {/* Değeri hep boştur: yalnız çekirdeğin hata/kaydırma düzeneğine ad verir. */}
          <input type="hidden" name={`gorsel.${k.anahtar}`} value="" />
          <span class="alan-baslik" id={`${k.id}-et`}>{k.etiket} <span class="zorunlu" aria-hidden="true">*</span></span>
          <p class="yardim" id={`${k.id}-yardim`}>{k.yardim}</p>
          <div class="g-kutu">
            <img data-onizleme alt="" hidden />
            <span class="g-bos" data-bos aria-hidden="true">🖼</span>
          </div>
          <div class="g-eylem">
            <label class="dugme dugme-ikincil g-sec" for={k.id} data-sec={b.sec} data-degistir={b.degistir}>{b.sec}</label>
            <input class="sr-only" type="file" id={k.id} accept="image/*" aria-required="true" aria-labelledby={`${k.id}-et`} aria-describedby={`${k.id}-yardim ${k.id}-hata`} />
            <button type="button" class="dugme dugme-ikincil" data-kaldir hidden>{b.kaldir}</button>
            <span class="g-durum" data-durum aria-live="polite"></span>
          </div>
          <p class="hata" id={`${k.id}-hata`} aria-live="polite" hidden></p>
        </div>
      ))}

      <div data-alan class="tam ucf-imza" data-imza>
        <span class="alan-baslik">{b.imza} <span class="zorunlu" aria-hidden="true">*</span></span>
        <p class="yardim">{b.imzaYardim}</p>
        <canvas class="imza-tuval" role="img" aria-label={b.imza}></canvas>
        <div class="imza-eylem">
          <button type="button" class="dugme dugme-ikincil" data-imza-temizle>{b.imzaTemizle}</button>
        </div>
        <div class="onay-kutu mt-3">
          <input id="i-imza-yok" type="checkbox" name="imzaYok" />
          <label for="i-imza-yok">{b.imzaYok}</label>
        </div>
        <p class="yardim">{b.imzaYokYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam" data-kosul="imzaYok=false">
        <div class="onay-kutu">
          <input id="i-onay-imza" type="checkbox" name="onay.imzaAktarimIzni" required />
          <label for="i-onay-imza">{adimMetin.imzaIzni}</label>
        </div>
        <p class="yardim">{adimMetin.imzaNotu}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- 6 · Rıza ve beyan -->
  <section class="ucf-bolum" id="b-riza" aria-labelledby="h-riza">
    <h2 id="h-riza"><span class="no">6</span>{h.bolum.riza}</h2>
    <div class="ucf-izgara">
      <div data-alan class="tam">
        <div class="onay-kutu">
          <input id="i-onay-riza" type="checkbox" name="onay.acikRiza" required />
          <label for="i-onay-riza">{h.riza.acikRiza}</label>
        </div>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <div class="onay-kutu">
          <input id="i-onay-ek10" type="checkbox" name="onay.ek10" required />
          <label for="i-onay-ek10">{adimMetin.ek10} <a href={ek10Yolu} target="_blank" rel="noopener">{h.riza.ek10Baglanti}</a></label>
        </div>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <div class="onay-kutu">
          <input id="i-onay-gizlilik" type="checkbox" name="onay.gizlilik" required />
          <label for="i-onay-gizlilik">{h.riza.gizlilik} <a href={yol(dil, 'gizlilik')} target="_blank" rel="noopener">{o.gizlilikKutu.gizlilikSayfa}<span aria-hidden="true"> ↗</span></a></label>
        </div>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <div class="onay-kutu">
          <input id="i-onay-gorsel" type="checkbox" name="onay.gorselRiza" required />
          <label for="i-onay-gorsel">{h.riza.gorselRiza}</label>
        </div>
        <p class="yardim">{h.riza.gorselRizaYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
      <div data-alan class="tam">
        <div class="onay-kutu">
          <input id="i-foto-izni" type="checkbox" name="fotografIzni" />
          <label for="i-foto-izni">{h.riza.fotoIzni}</label>
        </div>
        <p class="yardim">{h.riza.fotoAciklama}</p>
      </div>
      <div class="tam">
        <h3 class="font-serif text-lg mt-2 mb-1">{h.riza.beyanBaslik}</h3>
        <blockquote class="kurallar-kutu" style="max-height:none">{h.riza.beyanMetin}</blockquote>
      </div>
      <div data-alan class="tam">
        <label for="i-beyan">{h.riza.beyanEtiket} <span class="zorunlu" aria-hidden="true">*</span></label>
        <input id="i-beyan" name="onay.beyan" type="text" required maxlength="80" data-esle="basvuran.adSoyad" autocomplete="off" autocapitalize="words" />
        <p class="yardim">{h.riza.beyanYardim}</p>
        <p class="hata" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- 7 · Özet ve gönderim -->
  <section class="ucf-bolum" id="b-ozet" aria-labelledby="h-ozet">
    <h2 id="h-ozet"><span class="no">7</span>{h.bolum.ozet}</h2>
    <p class="bolum-not">{o.ozetAciklama}</p>
    <dl class="ozet-liste" data-ozet>
      {([
        ['cami', camiMetinleri[dil].baslik, '#b-cami'],
        ['kisi', h.ozet.kisi, '#b-kisi'], ['dogum', h.ozet.dogum, '#b-kisi'], ['uyruk', h.ozet.uyruk, '#b-kisi'], ['aile', h.ozet.aile, '#b-kisi'],
        ['durum', h.ozet.durum, '#b-durum'], ['iletisim', h.ozet.iletisim, '#b-iletisim'], ['din', h.ozet.din, '#b-ihtida'],
        ['teslimat', h.teslimat.baslik, '#b-iletisim'],
        ['sebep', h.ihtida.sebep, '#b-ihtida'], ['yeniIsim', h.ihtida.yeniIsim, '#b-ihtida'],
        ['toren', h.ozet.toren, '#b-ihtida'], ['sahitler', h.ozet.sahitler, '#b-ihtida'],
        ['belgeler', h.ozet.belgeler, '#b-belgeler'],
      ] as const).map(([anahtar, etiket, hedef]) => (
        <div data-ozet-alan={anahtar}><dt>{etiket}</dt><dd><span data-ozet-deger>{o.bosDeger}</span> <a href={hedef}>{o.ozetDuzenle}</a></dd></div>
      ))}
    </dl>
    <div class="ucf-not mt-5">
      <span class="simge" aria-hidden="true">🔒</span>
      <div><strong>{o.gizlilikKutu.baslik}</strong>{h.kimlikNotu}</div>
    </div>
    <div class="ucf-gonder mt-6">
      <button type="submit" class="dugme dugme-birincil">{o.gonder}</button>
      <p class="son-not">{doldur(o.basari.iletisim, { eposta, telefon })}</p>
    </div>
  </section>
  <div class="ucf-adim-eylemler" data-adim-eylemler hidden>
    <button type="button" class="dugme dugme-ikincil" data-adim-geri>{adimMetin.geri}</button>
    <button type="button" class="dugme dugme-birincil" data-adim-ileri>{adimMetin.ileri}<span aria-hidden="true"> →</span></button>
    <p>{adimMetin.taslak}</p>
  </div>
</form>

<section class="ucf-basari mt-8" data-basari hidden aria-live="polite">
  <h2>{o.basari.baslik}</h2>
  <div><div class="ref-etiket">{o.basari.referans}</div><div class="ref" data-ref>—</div></div>
  <p data-eposta-metin></p>
  <p class="text-sm" style="color: var(--metin-2)">{o.basari.spamNotu}</p>
  <p>{h.basari.sonrakiAdimlar}</p>
  <p class="text-sm" style="color: var(--metin-2)">{doldur(o.basari.iletisim, { eposta, telefon })}</p>
  <div class="eylemler">
    <a class="dugme dugme-ikincil" href={yol(dil, 'ihtida')}>{h.ustEtiket}</a>
    <a class="dugme dugme-ikincil" href={`/${dil}/`}>{o.anasayfa}</a>
  </div>
</section>

<script>
  import { ihtidaFormuBaslat } from '../../scripts/ihtida-form';
  ihtidaFormuBaslat();
</script>
