---
import type { Dil } from '../../i18n/ui';
import { ihtidaAdimMetinleri } from '../../i18n/ihtida-adimlari';
import FormAdimlar from './FormAdimlar.astro';
interface Props { dil: Dil }
const m = ihtidaAdimMetinleri[Astro.props.dil];
---
<FormAdimlar metin={m} gruplar={[
  ['b-cami', 'b-kisi'], ['b-durum'], ['b-iletisim'], ['b-ihtida'], ['b-belgeler'], ['b-riza'], ['b-ozet'],
]} ek={{ 'data-ihtida-adimlar': '' }} />
