---
/** Dil bazında doğrulanmış Diyanet videoları. Kaynak denetimi: docs/IHTIDA-VIDEOLARI.md.
 * Kapaklar yereldir; oynatıcı yalnız ziyaretçi istediğinde yüklenir.
 */
import seri from '../data/diyanet-videolar.json';
import enSeri from '../data/diyanet-videolar-en.json';
import videolar from '../data/ihtida-videolari.json';
import VideoDersi from './VideoDersi.astro';
import { yol } from '../i18n/utils';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;
/* İhtida videoları YALNIZ doğrulanmış Diyanet kaynaklarından seçilir (docs/IHTIDA-VIDEOLARI.md).
   Diyanet'in doğrulanmış Felemenkçe/Almanca video serisi yok; bu iki dilde İngilizce seri
   gösterilir (aynı 37 bölüm, Diyanet Publications) ve ziyaretçiye KENDİ dilinde videoların
   İngilizce olduğu yazılır — uydurma çeviri yapılmaz, video kendisi değiştirilmez. */
const VIDEO_DILI: Record<Dil, 'tr' | 'fr' | 'en'> = { tr: 'tr', fr: 'fr', en: 'en', nl: 'en', de: 'en' };
const videoDili = VIDEO_DILI[dil];
const liste = videolar[videoDili];
const dersler = videoDili === 'en' ? enSeri.bolumler : seri.bolumler.map(b => ({ ...b, kaynak: b.sayfa, kanal: 'Diyanet Dijital', poster: `/media/ihtida/kapaklar/ders-${String(b.no).padStart(2, '0')}.webp` }));
const ekDersler = seri.ekler.map((b, i) => ({ ...b, kaynak: b.sayfa, kanal: 'Diyanet Dijital', poster: `/media/ihtida/kapaklar/extra-${String(i + 1).padStart(2, '0')}.webp` }));
type Grup = 'baslarken' | 'inanc' | 'ibadet' | 'cagri' | 'musluman';
type VideoMetni = {
  baslik: string; giris: string; dil: string; devam: string; seri: string;
  grup: Record<Grup, string>; ek: string; katalog: string; kutuphane: string;
  kaynakNotu: string; yardim: string; aciklama: string; dis: string;
};
const M: Record<Dil, VideoMetni> = {
  tr: {
    baslik: 'İslam’ı videolarla tanıyın',
    giris: 'Diyanet’in Türkçe videolarıyla şehadetin anlamını, İslam’ı ve iman esaslarını öğrenin. İzlemek için videonun üzerindeki oynat düğmesine dokunun.',
    dil: 'Türkçe',
    devam: 'Keşfetmeye devam edin',
    seri: '“İslam Nedir?” serisinin 37 bölümünü göster',
    grup: { baslarken: 'Başlarken', inanc: 'İnancın esasları', ibadet: 'İbadet', cagri: 'İslam neye çağırır?', musluman: 'Müslümanın hâli' },
    ek: 'Serinin kısa videoları',
    katalog: 'Diyanet’in video kataloğu',
    kutuphane: 'Okumak isterseniz: Diyanet Kütüphanesi',
    kaynakNotu: 'Videolar Diyanet yayınlarıdır. Kapaklar Ulu Camii için hazırlanmış temsili görsellerdir. Oynat düğmesine dokunana kadar video sağlayıcısına bağlantı kurulmaz.',
    yardim: 'Video açılmıyor veya oturum açmanız isteniyorsa “YouTube’da aç” ya da “Kaynağında aç” bağlantısını deneyebilirsiniz. YouTube’un oturum kontrolü kaynak sayfasında da görünebilir.',
    aciklama: '',
    dis: 'yeni sekmede açılır',
  },
  fr: {
    baslik: 'Une parole à écouter en français',
    giris: 'Découvrez un sermon prononcé en français par Ali Erbaş à la mosquée Yunus Emre de Strasbourg et publié par Diyanet Haber. Touchez le bouton de lecture pour regarder la vidéo ici.',
    dil: 'Français',
    devam: 'Pour aller plus loin',
    /* Fransızca sayfada 37 bölümlük seri GÖSTERİLMEZ (aşağıdaki `dil !== 'fr'` kapısı);
       grup başlıkları yine de tam tutulur ki sözlük beş dilde eksiksiz kalsın. */
    seri: '',
    grup: { baslarken: 'Pour commencer', inanc: 'Les fondements de la foi', ibadet: 'Le culte', cagri: 'À quoi l’islam appelle-t-il ?', musluman: 'Vivre en musulman' },
    ek: '', katalog: '',
    kutuphane: 'Découvrir l’islam : les livres du Diyanet en français',
    kaynakNotu: 'Les vidéos sont publiées par le Diyanet. Les couvertures sont des illustrations créées pour Ulu Camii. Aucune connexion au fournisseur vidéo n’est établie avant votre clic sur Lecture.',
    yardim: 'Si la vidéo ne démarre pas ou demande une connexion, essayez « Ouvrir sur YouTube » ou « Ouvrir à la source ». YouTube peut aussi demander une connexion sur le site source.',
    aciklama: 'Il s’agit d’un sermon, et non d’un cours sur la conversion. Pour une introduction à l’islam en français, consultez aussi les livres gratuits du Diyanet ci-dessous.',
    dis: 'ouvre dans un nouvel onglet',
  },
  en: {
    baslik: 'Discover Islam through video',
    giris: 'Explore the declaration of faith, Islam and belief through Diyanet’s English-language videos. Press play on a video to watch it here.',
    dil: 'English',
    devam: 'Keep exploring',
    seri: '',
    grup: { baslarken: 'Getting started', inanc: 'The foundations of faith', ibadet: 'Worship', cagri: 'What Islam calls us to', musluman: 'Living as a Muslim' },
    ek: '',
    katalog: 'Explore all 37 English videos on What is Islam?',
    kutuphane: 'Prefer reading? Diyanet books in English',
    kaynakNotu: 'The videos are Diyanet publications. The covers are illustrations created for Ulu Camii. No connection to the video provider is made until you press play.',
    yardim: 'If the video does not play or asks you to sign in, try “Open on YouTube” or “Open at source”. YouTube may also ask you to sign in on the source website.',
    aciklama: '',
    dis: 'opens in a new tab',
  },
  nl: {
    baslik: 'Ontdek de islam met video’s',
    giris: 'Leer de geloofsgetuigenis, de islam en de geloofsgrondslagen kennen met de video’s van het Diyanet. Druk op de afspeelknop om een video hier te bekijken.',
    dil: 'Engels',
    devam: 'Verder ontdekken',
    seri: '',
    grup: { baslarken: 'Om te beginnen', inanc: 'De grondslagen van het geloof', ibadet: 'Eredienst', cagri: 'Waartoe de islam oproept', musluman: 'Leven als moslim' },
    ek: '',
    katalog: 'Alle 37 Engelstalige video’s van What is Islam?',
    kutuphane: 'Liever lezen? De boeken van het Diyanet in het Nederlands',
    kaynakNotu: 'De video’s zijn uitgaven van het Diyanet. De omslagbeelden zijn illustraties die voor Ulu Camii zijn gemaakt. Er wordt geen verbinding met de videoaanbieder gemaakt voordat u op afspelen drukt.',
    yardim: 'Start de video niet of wordt u gevraagd om in te loggen, probeer dan “Openen op YouTube” of “Openen bij de bron”. YouTube kan ook op de bronsite om een login vragen.',
    aciklama: 'Het Diyanet heeft geen geverifieerde videoreeks in het Nederlands; daarom tonen wij hier de Engelstalige reeks. De video’s en hun ondertiteling zijn in het Engels. Nederlandstalige boeken vindt u in de bibliotheek hieronder.',
    dis: 'opent in een nieuw tabblad',
  },
  de: {
    baslik: 'Den Islam mit Videos entdecken',
    giris: 'Lernen Sie das Glaubensbekenntnis, den Islam und die Glaubensgrundlagen mit den Videos des Diyanet kennen. Drücken Sie auf die Abspielschaltfläche, um ein Video hier anzusehen.',
    dil: 'Englisch',
    devam: 'Weiter entdecken',
    seri: '',
    grup: { baslarken: 'Zum Einstieg', inanc: 'Die Grundlagen des Glaubens', ibadet: 'Gottesdienst', cagri: 'Wozu der Islam aufruft', musluman: 'Als Muslim leben' },
    ek: '',
    katalog: 'Alle 37 englischsprachigen Videos von What is Islam?',
    kutuphane: 'Lieber lesen? Die Bücher des Diyanet auf Deutsch',
    kaynakNotu: 'Die Videos sind Veröffentlichungen des Diyanet. Die Titelbilder sind Illustrationen, die für Ulu Camii angefertigt wurden. Vor dem Drücken der Abspielschaltfläche wird keine Verbindung zum Videoanbieter hergestellt.',
    yardim: 'Startet das Video nicht oder werden Sie zum Anmelden aufgefordert, versuchen Sie „Auf YouTube öffnen“ oder „An der Quelle öffnen“. YouTube kann auch auf der Quellseite eine Anmeldung verlangen.',
    aciklama: 'Das Diyanet hat keine geprüfte Videoreihe auf Deutsch; deshalb zeigen wir hier die englischsprachige Reihe. Die Videos und ihre Untertitel sind auf Englisch. Deutschsprachige Bücher finden Sie in der Bibliothek weiter unten.',
    dis: 'öffnet in einem neuen Tab',
  },
};
const m = M[dil];
const grupBasliklari = m.grup;
const gruplar = ['baslarken', 'inanc', 'ibadet', 'cagri', 'musluman'] as const;
---
<section id="diyanet-videolari" class="video-bant" data-video-dil={dil} data-video-grubu>
  <div class="kapsayici">
    <div class="video-giris">
      <h2 class="bant-baslik">{m.baslik}</h2>
      <p class="bant-giris">{m.giris}</p>
    </div>
    <div class="one-cikan">
      <VideoDersi {...liste[0]} dil={dil} dilAdi={m.dil} yardim={m.yardim} acik />
    </div>
    {m.aciklama && <p class="bant-giris">{m.aciklama}</p>}
    {dil !== 'fr' && <div class="seri-dersleri" data-ders-serisi>
      {gruplar.map(g => <section class="ders-grubu" aria-labelledby={`ders-grubu-${g}`}>
        <h3 id={`ders-grubu-${g}`} class="bant-ara-baslik">{grupBasliklari[g]}</h3>
        <div class="ders-listesi">
          {dersler.filter(b => b.grup === g).map(b => <VideoDersi {...b} dil={dil} dilAdi={m.dil} yardim={m.yardim} />)}
        </div>
      </section>)}
      {dil === 'tr' && <section class="ders-grubu" aria-labelledby="ek-dersler">
        <h3 id="ek-dersler" class="bant-ara-baslik">{m.ek}</h3>
        <div class="ders-listesi">
          {ekDersler.map(b => <VideoDersi {...b} dil={dil} dilAdi={m.dil} yardim={m.yardim} />)}
        </div>
      </section>}
    </div>}
    <p class="bant-eylem"><a class="dugme dugme-ikincil" href={yol(dil, 'kutuphane')}>{m.kutuphane}</a></p>
    <p class="bant-not">{m.kaynakNotu}</p>
  </div>
</section>

<style>
  .video-bant { border-top: 1px solid var(--cizgi); padding: 3.5rem 0 1rem; }
  .video-giris { display: grid; gap: 1rem 3rem; align-items: start; margin-bottom: 1.5rem; }
  .bant-baslik { font-family: var(--font-serif); font-size: clamp(1.65rem, 1rem + 2vw, 2.6rem); line-height: 1.2; text-wrap: balance; margin: 0; }
  .bant-giris { max-width: 70ch; color: var(--metin-2); margin: 0; line-height: 1.65; }
  .one-cikan { width: 100%; }
  .one-cikan + .bant-giris { margin-top: 1rem; }
  .bant-ara-baslik { font-family: var(--font-serif); font-size: 1.5rem; color: var(--metin); margin: 2.5rem 0 .5rem; }
  .ders-listesi { border-top: 1px solid var(--cizgi); }
  .bant-eylem { margin-top: 1.8rem; }
  .bant-not { margin-top: 1.2rem; font-size: .875rem; color: var(--metin-2); max-width: 75ch; }
  /* Kapak resmi tüm genişliği doldurur; başlık çizimin sakin sol alanında kalır. */
  .video-bant :global(.video-golge) { background: linear-gradient(90deg, rgb(25 18 12 / .85), rgb(25 18 12 / .55) 57%, transparent 85%); }
  .video-bant :global(.video-kapak-baslik) { left: 5%; right: auto; top: 50%; bottom: auto; transform: translateY(-50%); max-width: 57%; font-size: clamp(1rem, .7rem + 2.25vw, 2.7rem); line-height: 1.25; text-wrap: balance; }
  .video-bant :global(.oynat-rozet) { left: 80%; width: clamp(3.25rem, 6vw, 5rem); height: clamp(3.25rem, 6vw, 5rem); }
  @media (min-width: 900px) { .video-giris { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
</style>
