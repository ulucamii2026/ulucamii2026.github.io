---
/** Mevlid Kandili tebriği — yalnız 24 Ağustos 2026'da (ziyaretçinin yerel tarihi) ve ziyaretçi başına bir kez görünür. */
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;
const m = dil === 'tr' ? {
  ust: 'Mevlid Kandili',
  baslik: 'Kandiliniz mübarek olsun',
  metin: "Peygamber Efendimiz Hz. Muhammed Mustafa'nın (s.a.s.) dünyayı teşriflerinin yıl dönümü olan bu mübarek gecenin ailelerimize, cemaatimize ve bütün İslâm âlemine hayır, rahmet ve bereket getirmesini Cenâb-ı Hak'tan niyaz ederiz.",
  imza: 'Marche-en-Famenne Ulu Camii Yönetim Kurulu',
  kapat: 'Kapat',
} : dil === 'en' ? {
  ust: 'Mawlid an-Nabi',
  baslik: 'Blessed Mawlid night',
  metin: 'On this blessed night marking the birth of the Prophet Muhammad (peace be upon him), we pray that it brings goodness, mercy and blessings to our families, our community and the whole Muslim world.',
  imza: 'Board of the Ulu Camii Mosque, Marche-en-Famenne',
  kapat: 'Close',
} : {
  ust: 'Mawlid an-Nabî',
  baslik: 'Bonne fête du Mawlid',
  metin: "En cette nuit bénie marquant la naissance du Prophète Muhammad (paix et bénédictions sur lui), nous prions pour qu'elle apporte bien, miséricorde et bénédictions à nos familles, à notre communauté et à tout le monde musulman.",
  imza: "Le Conseil d'administration de la Mosquée Ulu Camii de Marche-en-Famenne",
  kapat: 'Fermer',
};
---
<div id="kandil-ortu" class="hidden fixed inset-0 z-[90] items-center justify-center p-4 bg-(--murekkep)/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="kandil-baslik">
  <div class="kart relative w-full max-w-md p-8 text-center shadow-2xl">
    <button type="button" data-kandil-kapat class="absolute top-2 right-2 flex h-11 w-11 items-center justify-center rounded-full text-2xl leading-none text-(--metin-2) hover:text-(--vurgu)" aria-label={m.kapat}>×</button>
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-(--vurgu)/12" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-8 w-8 text-(--vurgu)" fill="currentColor">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        <path d="M17.8 4.6l.55 1.45 1.45.55-1.45.55-.55 1.45-.55-1.45-1.45-.55 1.45-.55z" />
      </svg>
    </div>
    <p class="etiket etiket-vurgu mt-4">{m.ust}</p>
    <h2 id="kandil-baslik" class="font-serif text-2xl mt-2">{m.baslik}</h2>
    <p class="mt-4 text-sm leading-relaxed text-(--metin-2)">{m.metin}</p>
    <p class="mt-4 text-sm font-semibold">{m.imza}</p>
    <button type="button" data-kandil-kapat class="dugme dugme-birincil mt-6 w-full justify-center">{m.kapat}</button>
  </div>
</div>
<style>
  #kandil-ortu > div { animation: kandil-gir 0.35s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes kandil-gir { from { opacity: 0; transform: translateY(12px) scale(0.96); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { #kandil-ortu > div { animation: none; } }
</style>
<script>
  const ortu = document.getElementById('kandil-ortu');
  const bugun = new Date().toLocaleDateString('sv-SE');
  let goruldu = false;
  try { goruldu = !!localStorage.getItem('kandil-mevlid-2026'); } catch { /* gizli pencere */ }
  if (ortu && bugun === '2026-08-24' && !goruldu) {
    ortu.classList.remove('hidden');
    ortu.classList.add('flex');
    document.documentElement.style.overflow = 'hidden';
    const kapat = () => {
      ortu.classList.add('hidden');
      ortu.classList.remove('flex');
      document.documentElement.style.overflow = '';
      try { localStorage.setItem('kandil-mevlid-2026', '1'); } catch { /* gizli pencere */ }
    };
    ortu.querySelectorAll('[data-kandil-kapat]').forEach((b) => b.addEventListener('click', kapat));
    ortu.addEventListener('click', (e) => { if (e.target === ortu) kapat(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') kapat(); });
    const d = ortu.querySelector('.dugme');
    if (d instanceof HTMLElement) d.focus();
  }
</script>
