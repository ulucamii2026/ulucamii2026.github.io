---
/**
 * Kurumsal kimlik şeridi — hero'nun altında, sayfanın ilk ekranına yakın.
 *
 * İki işi var: (1) caminin bağlı olduğu kurumları (T.C. Diyanet İşleri Başkanlığı ve
 * Belçika Diyanet Vakfı) ilk bakışta göstermek, (2) Türk ve Belçika bayraklarını
 * görünür bir yere taşımak — daha önce yalnız dil seçicide, dekoratif boyutta duruyorlardı
 * (25 Ağustos 2026, Rıdvan'ın isteği).
 *
 * Tasarım: hero'nun gürültüsünü artırmayacak kadar sakin. Kağıt zemin, ince tipografi;
 * kayıt bandının (kiremit zemin, yüksek kontrast) altında ikinci bir çağrı gibi durmasın
 * diye vurgusuz bırakıldı.
 *
 * KURGU (25 Ağustos 2026 akşamı gözden geçirildi): iki simetrik kurum bloğu, her biri
 * "amblem → cümle → ülke bayrağı" sırasında. Bayraklar artık şeridin sonunda sahipsiz
 * durmuyor; Diyanet Türkiye'nin, BDV Belçika'nın kurumu olduğu için her blok kendi
 * bayrağını taşıyor ve bayrak cümlenin İÇİNDE, son sözcüğün ardında akıyor — blok
 * kenarına iliştirilseydi metin sarınca cümleden kopup boşlukta kalırdı (mobilde
 * ölçüldü). Dar ekranda bloklar tam genişlikte alt alta geçer; amblemler aynı dikey
 * hatta dizilir.
 */
import Bayrak from './Bayrak.astro';
import type { Dil } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;

const m = {
  tr: {
    bolge: 'Bağlı olduğu kurumlar',
    baglilik: 'T.C. Diyanet İşleri Başkanlığı’na bağlı cami',
    uyelik: 'Belçika Diyanet Vakfı üyesi',
  },
  fr: {
    bolge: 'Affiliations institutionnelles',
    baglilik: 'Mosquée rattachée à la Présidence des Affaires religieuses de Türkiye',
    uyelik: 'Membre de la Fondation Diyanet de Belgique',
  },
  en: {
    bolge: 'Institutional affiliations',
    baglilik: 'Mosque affiliated with the Presidency of Religious Affairs of Türkiye',
    uyelik: 'Member of the Diyanet Foundation of Belgium',
  },
}[dil];

/**
 * Son sözcüğü ayırır ki bayrakla birlikte kalabilsin: cümle sarınca bayrak tek başına
 * satır başına düşüyordu (390 px'te ölçüldü) ve cümleden kopmuş gibi duruyordu.
 */
function sonSozcuk(metin: string) {
  const parcalar = metin.trim().split(' ');
  const son = parcalar.pop() ?? '';
  return { bas: parcalar.join(' '), son };
}
const bagli = sonSozcuk(m.baglilik);
const uye = sonSozcuk(m.uyelik);
---
<aside class="bg-(--zemin-2) border-b border-(--cizgi)" aria-label={m.bolge}>
  <div class="kapsayici py-3 flex flex-wrap items-center justify-start sm:justify-center gap-x-10 gap-y-3">
    <!-- Bağlılık: amblem + cümle + ülke tek grup; ayrılırlarsa amblem sahipsiz kalır -->
    <a href="https://www.diyanet.gov.tr" target="_blank" rel="noopener" class="kurum w-full sm:w-auto">
      <span class="plaka">
        <img src="/media/dis-logolar/diyanet.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
      </span>
      <span class="metin">{bagli.bas} <span class="son">{bagli.son}<Bayrak dil="tr" class="" /></span></span>
    </a>

    <!-- Üyelik: BDV'nin dairesel amblemi — çevresinde kurumun adı yazılı olduğu için
         tek başına da kurumu adlandırır. Tam kilit (amblem + kelime markası) bu
         boyutta okunmuyordu; kaynağı bdv.png olarak arşivde duruyor. -->
    <a href="https://www.diyanet.be" target="_blank" rel="noopener" class="kurum w-full sm:w-auto">
      <span class="plaka">
        <img src="/media/dis-logolar/bdv-amblem.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
      </span>
      <span class="metin">{uye.bas} <span class="son">{uye.son}<Bayrak dil="fr" class="" /></span></span>
    </a>
  </div>
</aside>

<style>
  .kurum {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--metin-2);
    transition: color 0.15s;
  }
  .kurum:hover { color: var(--metin); }

  /* Amblemler resmî kurum işaretleridir; renkleri ne çevrilebilir ne soldurulabilir.
     Bu yüzden her iki temada da AÇIK kalan kendi zeminlerine oturuyorlar — basılı işte
     logonun etrafındaki beyaz alan neyse bu plaka odur. Ölçüm (25 Ağu 2026): koyu temada
     BDV amblemi zeminle 1.34:1, Diyanet 2.87:1 kontrastındaydı ve üstüne %90 opaklık
     biniyordu; plakayla ikisi de tam kontrasta çıkıyor. --color-kagit tema değişkeni
     DEĞİLDİR, iki temada da aynı kalır; çerçeve de bu yüzden sabit tonda. */
  .plaka {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0.3rem;
    background: var(--color-kagit);
    border: 1px solid rgb(74 55 40 / 0.16);
    border-radius: 6px;
    transition: border-color 0.15s;
  }
  .kurum:hover .plaka { border-color: rgb(74 55 40 / 0.34); }
  .plaka img { display: block; height: 2.25rem; width: 2.25rem; object-fit: contain; }

  .metin { font-size: 0.82rem; line-height: 1.45; }
  /* Son sözcük ve bayrak hep aynı satırda kalır; ayrılırlarsa bayrak öksüz düşer. */
  .son { white-space: nowrap; }

  /* Bayrak cümleyi mühürleyen son işaret: metnin akışında durur, sarma sırasında onu
     takip eder. :global gerekli — SVG alt bileşenden geliyor, bu dosyanın scope
     damgasını taşımıyor; seçici yine de .metin ile sınırlı. Çerçeve şart: Belçika
     bayrağının siyah şeridi koyu kahve zeminde kenarını kaybediyor. */
  .metin :global(svg) {
    display: inline-block;
    vertical-align: -0.2em;
    margin-left: 0.45rem;
    height: 0.95rem;
    width: 1.42rem;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--cizgi);
  }

  @media (max-width: 30rem) {
    .kurum { gap: 0.6rem; }
    .metin { font-size: 0.8rem; }
  }
</style>
