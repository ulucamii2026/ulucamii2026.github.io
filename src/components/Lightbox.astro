---
/**
 * Lightbox — sayfa içinde büyük görsel görüntüleyici (kullanıcı sekmeden kopmaz).
 * Kullanım: <a href="/media/x.webp" data-lightbox="galeri" data-caption="..."><img .../></a>
 * Aynı data-lightbox değerine sahip bağlantılar bir albüm oluşturur (önceki/sonraki, ok tuşları, kaydırma).
 * Base.astro'da bir kez dahil edilir; sayfada data-lightbox yoksa hiçbir şey yapmaz.
 */
interface Props { dil: 'tr' | 'fr' }
const { dil } = Astro.props;
const m = dil === 'tr'
  ? { kapat: 'Kapat', onceki: 'Önceki görsel', sonraki: 'Sonraki görsel', goruntuleyici: 'Görsel görüntüleyici' }
  : { kapat: 'Fermer', onceki: 'Image précédente', sonraki: 'Image suivante', goruntuleyici: 'Visionneuse d’images' };
---
<dialog id="lightbox" class="lightbox" aria-label={m.goruntuleyici}>
  <button type="button" class="lb-kapat" data-lb="kapat" aria-label={m.kapat}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button type="button" class="lb-ok lb-onceki" data-lb="onceki" aria-label={m.onceki}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <figure class="lb-govde">
    <img id="lb-img" alt="" decoding="async" />
    <figcaption id="lb-caption"></figcaption>
  </figure>
  <button type="button" class="lb-ok lb-sonraki" data-lb="sonraki" aria-label={m.sonraki}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
  <p id="lb-sayac" class="lb-sayac mono" aria-live="polite"></p>
</dialog>

<style is:global>
  .lightbox { inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: #f5efe3; }
  .lightbox::backdrop { background: rgba(26, 18, 12, .88); backdrop-filter: blur(4px); }
  .lightbox[open] { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem; grid-template-rows: 1fr auto; align-items: center; }
  .lb-govde { grid-column: 2; grid-row: 1; display: grid; justify-items: center; align-content: center; gap: .6rem; max-height: 100dvh; padding: 3.5rem 0 .5rem; margin: 0; }
  .lb-govde img { max-width: 100%; max-height: calc(100dvh - 7.5rem); object-fit: contain; border-radius: var(--radius-kose, 6px); box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); animation: lb-giris 260ms cubic-bezier(.16,1,.3,1); }
  .lb-govde figcaption { font-size: .9rem; color: #e8dfcf; text-align: center; max-width: 60ch; padding: 0 1rem; }
  .lb-govde figcaption:empty { display: none; }
  .lb-kapat, .lb-ok { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 1px solid rgba(245,239,227,.28); background: rgba(26,18,12,.55); color: #f5efe3; cursor: pointer; transition: background 160ms, border-color 160ms; }
  .lb-kapat:hover, .lb-ok:hover { background: rgba(181,69,43,.85); border-color: transparent; }
  .lb-kapat:focus-visible, .lb-ok:focus-visible { outline: 2px solid #c98a2e; outline-offset: 2px; }
  .lb-kapat { position: fixed; top: .75rem; right: .75rem; z-index: 2; }
  .lb-onceki { grid-column: 1; grid-row: 1; justify-self: center; }
  .lb-sonraki { grid-column: 3; grid-row: 1; justify-self: center; }
  .lightbox[data-tek="1"] .lb-ok, .lightbox[data-tek="1"] .lb-sayac { display: none; }
  .lb-sayac { grid-column: 2; grid-row: 2; text-align: center; font-size: .75rem; letter-spacing: .08em; color: #cdbfa8; padding-bottom: .9rem; margin: 0; }
  @keyframes lb-giris { from { opacity: 0; transform: scale(.965); } }
  @media (max-width: 640px) {
    .lightbox[open] { grid-template-columns: 0 minmax(0, 1fr) 0; }
    .lb-ok { position: fixed; bottom: 2.6rem; z-index: 2; } .lb-onceki { left: .75rem; } .lb-sonraki { right: .75rem; }
    .lb-govde { padding: 3.25rem .75rem 3.5rem; } .lb-govde img { max-height: calc(100dvh - 9rem); }
  }
  @media (prefers-reduced-motion: reduce) { .lb-govde img { animation: none; } .lightbox::backdrop { backdrop-filter: none; } }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const cap = document.getElementById('lb-caption');
  const sayac = document.getElementById('lb-sayac');
  const baglar = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
  if (dlg && img && cap && sayac && baglar.length && typeof dlg.showModal === 'function') {
    let grup: HTMLAnchorElement[] = []; let i = 0; let tetik: HTMLElement | null = null;
    const goster = (k: number) => {
      i = (k + grup.length) % grup.length; const a = grup[i];
      const metin = a.dataset.caption || a.querySelector('img')?.alt || '';
      img.src = a.href; img.alt = metin; cap.textContent = metin;
      sayac.textContent = grup.length > 1 ? `${i + 1} / ${grup.length}` : '';
      dlg.dataset.tek = grup.length > 1 ? '0' : '1';
      [grup[(i + 1) % grup.length], grup[(i - 1 + grup.length) % grup.length]].forEach((n) => { if (n && n !== a) { const p = new Image(); p.src = n.href; } });
    };
    const ac = (a: HTMLAnchorElement) => {
      const ad = a.dataset.lightbox || ''; grup = baglar.filter((b) => (b.dataset.lightbox || '') === ad);
      tetik = a; goster(grup.indexOf(a)); dlg.showModal(); document.documentElement.style.overflow = 'hidden';
    };
    dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; img.removeAttribute('src'); tetik?.focus(); });
    baglar.forEach((a) => a.addEventListener('click', (e) => { if (e.metaKey || e.ctrlKey) return; e.preventDefault(); ac(a); }));
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement; const b = t.closest('[data-lb]') as HTMLElement | null;
      if (b?.dataset.lb === 'kapat') dlg.close(); else if (b?.dataset.lb === 'onceki') goster(i - 1); else if (b?.dataset.lb === 'sonraki') goster(i + 1);
      else if (t === dlg || t.classList.contains('lb-govde')) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') goster(i - 1); else if (e.key === 'ArrowRight') goster(i + 1); });
    let x0 = 0; dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 48) goster(dx < 0 ? i + 1 : i - 1); });
  }
</script>
