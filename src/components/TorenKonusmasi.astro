const TR_METIN: string[] = [
  'Az önce Bakara sûresinin yüce âyetlerini dinledik: uzun bir sûreyi, şüphenin üzerine bir kapı kapatır gibi kapatan ve kesinliğe bir pencere açar gibi açan sözler. Bu âyetler çok temel bir şey söyler: iman bir zorlama değil, hür bir cevaptır. Allah insana gücünün yetmeyeceği bir yük yüklemez; O, insanın sınırlarını insanın kendini bildiğinden daha iyi bilir.',
