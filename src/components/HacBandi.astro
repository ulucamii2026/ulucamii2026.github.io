---
/** 2027 hac ön kayıt bandı — ana sayfada, yalnız ön kayıt süresi boyunca.
 *
 * Neden ayrı bir bant: hac ön kaydı bizim değil, Belçika Diyanet Vakfı'nın takvimine bağlı ve
 * kaçırılınca telafisi yok (kontenjan sınırlı, kesin kayıt hakkı ödeme sırasına göre veriliyor).
 * Ana sayfadaki hizmetlerin altında, başvuru bağlantısı ve son tarihle birlikte gösterilir.
 *
 * Son gün SABİT DEĞİL, tarihle karşılaştırılır: süre dolduğunda bant kendiliğinden basılmaz,
 * kimsenin elle kaldırması gerekmez. "Kalan gün" derleme anında hesaplanır; site her gün
 * 03:30 UTC'de yeniden yayınlandığı için (deploy.yml cron) ertesi sabah kendini tazeler.
 * Ölçüt src/lib/etkinlik-tarihleri.ts'te tek kaynaktan gelir.
 *
 * Kaynak: Cami din görevlisinin 10 Eylül 2026 teyidi — ön başvuru 11 Eylül,
 * kesin kayıt 30 Eylül 2026. Ön başvuru ile kesin kayıt ayrı aşamalardır.
 */
import type { Dil } from '../i18n/ui';
import { yol } from '../i18n/utils';
import { HAC_SON_GUN, HAC_DUYURU_SLUG } from '../lib/etkinlik-tarihleri';

interface Props { dil: Dil }
const { dil } = Astro.props;

const simdi = Date.now();
const acik = simdi <= HAC_SON_GUN.getTime();
/* Bugün de sayılsın diye yukarı yuvarlanır: son gün sabahı "Son 1 gün" yazar, "0 gün" değil. */
const kalan = Math.max(1, Math.ceil((HAC_SON_GUN.getTime() - simdi) / 86_400_000));

const m = dil === 'tr' ? {
  rozet: kalan === 1 ? 'Son gün' : `Son ${kalan} gün`,
  baslik: '2027 Hac ön kayıtları — son başvuru 11 Eylül',
  alt: 'Ön kayıt 2.000 € · Kontenjan sınırlı, kesin kayıt hakkı ödeme sırasına göre · Yalnızca çevrimiçi · Ön kayıt yapanlar: kesin kayıt e-postanızı takip edin (son gün 30 Eylül)',
  dugme: 'Ayrıntılar ve yardım',
  dis: 'Ön kayıt: diyanet.be/onkayit',
} : dil === 'en' ? {
  rozet: kalan === 1 ? 'Last day' : `${kalan} days left`,
  baslik: 'Hajj 2027 pre-registration — deadline 11 September',
  alt: 'Pre-registration €2,000 · Limited places, confirmed by order of payment · Online only · Already pre-registered? Watch for the final-registration e-mail (deadline 30 September)',
  dugme: 'Details and help',
  dis: 'Register: diyanet.be/onkayit',
} : {
  rozet: kalan === 1 ? 'Dernier jour' : `Plus que ${kalan} jours`,
  baslik: 'Préinscriptions au Hajj 2027 — date limite le 11 septembre',
  alt: 'Préinscription 2 000 € · Places limitées, inscription selon l’ordre des paiements · Uniquement en ligne · Déjà préinscrit ? Surveillez l’e-mail d’inscription définitive (date limite le 30 septembre)',
  dugme: 'Détails et aide',
  dis: 'Préinscription : diyanet.be/onkayit',
};

const disKaynak = { tr: '(dış bağlantı)', fr: '(lien externe)', en: '(external link)' }[dil];
---
{acik && (
  <aside class="hac-bandi border-y" aria-label={m.baslik}>
    <div class="kapsayici py-4 sm:py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <p class="min-w-0">
        <span class="hac-rozet">{m.rozet}</span>
        <strong class="block font-serif text-lg sm:text-xl leading-snug mt-2">{m.baslik}</strong>
        <span class="block mt-1 text-sm opacity-90">{m.alt}</span>
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={yol(dil, 'duyurular', HAC_DUYURU_SLUG)} class="dugme hac-dugme font-bold shrink-0">
          {m.dugme}<span aria-hidden="true"> →</span>
        </a>
        <a href="https://www.diyanet.be/onkayit" target="_blank" rel="noopener" class="hac-dis text-sm font-semibold break-words min-w-0 min-h-11 inline-flex items-center">
          {m.dis}<span aria-hidden="true"> ↗</span><span class="sr-only"> {disKaynak}</span>
        </a>
      </div>
    </div>
  </aside>
)}

<style>
  /* Kur'an kursu bandı kiremit; hac bandı İznik mavisi — iki süreli duyuru üst üste gelince
     ziyaretçi bunların ayrı işler olduğunu renkten anlasın. */
  .hac-bandi {
    background: color-mix(in srgb, var(--vurgu-2) 7%, var(--zemin));
    border-color: var(--cizgi);
    color: var(--metin);
  }
  .hac-rozet {
    display: inline-block;
    background: var(--zemin-3);
    color: var(--metin);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .hac-dugme {
    background: var(--color-iznik);
    color: #fff;
  }
  .hac-dugme:hover {
    background: var(--color-iznik-koyu);
    color: #fff;
  }
  /* Koyu zemin üstünde bağlantı rengi (--vurgu-2) okunmuyor: krem + alt çizgi. */
  .hac-dis {
    color: var(--vurgu-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hac-dis:hover { color: var(--metin); }
</style>
