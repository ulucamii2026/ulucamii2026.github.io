---
/* Menü/tema betiği /vendor/govde.js içindedir (Base.astro tek sefer yükler); her sayfada aynı
   satır içi betiği tekrarlamamak için taşındı (performans denetimi, Eylül 2026). */
import { ceviri, yol, dilDegistirYolu, dilListesi } from '../i18n/utils';
import { diller } from '../i18n/ui';
import Bayrak from './Bayrak.astro';
import type { Dil, SayfaAnahtari } from '../i18n/ui';
interface Props { dil: Dil }
const { dil } = Astro.props;
const t = ceviri(dil);
type Madde = { href: string; ad: string; aciklama?: string };
type Grup = { ad: string; maddeler: Madde[] };
const L = (anahtar: SayfaAnahtari, ad?: string): Madde => ({ href: yol(dil, anahtar), ad: ad ?? t(`nav.${anahtar}` as any) });
/** Gruplu menü: 4 açılır grup + 2 doğrudan bağlantı; mobilde aynı gruplar başlıklı listeler olur.
    Grup başlıkları menüye özgüdür (ui.ts'te karşılığı yok) — üçü de burada tutulur; ikili
    `dil === 'tr' ? … : …` kullanılmaz, yoksa İngilizce sayfa Fransızca başlık gösterir. */
const grupAdi: Record<Dil, [string, string, string, string]> = {
  tr: ['Cami', 'Haberler', 'Eğitim', 'Hizmetler'],
  fr: ['Mosquée', 'Actualités', 'Enseignement', 'Services'],
  en: ['Mosque', 'News', 'Education', 'Services'],
};
/** Menüde kısa biçim: ui.ts'teki karşılığı "Etkinlikler & Afişler" gibi uzun. */
const etkinlikKisa: Record<Dil, string> = { tr: 'Etkinlikler', fr: 'Événements', en: 'Events' };
const [gCami, gHaber, gEgitim, gHizmet] = grupAdi[dil];
const gruplar: Grup[] = [
  { ad: gCami, maddeler: [L('hakkimizda'), L('yonetim'), L('namaz'), L('adab'), L('vefat'), L('galeri'), L('iletisim')] },
  { ad: gHaber, maddeler: [L('duyurular'), L('etkinlikler', etkinlikKisa[dil]), L('afisler')] },
  { ad: gEgitim, maddeler: [L('kurankursu'), L('irsat'), L('uip'), L('ihtida')] },
  { ad: gHizmet, maddeler: [L('bagis'), L('uyelik'), L('cenaze'), L('konsolosluk'), L('diyanet'), L('ihtidaBasvuru')] },
];
const temaEtiketi: Record<Dil, string> = { tr: 'Karanlık / aydınlık tema', fr: 'Thème sombre / clair', en: 'Dark / light theme' };
const dogrudan: Madde[] = [L('namaz'), L('iletisim')];
const aktif = (href: string) => Astro.url.pathname === href || (href !== yol(dil, 'anasayfa') && Astro.url.pathname.startsWith(href));
const grupAktif = (g: Grup) => g.maddeler.some((m) => aktif(m.href));
---
<header class="vt-baslik sticky top-0 z-40 bg-(--zemin)/95 backdrop-blur border-b border-(--cizgi)">
  <div class="kilim-serit" aria-hidden="true"></div>
  <div class="kapsayici flex items-center gap-3 py-2.5">
    <a href={yol(dil, 'anasayfa')} class="flex items-center gap-3 no-underline text-(--metin) hover:text-(--metin) min-w-0">
      <img src="/media/logo/ulu-camii-logo.svg" alt="" width="48" height="48" class="logo-amblem h-12 w-12 shrink-0" />
      <span class="leading-tight min-w-0">
        <span class="block font-serif font-semibold text-[1.15rem] sm:text-xl leading-none whitespace-nowrap">{t('site.kisa')}</span>
        <span class="etiket hidden sm:block mt-1 whitespace-nowrap">Marche-en-Famenne · 1979</span>
      </span>
    </a>
    <nav class="ml-auto hidden lg:flex items-center gap-0.5" aria-label={t('nav.menu')}>
      {gruplar.map((g, i) => (
        <div class="relative" data-grup>
          <button type="button" class:list={['inline-flex items-center gap-1 px-2.5 py-1.5 text-[0.9rem] whitespace-nowrap rounded-(--radius-kose) text-(--metin) hover:bg-(--zemin-3)', grupAktif(g) && 'bg-(--zemin-3) font-semibold']} aria-expanded="false" aria-controls={`grup-${i}`} aria-haspopup="true">
            {g.ad}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <ul id={`grup-${i}`} class="acilir hidden absolute left-0 top-full mt-1 min-w-[15rem] kart p-1.5 z-50" role="list">
            {g.maddeler.map((m) => (
              <li><a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined} class:list={['block px-3 py-2 text-[0.92rem] no-underline rounded-(--radius-kose) text-(--metin) hover:bg-(--zemin-3)', aktif(m.href) && 'bg-(--zemin-3) font-semibold']}>{m.ad}</a></li>
            ))}
          </ul>
        </div>
      ))}
      {dogrudan.map((m) => (
        <a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined} class:list={['hidden xl:inline-block px-2.5 py-1.5 text-[0.9rem] whitespace-nowrap no-underline rounded-(--radius-kose) text-(--metin) hover:bg-(--zemin-3)', aktif(m.href) && 'bg-(--zemin-3) font-semibold']}>{m.ad}</a>
      ))}
    </nav>
    <div class="ml-auto lg:ml-2 flex items-center gap-1.5 shrink-0">
      <a href={yol(dil, 'bagis')} class="hidden md:inline-flex dugme dugme-birincil !py-2 !px-3.5 text-sm">{t('nav.bagis')}</a>
      <div class="relative" data-grup data-dil-menu>
        <button type="button" class="inline-flex min-h-10 items-center gap-1.5 px-2.5 py-2 border border-(--cizgi-etkilesim) rounded-(--radius-kose) text-(--metin) hover:border-(--metin)" aria-expanded="false" aria-controls="dil-menu" aria-haspopup="true" aria-label={`${t('nav.dil')}: ${dil.toUpperCase()}`}>
        <Bayrak dil={dil} class="h-3.5 w-5 rounded-[1px]" />
          <span class="mono text-xs tracking-(--tracking-etiket) uppercase">{dil}</span>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul id="dil-menu" class="acilir hidden absolute right-0 top-full mt-1 min-w-[11rem] kart p-1.5 z-50" role="list">
          {dilListesi.map((d) => (
            <li>
              <a href={dilDegistirYolu(Astro.url, d)} hreflang={d} lang={d} aria-current={d === dil ? 'true' : undefined}
                 class:list={['flex items-center gap-2.5 px-3 py-2 text-[0.92rem] no-underline rounded-(--radius-kose) text-(--metin) hover:bg-(--zemin-3)', d === dil && 'bg-(--zemin-3) font-semibold']}>
                <Bayrak dil={d} class="h-3.5 w-5 rounded-[1px] shrink-0" />{diller[d]}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" id="tema-dugme" class="inline-flex min-h-10 items-center justify-center px-2.5 py-2 border border-(--cizgi-etkilesim) rounded-(--radius-kose) text-(--metin) hover:border-(--metin)" aria-label={temaEtiketi[dil]}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
      </button>
      <button type="button" id="menu-dugme" class="inline-flex min-h-10 items-center justify-center lg:hidden px-2.5 py-2 border border-(--cizgi-etkilesim) rounded-(--radius-kose) text-(--metin) hover:border-(--metin)" aria-expanded="false" aria-controls="mobil-menu" aria-label={t('nav.menu')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobil-menu" class="lg:hidden hidden border-t border-(--cizgi) bg-(--zemin) max-h-[calc(100dvh-5rem)] overflow-y-auto" aria-label={t('nav.menu')}>
    <div class="kapsayici py-4 grid gap-5 sm:grid-cols-2">
      <a href={yol(dil, 'anasayfa')} class="block px-2 py-2 no-underline font-semibold text-(--metin) sm:col-span-2 border-b border-(--cizgi)">{t('nav.anasayfa')}</a>
      {gruplar.map((g) => (
        <div>
          <p class="etiket etiket-vurgu px-2 mb-1">{g.ad}</p>
          <ul class="grid gap-0.5" role="list">
            {g.maddeler.map((m) => <li><a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined} class:list={['block px-2 py-2 no-underline text-(--metin) hover:bg-(--zemin-3) rounded-(--radius-kose)', aktif(m.href) && 'bg-(--zemin-3) font-semibold']}>{m.ad}</a></li>)}
          </ul>
        </div>
      ))}
      <div class="sm:col-span-2 border-t border-(--cizgi) pt-3 flex flex-wrap gap-2">
        {dilListesi.map((d) => (
          <a href={dilDegistirYolu(Astro.url, d)} hreflang={d} lang={d} class:list={['inline-flex items-center gap-2 px-3 py-2 border rounded-(--radius-kose) no-underline text-(--metin)', d === dil ? 'border-(--metin) font-semibold' : 'border-(--cizgi-etkilesim)']}>
            <Bayrak dil={d} class="h-3.5 w-5 rounded-[1px]" />{diller[d]}
          </a>
        ))}
      </div>
      <a href={yol(dil, 'portal')} class="block px-2 py-2 no-underline text-(--vurgu-2) font-semibold sm:col-span-2 border-t border-(--cizgi)">{t('nav.portal')}<span aria-hidden="true"> →</span></a>
    </div>
  </nav>
</header>

