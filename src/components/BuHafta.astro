---
/** "Bu hafta camide" — 7 günlük dikey liste, bugün vurgulu (Brüksel saati, build anında) */
import Ikon from './Ikon.astro';
import { yol } from '../i18n/utils';
import type { Dil, SayfaAnahtari } from '../i18n/ui';
import { haftaGunu } from '../lib/namaz';
interface Props { dil: Dil; program: { gun: number; baslik: { tr: string; fr: string }; saat: { tr: string; fr: string }; sayfa?: string }[]; bugunIdx?: number }
const { dil, program } = Astro.props;
const bugun = Astro.props.bugunIdx ?? haftaGunu(new Date());
const gunler = dil === 'tr' ? ['Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi', 'Pazar'] : dil === 'en' ? ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] : ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
const kisa = dil === 'tr' ? ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'] : dil === 'en' ? ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] : ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
const bosGun = dil === 'tr' ? 'Beş vakit namaz' : dil === 'en' ? 'Five daily prayers' : 'Cinq prières quotidiennes';
const bugunEtiket = dil === 'tr' ? 'Bugün' : dil === 'en' ? 'Today' : 'Auj.';
const ikonSec = (s?: string) => (s === 'kurankursu' || s === 'irsat' ? 'kurs' : s === 'namaz' ? 'hutbe' : 'takvim');
// program içeriği (site verisi) yalnız tr/fr sağlıyor; İngilizcede Fransızcaya düşer (içerik src/content kapsam dışı)
const icerikDil = dil === 'en' ? 'fr' : dil;
---
<ol class="kart-kagit divide-y divide-(--cizgi)" role="list">
  {gunler.map((g, i) => {
    const n = i + 1; const maddeler = program.filter((p) => p.gun === n); const bugunMu = n === bugun;
    return (
      <li class:list={['grid grid-cols-[3.2rem_minmax(0,1fr)] gap-3 px-4 py-2.5 items-start', bugunMu && 'bg-(--vurgu-2)/8']} aria-current={bugunMu ? 'date' : undefined}>
        <p class="pt-0.5">
          <span class:list={['etiket block', bugunMu && 'text-(--vurgu-2) font-medium']} title={g}>{kisa[i]}</span>
          {bugunMu && <span class="etiket block text-(--vurgu-2)">{bugunEtiket}</span>}
        </p>
        <div class="min-w-0">
          {maddeler.length ? maddeler.map((m) => (
            <a href={m.sayfa ? yol(dil, m.sayfa as SayfaAnahtari) : undefined} class="group flex items-start gap-2.5 no-underline text-(--metin) py-0.5">
              <Ikon ad={ikonSec(m.sayfa)} class="h-5 w-5 shrink-0 mt-0.5 text-(--vurgu)" />
              <span class="min-w-0"><span class="block font-semibold leading-snug group-hover:underline">{m.baslik[icerikDil]}</span><span class="block text-xs text-(--metin-2) mt-0.5">{m.saat[icerikDil]}</span></span>
            </a>
          )) : <p class="text-sm text-(--metin-2) py-0.5">{bosGun}</p>}
        </div>
      </li>
    );
  })}
</ol>
