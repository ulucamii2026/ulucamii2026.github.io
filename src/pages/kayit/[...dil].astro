---
/** Kur'an kursu online kayıt — site içine gömülü uygulama (Ağu 2026).
    Form mantığı /public/kayit/assets içindeki betiklerde; bu sayfa yalnız site iskeleti sağlar.

    ÜÇ DİLDE ÜRETİLİR (26 Ağustos 2026): /kayit/ (TR), /kayit/fr/, /kayit/en/.
    Önce tek sayfaydı ve iskelet Türkçe sabitti; form Fransızca'ya geçse bile menü Türkçe
    kalıyordu — ölçüldü: başlıktaki 32 metnin 21'i ("Hakkımızda", "Namaz Vakitleri",
    "Duyurular"…) çevrilmiyordu. Menüyü JS ile yamamak yerine her dil kendi sayfasını alıyor:
    çeviri tek kaynaktan (Astro i18n) geliyor, menüye yarın yeni bir bağlantı eklense de
    kendiliğinden çevriliyor.

    /kayit/ adresi Türkçe olarak SABİT kalır — afiş QR'ları buna bağlı.
    Eski ?lang=fr bağlantıları app.js tarafından /kayit/fr/ adresine yönlendirilir.
    Topbar gizli tutulur (app.js homeLink'e bağlanır); formun ayrı bir dil düğmesi yoktur,
    dil sitenin kendi dil seçicisiyle değişir. */
import Base from '../../layouts/Base.astro';
import type { Dil } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { dil: undefined }, props: { dil: 'tr' as Dil } },
    { params: { dil: 'fr' }, props: { dil: 'fr' as Dil } },
    { params: { dil: 'en' }, props: { dil: 'en' as Dil } },
  ];
}

const { dil } = Astro.props as { dil: Dil };

const aciklama = {
  tr: "Marche-en-Famenne Ulu Camii 2026–2027 Kur'an kursu online kayıt formu — telefonunuzdan birkaç adımda doldurun, sözleşmeyi imzalayın, kayıt belgeniz e-postanıza gelsin.",
  fr: "Formulaire d'inscription en ligne aux cours de Coran 2026–2027 de la Mosquée Ulu Camii de Marche-en-Famenne — remplissez-le depuis votre téléphone, signez le contrat et recevez votre document par e-mail.",
  en: "Online registration form for the 2026–2027 Qur'an course at Marche-en-Famenne Ulu Mosque — fill it in from your phone, sign the agreement and receive your document by e-mail.",
}[dil];

const baslik = {
  tr: 'Kur’an Kursu Online Kayıt',
  fr: 'Inscription en ligne au cours de Coran',
  en: 'Qur’an Course Online Registration',
}[dil];
---
<Base baslik={baslik} dil={dil} aciklama={aciklama}>
  <Fragment slot="head">
    <script is:inline>
      const CAMI = Object.freeze({
        name: 'Marche-en-Famenne Ulu Camii',
        legalName: 'Association Diyanet Mosquée Ulu Camii de Marche en Famenne ASBL',
        kbo: '0421.900.807',
        address: 'Thier des Corbeaux 14, 6900 Marche-en-Famenne, Belçika',
        phone: '+32 472 98 50 73',
        phoneRaw: '32472985073',
        email: 'info@ulucamii.be',
        founded: 1986,
        courseYear: '2026-2027'
      });
      window.CAMI = CAMI;
      window.GONDERIM = Object.freeze({
        ucNokta: 'https://script.google.com/macros/s/AKfycbz2cgLbdHmx9ejuk4euzybGbpDro0UAEjzjwl86tMdRtz05Pp5WI1JUZT374y_lb4J8BQ/exec',
        ortakSir: 'ULUCAMII-KAYIT-2026'
      });
    </script>
    <script is:inline define:vars={{ dil }}>window.KAYIT_DILI = dil;</script>
    <link rel="stylesheet" href="/kayit/assets/styles.css" />
  </Fragment>

  <div class="app-shell kayit-gomulu">
    <header class="topbar">
      <a class="brand" href="#" id="homeLink" aria-label="Marche-en-Famenne Ulu Camii">
        <img src="/kayit/assets/logo-koyu.svg" alt="" width="56" height="56">
        <span>
          <strong data-i18n="institutionShort">Marche Ulu Camii</strong>
          <small data-i18n="appTitle">Online kayıt</small>
        </span>
      </a>
    </header>

    <div class="progress-panel" id="progressPanel" hidden>
      <div class="progress-copy">
        <span id="stepName">Kimlik</span>
        <strong id="stepCount" aria-live="polite">1 / 7</strong>
      </div>
      <div class="progress-track" role="progressbar" aria-label="Kayıt ilerlemesi" data-i18n-aria="progressLabel" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1">
        <span id="progressFill"></span>
      </div>
    </div>

    {/* Düzeltme şeridi: form doldurulurken hangi kaydın düzeltildiğini ve yeni
        kayıt açılmayacağını her adımda söyler. */}
    <p class="duzeltme-serit" id="duzeltmeSerit" hidden role="status">
      <span id="duzeltmeSeritMetin"></span>
      <button class="link-button" type="button" id="duzeltmeIptal" data-i18n="fixCancel">Vazgeç</button>
    </p>

    <div id="mainContent">
      <form id="registrationForm" novalidate autocomplete="on">
        <section class="step step-welcome is-active" data-step="0" aria-labelledby="welcomeTitle">
          <div class="welcome-heading">
            <img class="welcome-logo kurs-logo" src="/kayit/assets/kurs-logo.png" alt="Marche-en-Famenne Ulu Camii Kur’an Kursu logosu" width="128" height="128">
            <h1 id="welcomeTitle" data-i18n="courseTitle">Kur’an-ı Kerim ve Temel Dinî Bilgiler Kursu</h1>
            <p class="course-year" data-i18n="courseYear">2026–2027 eğitim yılı</p>
            <p class="welcome-lead" data-i18n="welcomeIntro">Formu telefonunuzdan doldurun, sözleşmeyi okuyup imzalayın ve tamamlanan PDF’yi yalnızca siz istediğinizde paylaşın.</p>
          </div>

          <dl class="course-sheet">
            <div><dt data-i18n="starts">Başlangıç</dt><dd data-i18n="startsValue">5 Eylül 2026 Cumartesi</dd></div>
            <div><dt data-i18n="ends">Bitiş</dt><dd data-i18n="endsValue">6 Haziran 2027 Pazar</dd></div>
            <div><dt data-i18n="courseDays">Ders günleri</dt><dd data-i18n="courseDaysValue">Cumartesi ve Pazar</dd></div>
            <div><dt data-i18n="summerHours">Yaz saati</dt><dd data-i18n="summerHoursValue">11:00–13:40</dd></div>
            <div><dt data-i18n="winterHours">Kış saati</dt><dd data-i18n="winterHoursValue">10:00–12:40</dd></div>
            <div><dt data-i18n="lessonRhythm">Ders düzeni</dt><dd data-i18n="lessonRhythmValue">3 ders · 40 dk ders + 20 dk teneffüs</dd></div>
            <div class="course-sheet-wide"><dt data-i18n="lessons">Dersler</dt><dd data-i18n="lessonsValue">Kur’an-ı Kerim · İtikat · İbadet · Siyer · Ahlak</dd></div>
            <div class="course-sheet-wide"><dt data-i18n="mosquePhoneLabel">Sorularınız için</dt><dd><a class="tel-baglanti" href="tel:+32472985073">+32 472 98 50 73</a> <span class="tel-not" data-i18n="mosquePhoneNote">cami telefonu</span></dd></div>
          </dl>

          <aside class="privacy-note" aria-labelledby="privacyTitle">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M12 2.5 4.5 5.4v5.7c0 4.8 3 8.9 7.5 10.4 4.5-1.5 7.5-5.6 7.5-10.4V5.4L12 2.5Zm0 2.2 5.3 2v4.4c0 3.6-2.1 6.8-5.3 8.1-3.2-1.3-5.3-4.5-5.3-8.1V6.8l5.3-2.1Zm-1 4.1v2.1H9.7v4.8h4.6v-4.8H13V8.8h-2Zm.8 3.9h.4v1.2h-.4v-1.2Z"/></svg>
            <div>
              <h2 id="privacyTitle" data-i18n="privacyTitle">Bilgileriniz güvende</h2>
              <p data-i18n="privacyText">Bilgileriniz ve kimlik fotoğrafları telefonunuzdan çıkmaz. Siz göndermedikçe hiçbir yere iletilmez.</p>
              <small data-i18n="noServer">Sunucu yok · İzleme yok · Çerez yok</small>
            </div>
          </aside>

          <div class="karar-kartlari" id="kararKartlari">
            <article class="karar-kart" id="draftCard" hidden>
              <h2 id="draftCardTitle" data-i18n="draftCardTitle">Yarım kalan bir kaydınız var</h2>
              <p id="draftCardBody"></p>
              <button class="button button-primary button-wide" type="button" id="draftContinueButton" data-i18n="draftContinue">Kaldığım yerden devam et</button>
              <button class="link-button" type="button" id="draftDeleteLink" data-i18n="draftDelete">Bunu sil, yeni kayıt başlat</button>
            </article>

            <article class="karar-kart karar-kart-one" id="siblingCard" hidden>
              <h2 id="siblingCardTitle" data-i18n="siblingTitle2">İkinci çocuğunuzu mu kaydediyorsunuz?</h2>
              <p id="siblingCardBody"></p>
              <button class="button button-primary button-wide" type="button" id="siblingYesButton" data-i18n="siblingYes2">Evet, ikinci çocuğumu kaydet</button>
              <button class="link-button" type="button" id="siblingNoLink" data-i18n="siblingNo">Hayır, bilgiler değişti</button>
            </article>

            {/* Bu cihazdan gönderilmiş kayıtlar. Bir yazım hatasını düzeltmek için
                veli eskiden formun tamamını baştan doldurup eski kayıt numarasını
                elle yazmak zorundaydı (27 Ağustos 2026, Rıdvan bildirdi). */}
            <article class="karar-kart kayitlarim" id="kayitlarimKart" hidden aria-labelledby="kayitlarimBaslik">
              <h2 id="kayitlarimBaslik" data-i18n="myRecordsTitle">Bu cihazdan yaptığınız kayıtlar</h2>
              <p data-i18n="myRecordsIntro">Bir bilgide hata varsa düzeltin: bilgiler forma geri gelir, yeni kayıt açılmaz, aynı kayıt güncellenir.</p>
              <ul class="kayitlarim-liste" id="kayitlarimListe"></ul>
              <button class="link-button" type="button" id="kayitlarimSil" data-i18n="myRecordsForget">Bu kayıtları cihazdan sil</button>
            </article>
          </div>

          <button class="button button-primary button-wide" type="button" id="startButton" data-i18n="startRegistration">Kayda başla</button>

          <details class="update-ref" id="updateRefBox">
            <summary data-i18n="updateExisting">Önceki kaydımı güncellemek istiyorum</summary>
            <div class="field">
              <label for="updateRef" data-i18n="updateRefLabel">Güncellenecek kayıt numarası</label>
              <input id="updateRef" name="updateRef" type="text" autocapitalize="characters" spellcheck="false" placeholder="UC-2026-0001" aria-describedby="updateRefHelp">
              <small id="updateRefHelp" data-i18n="updateRefHelp">Bilgilerinizi güncelliyorsanız önceki kayıt numaranızı buraya yazın; yeni bir kayıt yapıyorsanız boş bırakın.</small>
              <p class="field-error" id="updateRefError" role="alert"></p>
            </div>
          </details>
        </section>

        <section class="step" data-step="1" aria-labelledby="identityTitle" hidden>
          <header class="step-heading">
            <h1 id="identityTitle" data-i18n="identityTitle">Kimlik belgesini ekleyin</h1>
            <p data-i18n="identityIntro">Ön ve arka yüzü kamerayla çekebilir veya galeriden seçebilirsiniz. Görseller yalnızca bu cihazda sıkıştırılır.</p>
          </header>

          <div class="identity-grid">
            <article class="upload-panel" data-upload="identityFront">
              <div class="upload-panel-heading">
                <h2 data-i18n="identityFront">Kimlik ön yüz</h2>
                <span class="status-chip" data-upload-status data-i18n="notAdded">Henüz görüntü eklenmedi</span>
              </div>
              <div class="image-preview" data-preview-container hidden>
                <img data-preview src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Kimlik ön yüz önizlemesi" data-i18n-alt="identityFrontPreview">
              </div>
              <div class="upload-actions">
                <label class="button button-secondary file-button" tabindex="0" role="button">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8.5 5 10 3h4l1.5 2H19a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.5ZM12 8a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"/></svg>
                  <span data-i18n="camera" data-camera-label>Kamera ile çek</span>
                  <input type="file" accept="image/*" capture="environment" data-image-input="identityFront" tabindex="-1">
                </label>
                <label class="button button-secondary file-button" tabindex="0" role="button">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 2v10.6l3.6-3.6 2.8 2.8 2.2-2.2L19 18V5H5Zm10 2.5A1.5 1.5 0 1 0 15 10a1.5 1.5 0 0 0 0-3Z"/></svg>
                  <span data-i18n="gallery" data-gallery-label>Galeriden yükle</span>
                  <input type="file" accept="image/*" data-image-input="identityFront" tabindex="-1">
                </label>
                <button class="button button-quiet" type="button" data-remove-image="identityFront" hidden data-i18n="removeImage">Kaldır</button>
              </div>
            </article>

            <article class="upload-panel" data-upload="identityBack">
              <div class="upload-panel-heading">
                <h2 data-i18n="identityBack">Kimlik arka yüz</h2>
                <span class="status-chip" data-upload-status data-i18n="notAdded">Henüz görüntü eklenmedi</span>
              </div>
              <div class="image-preview" data-preview-container hidden>
                <img data-preview src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Kimlik arka yüz önizlemesi" data-i18n-alt="identityBackPreview">
              </div>
              <div class="upload-actions">
                <label class="button button-secondary file-button" tabindex="0" role="button">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8.5 5 10 3h4l1.5 2H19a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.5ZM12 8a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"/></svg>
                  <span data-i18n="camera" data-camera-label>Kamera ile çek</span>
                  <input type="file" accept="image/*" capture="environment" data-image-input="identityBack" tabindex="-1">
                </label>
                <label class="button button-secondary file-button" tabindex="0" role="button">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 2v10.6l3.6-3.6 2.8 2.8 2.2-2.2L19 18V5H5Zm10 2.5A1.5 1.5 0 1 0 15 10a1.5 1.5 0 0 0 0-3Z"/></svg>
                  <span data-i18n="gallery" data-gallery-label>Galeriden yükle</span>
                  <input type="file" accept="image/*" data-image-input="identityBack" tabindex="-1">
                </label>
                <button class="button button-quiet" type="button" data-remove-image="identityBack" hidden data-i18n="removeImage">Kaldır</button>
              </div>
            </article>
          </div>

          <div class="mrz-kutu">
            <button class="button button-secondary mrz-dugme" type="button" id="mrzOkuButonu" disabled>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h6v2H6v3H4V5Zm10 0h6v5h-2V7h-4V5ZM4 14h2v3h4v2H4v-5Zm14 0h2v5h-6v-2h4v-3ZM7 11h10v2H7v-2Z"/></svg>
              <span data-i18n="mrzButton">Bilgileri kimlikten oku</span>
            </button>
            <p class="mrz-durum" id="mrzDurum" role="status" data-i18n="mrzHelp">Kimliğin arka yüzündeki makine okunabilir satırlardan ad, soyad, doğum tarihi ve numara otomatik doldurulur.</p>
          </div>
          <label class="check-row manual-check">
            <input type="checkbox" name="manualIdentity" value="yes">
            <span><strong data-i18n="manualIdentity">Kimliğim yanımda değil, bilgileri elle gireceğim</strong><small data-i18n="identitySkipNote">Bu adım zorunlu değildir. Kimlik eklenmezse özette hatırlatma gösterilir.</small></span>
          </label>
          <p class="field-error section-error" id="identityError" aria-live="polite"></p>
        </section>

        <section class="step" data-step="2" aria-labelledby="studentTitle" hidden>
          <header class="step-heading">
            <h1 id="studentTitle" data-i18n="studentTitle">Öğrenci bilgileri</h1>
            <p data-i18n="studentIntro">Bilgileri kimlik belgesindeki yazılışa uygun girin.</p>
          </header>

          <article class="student-photo-row" data-upload="studentPhoto">
            <div class="student-photo-preview" data-preview-container>
              <img data-preview src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Öğrenci fotoğrafı önizlemesi" data-i18n-alt="studentPhotoPreview" hidden>
              <svg data-empty-photo aria-hidden="true" viewBox="0 0 24 24"><path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-5 0-9 2.5-9 5.5V21h18v-1.5C21 16.5 17 14 12 14Z"/></svg>
            </div>
            <div>
              <h2 data-i18n="studentPhoto">Öğrenci fotoğrafı</h2>
              <p data-i18n="studentPhotoHelp">Resmî formun fotoğraf alanı için ayrı bir portre ekleyebilirsiniz.</p>
              <div class="inline-actions">
                <label class="button button-secondary file-button" tabindex="0" role="button"><span data-i18n="addPhoto" data-photo-label>Fotoğraf ekle</span><input type="file" accept="image/*" data-image-input="studentPhoto" tabindex="-1"></label>
                <button class="button button-quiet" type="button" data-remove-image="studentPhoto" hidden data-i18n="removeImage">Kaldır</button>
              </div>
            </div>
          </article>

          <div class="form-grid">
            <div class="field"><label for="studentSurname"><span data-i18n="surname">Soyadı</span> <span aria-hidden="true">*</span></label><input id="studentSurname" name="studentSurname" autocomplete="family-name" required aria-describedby="studentSurnameError"><p class="field-error" id="studentSurnameError"></p></div>
            <div class="field"><label for="studentName"><span data-i18n="givenName">Adı</span> <span aria-hidden="true">*</span></label><input id="studentName" name="studentName" autocomplete="given-name" required aria-describedby="studentNameError"><p class="field-error" id="studentNameError"></p></div>
            <div class="field"><label for="birthPlace"><span data-i18n="birthPlace">Doğum yeri</span> <span aria-hidden="true">*</span></label><input id="birthPlace" name="birthPlace" autocomplete="off" required aria-describedby="birthPlaceError"><p class="field-error" id="birthPlaceError"></p></div>
            <div class="field"><label for="birthDate"><span data-i18n="birthDate">Doğum tarihi</span> <span aria-hidden="true">*</span></label><input id="birthDate" name="birthDate" type="date" autocomplete="bday" required min="1990-01-01" aria-describedby="birthDateUyari birthDateError"><p class="field-uyari" id="birthDateUyari" role="status" hidden></p><p class="field-error" id="birthDateError"></p></div>
            {/* Acilir liste degil, tek dokunusla secim: telefonda native liste ayrica "Tamam"a basmayi gerektiriyordu (27 Ağustos 2026, Rıdvan bildirdi). */}
            <fieldset class="choice-group field-full"><legend><span data-i18n="gender">Cinsiyeti</span> <span aria-hidden="true">*</span></legend><div class="segmented-options"><label><input type="radio" name="gender" value="female" required aria-describedby="genderError"><span data-i18n="female">Kız</span></label><label><input type="radio" name="gender" value="male"><span data-i18n="male">Erkek</span></label></div><p class="field-error" id="genderError"></p></fieldset>
            <div class="field"><label for="identityNumber"><span data-i18n="identityNumber">Kimlik no</span> <span aria-hidden="true">*</span></label><input id="identityNumber" name="identityNumber" autocomplete="off" autocapitalize="characters" minlength="6" maxlength="20" required aria-describedby="identityNumberHelp identityNumberError"><small class="field-help" id="identityNumberHelp" data-i18n="identityNumberHelp">Belçika veya T.C. kimlik numarası</small><p class="field-uyari" id="identityNumberUyari" role="status" hidden></p><p class="field-error" id="identityNumberError"></p></div>
            <div class="field"><label for="studentPhone"><span data-i18n="studentPhone">Öğrencinin cep telefonu</span> <small data-i18n="optional">İsteğe bağlı</small></label><div class="tel-grup"><select class="tel-cc" id="studentPhoneCC" name="studentPhoneCC" aria-label="Ülke kodu / Indicatif"><option value="32" selected>BE +32</option><option value="90">TR +90</option><option value="33">FR +33</option><option value="31">NL +31</option><option value="49">DE +49</option><option value="352">LU +352</option><option value="44">UK +44</option><option value="39">IT +39</option><option value="34">ES +34</option><option value="212">MA +212</option></select><input id="studentPhone" name="studentPhone" type="tel" inputmode="numeric" autocomplete="tel-national" aria-describedby="studentPhoneError"></div><p class="field-error" id="studentPhoneError"></p></div>
            <div class="field"><label for="studentEmail"><span data-i18n="studentEmail">Öğrencinin e-postası</span> <small data-i18n="optional">İsteğe bağlı</small></label><input id="studentEmail" name="studentEmail" type="email" inputmode="email" autocomplete="email" aria-describedby="studentEmailError"><p class="field-error" id="studentEmailError"></p></div>
          </div>
        </section>

        <section class="step" data-step="3" aria-labelledby="schoolHealthTitle" hidden>
          <header class="step-heading"><h1 id="schoolHealthTitle" data-i18n="schoolHealthTitle">Okul ve sağlık bilgileri</h1><p data-i18n="schoolHealthIntro">Kurs ekibinin öğrenciyi doğru destekleyebilmesi için gerekli bilgileri ekleyin.</p></header>

          <div class="form-grid">
            <div class="field field-full"><label for="school"><span data-i18n="school">Okuduğu okul</span> <span aria-hidden="true">*</span></label><select id="school" name="school" required aria-describedby="schoolError"><option value="" data-i18n="selectOne">Seçiniz</option></select><p class="field-error" id="schoolError"></p></div>
            <div class="field field-full conditional-field" id="otherSchoolField" hidden><label for="otherSchoolName"><span data-i18n="otherSchoolName">Okulun adı</span> <span aria-hidden="true">*</span></label><input id="otherSchoolName" name="otherSchoolName" autocomplete="organization" aria-describedby="otherSchoolNameError"><p class="field-error" id="otherSchoolNameError"></p></div>
