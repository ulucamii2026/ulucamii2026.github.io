---
/** Kur'an kursu kayıt formu — /kayit/ (TR, sabit: afiş QR'ları buna bağlı), /kayit/fr/, /kayit/en/.
    30 Ağustos 2026 v2: form bileşeni src/components/formlar/KayitFormu.astro; istemci tarafı PDF, OCR,
    kimlik/görsel yükleme ve imza kanvası kaldırıldı (hukuki gerekçe bileşen başlığında). */
import Base from '../../layouts/Base.astro';
import SayfaBasligi from '../../components/SayfaBasligi.astro';
import KayitFormu from '../../components/formlar/KayitFormu.astro';
import type { Dil } from '../../i18n/ui';
import { formMetinleri } from '../../i18n/formlar';
import { siteAyarlari } from '../../lib/icerik';
import '../../styles/formlar.css';

export function getStaticPaths() {
  return [
    { params: { dil: undefined }, props: { dil: 'tr' as Dil } },
    { params: { dil: 'fr' }, props: { dil: 'fr' as Dil } },
    { params: { dil: 'en' }, props: { dil: 'en' as Dil } },
  ];
}

const { dil } = Astro.props as { dil: Dil };
const m = formMetinleri(dil);
const site = await siteAyarlari();
---
<Base baslik={m.kayit.sayfaBaslik} dil={dil} aciklama={m.kayit.sayfaAciklama} dilHatirla={false}>
  <SayfaBasligi etiket={m.kayit.ustEtiket} baslik={m.kayit.sayfaBaslik} />
  <section class="kapsayici py-10 sm:py-14" style="max-width: 52rem">
    <KayitFormu dil={dil} uc={site.servisler.basvuru} eposta={site.eposta ?? 'info@ulucamii.be'} telefon={site.telefon.dinGorevlisi} />
  </section>
</Base>
