---
/** Kur'an kursu kayıt formu — /kayit/ (TR, sabit: afiş QR'ları buna bağlı), /kayit/fr/, /kayit/en/.
    30 Ağustos 2026 v2: form bileşeni src/components/formlar/KayitFormu.astro; istemci tarafı PDF, OCR,
    kimlik/görsel yükleme ve imza kanvası kaldırıldı (hukuki gerekçe bileşen başlığında). */
import Base from '../../layouts/Base.astro';
import SayfaBasligi from '../../components/SayfaBasligi.astro';
import KayitFormu from '../../components/formlar/KayitFormu.astro';
import type { Dil } from '../../i18n/ui';
import { formMetinleri } from '../../i18n/formlar';
import { siteAyarlari } from '../../lib/icerik';
import '../../styles/formlar.css';
import loraLatin from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';
import loraGenis from '@fontsource-variable/lora/files/lora-latin-ext-wght-normal.woff2?url';
import workLatin from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
import workGenis from '@fontsource-variable/work-sans/files/work-sans-latin-ext-wght-normal.woff2?url';

export function getStaticPaths() {
  return [
    { params: { dil: undefined }, props: { dil: 'tr' as Dil } },
    { params: { dil: 'fr' }, props: { dil: 'fr' as Dil } },
    { params: { dil: 'en' }, props: { dil: 'en' as Dil } },
  ];
}

const { dil } = Astro.props as { dil: Dil };
const m = formMetinleri(dil);
const site = await siteAyarlari();
---
<Base baslik={m.kayit.sayfaBaslik} dil={dil} aciklama={m.kayit.sayfaAciklama} dilHatirla={false}>
  <Fragment slot="head">
    {/* Aynı yerel fontları erken getir: başlık satırları ilk boyamadan sonra kaymasın. */}
    {[loraLatin, workLatin, ...(dil === 'tr' ? [loraGenis, workGenis] : [])].map(href => <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />)}
  </Fragment>
  <SayfaBasligi etiket={m.kayit.ustEtiket} baslik={m.kayit.sayfaBaslik} />
  <section class="kapsayici k-sayfa py-10 sm:py-14">
    <KayitFormu dil={dil} uc={site.servisler.basvuru} eposta={site.eposta ?? 'info@ulucamii.be'} telefon={site.telefon.cami} whatsapp={site.whatsapp!.numara.replace(/\D/g, '')} />
  </section>
</Base>
