---
import Base from '../../layouts/Base.astro';
import DuyuruKarti from '../../components/DuyuruKarti.astro';
import EtkinlikKarti from '../../components/EtkinlikKarti.astro';
import NamazVakitleri from '../../components/NamazVakitleri';
import SiradakiVakit from '../../components/SiradakiVakit';
import BuHafta from '../../components/BuHafta.astro';
import HeroSlayt from '../../components/HeroSlayt.astro';
import DuyuruSeridi from '../../components/DuyuruSeridi.astro';
import BagisBandi from '../../components/BagisBandi.astro';
import HacBandi from '../../components/HacBandi.astro';
import KayitBandi from '../../components/KayitBandi.astro';
import KurumsalSerit from '../../components/KurumsalSerit.astro';
import IletisimMini from '../../components/IletisimMini.astro';
import Ikon from '../../components/Ikon.astro';
import { ceviri, yol, tarihBicimle } from '../../i18n/utils';
import type { Dil } from '../../i18n/ui';
import { dilYollari, duyurular, yaklasanEtkinlikler, namazVakitleri, siteAyarlari } from '../../lib/icerik';
import { haftaGunu } from '../../lib/namaz';

export const getStaticPaths = dilYollari;
const dil = Astro.params.lang as Dil;
const t = ceviri(dil);
const site = await siteAyarlari();
const tumDuyurular = await duyurular(dil);
/* Editörün CMS'te işaretlediği duyuru önce gelir; yoksa kapak görseli olan, o da yoksa en yeni.
   (Daha önce yalnız `kapak` bakılıyordu; `oneCikan` işareti okunmadığı için editörün seçimi
   yok sayılıyordu — 25 Ağustos 2026 denetimi.) */
const oneCikan = tumDuyurular.find((d) => d.data.oneCikan)
  ?? tumDuyurular.find((d) => d.data.kapak)
  ?? tumDuyurular[0];
const digerDuyurular = tumDuyurular.filter((d) => d !== oneCikan).slice(0, 4);
const etkinlikler = await yaklasanEtkinlikler(dil, 3);
const namaz = namazVakitleri();
const bugunGun = haftaGunu(new Date());
const namazEtiket = { imsak: t('namaz.imsak'), gunes: t('namaz.gunes'), ogle: t('namaz.ogle'), ikindi: t('namaz.ikindi'), aksam: t('namaz.aksam'), yatsi: t('namaz.yatsi'), siradaki: t('namaz.siradaki'), kalan: t('namaz.kalan'), hicri: t('namaz.hicri') };
const hizmetler = [
  { href: yol(dil, 'bagis'), ad: t('ana.hizli.bagis'), ikon: 'bagis' as const },
  { href: yol(dil, 'kurankursu'), ad: t('ana.hizli.kurs'), ikon: 'kurs' as const },
  { href: yol(dil, 'uyelik'), ad: t('ana.hizli.uyelik'), ikon: 'uyelik' as const },
  { href: yol(dil, 'konsolosluk'), ad: t('ana.hizli.konsolosluk'), ikon: 'konsolosluk' as const },
  { href: yol(dil, 'cenaze'), ad: t('ana.hizli.cenaze'), ikon: 'cenaze' as const },
  { href: yol(dil, 'iletisim'), ad: t('ana.hizli.iletisim'), ikon: 'iletisim' as const },
];
const m = dil === 'tr' ? {
  heroUst: 'Marche-en-Famenne · Belçika · 1979’dan beri',
  heroAlt: 'Beş vakit namaz, Cuma hutbesi, Kur’an kursu, Ramazan ve bayram programları, cenaze namazları — Famenne’deki Müslümanların 40 yıllık ocağı.',
  buHafta: 'Bu hafta camide', buHaftaAlt: 'Haftalık programımız; bugün vurgulu.',
  hizmet: 'Hizmetlerimiz',
  sonDuyuru: 'Son duyurular', tumDuyuru: 'Tüm duyurular',
  etkinlik: 'Yaklaşan etkinlikler', tumEtkinlik: 'Tüm etkinlikler ve afişler',
  tanitimBaslik: '40 yıldır Marche-en-Famenne’de',
  tanitim: 'Marche-en-Famenne Ulu Camii, 1979’da kurulan derneğimizin çatısı altında 1986’dan beri bölgemizdeki Müslümanlara ibadet, eğitim ve dayanışma hizmeti sunmaktadır. Valon Bölgesi tarafından tanınmış bir ibadet topluluğu olarak Belçika Diyanet Vakfı’na bağlıyız; kapımız her milletten komşumuza açıktır.',
  tanitimCta: 'Hakkımızda', ziyaret: 'Camiyi ziyaret etmek isteyenler için rehber',
  duyuruBos: t('duyuru.bos'), etkinlikBos: t('etkinlik.bos'),
} : dil === 'en' ? {
  heroUst: 'Marche-en-Famenne · Belgium · since 1979',
  heroAlt: 'Five daily prayers, the Friday sermon, Qur’an school, Ramadan and Eid programmes, and funeral prayers — home to the Muslims of the Famenne for 40 years.',
  buHafta: 'This week at the mosque', buHaftaAlt: 'Our weekly programme; today is highlighted.',
  hizmet: 'Our services',
  sonDuyuru: 'Latest announcements', tumDuyuru: 'All announcements',
  etkinlik: 'Upcoming events', tumEtkinlik: 'All events and posters',
  tanitimBaslik: '40 years in Marche-en-Famenne',
  tanitim: 'Marche-en-Famenne Ulu Mosque, carried by our association founded in 1979, has served the Muslims of our region with worship, education and mutual support since 1986. Recognised by the Walloon Region as a place of worship and affiliated with the Diyanet Foundation of Belgium, our door is open to neighbours of every background.',
  tanitimCta: 'About us', ziyaret: 'A guide for those wishing to visit the mosque',
  duyuruBos: t('duyuru.bos'), etkinlikBos: t('etkinlik.bos'),
} : {
  heroUst: 'Marche-en-Famenne · Belgique · depuis 1979',
  heroAlt: 'Cinq prières quotidiennes, prêche du vendredi, école coranique, programmes du Ramadan et des fêtes, prières funéraires — le foyer des musulmans de la Famenne depuis 40 ans.',
  buHafta: 'Cette semaine à la mosquée', buHaftaAlt: 'Notre programme hebdomadaire ; le jour actuel est mis en évidence.',
  hizmet: 'Nos services',
  sonDuyuru: 'Dernières annonces', tumDuyuru: 'Toutes les annonces',
  etkinlik: 'Événements à venir', tumEtkinlik: 'Tous les événements et affiches',
  tanitimBaslik: 'Depuis 40 ans à Marche-en-Famenne',
  tanitim: 'La mosquée Ulu Camii de Marche-en-Famenne, portée par notre association fondée en 1979, accueille depuis 1986 les musulmans de la région pour le culte, l’enseignement et l’entraide. Communauté cultuelle reconnue par la Région wallonne et rattachée à la Fondation Diyanet de Belgique, notre porte est ouverte à tous nos voisins, de toutes origines.',
  tanitimCta: 'À propos', ziyaret: 'Guide pour visiter la mosquée',
  duyuruBos: t('duyuru.bos'), etkinlikBos: t('etkinlik.bos'),
};
const etkinlikGrid = etkinlikler.length >= 3 ? 'md:grid-cols-3' : etkinlikler.length === 2 ? 'sm:grid-cols-2 max-w-4xl' : 'max-w-md';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Mosque', name: t('site.ad'), alternateName: site.dernekAdi,
  url: new URL(yol(dil, 'anasayfa'), Astro.site).toString(), telephone: site.telefon.cami, email: site.eposta,
  address: { '@type': 'PostalAddress', streetAddress: site.adres.sokak, postalCode: site.adres.posta, addressLocality: site.adres.sehir, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: site.gps.enlem, longitude: site.gps.boylam },
  foundingDate: '1979', sameAs: [site.sosyal.facebook].filter(Boolean), image: new URL('/media/galeri/cami-24.webp', Astro.site).toString(),
  // İki temas noktası: din görevlisi (imam@) ve dernek (info@) — boş alanlar düşer.
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'imam', telephone: site.telefon.dinGorevlisi, email: site.epostaDinGorevlisi },
    { '@type': 'ContactPoint', contactType: 'association', telephone: site.telefon.cami, email: site.eposta },
  ].map((c) => Object.fromEntries(Object.entries(c).filter(([, v]) => v))),
};
---
<Base baslik={t('site.ad')} dil={dil} aciklama={t('site.slogan')}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- ① Hero — gerçek fotoğraf, tek yazılmış giriş hareketi, altında canlı vakit şeridi -->
  <section class="relative overflow-hidden">
    <HeroSlayt dil={dil} />
    <div class="kapsayici relative pt-20 pb-10 sm:pt-28 sm:pb-12 lg:pt-36 lg:pb-14 text-(--color-krem)">
      <div class="hero-giris max-w-[46rem]">
        <p class="etiket text-(--color-ochre-acik)">{m.heroUst}</p>
        <h1 class="mt-3 text-(--color-krem) drop-shadow-[0_2px_14px_rgba(0,0,0,.45)] text-[clamp(2.4rem,1.4rem+4vw,4.4rem)]">{t('site.ad')}</h1>
        <p class="arabic mt-5 text-left text-(--color-ochre-acik) text-[1.6rem] sm:text-[2rem]" lang="ar">السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ</p>
        <DuyuruSeridi dil={dil} mesajlar={site.heroMesajlar ?? []} />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={yol(dil, 'namaz')} class="dugme dugme-birincil"><Ikon ad="saat" class="h-5 w-5" />{t('nav.namaz')}</a>
          <a href={yol(dil, 'bagis')} class="dugme bg-(--color-krem) text-(--color-ceviz-koyu) hover:bg-(--color-krem-koyu) hover:text-(--color-ceviz-koyu)"><Ikon ad="bagis" class="h-5 w-5" />{t('nav.bagis')}</a>
          <a href={yol(dil, 'kurankursu')} class="dugme border-(--color-krem)/60 text-(--color-krem) hover:border-(--color-krem) hover:text-(--color-krem)">{t('ana.hizli.kurs')}</a>
        </div>
      </div>
      <div class="mt-10 sm:mt-14 border-t border-(--color-krem)/25 pt-4 hero-serit-cizgi">
        <SiradakiVakit client:load gunler={namaz.gunler} dil={dil} etiketler={namazEtiket} />
      </div>
    </div>
    <div class="kilim-serit" aria-hidden="true"></div>
  </section>

  <!-- ①a Hac ön kaydı — Diyanet takvimine bağlı, 30 Eylül'de kendiliğinden kalkar -->
  <HacBandi dil={dil} />

  <KayitBandi dil={dil} link={site.kursKayitLinki} />

  <KurumsalSerit dil={dil} />

  <!-- ② Namaz vakitleri (vurgulu) + Bu hafta -->
  <section class="bg-(--zemin-2) border-b border-(--cizgi) reveal" aria-labelledby="vakit-baslik">
    <div class="kapsayici py-12 sm:py-16 grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 id="vakit-baslik">{t('ana.bugun')}</h2>
          <a href={yol(dil, 'namaz')} class="inline-flex items-center gap-1.5 text-sm font-semibold no-underline hover:underline">{t('ana.tumvakitler')} <Ikon ad="ok" class="h-4 w-4" /></a>
        </div>
        <span class="serit mb-5" aria-hidden="true"></span>
        <NamazVakitleri client:load gunler={namaz.gunler} dil={dil} etiketler={namazEtiket} vurgulu cumaEtiket={t('namaz.cuma')} cumaSaati={site.cumaSaati} />
        <p class="etiket mt-4">{t('namaz.kaynak')}</p>
        <!-- Hızlı erişim karoları — vakit sütunundaki boşluğu değerlendirir, iki sütunu dengeler -->
        <nav class="mt-8" aria-label={m.hizmet}>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-(--cizgi) border border-(--cizgi)" role="list">
          {hizmetler.map((h) => (
            <li class="bg-(--zemin)">
              <a href={h.href} class="group flex items-center gap-3 px-3.5 py-3.5 no-underline text-(--metin) hover:bg-(--zemin-3) transition-colors h-full">
                <Ikon ad={h.ikon} class="h-6 w-6 shrink-0 text-(--vurgu) transition-transform duration-300 ease-out group-hover:-translate-y-0.5" />
                <span class="font-semibold text-[0.92rem] leading-snug">{h.ad}</span>
              </a>
            </li>
          ))}
        </ul>
        </nav>
      </div>
      <div id="bu-hafta" class="scroll-mt-24">
        <h2 class="text-[1.35rem] sm:text-2xl">{m.buHafta}</h2>
        <span class="serit" aria-hidden="true"></span>
        <p class="mt-3 mb-5 text-sm text-(--metin-2)">{m.buHaftaAlt}</p>
        <BuHafta dil={dil} program={site.haftalikProgram} bugunIdx={bugunGun} />
      </div>
    </div>
  </section>

  <!-- ④ Duyurular — bento: 1 öne çıkan + liste -->
  <section class="kapsayici py-10 sm:py-14 reveal" aria-labelledby="duyuru-baslik">
    <div class="flex flex-wrap items-end justify-between gap-3 cetvel pt-4">
      <h2 id="duyuru-baslik">{m.sonDuyuru}</h2>
      <a href={yol(dil, 'duyurular')} class="inline-flex items-center gap-1.5 text-sm font-semibold no-underline hover:underline">{m.tumDuyuru} <Ikon ad="ok" class="h-4 w-4" /></a>
    </div>
    <span class="serit mb-6" aria-hidden="true"></span>
    {oneCikan ? (
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
        <article class="kart overflow-hidden flex flex-col">
          {oneCikan.data.kapak && <a href={yol(dil, 'duyurular', oneCikan.slug)} class="block aspect-[16/9] overflow-hidden border-b border-(--cizgi)"><img src={oneCikan.data.kapak} alt={oneCikan.data.kapakAlt ?? ''} loading="lazy" decoding="async" width="1400" height="788" class="h-full w-full object-cover" /></a>}
          <div class="p-6 sm:p-7 flex flex-col gap-3">
            <p class="etiket"><time datetime={oneCikan.data.tarih.toISOString()}>{tarihBicimle(oneCikan.data.tarih, dil)}</time></p>
            <h3 class="text-[1.5rem] sm:text-[1.8rem] leading-tight"><a href={yol(dil, 'duyurular', oneCikan.slug)} class="no-underline text-(--metin) hover:text-(--vurgu)">{oneCikan.data.baslik}</a></h3>
            {oneCikan.data.ozet && <p class="text-(--metin-2)">{oneCikan.data.ozet}</p>}
            <a href={yol(dil, 'duyurular', oneCikan.slug)} class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold no-underline hover:underline">{t('duyuru.devam')} <Ikon ad="ok" class="h-4 w-4" /></a>
          </div>
        </article>
        <ul class="grid content-start divide-y divide-(--cizgi) border-y border-(--cizgi)" role="list">
          {digerDuyurular.map((d) => (
            <li><a href={yol(dil, 'duyurular', d.slug)} class="group grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 py-4 no-underline text-(--metin)">
              <time datetime={d.data.tarih.toISOString()} class="rakam leading-none"><span class="block text-3xl">{tarihBicimle(d.data.tarih, dil, { day: 'numeric' })}</span><span class="etiket block mt-1">{tarihBicimle(d.data.tarih, dil, { month: 'short', year: 'numeric' })}</span></time>
              <span class="min-w-0"><span class="block font-serif font-semibold text-lg leading-snug group-hover:text-(--vurgu) transition-colors">{d.data.baslik}</span>{d.data.ozet && <span class="block mt-1 text-sm text-(--metin-2) line-clamp-2">{d.data.ozet}</span>}</span>
            </a></li>
          ))}
        </ul>
      </div>
    ) : <p class="text-(--metin-2)">{m.duyuruBos}</p>}
    <div class="mt-10 cetvel pt-5">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h3 class="text-xl sm:text-2xl" id="etkinlik-baslik">{m.etkinlik}</h3>
        <a href={yol(dil, 'etkinlikler')} class="inline-flex items-center gap-1.5 text-sm font-semibold no-underline hover:underline">{m.tumEtkinlik} <Ikon ad="ok" class="h-4 w-4" /></a>
      </div>
      <span class="serit mb-5" aria-hidden="true"></span>
      {etkinlikler.length ? (
        <div class:list={['grid gap-5', etkinlikGrid]}>
          {etkinlikler.map((e) => <EtkinlikKarti dil={dil} slug={e.slug} {...e.data} />)}
        </div>
      ) : <p class="text-(--metin-2)">{m.etkinlikBos}</p>}
    </div>
  </section>

  <!-- ⑤ Bağış — çok kanallı koyu bant -->
  <BagisBandi dil={dil} banka={site.banka} />

  <!-- ⑨ Bize ulaşın -->
  <IletisimMini dil={dil} site={site} />
</Base>
