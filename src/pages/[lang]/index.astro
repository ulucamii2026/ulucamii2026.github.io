---
import Base from '../../layouts/Base.astro';
import NamazVakitleri from '../../components/NamazVakitleri';
import SiradakiVakit from '../../components/SiradakiVakit';
import GundemVitrini from '../../components/GundemVitrini.astro';
import DuyuruSeridi from '../../components/DuyuruSeridi.astro';
import VefatBandi from '../../components/VefatBandi.astro';
import Ikon from '../../components/Ikon.astro';
import AnaSayfaAkisi from '../../components/AnaSayfaAkisi.astro';
import { ceviri, yol } from '../../i18n/utils';
import type { Dil } from '../../i18n/ui';
import { dilYollari, namazVakitleri as namazVakitleriGet, siteAyarlari } from '../../lib/icerik';

export const getStaticPaths = dilYollari;
const dil = Astro.params.lang as Dil;
const t = ceviri(dil);
const site = await siteAyarlari();

const namaz = namazVakitleriGet();
const namazPenceresi = namaz.gunler.slice(0, 7);
const namazEtiket = { imsak: t('namaz.imsak'), gunes: t('namaz.gunes'), ogle: t('namaz.ogle'), ikindi: t('namaz.ikindi'), aksam: t('namaz.aksam'), yatsi: t('namaz.yatsi'), siradaki: t('namaz.siradaki'), kalan: t('namaz.kalan'), hicri: t('namaz.hicri') };

const hizliIslemler = [
  { href: yol(dil, 'kurankursu'), ad: t('nav.kurankursu'), ikon: 'kurs' as const },
  { href: yol(dil, 'portal'), ad: t('nav.portal'), ikon: 'uyelik' as const },
  { href: yol(dil, 'ihtidaBasvuru'), ad: t('nav.ihtidaBasvuru'), ikon: 'belge' as const },
  { href: yol(dil, 'cenaze'), ad: t('ana.hizli.cenaze'), ikon: 'cenaze' as const },
];

const m = dil === 'tr' ? {
  heroUst: 'Marche-en-Famenne · Belçika · 1986’dan beri',
  heroAlt: 'Beş vakit namaz, Cuma hutbesi, Kur’an kursu, Ramazan ve bayram programları, cenaze namazları — Famenne’deki Müslümanların ocağı.',
  hizmet: 'Hızlı Erişim',
} : dil === 'en' ? {
  heroUst: 'Marche-en-Famenne · Belgium · since 1986',
  heroAlt: 'Five daily prayers, the Friday sermon, Qur’an school, Ramadan and Eid programmes, and funeral prayers — home to the Muslims of the Famenne.',
  hizmet: 'Quick Access',
} : {
  heroUst: 'Marche-en-Famenne · Belgique · depuis 1986',
  heroAlt: 'Cinq prières quotidiennes, prêche du vendredi, école coranique, programmes du Ramadan et des fêtes, prières funéraires — le foyer des musulmans de la Famenne.',
  hizmet: 'Accès Rapide',
};

const anaSayfaJsonLd = {
  '@type': 'Mosque', '@id': new URL('/#kurum', Astro.site).toString(),
  geo: { '@type': 'GeoCoordinates', latitude: site.gps.enlem, longitude: site.gps.boylam },
  image: new URL('/media/galeri/cami-24.webp', Astro.site).toString(),
  alternateName: site.dernekAdi,
  hasMap: `https://www.openstreetmap.org/?mlat=${site.gps.enlem}&mlon=${site.gps.boylam}#map=17/${site.gps.enlem}/${site.gps.boylam}`,
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'imam', telephone: site.telefon.dinGorevlisi, email: site.epostaDinGorevlisi },
    { '@type': 'ContactPoint', contactType: 'association', telephone: site.telefon.cami, email: site.eposta },
  ].map((c) => Object.fromEntries(Object.entries(c).filter(([, v]) => v))),
};
---
<Base baslik={t('site.ad')} dil={dil} aciklama={m.heroAlt} ekJsonLd={[anaSayfaJsonLd]}>
  <div class="ana-kurumsal">
  <nav class="kapsayici ana-hizli" aria-label={m.hizmet}>
    <ul role="list">
      {hizliIslemler.map((h) => <li><a href={h.href}><Ikon ad={h.ikon} class="h-5 w-5 shrink-0" /><span>{h.ad}</span><Ikon ad="ok" class="ana-hizli-ok h-4 w-4 shrink-0" /></a></li>)}
    </ul>
  </nav>
  <!-- Diyanet Belçika referansı: geniş görsel vitrin + erişilebilir canlı vakit paneli. -->
  <GundemVitrini dil={dil} siteAdi={t('site.ad')} />
  <section class="kapsayici" aria-labelledby="vakit-baslik">
    <div class="ana-vakit-yatay">
      <div class="ana-vakit-baslik flex items-center gap-3"><Ikon ad="saat" class="h-6 w-6 text-(--vurgu-2)" /><h2 id="vakit-baslik" class="text-2xl">{t('ana.bugun')}</h2></div>
      <div class="ana-vakit-kapsam">
        <NamazVakitleri client:load gunler={namazPenceresi} dil={dil} etiketler={namazEtiket} vurgulu cumaEtiket={t('namaz.cuma')} cumaKisaEtiket={t('namaz.cumaKisa')} cumaSaati={site.cumaSaati} cumaAciklama={t('namaz.cumaAciklama')} />
      </div>
      <div class="ana-siradaki-kapsam">
          <SiradakiVakit client:load gunler={namazPenceresi} dil={dil} etiketler={namazEtiket} />
      </div>
      <div class="ana-vakit-linkler">
        <a href={yol(dil, 'namaz')} class="ana-vakit-tumu">{t('ana.tumvakitler')} <Ikon ad="ok" class="h-4 w-4" /></a>
        <p class="text-xs text-(--metin-2) mt-1">{t('namaz.kaynak')}</p>
      </div>
    </div>
    <div class="ana-duyuru-seridi mt-3"><DuyuruSeridi dil={dil} mesajlar={site.heroMesajlar ?? []} /></div>
  </section>

  <!-- ① c Vefat / cenaze namazı — yalnız yakın tarihli bir kayıt varsa basılır, sonra kendiliğinden kalkar -->
  <VefatBandi dil={dil} />

  <AnaSayfaAkisi dil={dil} />
  </div>
</Base>

<style>
  .ana-kurumsal { --vurgu: var(--vurgu-2); }
  .ana-hizli { padding-top: 1.5rem; padding-bottom: 1rem; }
  .ana-hizli ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; }
  .ana-hizli a { display: flex; align-items: center; gap: .7rem; height: 100%; min-height: 44px; padding: .85rem 1rem; background: var(--zemin-2); color: var(--metin); border: 1px solid var(--cizgi); text-decoration: none; border-radius: var(--radius-kose); font-size: .9rem; font-weight: 600; line-height: 1.4; transition: background .2s, box-shadow .25s, border-color .2s; }
  .ana-hizli a:hover, .ana-hizli a:focus-visible { background: var(--zemin-3); border-color: var(--vurgu-2); box-shadow: var(--shadow-kart); }
  .ana-hizli :global(.ana-hizli-ok) { margin-left: auto; transition: transform .2s; }
  
  .ana-vakit-yatay {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    grid-template-areas:
      "baslik linkler"
      "namaz  siradaki";
    align-items: center;
    gap: 1.25rem 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--zemin-2);
    border: 1px solid var(--cizgi);
    border-top: 3px solid var(--vurgu-2);
    border-radius: var(--radius-kose);
    margin-top: 1.5rem;
  }
  .ana-vakit-baslik { grid-area: baslik; }
  .ana-vakit-kapsam { grid-area: namaz; min-width: 0; width: 100%; }
  .ana-siradaki-kapsam {
    grid-area: siradaki;
    background: #163e53;
    color: #f7f3ea;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-kose);
    min-width: 0;
    max-width: 280px;
    width: 100%;
    justify-self: end;
    align-self: center;
  }
  .ana-vakit-linkler {
    grid-area: linkler;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    min-width: 0;
    text-align: right;
  }
  .ana-vakit-yatay :global(ul) { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: space-between; width: 100%; }
  .ana-vakit-yatay :global(li) { flex: 1 1 70px; min-width: 70px; text-align: center; }
  .ana-vakit-yatay :global(.rakam) { font-size: 1.4rem; }
  .ana-vakit-yatay :global(.etiket) { letter-spacing: .035em; font-size: 0.75rem; }
  .ana-vakit-yatay :global(li[aria-current='time']) { background: var(--color-iznik); color: #fff; border-color: var(--color-iznik); border-radius: 4px; padding-block: 0.2rem; }
  .ana-vakit-yatay :global(li[aria-current='time'] .etiket) { color: #fff; }
  .ana-vakit-tumu { display: flex; align-items: center; gap: .5rem; font-size: .875rem; font-weight: 600; text-decoration: none; color: var(--metin); }
  .ana-vakit-tumu:hover { text-decoration: underline; }

  .ana-duyuru-seridi { padding: .8rem 1.25rem; background: #163e53; color: #f7f3ea; border-radius: var(--radius-kose); }
  .ana-duyuru-seridi :global(#duyuru-seridi) { margin: 0; padding: 0; max-width: none; }
  .ana-duyuru-seridi :global(.serit-mesaj) { font-size: .95rem; filter: none; }
  .ana-duyuru-seridi:empty { display: none; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .ana-hizli a:hover :global(.ana-hizli-ok) { transform: translateX(3px); }
  }
  @media (max-width: 1023px) {
    .ana-vakit-yatay {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "baslik linkler"
        "namaz  namaz"
        "siradaki siradaki";
      gap: 1rem 1.5rem;
    }
    .ana-vakit-linkler {
      align-items: flex-end;
      width: auto;
      margin-top: 0;
    }
    .ana-siradaki-kapsam {
      max-width: none;
      width: 100%;
      justify-self: stretch;
    }
    .ana-hizli ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .ana-vakit-yatay {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 0.75rem;
    }
    .ana-vakit-baslik {
      width: 100%;
    }
    .ana-hizli { padding-top: 1rem; }
    .ana-hizli a { padding: .75rem; font-size: .82rem; gap: .5rem; }
    .ana-hizli :global(.ana-hizli-ok) { display: none; }
    .ana-vakit-yatay :global(ul) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .ana-vakit-yatay :global(li) {
      min-width: 0;
      flex: none;
    }
    .ana-vakit-linkler {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 0.5rem;
      width: 100%;
      min-width: 0;
      text-align: left;
      align-items: center;
    }
    .ana-siradaki-kapsam {
      width: 100%;
      max-width: none;
    }
  }

</style>
