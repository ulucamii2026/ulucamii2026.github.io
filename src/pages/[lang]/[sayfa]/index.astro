---
import type { Dil, SayfaAnahtari } from '../../../i18n/ui';
import { yollar } from '../../../i18n/ui';
import Hakkimizda from '../../../sayfalar/Hakkimizda.astro';
import Duyurular from '../../../sayfalar/Duyurular.astro';
import Etkinlikler from '../../../sayfalar/Etkinlikler.astro';
import Namaz from '../../../sayfalar/Namaz.astro';
import KuranKursu from '../../../sayfalar/KuranKursu.astro';
import Bagis from '../../../sayfalar/Bagis.astro';
import Uyelik from '../../../sayfalar/Uyelik.astro';
import Konsolosluk from '../../../sayfalar/Konsolosluk.astro';
import Galeri from '../../../sayfalar/Galeri.astro';
import Iletisim from '../../../sayfalar/Iletisim.astro';
import MetinSayfasi from '../../../sayfalar/MetinSayfasi.astro';
import Portal from '../../../sayfalar/Portal.astro';
import Vefat from '../../../sayfalar/Vefat.astro';
import Irsat from '../../../sayfalar/Irsat.astro';
import Ihtida from '../../../sayfalar/Ihtida.astro';
import IhtidaBasvuru from '../../../sayfalar/IhtidaBasvuru.astro';
// import Hutbeler from '../../../sayfalar/Hutbeler.astro';  // PASİF — aşağıdaki PASIF listesine bak
import CamiAdabi from '../../../sayfalar/CamiAdabi.astro';
import YonetimKurulu from '../../../sayfalar/YonetimKurulu.astro';
import Cenaze from '../../../sayfalar/Cenaze.astro';
import Afisler from '../../../sayfalar/Afisler.astro';
import DiyanetHizmetleri from '../../../sayfalar/DiyanetHizmetleri.astro';

/* Yayımı durdurulmuş sayfalar: yol hiç üretilmez — adres 404 döner ve sitemap'e girmez.
   hutbeler (26 Ağustos 2026, Rıdvan): hutbeler hizmete özel belgelerdir, yayımlanmadan
   önce Diyanet izni gerekir. Sayfa, 126 kayıt ve 225 PDF duruyor; bu listeden çıkarıp
   bileşen eşlemesini geri açmak yayına döndürmeye yeter. */
export function getStaticPaths() {
  // Astro getStaticPaths'i yalıtılmış çalıştırır: bu liste fonksiyonun İÇİNDE durmalı.
  const PASIF: SayfaAnahtari[] = ['hutbeler'];
  const yol: { params: { lang: Dil; sayfa: string }; props: { anahtar: SayfaAnahtari } }[] = [];
  for (const lang of ['tr', 'fr', 'en'] as Dil[]) {
    for (const [anahtar, seg] of Object.entries(yollar) as [SayfaAnahtari, Record<Dil, string>][]) {
      if (anahtar === 'anasayfa' || PASIF.includes(anahtar)) continue;
      yol.push({ params: { lang, sayfa: seg[lang] }, props: { anahtar } });
    }
  }
  return yol;
}
const dil = Astro.params.lang as Dil;
const { anahtar } = Astro.props;
const bilesenler: Record<Exclude<SayfaAnahtari, 'anasayfa'>, any> = {
  hakkimizda: Hakkimizda, duyurular: Duyurular, etkinlikler: Etkinlikler, namaz: Namaz, kurankursu: KuranKursu,
  bagis: Bagis, uyelik: Uyelik, konsolosluk: Konsolosluk, galeri: Galeri, iletisim: Iletisim,
  kunye: MetinSayfasi, gizlilik: MetinSayfasi, portal: Portal, vefat: Vefat, cenaze: Cenaze,
  irsat: Irsat, ihtida: Ihtida, ihtidaBasvuru: IhtidaBasvuru, adab: CamiAdabi, yonetim: YonetimKurulu, afisler: Afisler, diyanet: DiyanetHizmetleri,
  /* hutbeler: PASİF — hutbeler hizmete özel belgeler, yayımdan önce Diyanet izni gerekiyor
     (Rıdvan, 26 Ağustos 2026). Sayfa (src/sayfalar/Hutbeler.astro), 126 kayıt ve 225 PDF
     duruyor; bu satır geri açılınca /hutbeler ve /sermons yeniden üretilir. */
};
const Bilesen = bilesenler[anahtar as Exclude<SayfaAnahtari, 'anasayfa'>];
---
<Bilesen dil={dil} anahtar={anahtar} />
