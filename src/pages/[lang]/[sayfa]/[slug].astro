---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SayfaBasligi from '../../../components/SayfaBasligi.astro';
import { yollar, type Dil } from '../../../i18n/ui';
import { ceviri, yol, tarihBicimle, hreflangKodu } from '../../../i18n/utils';
import { duyurular, etkinlikler, siteAyarlari } from '../../../lib/icerik';
import { etkinlikIcsUret, saatAyristir, brukselYerelSaatiUtcyeCevir } from '../../../lib/ics';

export async function getStaticPaths() {
  const out: any[] = [];
  for (const lang of ['tr', 'fr', 'en'] as Dil[]) {
    for (const d of await duyurular(lang)) out.push({ params: { lang, sayfa: yollar.duyurular[lang], slug: d.slug }, props: { tur: 'duyuru', entry: d } });
    for (const e of await etkinlikler(lang)) out.push({ params: { lang, sayfa: yollar.etkinlikler[lang], slug: e.slug }, props: { tur: 'etkinlik', entry: e } });
  }
  return out;
}
const dil = Astro.params.lang as Dil;
const { tur, entry } = Astro.props;
const t = ceviri(dil);
const { Content } = await render(entry);
const d = entry.data as any;
const geri = tur === 'duyuru' ? yol(dil, 'duyurular') : yol(dil, 'etkinlikler');
const etiket = tur === 'duyuru' ? t('nav.duyurular') : t('nav.etkinlikler');
const tarih: Date = tur === 'duyuru' ? d.tarih : d.baslangic;
const kapak: string | undefined = tur === 'duyuru' ? d.kapak : d.afis;
const grup = tur === 'duyuru' ? 'duyuru' : 'etkinlik';
const galeri: Array<{ dosya: string; kucuk?: string; alt?: string }> = Array.isArray(d.galeri) ? d.galeri : [];
const galeriBaslik = dil === 'tr' ? 'Fotoğraflar' : dil === 'en' ? 'Photos' : 'Photos';
/* Duyuru ve etkinlik arşivi yalnız TR ve FR yayımlanır; İngilizce sayfada Fransızca metin
   gösterilir (lib/icerik.ts → icerikDili). Liste sayfalarında bu not vardı, detayda yoktu:
   arama motorundan doğrudan gelen ziyaretçi neden Fransızca okuduğunu bilmiyordu
   (25 Ağustos 2026 denetim turu 4). */
/* Kapak lightbox'ta büyüyor ama bunu gösteren bir şey yoktu: 360 px'lik sütunda
   afişin yazıları okunmuyor, ziyaretçi tıklanabileceğini bilmiyordu (26 Ağustos 2026). */
const buyutNotu = dil === 'tr' ? 'Büyütmek için tıklayın' : dil === 'en' ? 'Click to enlarge' : 'Cliquez pour agrandir';
const enNotu = tur === 'duyuru'
  ? 'This announcement is published in Turkish and French. An English version is not available.'
  : 'This event is published in Turkish and French. An English version is not available.';
/* İngilizce sayfada <meta name="description">/og:description Fransızca özete düşüyordu (icerikDili
   fallback'i) — hreflang="en" içerik diliyle çelişiyordu. Arama sonucu/paylaşım kartı artık önce
   bu notu, ardından mevcut özeti gösteriyor (25 Ağustos 2026 denetim turu 4, seo-yapisal#1). */
const enMetaOneki = tur === 'duyuru'
  ? 'This announcement is available in Turkish and French only. '
  : 'This event is available in Turkish and French only. ';
const enAciklama = dil === 'en' ? enMetaOneki + (d.ozet ?? '') : d.ozet;

const kanonikUrl = new URL(Astro.url.pathname, Astro.site).toString();
const waMetin = `${d.baslik} — ${kanonikUrl}`;
const waEtiket = dil === 'tr' ? "WhatsApp'ta paylaş" : dil === 'en' ? 'Share on WhatsApp' : 'Partager sur WhatsApp';

/* Yapısal veri: sitewide Organization'ın yanına sayfaya özel NewsArticle/Event + BreadcrumbList
   (zengin arama sonuçları için, seo-yapisal#3 + iyilestirme#5). Adres kurumJsonLd ile aynı kaynaktan. */
const site = await siteAyarlari();
const kurumId = new URL('/#kurum', Astro.site).toString();
const mutlakGorsel = kapak ? new URL(kapak, Astro.site).toString() : undefined;
const camiAdresi = { '@type': 'PostalAddress', streetAddress: site.adres.sokak, postalCode: site.adres.posta, addressLocality: site.adres.sehir, addressCountry: 'BE' };
const anaSayfaEtiket = dil === 'tr' ? 'Ana Sayfa' : dil === 'en' ? 'Home' : 'Accueil';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: anaSayfaEtiket, item: new URL(yol(dil, 'anasayfa'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: etiket, item: new URL(geri, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: d.baslik, item: kanonikUrl },
  ],
};
/* Event startDate: içerikteki 'saat' alanı ayrıştırılabiliyorsa (ör. "20.00") Europe/Brussels
   yerel saati olarak doğru UTC ana çevrilir; aksi hâlde (serbest metin saat) tarih-yalnız
   (00:00Z) davranışı korunur — .ics üretimiyle (lib/ics.ts) aynı mantık (jsonld#3). */
const etkinlikSaati = tur === 'etkinlik' ? saatAyristir(d.saat) : null;
const etkinlikBaslangicTarihi: Date = etkinlikSaati
  ? brukselYerelSaatiUtcyeCevir(
      (d.baslangic as Date).getUTCFullYear(),
      (d.baslangic as Date).getUTCMonth(),
      (d.baslangic as Date).getUTCDate(),
      etkinlikSaati.saat,
      etkinlikSaati.dakika,
    )
  : (d.baslangic as Date);
const icerikJsonLd = tur === 'duyuru'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: d.baslik,
      datePublished: (d.tarih as Date).toISOString(),
      ...(mutlakGorsel ? { image: [mutlakGorsel] } : {}),
      author: { '@id': kurumId },
      publisher: { '@id': kurumId },
      inLanguage: hreflangKodu(dil),
      mainEntityOfPage: kanonikUrl,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: d.baslik,
      /* Saat yoksa schema.org'un salt-tarih biçimi (YYYY-MM-DD): "00:00Z" gece 02:00 diye okunmasın. */
      startDate: etkinlikSaati ? etkinlikBaslangicTarihi.toISOString() : etkinlikBaslangicTarihi.toISOString().slice(0, 10),
      ...(d.bitis
        ? { endDate: etkinlikSaati
            ? brukselYerelSaatiUtcyeCevir((d.bitis as Date).getUTCFullYear(), (d.bitis as Date).getUTCMonth(), (d.bitis as Date).getUTCDate(), etkinlikSaati.saat, etkinlikSaati.dakika).toISOString()
            : (d.bitis as Date).toISOString().slice(0, 10) }
        : {}),
      location: d.yer
        ? { '@type': 'Place', name: d.yer, address: camiAdresi }
        : { '@type': 'Place', name: 'Ulu Camii', address: camiAdresi },
      ...(mutlakGorsel ? { image: [mutlakGorsel] } : {}),
      organizer: { '@id': kurumId },
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
    };
const ekJsonLd = [icerikJsonLd, breadcrumbJsonLd];

/* "Takvime ekle" (.ics): yalnız etkinliklerde, data: URI ile (statik dosya/derleme bağımlılığı yok). */
const icsHref = tur === 'etkinlik'
  ? `data:text/calendar;charset=utf-8,${encodeURIComponent(etkinlikIcsUret({ slug: entry.slug, baslik: d.baslik, baslangic: d.baslangic, bitis: d.bitis, saat: d.saat, yer: d.yer }, dil))}`
  : undefined;
---
<Base baslik={d.baslik} dil={dil} aciklama={enAciklama} kapak={kapak} ogTuru="article" ekJsonLd={ekJsonLd}>
  <SayfaBasligi etiket={etiket} baslik={d.baslik} altBaslik={d.ozet}>
    <p class="etiket mt-4">
      <time datetime={tarih.toISOString()}>{tarihBicimle(tarih, dil)}</time>
      {tur === 'etkinlik' && d.bitis && d.bitis.getTime() !== d.baslangic.getTime() && <span> – {tarihBicimle(d.bitis, dil)}</span>}
      {tur === 'etkinlik' && d.saat && <span> · {d.saat}</span>}
      {tur === 'etkinlik' && d.yer && <span> · {t('etkinlik.yer')}: {d.yer}</span>}
    </p>
    <p class="mt-2 text-sm">
      <a href={`https://wa.me/?text=${encodeURIComponent(waMetin)}`} target="_blank" rel="noopener">{waEtiket}<span aria-hidden="true"> ↗</span></a>
      {icsHref && <>{' · '}<a href={icsHref} download={`${entry.slug}.ics`}>{t('etkinlik.takvimeEkle')}</a></>}
    </p>
  </SayfaBasligi>
  {dil === 'en' && <div class="kapsayici pt-6"><p class="bilgi text-sm">{enNotu}</p></div>}
  <article class="kapsayici py-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_360px]">
    {/* Mobilde tek sütuna inince görsel metnin en altında kalıyordu — kimse oraya kadar
        inmiyor. Dar ekranda üste alındı, geniş ekranda sağdaki sütunda kalıyor. */}
    <div class="duz-yazi order-2 lg:order-1 min-w-0"><Content /></div>
    {kapak && (
      <aside class="order-1 lg:order-2">
        <a href={kapak} data-lightbox={grup} data-caption={d.kapakAlt ?? d.baslik} class="gorsel-cerceve block">
          <img src={tur === 'etkinlik' && d.afisKucuk ? d.afisKucuk : kapak} alt={d.kapakAlt ?? d.baslik} loading="lazy" decoding="async" />
        </a>
        {tur === 'etkinlik'
          ? <p class="mt-2 text-sm"><a href={kapak} target="_blank" rel="noopener">{t('etkinlik.afis')}<span aria-hidden="true"> ↗</span></a></p>
          : <p class="mt-2 text-sm text-(--metin-2)">{buyutNotu}</p>}
      </aside>
    )}
  </article>
  {galeri.length > 0 && (
    <div class="kapsayici pb-12">
      <h2 class="etiket etiket-vurgu text-base cetvel pt-4 mb-4">{galeriBaslik}</h2>
      <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        {galeri.map((g, i) => (
          <a href={g.dosya} data-lightbox={grup} data-caption={g.alt ?? d.kapakAlt ?? d.baslik} class="block aspect-square overflow-hidden rounded-(--radius-kose) border border-(--cizgi)">
            <img src={g.kucuk ?? g.dosya} alt={g.alt ?? `${d.baslik} — ${i + 1}`} loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </a>
        ))}
      </div>
    </div>
  )}
  <p class="kapsayici pb-12"><a href={geri} class="dugme dugme-ikincil">← {t('genel.geri')}</a></p>
</Base>
