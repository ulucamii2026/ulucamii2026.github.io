  .portal .zengin-alan { display: flex; flex-direction: column; gap: 0.35rem; }
  .portal .za-et { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--metin-2); }
  .portal .za-arac { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem; padding: 0.3rem; border: 1px solid var(--cizgi); border-bottom: 0; border-radius: var(--radius-kose) var(--radius-kose) 0 0; background: var(--zemin-2); }
  .portal .za-b { display: inline-flex; align-items: center; justify-content: center; min-width: 1.9rem; height: 1.9rem; padding: 0 0.35rem; font-size: 0.9rem; line-height: 1; color: var(--metin); background: var(--zemin); border: 1px solid var(--cizgi); border-radius: 4px; cursor: pointer; transition: border-color .12s, background .12s; }
