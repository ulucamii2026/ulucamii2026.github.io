  .portal .bolum { background: var(--zemin); border: 1px solid var(--cizgi); border-radius: var(--radius-kose); padding: 1.25rem 1.4rem; margin-bottom: 1.25rem; box-shadow: var(--shadow-kart); }
  .portal .bolum h2 { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 600; margin: 0 0 0.75rem; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
  .portal .bolum h2 .simge { width: 1.2rem; height: 1.2rem; color: var(--vurgu); flex: none; }
  .portal .bolum h3 { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: var(--tracking-etiket); text-transform: uppercase; color: var(--metin-2); margin: 1.3rem 0 0.4rem; }
  .portal .liste { list-style: none; margin: 0; padding: 0; }
  .portal .liste li { padding: 0.5rem 0; border-top: 1px solid var(--cizgi); display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; align-items: center; }
