---
/**
 * Dinleme sayfası — /e/<kod>/ (21 Eylül 2026).
 *
 * Basılı Fransızca ders kitabının kare kodları buraya gelir: ziyaretçi kitabın üstüne telefonunu
 * tutmuş, tek isteği DİNLEMEK. Bu yüzden sayfa dar, telefon önceliklidir ve yalnız Fransızcadır.
 * Arama motoruna kapalıdır (noindex → site haritası dışı, menüde yok); bilinmeyen kod normal 404 verir.
 *
 * Sözleşme, üretim ve sınama: docs/DINLEME-SAYFALARI.md · türler: src/lib/ecouter.ts
 * Ses kuralı: bütün tilâvet/Elifbâ sesleri yalnız resmî Diyanet kayıtlarıdır (AGENTS.md).
 */
import Base from '../../layouts/Base.astro';
import { EC_METIN, ecParcaAdi, type EcouterKod, type EcouterVeri } from '../../lib/ecouter';
import ham from '../../data/ecouter.json';
import '../../styles/ecouter.css';

const veri = ham as unknown as EcouterVeri;

export function getStaticPaths() {
  const kodlar = (ham as unknown as EcouterVeri).kodlar;
  return Object.entries(kodlar).map(([kod, icerik]) => ({ params: { kod }, props: { icerik } }));
}

const { icerik } = Astro.props as { icerik: EcouterKod };
const m = EC_METIN;
const satirlar = icerik.satirlar ?? [];
const ogeler = icerik.ogeler ?? [];
/** Gerçekten çalınabilen parça sayısı: «Lecture continue» ancak ikisi varsa anlamlıdır. */
const calinabilir = [...satirlar, ...ogeler].filter((p) => p.ses).length;
/** Satırların bir kısmı sesliyse sessiz satıra boş yer bırakılır (hiza bozulmasın);
    hiçbirinde ses yoksa sütun tamamen kalkar — boş halka gösterilmez. */
const satirSesiVar = satirlar.some((s) => s.ses);
const calarVar = calinabilir > 0 || Boolean(icerik.tam);
const aciklama = [icerik.baslik, icerik.altbaslik].filter(Boolean).join(' — ');
/** Betiksiz erişim listesi: her ses en azından düz bağlantı olarak açılabilir. */
const yedekler = [
  ...(icerik.tam ? [{ ad: icerik.tam.etiket ?? m.tamEtiket, ses: icerik.tam.ses }] : []),
  ...satirlar.map((p, i) => ({ ad: ecParcaAdi(p, i + 1, false), ses: p.ses })),
  ...ogeler.map((p, i) => ({ ad: ecParcaAdi(p, i + 1, true), ses: p.ses })),
].filter((y): y is { ad: string; ses: string } => Boolean(y.ses));
const surumVar = veri.surum;
---
<Base baslik={icerik.baslik} dil="fr" aciklama={aciklama} noindex dilHatirla={false}>
  <Fragment slot="head">
    {/* Yönlendirme kodu: betiksiz tarayıcıda da çalışsın diye meta ile. Gecikme 0 —
        gecikmeli yenileme WCAG 2.2.1'e takılır; düğme yenileme çalışmazsa yedektir. */}
    {icerik.yonlendir && <meta http-equiv="refresh" content={`0;url=${icerik.yonlendir}`} />}
  </Fragment>

  <div class="ec-sayfa">
    <header class="ec-ust">
      <p class="etiket etiket-vurgu">{m.etiket}</p>
      <h1>{icerik.baslik}</h1>
      {icerik.altbaslik && <p class="ec-altbaslik">{icerik.altbaslik}</p>}
      <span class="serit" aria-hidden="true"></span>
    </header>

    {icerik.yonlendir ? (
      <section class="ec-yonlendir kart" data-ec-yonlendir={icerik.yonlendir}>
        <p>{m.yonlendirMetin}</p>
        <p class="ec-yonlendir-eylem">
          <a class="dugme dugme-birincil" href={icerik.yonlendir}>{m.yonlendirDugme}</a>
        </p>
      </section>
    ) : (
      <section class="ec-govde" data-ecouter data-surum={surumVar}>
        {icerik.tam && (
          <div class="ec-tam">
            {/* Etiket durum değişiminde DEĞİŞMEZ (düzen kaymasın); durumu simge ve aria-pressed taşır. */}
            <button type="button" class="dugme dugme-birincil ec-tam-dugme" data-ec-tam data-ses={icerik.tam.ses} aria-pressed="false">
              <span class="ec-simge" aria-hidden="true"></span>
              <span>{icerik.tam.etiket ?? m.tamEtiket}</span>
            </button>
            <div class="ec-ilerleme" aria-hidden="true">
              <div class="ec-cubuk"><span data-ec-dolgu></span></div>
              <p class="ec-sure"><span class="mono" data-ec-gecen>{m.sureSifir}</span><span> / </span><span class="mono" data-ec-toplam>{m.sureBos}</span></p>
            </div>
          </div>
        )}

        {calarVar && (
          <div class="ec-kontroller" role="group" aria-label={m.kontroller}>
            <div class="ec-hiz" role="group" aria-label={m.hizBaslik}>
              <span class="etiket ec-hiz-etiket">{m.hizBaslik}</span>
              <button type="button" class="ec-cip" data-ec-hiz="0.75" aria-pressed="false" aria-label={m.hizYavasAd}>{m.hizYavas}</button>
              <button type="button" class="ec-cip" data-ec-hiz="1" aria-pressed="true" aria-label={m.hizNormalAd}>{m.hizNormal}</button>
            </div>
            <button type="button" class="ec-cip ec-cip-genis" data-ec-tekrar aria-pressed="false">{m.tekrar}</button>
            {calinabilir > 1 && (
              <button type="button" class="ec-cip ec-cip-genis" data-ec-zincir aria-pressed="false">{m.zincir}</button>
            )}
          </div>
        )}
        {calarVar && <p class="ec-ipucu">{m.tekrarIpucu}</p>}

        {satirlar.length > 0 && (
          <ul class="ec-satirlar" role="list">
            {satirlar.map((s, i) => (
              <li class="ec-satir" data-ec-parca>
                <div class="ec-satir-metin">
                  {s.no != null && <span class="ec-no mono">{s.no}</span>}
                  {s.ar && <p class="arabic ec-ar" lang="ar" dir="rtl">{s.ar}</p>}
                  {s.okunus && <p class="ec-okunus">{s.okunus}</p>}
                  {s.fr && <p class="ec-fr">{s.fr}</p>}
                </div>
                {s.ses ? (
                  <button type="button" class="ec-cal" data-ec-cal data-ses={s.ses} aria-pressed="false">
                    <span class="ec-simge" aria-hidden="true"></span>
                    <span class="sr-only">{ecParcaAdi(s, i + 1, false)}</span>
                  </button>
                ) : satirSesiVar ? (
                  <span class="ec-sessiz" aria-hidden="true"></span>
                ) : null}
              </li>
            ))}
          </ul>
        )}

        {ogeler.length > 0 && (
          <ul class="ec-izgara" role="list" dir="rtl">
            {ogeler.map((o, i) => (
              <li class="ec-kare" data-ec-parca>
                {o.ses ? (
                  <button type="button" class="ec-kare-dugme" data-ec-cal data-ses={o.ses} aria-pressed="false">
                    {o.ar && <span class="arabic ec-ar-kare" lang="ar" dir="rtl">{o.ar}</span>}
                    <span class="sr-only">{ecParcaAdi(o, i + 1, true)}</span>
                    {o.okunus && <span class="ec-okunus ec-kare-okunus" dir="ltr" aria-hidden="true">{o.okunus}</span>}
                  </button>
                ) : (
                  <span class="ec-kare-dugme ec-kare-sessiz">
                    {o.ar && <span class="arabic ec-ar-kare" lang="ar" dir="rtl">{o.ar}</span>}
                    {o.okunus && <span class="ec-okunus ec-kare-okunus" dir="ltr">{o.okunus}</span>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        )}

        {/* Yeri baştan ayrılmıştır: hata iletisi geldiğinde sayfa kaymaz. */}
        <p class="ec-durum" data-ec-durum role="status" aria-live="polite"></p>

        <noscript>
          <div class="ec-noscript">
            <p>{m.noscript}</p>
            {icerik.tam && <audio controls preload="none" src={icerik.tam.ses}></audio>}
            {yedekler.length > 0 && (
              <>
                <p class="etiket">{m.noscriptListe}</p>
                <ul class="ec-noscript-liste" role="list">
                  {yedekler.map((y) => <li><a href={y.ses}>{y.ad}</a></li>)}
                </ul>
              </>
            )}
          </div>
        </noscript>
      </section>
    )}

    <footer class="ec-kaynak">
      {icerik.kaynak && <span>{icerik.kaynak}</span>}
      <span>{m.kurum}</span>
    </footer>
  </div>
</Base>

<script>
  import { dinlemeyiBaslat } from '../../scripts/ecouter';
  dinlemeyiBaslat();
</script>
