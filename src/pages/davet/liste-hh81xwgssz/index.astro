  <script is:inline type="application/json" id="uc" set:html={JSON.stringify(UC)}></script>
  <script is:inline>
    (() => {
      'use strict';
      const UC = JSON.parse(document.getElementById('uc').textContent);
      const $ = (i) => document.getElementById(i);
      const TZ = 'Europe/Brussels';
      const SON_YANIT = Date.parse('2026-11-07T17:00:00+01:00');
      const SON_YANIT_GUN = '2026-11-07';
      const PROGRAM = Date.parse('2026-11-08T15:00:00+01:00');
      const PROGRAM_BAS = Date.parse('2026-11-08T15:30:00+01:00');
      const PROGRAM_SON = Date.parse('2026-11-09T00:00:00+01:00');
      const ONBELLEK_ANAHTARI = 'veda-liste-onbellek-v1';
      const ONBELLEK_SON = Date.parse('2026-11-09T23:59:00+01:00');
      const OTURUM_ANAHTARI = 'veda-liste-oturum-v1';
      const SON_GORULEN = 'veda-liste-son-gorulen-v1';
      const GERI_DENEME = [5000, 10000, 20000, 40000, 60000, 120000];
      const YENILEME = 60000;
      const ZAMAN_ASIMI = 45000;
      const KURUM_ILK = 6;
      const kol = new Intl.Collator('tr', { sensitivity: 'base', numeric: true });

      // ---------- Yardımcılar ----------
      const trn = (s) => String(s == null ? '' : s).toLocaleLowerCase('tr').replace(/ı/g, 'i').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^\p{L}\p{N} ]+/gu, ' ').replace(/\s+/g, ' ').trim();
      const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
      const bosalt = (e) => { while (e.firstChild) e.removeChild(e.firstChild); };
      const ayirt = (ms, secenek) => { const o = {}; try { new Intl.DateTimeFormat('tr-TR', Object.assign({ timeZone: TZ, hourCycle: 'h23' }, secenek)).formatToParts(new Date(ms)).forEach((p) => { o[p.type] = p.value; }); } catch (_) {} return o; };
      const gunAnahtar = (ms) => { const p = ayirt(ms, { year: 'numeric', month: '2-digit', day: '2-digit' }); return p.year + '-' + p.month + '-' + p.day; };
      const saatDk = (ms) => { const p = ayirt(ms, { hour: '2-digit', minute: '2-digit' }); return p.hour + '.' + p.minute; };
      const gunAy = (ms) => { const p = ayirt(ms, { day: 'numeric', month: 'short' }); return p.day + ' ' + p.month; };
      const mutlak = (ms) => gunAy(ms) + ' ' + saatDk(ms);
      const gunEkle = (anahtar, n) => { const [y, m, d] = anahtar.split('-').map(Number); const t = new Date(Date.UTC(y, m - 1, d + n)); return t.toISOString().slice(0, 10); };
      const gunFark = (a, b) => { const f = (s) => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d); }; return Math.round((f(a) - f(b)) / 86400000); };
      const goreli = (ms, simdi) => {
        const f = simdi - ms;
        if (f < 45000) return 'az önce';
        if (f < 3600000) return Math.max(1, Math.round(f / 60000)) + ' dk önce';
        if (f < 86400000 && gunAnahtar(ms) === gunAnahtar(simdi)) return Math.round(f / 3600000) + ' saat önce';
        const g = gunFark(gunAnahtar(simdi), gunAnahtar(ms));
        if (g <= 0) return Math.round(f / 3600000) + ' saat önce';
        if (g === 1) return 'dün';
        return g + ' gün önce';
      };
      const sureMetni = (ms) => {
        const dk = Math.max(0, Math.floor(ms / 60000));
        const g = Math.floor(dk / 1440), s = Math.floor((dk % 1440) / 60), m = dk % 60;
        if (g >= 1) return g + ' gün ' + s + ' sa';
        if (s >= 1) return s + ' sa ' + m + ' dk';
        return m + ' dk';
      };
      const tel = (t) => String(t || '').replace(/[^\d+]/g, '');
      const sayiYaz = (n) => String(n);

      // ---------- Depolar (anahtar yalnız sessionStorage) ----------
      const oturumOku = () => { try { return sessionStorage.getItem(OTURUM_ANAHTARI) || ''; } catch (_) { return ''; } };
      const oturumYaz = (k) => { try { sessionStorage.setItem(OTURUM_ANAHTARI, k); } catch (_) {} };
      const oturumSil = () => { try { sessionStorage.removeItem(OTURUM_ANAHTARI); } catch (_) {} };
      // <onbellek-mantigi>
      const onbellekGecerliMi = (o, simdi) => !!(o && typeof o === 'object' && o.veri && o.veri.ok && Array.isArray(o.veri.kayitlar) && o.veri.toplam && typeof o.alindi === 'string' && !isNaN(Date.parse(o.alindi)) && (simdi == null ? Date.now() : simdi) < ONBELLEK_SON);
      // </onbellek-mantigi>
      const depoSil = () => { try { localStorage.removeItem(ONBELLEK_ANAHTARI); } catch (_) {} };
      const depoOku = () => { try { const o = JSON.parse(localStorage.getItem(ONBELLEK_ANAHTARI) || 'null'); if (onbellekGecerliMi(o)) return o; if (o) depoSil(); } catch (_) {} return null; };
      const depoYaz = (veri) => { try { localStorage.setItem(ONBELLEK_ANAHTARI, JSON.stringify({ alindi: new Date().toISOString(), veri })); } catch (_) {} };
      const sonGorulenOku = () => { try { return Number(localStorage.getItem(SON_GORULEN)) || 0; } catch (_) { return 0; } };
      const sonGorulenYaz = (ms) => { try { localStorage.setItem(SON_GORULEN, String(ms)); } catch (_) {} };

      // ---------- Anahtar ----------
      let anahtar = '';
      try { anahtar = decodeURIComponent(location.hash.replace(/^#/, '')); } catch (_) { anahtar = location.hash.replace(/^#/, ''); }
      if (location.hash) { try { history.replaceState(null, '', location.pathname); } catch (_) {} }
      if (anahtar) oturumYaz(anahtar); else anahtar = oturumOku();

      // ---------- Durum ----------
      const onceki = sonGorulenOku();            // önceki ziyaretin sonu (oturum boyunca sabit, "Yeni" için)
      let yeniEsik = onceki;
      const S = { sekme: 'tumu', ara: '', sira: 'yeni', grup: null, kurumHepsi: false, eskiMsj: false };
      let veri = null, alindi = 0, imza = '', gruplar = [], ozet = null;
      let suruyor = false, yetkisiz = false, hataSayisi = 0, planli = null, tiktak = null;
      const acik = new Set();
      let kayitIdleri = null;

      // ---------- Mesaj / durum ekranları ----------
      const duyur = (m) => { $('duyuru').textContent = ''; setTimeout(() => { $('duyuru').textContent = m; }, 30); };
      const iskeletGoster = (not) => {
        const d = $('durum'); bosalt(d);
        const p = el('p', 'yukleniyor-not'); p.appendChild(el('span', 'donen')); p.lastChild.setAttribute('aria-hidden', 'true'); p.appendChild(el('span', '', not || 'Liste yükleniyor… (ilk açılış birkaç saniye sürebilir)')); d.appendChild(p);
        const i = el('div', 'iskelet'); i.setAttribute('aria-hidden', 'true'); ['b1', 'b2', 'b3', 'b3'].forEach((c) => i.appendChild(el('i', c))); d.appendChild(i);
      };
      const durumMesaj = (m, tur, dugme) => {
        const d = $('durum'); bosalt(d); if (!m) return;
        const p = el('p', 'mesaj ' + (tur || '')); p.setAttribute('role', tur === 'hata' ? 'alert' : 'status'); p.textContent = m; d.appendChild(p);
        if (dugme) { const b = el('button', 'd-btn birincil', dugme.ad); b.type = 'button'; b.addEventListener('click', dugme.islem); d.appendChild(b); }
      };

      // ---------- Veri işleme ----------
      const kayitHazirla = (k) => {
        const ms = Date.parse(k.zaman);
        return { ad: String(k.ad || '').trim(), kurum: String(k.kurum || '').trim(), gorev: String(k.gorev || '').trim(), telefon: String(k.telefon || '').trim(), durum: k.durum === 'katilacak' ? 'katilacak' : 'katilamayacak', kisi: k.durum === 'katilacak' ? (Number(k.kisi) || 1) : 0, ms: isNaN(ms) ? 0 : ms, gecerli: !!k.gecerli, mesaj: String(k.mesaj || '').trim() };
      };
      const islet = (v) => {
        const hepsi = v.kayitlar.map(kayitHazirla);
        const harita = new Map();
        hepsi.forEach((k) => { const a = trn(k.ad) + '|' + trn(k.kurum); (harita.get(a) || harita.set(a, []).get(a)).push(k); });
        const g = [];
        harita.forEach((liste, a) => {
          liste.sort((x, y) => y.ms - x.ms);
          const cur = liste.find((x) => x.gecerli) || liste[0];
          g.push({ key: a, cur, eski: liste.filter((x) => x !== cur), ara: trn(cur.ad + ' ' + cur.kurum + ' ' + cur.gorev), gkey: trn(cur.gorev), kkey: trn(cur.kurum) });
        });
        // özet (yalnız geçerli kayıtlar)
        const gecerli = hepsi.filter((k) => k.gecerli);
        const kat = gecerli.filter((k) => k.durum === 'katilacak');
        const bugun = gunAnahtar(Date.now());
        const o = { kat: kat.length, kisi: kat.reduce((t, k) => t + k.kisi, 0), yok: gecerli.length - kat.length, msj: gecerli.filter((k) => k.mesaj).length, bugun: gecerli.filter((k) => gunAnahtar(k.ms) === bugun).length, sonra: gecerli.filter((k) => k.ms > SON_YANIT).length };
        if (v.toplam) { o.kat = Number(v.toplam.katilacakKayit) || 0; o.kisi = Number(v.toplam.katilacakKisi) || 0; o.yok = Number(v.toplam.katilamayacak) || 0; }
        // kırılımlar
        const gm = new Map(), km = new Map();
        kat.forEach((k) => {
          const gk = trn(k.gorev);
          const a = gm.get(gk) || gm.set(gk, { key: gk, ad: k.gorev || 'Belirtilmemiş', kisi: 0, kayit: 0 }).get(gk); a.kisi += k.kisi; a.kayit++;
          const kk = trn(k.kurum);
          const b = km.get(kk) || km.set(kk, { key: kk, adlar: new Map(), kisi: 0, kayit: 0 }).get(kk); b.kisi += k.kisi; b.kayit++;
          const r = b.adlar.get(k.kurum) || b.adlar.set(k.kurum, { n: 0, ms: 0 }).get(k.kurum); r.n++; r.ms = Math.max(r.ms, k.ms);
        });
        const buyukMu = (s) => s === s.toLocaleUpperCase('tr') && s !== s.toLocaleLowerCase('tr');
        o.gorevler = Array.from(gm.values()).sort((x, y) => y.kisi - x.kisi || kol.compare(x.ad, y.ad));
        o.kurumlar = Array.from(km.values()).map((b) => {
          let en = null; b.adlar.forEach((r, ad) => { if (!en || r.n > en.r.n || (r.n === en.r.n && ((buyukMu(en.ad) && !buyukMu(ad)) || (buyukMu(en.ad) === buyukMu(ad) && r.ms > en.r.ms)))) en = { ad, r }; });
          return { key: b.key, ad: (en && en.ad) || 'Belirtilmemiş', kisi: b.kisi, kayit: b.kayit };
        }).sort((x, y) => y.kisi - x.kisi || kol.compare(x.ad, y.ad));
        // günlük
        const gun = new Map();
        gecerli.forEach((k) => { if (!k.ms) return; const d = gunAnahtar(k.ms); const r = gun.get(d) || gun.set(d, { once: 0, sonra: 0 }).get(d); if (k.ms > SON_YANIT) r.sonra++; else r.once++; });
        o.gun = gun;
        return { hepsi, gruplar: g, ozet: o };
      };

      // ---------- Çizim: panel ----------
      const panoCiz = () => {
        const o = ozet;
        $('t-kisi').textContent = sayiYaz(o.kisi); $('t-kayit').textContent = sayiYaz(o.kat); $('t-yok').textContent = sayiYaz(o.yok); $('t-msj').textContent = sayiYaz(o.msj); $('t-bugun').textContent = sayiYaz(o.bugun);
        $('t-kisi-alt').textContent = 'eşler ve misafirler dahil · ' + o.kat + ' kayıttan';
        zamanCiz();
        // grafik
        const gun = o.gun; const bugun = gunAnahtar(Date.now());
        const g = $('grafik'), ek = $('eksen'); bosalt(g); bosalt(ek);
        if (!gun.size) { $('grafik-aralik').textContent = 'Henüz kayıt yok'; g.setAttribute('aria-label', 'Henüz bildirim yok'); return; }
        const keys = Array.from(gun.keys()).sort();
        let son = keys[keys.length - 1] > bugun ? keys[keys.length - 1] : bugun;
        let bas = keys[0]; if (gunFark(son, bas) > 20) bas = gunEkle(son, -20);
        const gunler = []; for (let d = bas; d <= son; d = gunEkle(d, 1)) gunler.push(d);
        const en = Math.max(1, ...gunler.map((d) => { const r = gun.get(d); return r ? r.once + r.sonra : 0; }));
        const ozetMetin = [];
        gunler.forEach((d) => {
          const r = gun.get(d) || { once: 0, sonra: 0 }; const top = r.once + r.sonra;
          const c = el('div', 'gun'); c.title = d.slice(8) + '.' + d.slice(5, 7) + ': ' + top + ' kayıt';
          if (r.sonra) { const i = el('i', 'sonra'); i.style.height = (r.sonra / en * 100) + '%'; c.appendChild(i); }
          if (r.once) { const i = el('i', ''); i.style.height = (r.once / en * 100) + '%'; c.appendChild(i); }
          g.appendChild(c); ek.appendChild(el('span', '', d.slice(8)));
          if (top) ozetMetin.push(d.slice(8) + '.' + d.slice(5, 7) + ' ' + top);
        });
        g.setAttribute('aria-label', 'Günlük bildirim sayıları: ' + ozetMetin.join(', '));
        const bu = (d) => gunAy(Date.parse(d + 'T12:00:00+01:00'));
        $('grafik-aralik').textContent = bu(gunler[0]) + ' – ' + bu(gunler[gunler.length - 1]) + ' · en çok ' + en;
      };
      const zamanCiz = () => {
        const simdi = Date.now();
        if (simdi < SON_YANIT) {
          $('s1-et').textContent = 'Yanıt süresine'; $('s1-deger').textContent = sureMetni(SON_YANIT - simdi); $('s1-alt').textContent = 'Cumartesi 7 Kasım, 17.00';
        } else {
          $('s1-et').textContent = 'Yanıt süresi'; $('s1-deger').textContent = 'Doldu';
          $('s1-alt').textContent = 'Form hâlâ açık. Sonradan gelenler «süre sonrası» diye işaretlenir' + (ozet && ozet.sonra ? ' (' + ozet.sonra + ' kayıt).' : '.');
        }
        if (simdi < PROGRAM) { $('s2-deger').textContent = 'Programa ' + sureMetni(PROGRAM - simdi); $('s2-alt').textContent = 'Pazar 8 Kasım · karşılama 15.00, başlangıç 15.30'; }
        else if (simdi < PROGRAM_SON) { $('s2-deger').textContent = simdi < PROGRAM_BAS ? 'Karşılama başladı' : 'Program başladı'; $('s2-alt').textContent = 'BDV Genel Merkezi · 8 Kasım'; }
        else { $('s2-deger').textContent = 'Program günü geçti'; $('s2-alt').textContent = '8 Kasım 2026'; }
      };
      const dilimCiz = (ul, liste, tur) => {
        bosalt(ul);
        const en = Math.max(1, ...liste.map((x) => x.kisi));
        liste.forEach((x) => {
