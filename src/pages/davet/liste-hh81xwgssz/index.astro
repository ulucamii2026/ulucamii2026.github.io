---
/**
 * «Ahde Vefa» — Veda Programı: KORUMALI katılım listesi (yalnız Rıdvan KAYAHAN ve Müşavir Bey). Gizli adres; noindex.
 * Koruma: uzun rastgele anahtar adres parçasında (#anahtar) verilir; sunucuya yalnız POST gövdesiyle gider,
 * depoda YOK (Apps Script özelliği LISTE_ANAHTARI). Parça açılır açılmaz adres çubuğundan silinir;
 * yenilemede erişim kaybolmasın diye anahtar yalnız sessionStorage'da (sekmeye özel) tutulur,
 * localStorage'a, adrese ya da günlüğe ASLA yazılmaz.
 * Açılış: https://ulucamii.be/davet/liste-hh81xwgssz/#<anahtar>
 * Arka uç: scripts/apps-script/veda-davet/Kod.gs (değişmez). Her şey istemci tarafındadır.
 */
const UC = 'https://script.google.com/macros/s/AKfycbyhTvE9DHr58vAZC7ifqmz13HHrGMIBzug_thLzV-7y_hxdWJ1OLV6f-oCMPUFqwphecA/exec';
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="referrer" content="no-referrer">
  <meta name="color-scheme" content="light dark">
  <title>Veda Programı — Katılım Listesi</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://script.google.com" crossorigin>
  <link rel="preconnect" href="https://script.googleusercontent.com" crossorigin>
  <link rel="stylesheet" href="/davet/ortak/davet.css">
  <style is:global>
    :root {
      color-scheme: light dark;
      --bg: #fff; --panel: #f7f6f3; --panel2: #efece5; --ink: #2e2f31; --muted: #5d5f62; --line: #d9d6cf;
      --red: #EE3434; --redtxt: #c4161c; --redbtn: #d42a2a; --focus: rgba(196, 22, 28, .5);
      --ok-bg: #e4f1e7; --ok-tx: #1d4a29; --no-bg: #f6e3e1; --no-tx: #7d1a14; --warn-bg: #fff1d6; --warn-tx: #6e4300;
      --bar: #EE3434; --bar2: #b9b6ae; --nokta-ok: #2f6b3a; --nokta-uyari: #b7791f; --nokta-hata: #b3261e;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --zemin: #141516; --koyu: #ecebe7; --krem: #1d1f21; --cizgi: #3a3d40; --gri: #a8abae;
        --bg: #141516; --panel: #1d1f21; --panel2: #26292c; --ink: #ecebe7; --muted: #a8abae; --line: #3a3d40;
        --redtxt: #ff8f86; --redbtn: #d42a2a; --focus: rgba(255, 143, 134, .6);
        --ok-bg: #1c3324; --ok-tx: #9fdcaf; --no-bg: #3a1f1d; --no-tx: #ffb4ab; --warn-bg: #3a2d12; --warn-tx: #ffd58a;
        --bar2: #5b5e62; --nokta-ok: #5fbf78; --nokta-uyari: #e0a84a; --nokta-hata: #ff8f86;
      }
      .ustlogo { background: #fff; padding: 12px 16px; margin-top: 12px; border-radius: 3px 3px 0 0; }
      .kirmizi-serit { margin-left: 0; margin-right: 0; }
    }

    .d { color: var(--ink); font-variant-numeric: tabular-nums; }
    .d h1 { font-size: clamp(1.7rem, 6vw, 2.3rem); margin: 22px 0 2px; }
    .d h2 { margin: 0 0 10px; color: var(--redtxt); }
    .d .altbaslik { color: var(--muted); margin: 0 0 14px; }
    @media (min-width: 760px) { .sayfa.genis { max-width: 1120px; } }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* Düğmeler (davet.css'in genel button kuralını bu sayfada ezer) */
    .d button.d-btn { font: 600 .78rem/1.1 var(--sans); letter-spacing: .04em; text-transform: none; min-height: 44px; padding: 0 14px; width: auto; border-radius: 4px; background: transparent; color: var(--redtxt); border: 1px solid var(--redtxt); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .d button.d-btn:hover { background: var(--panel2); }
    .d button.d-btn.birincil { background: var(--redbtn); border-color: var(--redbtn); color: #fff; }
    .d button.d-btn.birincil:hover { background: #b81f1f; }
    .d button.d-btn:disabled { opacity: .55; cursor: default; }
    .d button.d-btn.sessiz { color: var(--muted); border-color: var(--line); }
    .d :focus-visible, .d a:focus-visible, .d summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 3px; }
    .d a { color: var(--redtxt); text-underline-offset: 3px; }

    /* Durum şeridi */
    .serit { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 4px 0 12px; font: 400 .82rem/1.4 var(--sans); color: var(--muted); }
    .serit .metin { flex: 1 1 220px; min-width: 0; display: flex; align-items: center; gap: 8px; }
    .nokta { width: 10px; height: 10px; border-radius: 50%; background: var(--nokta-ok); flex: none; }
    .nokta.yenileniyor { background: var(--nokta-uyari); }
    .nokta.hata { background: var(--nokta-hata); }
    .serit .dugmeler { display: flex; flex-wrap: wrap; gap: 8px; }
    .bant { font: 400 .88rem/1.45 var(--sans); padding: 10px 14px; margin: 0 0 12px; border-left: 4px solid var(--muted); background: var(--panel); border-radius: 0 3px 3px 0; }
    .bant.uyari { border-color: var(--nokta-uyari); background: var(--warn-bg); color: var(--warn-tx); }
    .bant.hata { border-color: var(--nokta-hata); background: var(--no-bg); color: var(--no-tx); }
    .bant.yeni { border-color: var(--nokta-ok); background: var(--ok-bg); color: var(--ok-tx); display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; }
    .bant button { margin-left: auto; }

    /* İskelet ve yükleniyor */
    .iskelet { display: grid; gap: 10px; }
    .iskelet i { display: block; border-radius: 4px; background: linear-gradient(90deg, var(--panel) 25%, var(--panel2) 50%, var(--panel) 75%); background-size: 200% 100%; animation: parla 1.4s linear infinite; }
    .iskelet .b1 { height: 130px; } .iskelet .b2 { height: 64px; } .iskelet .b3 { height: 88px; }
    .yukleniyor-not { font: 400 .85rem/1.4 var(--sans); color: var(--muted); margin: 0 0 10px; display: flex; align-items: center; gap: 8px; }
    .donen { width: 1rem; height: 1rem; flex: none; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: don .8s linear infinite; opacity: .7; }
    @keyframes don { to { transform: rotate(360deg); } }
    @keyframes parla { to { background-position: -200% 0; } }
    @media (prefers-reduced-motion: reduce) {
      .iskelet i { animation: none; } .donen { animation: none; border-top-color: currentColor; }
      * { scroll-behavior: auto !important; transition: none !important; }
    }

    /* Panel */
    .pano { display: grid; gap: 12px; margin: 0 0 18px; }
    @media (min-width: 760px) { .pano { grid-template-columns: 1.15fr 1fr; align-items: stretch; } }
    .kahraman { border: 1px solid var(--line); border-top: 4px solid var(--red); background: var(--panel); border-radius: 4px; padding: 16px; display: grid; gap: 12px; }
    .buyuk { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .buyuk b { font: 600 clamp(3.4rem, 17vw, 5rem)/1 "Source Serif 4 Display", var(--serif); color: var(--red); }
    .buyuk span { font: 600 .82rem/1.35 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .buyuk small { display: block; font: 400 .74rem/1.4 var(--sans); letter-spacing: 0; text-transform: none; margin-top: 2px; }
    .kucukler { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    @media (min-width: 460px) { .kucukler { grid-template-columns: repeat(4, 1fr); } }
    .kucuk { border: 1px solid var(--line); background: var(--bg); border-radius: 4px; padding: 8px 10px; }
    .kucuk b { display: block; font: 600 1.55rem/1.15 "Source Serif 4 Display", var(--serif); color: var(--ink); }
    .kucuk span { font: 400 .72rem/1.3 var(--sans); color: var(--muted); }
    .sag { display: grid; gap: 12px; align-content: start; }
    .kart { border: 1px solid var(--line); background: var(--panel); border-radius: 4px; padding: 12px 14px; }
    .kart .et { font: 600 .7rem/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; }
    .kart .deger { font: 600 1.3rem/1.25 "Source Serif 4 Display", var(--serif); color: var(--ink); margin: 0; }
    .kart .alt { font: 400 .8rem/1.45 var(--sans); color: var(--muted); margin: 4px 0 0; }
    .sayac2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 420px) { .sayac2 { grid-template-columns: 1fr; } }
    .grafik { display: flex; align-items: flex-end; gap: 3px; height: 64px; margin-top: 8px; }
    .grafik .gun { flex: 1 1 0; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; }
    .grafik .gun i { display: block; background: var(--bar); min-height: 0; }
    .grafik .gun i.sonra { background: var(--bar2); }
    .grafik .gun i:first-of-type { border-radius: 2px 2px 0 0; }
    .grafik-eksen { display: flex; gap: 3px; font: 400 .6rem/1.4 var(--sans); color: var(--muted); }
    .grafik-eksen span { flex: 1 1 0; text-align: center; overflow: hidden; }
    .lejant { font: 400 .72rem/1.4 var(--sans); color: var(--muted); margin: 4px 0 0; display: flex; gap: 12px; flex-wrap: wrap; }
    .lejant i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; background: var(--bar); vertical-align: -1px; }
    .lejant i.sonra { background: var(--bar2); }

    /* Kırılımlar */
    .kirilimlar { display: grid; gap: 12px; margin: 0 0 18px; }
    @media (min-width: 760px) { .kirilimlar { grid-template-columns: 1fr 1fr; align-items: start; } }
    .kirilim ul { list-style: none; margin: 0; padding: 0; }
    .kirilim li { margin: 0; }
    .kirilim button.satir { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; width: 100%; min-height: 44px; padding: 6px 4px; border: 0; border-top: 1px solid var(--line); border-radius: 0; background: transparent; text-align: left; cursor: pointer; font: 400 .92rem/1.3 var(--serif); color: var(--ink); letter-spacing: 0; text-transform: none; align-items: center; }
    .d .kirilim button.satir:hover { background: var(--panel2); }
    .kirilim button.satir[aria-pressed="true"] { background: var(--panel2); box-shadow: inset 3px 0 0 var(--red); }
    .kirilim .sayi { font: 600 .85rem/1.2 var(--sans); white-space: nowrap; }
    .kirilim .sayi small { font-weight: 400; color: var(--muted); }
    .kirilim .cubuk { grid-column: 1 / -1; height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
    .kirilim .cubuk i { display: block; height: 100%; background: var(--red); }
    .kirilim .daha { margin-top: 6px; }

    /* Araç çubuğu */
    .arac { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 8px 0; margin: 0 0 8px; border-bottom: 1px solid var(--line); display: grid; gap: 8px; }
    .arac .ust { display: grid; grid-template-columns: 1fr; gap: 8px; }
    @media (min-width: 560px) { .arac .ust { grid-template-columns: 1fr auto; } }
    .d input[type="search"] { width: 100%; min-height: 46px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--panel); color: var(--ink); font: 400 17px/1.3 var(--serif); -webkit-appearance: none; appearance: none; }
    .d select { width: auto; min-height: 46px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px; background: var(--panel); color: var(--ink); font: 400 15px/1.3 var(--sans); }
    .d input:focus, .d select:focus { outline: 3px solid var(--focus); outline-offset: 1px; border-color: var(--redtxt); }
    .sekmeler { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: thin; }
    .d button.sekme { flex: 0 0 auto; min-height: 44px; padding: 0 12px; width: auto; font: 600 .8rem/1 var(--sans); letter-spacing: .02em; text-transform: none; border-radius: 22px; background: transparent; color: var(--ink); border: 1px solid var(--line); cursor: pointer; }
    .d button.sekme:hover { background: var(--panel2); }
    .d button.sekme[aria-pressed="true"] { background: var(--redbtn); border-color: var(--redbtn); color: #fff; }
    .sekme .n { font-weight: 400; opacity: .85; margin-left: 4px; }
    .chip { display: inline-flex; align-items: center; gap: 6px; font: 400 .82rem/1.3 var(--sans); background: var(--panel2); border-radius: 14px; padding: 4px 4px 4px 10px; }
    .d .chip button { min-height: 32px; min-width: 32px; width: 32px; padding: 0; border-radius: 16px; background: transparent; color: var(--ink); border: 0; font-size: 1rem; letter-spacing: 0; }
    .sonuc-sayi { font: 400 .8rem/1.4 var(--sans); color: var(--muted); margin: 0 0 8px; display: flex; gap: 8px 14px; flex-wrap: wrap; align-items: center; }

    /* Rozetler */
    .rz { display: inline-block; font: 600 .66rem/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; padding: 4px 7px; border-radius: 3px; vertical-align: 2px; margin-left: 6px; white-space: nowrap; }
    .rz.evet { background: var(--ok-bg); color: var(--ok-tx); }
    .rz.hayir { background: var(--no-bg); color: var(--no-tx); }
    .rz.eski { background: var(--panel2); color: var(--muted); }
    .rz.yeni { background: var(--redbtn); color: #fff; }
    .rz.gec { background: var(--warn-bg); color: var(--warn-tx); }
    .rz.msj { background: transparent; color: var(--muted); border: 1px solid var(--line); }

    /* Tablo (geniş ekran) / kart (telefon) */
    table.liste-t { width: 100%; border-collapse: collapse; }
    table.liste-t th { text-align: left; font: 600 .68rem/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding: 6px 8px; border-bottom: 2px solid var(--line); }
    table.liste-t td { padding: 10px 8px; vertical-align: top; font: 400 .95rem/1.4 var(--serif); }
    table.liste-t tbody { border-bottom: 1px solid var(--line); }
    table.liste-t tbody.yeni-kayit { box-shadow: inset 3px 0 0 var(--red); }
    td.c-ad { font-weight: 600; font-size: 1.02rem; }
    td.c-ad .rz:first-of-type { margin-left: 0; }
    td.c-ad .rozetler { display: block; margin-top: 4px; }
    td.c-ad .rozetler .rz { margin: 0 6px 4px 0; }
    td.c-zaman .mut, .mut { color: var(--muted); font: 400 .78rem/1.35 var(--sans); display: block; }
    td.c-tel a { white-space: nowrap; font: 400 .88rem/1.3 var(--sans); }
    td.c-kisi { white-space: nowrap; }
    td.bos { color: var(--muted); }
    tr.ek td { padding: 0 8px 10px; }
    details.d-det { margin: 0; }
    details.d-det summary { cursor: pointer; font: 600 .78rem/1.4 var(--sans); color: var(--redtxt); min-height: 32px; display: flex; align-items: center; }
    details.d-det .ic { margin: 4px 0 4px; padding: 10px 12px; background: var(--panel); border-left: 3px solid var(--red); white-space: pre-wrap; overflow-wrap: anywhere; font: 400 .95rem/1.5 var(--serif); color: var(--ink); }
    .eskiler { display: grid; gap: 6px; margin: 4px 0; }
    .eskiler .e { padding: 8px 10px; background: var(--panel); border-radius: 3px; font: 400 .85rem/1.45 var(--sans); color: var(--muted); }
    .eskiler .e .m { display: block; margin-top: 4px; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--serif); color: var(--ink); }
    @media (min-width: 760px) {
      table.liste-t { table-layout: fixed; }
      table.liste-t col.k-ad { width: 26%; } table.liste-t col.k-kurum { width: 22%; } table.liste-t col.k-gorev { width: 15%; }
      table.liste-t col.k-tel { width: 15%; } table.liste-t col.k-kisi { width: 7%; } table.liste-t col.k-zaman { width: 15%; }
      td { overflow-wrap: anywhere; }
      table.liste-t tbody:hover { background: var(--panel); }
    }
    @media (max-width: 759px) {
      table.liste-t, table.liste-t tbody, table.liste-t tr, table.liste-t td { display: block; }
      table.liste-t thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      table.liste-t colgroup { display: none; }
      table.liste-t tbody { border: 1px solid var(--line); border-radius: 6px; margin: 0 0 10px; padding: 8px 12px; background: var(--bg); }
      table.liste-t tbody.yeni-kayit { box-shadow: inset 4px 0 0 var(--red); }
      table.liste-t tr.ana { display: grid; grid-template-columns: 1fr auto; column-gap: 10px; align-items: baseline; }
      table.liste-t td { padding: 2px 0; }
      td.c-ad { grid-column: 1 / -1; }
      td.c-kurum { grid-column: 1 / -1; color: var(--muted); }
      td.c-gorev { grid-column: 1; color: var(--muted); font-size: .88rem; }
      td.c-kisi { grid-column: 2; text-align: right; font-weight: 600; }
      td.c-tel { grid-column: 1; padding-top: 4px; }
      td.c-tel a { display: inline-flex; align-items: center; min-height: 40px; }
      td.c-zaman { grid-column: 2; text-align: right; padding-top: 4px; }
      td.bos.c-gorev, td.bos.c-tel { display: none; }
      tr.ek td { padding: 4px 0 2px; }
    }

    /* Mesajlar */
    .mesajlar { display: grid; gap: 12px; }
    @media (min-width: 900px) { .mesajlar { grid-template-columns: 1fr 1fr; } }
    .msg { border: 1px solid var(--line); border-left: 4px solid var(--red); background: var(--panel); border-radius: 3px; padding: 12px 14px; margin: 0; }
    .msg.eski-m { border-left-color: var(--bar2); }
    .msg blockquote { margin: 0 0 8px; font: 400 1.05rem/1.6 var(--serif); white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ink); }
    .msg figcaption { font: 600 .88rem/1.35 var(--sans); color: var(--ink); }
    .msg figcaption .mut { font-weight: 400; margin-top: 2px; }
    .araclar2 { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }

    .bos-durum { text-align: center; padding: 36px 12px; color: var(--muted); font: 400 1rem/1.5 var(--serif); border: 1px dashed var(--line); border-radius: 6px; }
    .bos-durum b { display: block; font: 600 1.1rem/1.3 var(--serif); color: var(--ink); margin-bottom: 6px; }
    .not-alt { font: 400 .78rem/1.6 var(--sans); color: var(--muted); margin: 22px 0 0; }

    /* Yazdırma: ekran arayüzü gizlenir; yalnız seçilen blok basılır. Telefon ve mesaj kapı listesine ASLA girmez. */
    #yazdir { display: none; }
    @media print {
      @page { size: A4; margin: 12mm 12mm 14mm; @bottom-center { content: counter(page) " / " counter(pages); font: 8pt Montserrat, sans-serif; color: #666; } }
      :root { color-scheme: light; --bg: #fff; --ink: #1d1d1f; --muted: #555; --line: #bdbab3; --panel: #fff; --panel2: #eee; }
      html, body { background: #fff !important; color: #000 !important; }
      body { font-size: 10.5pt; }
      .sayfa { display: none !important; }
      #yazdir { display: block; }
      #yazdir .blok { display: none; }
      body[data-yazdir="kapi"] #yazdir .kapi, body[data-yazdir="mesaj"] #yazdir .msjblok { display: block; }
      .yz-ust { display: flex; justify-content: space-between; align-items: center; gap: 12mm; margin-bottom: 3mm; }
      .yz-ust img { height: 13mm; width: auto; display: block; }
      .yz-serit { height: 1.2mm; background: #EE3434 !important; margin: 0 0 5mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      #yazdir h1 { font-size: 20pt; margin: 0 0 1mm; color: #EE3434; }
      #yazdir .yz-alt { font: 600 8.5pt/1.4 Montserrat, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #555; margin: 0 0 2mm; }
      #yazdir .yz-ozet { font: 400 10pt/1.5 Montserrat, sans-serif; margin: 0 0 4mm; padding: 2mm 0; border-top: .3mm solid #999; border-bottom: .3mm solid #999; }
      #yazdir .yz-ozet b { font-weight: 600; }
      table.kapi-t { width: 100%; border-collapse: collapse; }
      table.kapi-t thead { display: table-header-group; }
      table.kapi-t th { font: 600 8pt/1.3 Montserrat, sans-serif; letter-spacing: .06em; text-transform: uppercase; text-align: left; border-bottom: .5mm solid #000; padding: 1.5mm 1.5mm; }
      table.kapi-t td { border-bottom: .2mm solid #999; padding: 0 1.5mm; height: 8.2mm; vertical-align: middle; font: 400 10.5pt/1.2 "Source Serif 4", Georgia, serif; }
      table.kapi-t tr { break-inside: avoid; page-break-inside: avoid; }
      table.kapi-t td.kutu { width: 9mm; text-align: center; font-size: 14pt; }
      table.kapi-t td.no { width: 8mm; color: #666; font-size: 8.5pt; text-align: right; }
      table.kapi-t th:nth-child(5), table.kapi-t td:nth-child(5) { width: 32mm; }
      table.kapi-t td.kisi { width: 14mm; text-align: center; font-weight: 600; }
      table.kapi-t td.ad { font-weight: 600; }
      table.kapi-t tr.bosyer td { height: 9mm; }
      .yz-not { font: 400 8pt/1.5 Montserrat, sans-serif; color: #555; margin-top: 4mm; }
