---
// Kök: tarayıcı diline göre /tr/ veya /fr/ — JS kapalıysa meta refresh ile TR
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Marche-en-Famenne Ulu Camii</title>
    <link rel="alternate" hreflang="tr" href="https://ulucamii.be/tr/" />
    <link rel="alternate" hreflang="fr-BE" href="https://ulucamii.be/fr/" />
    <link rel="alternate" hreflang="en" href="https://ulucamii.be/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ulucamii.be/tr/" />
    <script is:inline>
      (function () {
        var d = (navigator.languages || [navigator.language || 'tr']).map(function (l) { return l.toLowerCase().slice(0, 2); });
        var hedef = 'tr';
        for (var i = 0; i < d.length; i++) { if (d[i] === 'tr') { hedef = 'tr'; break; } if (d[i] === 'fr') { hedef = 'fr'; break; } if (d[i] === 'en') { hedef = 'en'; break; } }
        location.replace('/' + hedef + '/');
      })();
    </script>
    <meta http-equiv="refresh" content="1; url=/tr/" />
  </head>
  <body><p><a href="/tr/">Türkçe</a> · <a href="/fr/">Français</a> · <a href="/en/">English</a></p></body>
</html>
