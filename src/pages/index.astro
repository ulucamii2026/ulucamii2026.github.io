---
/** Kök (/) — dil seçmeden gelen ziyaretçiyi doğru dile gönderir.
 *
 * Sıra: (1) ziyaretçinin sitede en son kullandığı dil, (2) tarayıcının dil sırası,
 * (3) hiçbiri tutmuyorsa İngilizce. Üçüncü basamak 26 Ağustos 2026'da Rıdvan'ın kararıyla
 * Türkçe'den İngilizce'ye çevrildi: Belçika'da Felemenkçe tarayıcı çok yaygın ve bu
 * ziyaretçiler Türkçe sayfaya düşüyordu — ölçüldü (nl, de, ar, es hepsi /tr/ açıyordu).
 * Türkçe, Fransızca ve İngilizce tarayıcılar kendi dillerine gider; ortak dil İngilizce.
 *
 * JS kapalıysa meta refresh Türkçe'ye gider: tarayıcı dili okunamadığı için tercih
 * yapılamaz ve caminin ana cemaati Türkçe konuşur (x-default de Türkçe).
 */
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Marche-en-Famenne Ulu Camii</title>
    <link rel="alternate" hreflang="tr" href="https://ulucamii.be/tr/" />
    <link rel="alternate" hreflang="fr-BE" href="https://ulucamii.be/fr/" />
    <link rel="alternate" hreflang="en" href="https://ulucamii.be/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ulucamii.be/tr/" />
    <script is:inline>
      (function () {
        var DILLER = ['tr', 'fr', 'en'];
        var hedef = null;

        // 1) Ziyaretçinin kendi seçimi her şeyin önünde: sitede en son hangi dilde
        //    gezdiyse oraya döner (Base.astro her sayfada yazar).
        try {
          var kayitli = localStorage.getItem('uluCamiiSiteDili');
          if (DILLER.indexOf(kayitli) !== -1) hedef = kayitli;
        } catch (e) { /* gizli sekme ya da depolama kapalı: tarayıcı diline düş */ }

        // 2) Tarayıcının tercih sırası — ilk tanıdığımız dil kazanır.
        if (!hedef) {
          var istenen = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < istenen.length; i++) {
            var kod = String(istenen[i]).toLowerCase().slice(0, 2);
            if (DILLER.indexOf(kod) !== -1) { hedef = kod; break; }
          }
        }

        // 3) Tarayıcı bu üç dilden hiçbirini istemiyorsa ortak dil İngilizce.
        location.replace('/' + (hedef || 'en') + '/');
      })();
    </script>
    <meta http-equiv="refresh" content="1; url=/tr/" />
  </head>
  <body><p><a href="/tr/">Türkçe</a> · <a href="/fr/">Français</a> · <a href="/en/">English</a></p></body>
</html>
