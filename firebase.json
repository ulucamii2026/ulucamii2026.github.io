{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "ilim-yolu",
      "predeploy": ["npm --prefix functions run build"],
      "ignore": ["node_modules", ".git", "*.log", "src", "build.mjs", "tsconfig.json"]
    }
  ],
  "hosting": [
    {
      "site": "ulucamii-egitim",
      "public": "egitim/dist",
      "rewrites": [
        { "source": "/api/saglik", "function": { "functionId": "saglik", "region": "europe-west1" } },
        { "source": "/api/cocuk-giris", "function": { "functionId": "cocukGiris", "region": "europe-west1" } },
        { "source": "/api/kart-giris", "function": { "functionId": "kartGiris", "region": "europe-west1" } },
        { "source": "/api/abonelik-cik", "function": { "functionId": "abonelikCik", "region": "europe-west1" } }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src 'self' https://apis.google.com; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self' https://ulucamii.be blob:; connect-src 'self' https://ulucamii.be https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://europe-west1-ulucamii-portal.cloudfunctions.net https://script.google.com https://script.googleusercontent.com; frame-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'"
            },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" }
          ]
        },
        {
          "regex": "^(.*/|.*\\.html)$",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/_astro/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/media/ses/kart/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
          "source": "/fonts/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        }
      ]
    }
  ]
}
