rules_version = '2';
// Veli portalı güvenlik kuralları (6 Eyl 2026). Dağıtım: npm run firebase:kurallar (dernek hesabı, proje ulucamii-portal).
//
// Roller
//   hoca  : Firebase kullanıcısı + hocalar/{uid} belgesi var (belge yalnız yönetici betiğiyle yazılır).
//   veli  : Firebase kullanıcısı + aileler/{e-posta} belgesi var (hoca ekranı oluşturur; e-posta küçük harf).
//           Veli yalnız aileler/{e-posta}.ogrenciler listesindeki öğrencilerin belgelerini okur.
// Liste sorguları: veli tarafı her zaman where('ref','==',…) ya da where('yayin','==',true) ile sorar (kural kanıtlanabilir olsun).
service cloud.firestore {
  match /databases/{db}/documents {
    function girisli() { return request.auth != null && request.auth.token.email != null && !cocukOturumu(); }
    /* 26 Eyl 2026: e-postaya dayanan her yetki DOĞRULANMIŞ e-posta ister. Veli hesabını ilk e-posta
       bağlantısıyla kendisi açar (bağlantı adresi doğrular). Ama hesap açma herkese açık olduğundan biri,
       henüz giriş yapmamış bir velinin adresiyle herkese açık web anahtarı üzerinden doğrulanmamış bir
       şifreli hesap açıp aile rolünü alabiliyordu. Hoca rolü uid'ye bağlıdır; bundan etkilenmez. */
    function dogrulanmis() { return girisli() && request.auth.token.email_verified == true; }
    function eposta() { return request.auth.token.email.lower(); }
    function hoca() { return girisli() && exists(/databases/$(db)/documents/hocalar/$(request.auth.uid)); }
    function aile() { return dogrulanmis() && exists(/databases/$(db)/documents/aileler/$(eposta())); }
    function aileOgrencileri() { return get(/databases/$(db)/documents/aileler/$(eposta())).data.ogrenciler; }
    function veliOkur(ref) { return aile() && ref in aileOgrencileri(); }
    function islemeAcik(ref) { return !exists(/databases/$(db)/documents/portalSilme/$(ref)); }
    /* 2 Kas 2026 — İlim Yolu (docs/ILIM-YOLU.md, Dilim 1). oturum(): e-postasız oturumlar da (çocuk hesabı: custom token,
       {rol:'cocuk', ref}) dahil her giriş. Çocuk token'ında e-posta yoktur: girisli(), aile() ve hoca() onu hiçbir zaman
       kabul etmez; çocuk yalnız aşağıdaki oturum()/sahip()/ogrenciOkur() yollarına girer. `ref` yetkisini yalnız sunucu verir
       (cocukHesabiAc, hesabiBagla). */
    /* 10 Kas 2026 (güvenlik incelemesi F-03, F-05): çocuk oturumu YALNIZ custom token'dan gelir ve e-posta taşımaz. Bir çocuk
       ID token'ıyla Auth'a e-posta/şifre ya da Google kimliği bağlarsa (kart/şifre yenilemeyi atlatırdı) token'da
       sign_in_provider 'custom' dışına çıkar ya da e-posta belirir → oturum() ve ogrenciOkur() reddeder, girisli() de (hoca/aile yolu).
       canli(uid): hesabiTamamenSil silinen uid için silinenUidler/{uid} yazar; silinmiş hesabın önbellekteki token'ı belge yeniden yazamaz. */
    function cocukOturumu() { return request.auth != null && (request.auth.token.get('rol', '') == 'cocuk' || request.auth.uid.matches('^c_.*')); }
    function oturum() {
      return request.auth != null
        && (!cocukOturumu() || (request.auth.token.firebase.sign_in_provider == 'custom' && !('email' in request.auth.token)));
    }
    function canli(uid) { return !exists(/databases/$(db)/documents/silinenUidler/$(uid)); }
    function sahip(uid) { return oturum() && request.auth.uid == uid; }
    function ogrenciOkur(ref) { return oturum() && request.auth.token.get('ref', '') == ref && ref != '' && canli(request.auth.uid); }
    // Ezber Kilimi (27 Eyl 2026, Faz 1b): katalog kimliği, ders günü ve veliye giden kalıp notu biçimleri.
    function ezberKimligi(k) { return k is string && k.size() <= 40 && k.matches('^[sdb]-[a-z0-9]+(-[a-z0-9]+)*$'); }
    function gunDizesi(g) { return g is string && g.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function kalipNotu(n) { return n is string && n.matches('^[a-z0-9-]{1,40}$'); }
    function kalipNotlari(l) {
      return l is list && l.size() <= 3 && (l.size() < 1 || kalipNotu(l[0])) && (l.size() < 2 || kalipNotu(l[1]))
        && (l.size() < 3 || kalipNotu(l[2]));
    }

    match /portalSilme/{ref} {
      allow read, delete: if hoca();
      allow create: if hoca() && request.resource.data.keys().hasOnly(['islem','zaman'])
        && request.resource.data.islem is string && request.resource.data.zaman == request.time;
    }
    match /dersDefteri/{ref}/kayitlar/{id} {
      function gecerli() {
        let d=request.resource.data;
        return d.keys().hasOnly(['donem','tarih','sira','no','sayfa','konu','kaynak','grup','durum','giris','calisma','okunan','dikkat','oz','odev','sonraki','surum','guncelleme'])
          && d.donem == '2026-2027' && d.tarih is string
          && d.tarih.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.tarih >= '2026-09-01' && d.tarih <= '2027-07-31'
          && ((d.sira == 1 && id == d.tarih + '_1') || (d.sira == 2 && id == d.tarih + '_2') || (d.sira == 3 && id == d.tarih + '_3'))
          && d.sira is int && d.no is int && d.no >= 1 && d.no <= 261
          && d.sayfa is int && d.sayfa == d.no + 50
          && d.konu is string && d.konu.size() > 0 && d.konu.size() <= 200
          && d.kaynak is string && d.kaynak.size() <= 300
          // 12 Eyl 2026: 'gelmedi' ve 'mazeretli' eklendi. Öncesinde gelmeyen öğrencinin kaydı
          // da 'islendi' oluyordu; ders o öğrenciye işlenmiş görünüyordu (bkz. src/lib/ders-defteri.ts).
          && d.grup in ['', 'A', 'B'] && d.durum in ['islendi','kismen','ertelendi','gelmedi','mazeretli']
          && d.giris in ['kagit','dijital'] && d.oz in ['','tekrar','destek','kendim']
          && d.calisma is string && d.calisma.size() > 0 && d.calisma.size() <= 1800
          && d.okunan is string && d.okunan.size() <= 400
          && d.dikkat is string && d.dikkat.size() <= 400
          && d.odev is string && d.odev.size() <= 1000
          && d.sonraki is string && d.sonraki.size() <= 600
          && d.surum is int && d.guncelleme == request.time;
      }
      allow read, delete: if hoca();
      allow create: if hoca() && islemeAcik(ref) && exists(/databases/$(db)/documents/ogrenciler/$(ref)) && gecerli() && request.resource.data.surum == 1;
      allow update: if hoca() && islemeAcik(ref) && gecerli() && request.resource.data.surum == resource.data.surum + 1
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['donem','tarih','sira','no','sayfa','konu','kaynak']);
    }
    /* 14 Eyl 2026: ders kaydının Fransızca çevirisi (hoca Türkçe yazar, Fransızca aile Fransızca okur). Kaydın
       yanında ayrı belge; kaynakSurum kaydın surum'unu izler (eskiyince yeniden üretilir). Defter gibi yalnız hocaya
       açıktır; veli bülten üzerinden okur. Sınırlar kaydın ~1,35 katı (Fransızca daha uzun). */
    match /dersDefteri/{ref}/ceviriler/{id} {
      function ceviriGecerli() {
        let d=request.resource.data;
        return d.keys().hasOnly(['kayitId','dil','kaynakSurum','yontem','calisma','odev','sonraki','okunan','dikkat','guncelleme'])
          && d.dil in ['fr'] && d.kayitId is string && d.kayitId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[123]$')
          && id == d.kayitId + '_' + d.dil
          && d.kaynakSurum is int && d.kaynakSurum >= 1
          && d.yontem in ['kalip','makine','karma']
          && d.calisma is string && d.calisma.size() > 0 && d.calisma.size() <= 2400
          && d.odev is string && d.odev.size() <= 1400
          && d.sonraki is string && d.sonraki.size() <= 800
          && d.okunan is string && d.okunan.size() <= 600
          && d.dikkat is string && d.dikkat.size() <= 600
          && d.guncelleme == request.time;
      }
      allow read, delete: if hoca();
      allow create, update: if hoca() && islemeAcik(ref) && ceviriGecerli();
    }
    match /bultenler/{ref}/haftalar/{id} {
      function gecerli() {
        let d=request.resource.data;
        return d.keys().hasOnly(['tarih','hafta','dil','metin','yayin','surum','guncelleme'])
          && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.tarih == id
          && d.hafta is int && d.hafta >= 1 && d.hafta <= 54
          && d.dil in ['tr','fr','en'] && d.yayin is bool && d.surum is int
          && d.guncelleme == request.time && d.metin is map
          && d.metin.keys().hasOnly(['ders','odev','getir','not'])
          && d.metin.ders is string && d.metin.ders.size() > 0 && d.metin.ders.size() <= 2200
          && d.metin.odev is string && d.metin.odev.size() <= 1200
          && d.metin.getir is string && d.metin.getir.size() <= 400
          && d.metin.not is string && d.metin.not.size() <= 1000;
      }
      allow read: if hoca() || (veliOkur(ref) && resource.data.yayin == true);
      allow create: if hoca() && islemeAcik(ref) && gecerli() && request.resource.data.surum == 1;
      allow update: if hoca() && islemeAcik(ref) && gecerli() && request.resource.data.surum == resource.data.surum + 1;
      allow delete: if hoca();
      match /okumalar/{ep} {
        function bulten() { return get(/databases/$(db)/documents/bultenler/$(ref)/haftalar/$(id)).data; }
        allow read: if hoca() || (veliOkur(ref) && ep == eposta() && bulten().yayin == true);
        allow create, update: if veliOkur(ref) && islemeAcik(ref) && ep == eposta() && bulten().yayin == true
          && request.resource.data.keys().hasOnly(['surum','zaman'])
          && request.resource.data.surum == bulten().surum
          && request.resource.data.zaman == request.time;
        allow delete: if hoca();
      }
    }

    match /hocalar/{uid} {
      allow read: if girisli() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if girisli() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sifreVar', 'sonGiris']);
    }
    match /ayarlar/{id} {
      allow read, write: if hoca();
    }
    match /aileler/{ep} {
      allow read: if hoca() || (dogrulanmis() && eposta() == ep);
      allow create, delete: if hoca();
      allow update: if hoca()
        || (dogrulanmis() && eposta() == ep
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dil', 'cep', 'adSoyad', 'sonGiris', 'sifreVar', 'kitapSecim']));
    }
    match /ogrenciler/{ref} {
      allow read: if hoca() || veliOkur(ref);
      allow write: if hoca();
    }

    // Son öz değerlendirme; katalog dışında belge üretilemez, veli başkasının kaydını göremez.
    match /evCalismalari/{ref}/etkinlikler/{id} {
      /* 27 Eyl 2026 (Ezber Kilimi Faz 1b): katalogdaki 81 madde `ezber-<katalogId>` olarak eklendi; eski 19 `ezber-*`
         kimliği geçiş boyunca kalır. Liste bilerek açık yazılır (kalıp, velinin sınırsız belge açmasına izin verirdi).
         Katalog değişirse bu liste de değişir: tests/ezber-katalog.test.mjs katalogla birebir karşılaştırır. */
      function katalogEzberi() {
        return id in [
          'ezber-d-euzu-besmele', 'ezber-d-kelime-i-tevhid', 'ezber-d-kelime-i-sehadet', 'ezber-b-imanin-sartlari', 'ezber-b-islamin-sartlari', 'ezber-b-abdestin-farzlari',
          'ezber-b-guslun-farzlari', 'ezber-b-teyemmumun-farzlari', 'ezber-d-abdest-niyeti', 'ezber-b-namazin-farzlari', 'ezber-d-namaz-niyeti', 'ezber-d-tekbir',
          'ezber-d-subhaneke', 'ezber-s-fatiha', 'ezber-s-ihlas', 'ezber-s-kevser', 'ezber-d-ruku-tesbihi', 'ezber-d-tesmi-tahmid',
          'ezber-d-secde-tesbihi', 'ezber-d-ettehiyyatu', 'ezber-d-salli', 'ezber-d-barik', 'ezber-d-rabbena-atina', 'ezber-d-rabbenagfirli',
          'ezber-d-selam', 'ezber-s-asr', 'ezber-s-fil', 'ezber-s-nasr', 'ezber-s-felak', 'ezber-s-nas',
          'ezber-s-kureys', 'ezber-s-maun', 'ezber-s-kafirun', 'ezber-s-tebbet', 'ezber-s-insirah', 'ezber-d-kunut-1',
          'ezber-d-kunut-2', 'ezber-s-ayetel-kursi', 'ezber-d-tesbihat', 'ezber-d-ezan', 'ezber-d-kamet', 'ezber-d-ezan-duasi',
          'ezber-d-amentu', 'ezber-s-humeze', 'ezber-s-tekasur', 'ezber-s-karia', 'ezber-s-adiyat', 'ezber-s-zilzal',
          'ezber-s-beyyine', 'ezber-s-kadir', 'ezber-s-alak', 'ezber-s-tin', 'ezber-s-duha', 'ezber-s-leyl',
          'ezber-s-sems', 'ezber-s-beled', 'ezber-s-fecr', 'ezber-s-gasiye', 'ezber-s-ala', 'ezber-s-tarik',
          'ezber-s-buruc', 'ezber-s-insikak', 'ezber-s-mutaffifin', 'ezber-s-infitar', 'ezber-s-tekvir', 'ezber-s-abese',
          'ezber-s-naziat', 'ezber-s-nebe', 'ezber-b-ulul-azm', 'ezber-d-tesrik-tekbiri', 'ezber-d-kadir-gecesi-duasi', 'ezber-d-rabbisrahli',
          'ezber-d-telbiye', 'ezber-d-oruc-niyeti', 'ezber-s-alak-1-5', 'ezber-b-secme-hadisler', 'ezber-b-kuran-fazileti-hadisleri', 'ezber-b-dort-halife',
          'ezber-d-yemek-duasi', 'ezber-s-bakara-285-286', 'ezber-s-hasr-22-24'
        ];
      }
      function kayitGecerli() {
        let d=request.resource.data;
        return (id in ['harf-elif','harf-be','harf-te','harf-se','harf-cim','harf-ha','harf-hi','harf-dal','harf-zel','harf-ra','harf-ze','harf-sin','harf-sin2','harf-sad','harf-dad','harf-ti','harf-zi','harf-ayn','harf-gayn','harf-fe','harf-kaf','harf-kef','harf-lam','harf-mim','harf-nun','harf-he','harf-vav','harf-ye','ezber-fatiha','ezber-ayetel-kursi','ezber-insirah','ezber-kadir','ezber-asr','ezber-fil','ezber-kureys','ezber-maun','ezber-kevser','ezber-kafirun','ezber-nasr','ezber-tebbet','ezber-ihlas','ezber-felak','ezber-nas','ezber-subhaneke','ezber-tahiyyat','ezber-salli-barik','ezber-rabbena','bilgi-islam-sartlari','bilgi-kuran-ilk-ayet','bilgi-namaz-vakitleri','bilgi-besmele-anlami','bilgi-iman-sartlari','bilgi-abdest-temizlik','bilgi-peygamberimiz-dogum','bilgi-selamlasma-adabi','bilgi-fatiha-suresi','bilgi-elifba-harf-sayisi','hayat-davet','hayat-hata','hayat-emanet','hayat-su','hayat-dinle','hayat-tesekkur','hayat-guven','hayat-baris'] || katalogEzberi())
          && d.keys().hasAll(['son','sonraki','basamak','cevap','guncelleme'])
          && d.keys().hasOnly(['son','sonraki','basamak','cevap','guncelleme'])
          && d.son is timestamp && d.sonraki is timestamp
          && d.son <= request.time + duration.value(1,'d')
          && d.son >= request.time - duration.value(370,'d')
          && d.basamak is int && d.basamak >= 0 && d.basamak <= 3
          && d.cevap in ['destek','tekrar','rahat']
          && (d.cevap != 'destek' || d.basamak == 0)
          && (d.cevap != 'tekrar' || d.basamak == 1)
          && (d.cevap != 'rahat' || d.basamak >= 1)
          && d.sonraki == d.son + duration.value([1,1,3,7][d.basamak],'d')
          && d.guncelleme == request.time;
      }
      allow read: if hoca() || veliOkur(ref);
      allow create: if veliOkur(ref) && islemeAcik(ref) && kayitGecerli();
      allow update: if veliOkur(ref) && islemeAcik(ref) && kayitGecerli() && request.resource.data.son >= resource.data.son
        && (request.resource.data.son > resource.data.son || request.resource.data.basamak <= resource.data.basamak);
      allow delete: if hoca();
    }

    match /yoklama/{id} {
      allow read: if hoca() || veliOkur(resource.data.ref);
      allow create, update: if hoca() && islemeAcik(request.resource.data.ref);
      allow delete: if hoca();
    }
    match /ilerleme/{ref} {
      allow read: if hoca() || veliOkur(ref);
      allow create, update: if hoca() && islemeAcik(ref);
      allow delete: if hoca();
    }
    /* 27 Eyl 2026 (Ezber Kilimi Faz 1b): öğrencinin ezber durumu. Öğrenci başına tek belge (sınıf görünümü öğrenci başına
       tek okuma); `ogeler` katalog kimliğiyle anahtarlı. Kural haritada döngü kuramadığı için her yazım TEK maddeyi
       değiştirir ve onu `degisen` ile bildirir; kural diff ile yalnız o maddenin değiştiğini ve biçimini doğrular.
       Madde `surum`'u eski + 1 olmalı: ortak hoca hesabı iki telefonda açıkken eski ekrandan ya da çevrim dışı kuyruktan
       gelen yazım sessizce ezmez, reddedilir. Madde silme (hocanın düzeltmesi, «Geri al») da sürümlüdür: yazım silinen
       kaydın sürümünü `silinenSurum` ile bildirir; sunucudaki sürüm o değilse (araya başka telefon girdi) reddedilir.
       Olaylar yalnız eklenir.
       Durum makinesi: src/lib/ezber/durum.ts · yazan: src/lib/ezber/depo.ts · belge: docs/EZBER-KILIMI.md. */
    match /ezberDurum/{ref} {
      function belgeGecerli() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ogeler', 'degisen', 'guncelleme', 'silinenSurum']) && d.ogeler is map && d.ogeler.size() <= 150
          && ezberKimligi(d.degisen) && d.guncelleme == request.time
          && (!('silinenSurum' in d) || d.silinenSurum is int);
      }
      function maddeGecerli(o, eski) {
        let id = request.resource.data.degisen;
        return o is map
          && o.keys().hasOnly(['basamak', 'kalite', 'notlar', 'son', 'sonrakiKontrol', 'surum'])
          && o.keys().hasAll(['basamak', 'kalite', 'notlar', 'son', 'sonrakiKontrol', 'surum'])
          && o.basamak is int && o.basamak >= 1 && o.basamak <= 4
          && o.kalite in ['', 'tam', 'az', 'tekrar'] && kalipNotlari(o.notlar) && o.son == request.time
          && (o.sonrakiKontrol == '' || gunDizesi(o.sonrakiKontrol))
          // Hocaya okudu ve Pekişti kontrol günü taşır, Kalıcı taşımaz; Çalışıyor ikisi de olabilir.
          && (o.basamak == 1 || (o.basamak == 4) == (o.sonrakiKontrol == ''))
          && o.surum is int && o.surum == (id in eski ? eski[id].surum + 1 : 1);
      }
      function degisenGecerli(yeni, eski) {
        let id = request.resource.data.degisen;
        return (id in yeni && maddeGecerli(yeni[id], eski))
          || (!(id in yeni) && id in eski && request.resource.data.get('silinenSurum', 0) == eski[id].surum);
      }
      // İlim Yolu (2 Kas 2026): öğrencinin kendisi (çocuk hesabı ya da bağlı yetişkin) yalnız kendi ref'ini okur; yazamaz.
      allow read: if hoca() || veliOkur(ref) || ogrenciOkur(ref);
      allow create: if hoca() && islemeAcik(ref) && exists(/databases/$(db)/documents/ogrenciler/$(ref)) && belgeGecerli()
        && request.resource.data.degisen in request.resource.data.ogeler
        && request.resource.data.ogeler.keys().hasOnly([request.resource.data.degisen])
        && degisenGecerli(request.resource.data.ogeler, {});
      allow update: if hoca() && islemeAcik(ref) && belgeGecerli()
        && request.resource.data.ogeler.diff(resource.data.ogeler).affectedKeys().hasOnly([request.resource.data.degisen])
        && degisenGecerli(request.resource.data.ogeler, resource.data.ogeler);
      allow delete: if hoca();
      match /olaylar/{olay} {
        function olayGecerli() {
          let d = request.resource.data;
          return d.keys().hasOnly(['ezber', 'tur', 'kalite', 'notlar', 'basamakOnce', 'basamakSonra', 'zorla', 'tarih', 'zaman'])
            && d.keys().hasAll(['ezber', 'tur', 'kalite', 'notlar', 'basamakOnce', 'basamakSonra', 'zorla', 'tarih', 'zaman'])
            && ezberKimligi(d.ezber) && d.tur in ['atama', 'dinleme', 'duzeltme', 'gecis']
            && d.kalite in ['', 'tam', 'az', 'tekrar'] && (d.tur == 'dinleme') == (d.kalite != '')
            && kalipNotlari(d.notlar) && d.zorla is bool && (!d.zorla || d.tur == 'dinleme')
            && d.basamakOnce is int && d.basamakOnce >= 0 && d.basamakOnce <= 4
            && d.basamakSonra is int && d.basamakSonra >= 0 && d.basamakSonra <= 4
            && (d.tur != 'atama' || (d.basamakOnce == 0 && d.basamakSonra == 1))
            && (d.tur != 'gecis' || (d.basamakOnce == 0 && d.basamakSonra in [1, 2]))
            && gunDizesi(d.tarih) && d.zaman == request.time;
        }
        allow read: if hoca() || veliOkur(ref) || ogrenciOkur(ref);
        // Sahipsiz olay yok: durum belgesi (aynı toplu yazımda açılsa bile) yazım sonunda var olmalı.
        allow create: if hoca() && islemeAcik(ref) && existsAfter(/databases/$(db)/documents/ezberDurum/$(ref)) && olayGecerli();
        allow delete: if hoca();
      }
    }
    match /degerlendirme/{id} {
      allow read: if hoca() || veliOkur(resource.data.ref);
      allow create, update: if hoca() && islemeAcik(request.resource.data.ref);
      allow delete: if hoca();
    }
    match /notlar/{id} {
      allow read: if hoca() || (veliOkur(resource.data.ref) && resource.data.veliyeGorunur == true);
      allow create, update: if hoca() && islemeAcik(request.resource.data.ref);
      allow delete: if hoca();
    }
    match /odevler/{id} {
      allow read: if hoca() || (aile() && resource.data.yayin == true);
      allow write: if hoca();
    }
    match /duyurular/{id} {
      allow read: if hoca() || (aile() && resource.data.yayin == true);
      allow write: if hoca();
    }
    match /bildirimler/{id} {
      // 12 Eyl 2026: veli tarafına alan allowlist'i eklendi. Önce yoktu; veli kendi belgesine
      // keyfi alan/boyut ekleyebiliyor ve `zaman`ı ileri tarihe atarak hoca ekranındaki
      // sıralamada (zamanMs'e göre azalan) kendini en üste çıkarabiliyordu. Liste, veli
      // portalinin gerçekten yazdığı alanlardır (src/scripts/veli-portali.ts, 'bildir' dalı).
      function veliAlanlari() {
        let d = request.resource.data;
        return d.keys().hasOnly(['eposta', 'ref', 'tur', 'metin', 'okundu', 'zaman', 'ogrenciAd', 'dil', 'tarih'])
          && (!('ogrenciAd' in d) || (d.ogrenciAd is string && d.ogrenciAd.size() <= 120))
          && (!('dil' in d) || d.dil in ['tr', 'fr', 'en'])
          && (!('tarih' in d) || d.tarih == null || (d.tarih is string && d.tarih.size() <= 10));
      }
      allow read: if hoca() || (dogrulanmis() && resource.data.eposta == eposta());
      allow create: if aile()
        && islemeAcik(request.resource.data.ref)
        && veliAlanlari()
        && request.resource.data.zaman == request.time
        && request.resource.data.eposta == eposta()
        && request.resource.data.ref in aileOgrencileri()
        && request.resource.data.tur in ['mazeret', 'iletisim', 'soru']
        && request.resource.data.metin is string && request.resource.data.metin.size() <= 1000
        && request.resource.data.okundu == false;
      // Veli, hoca HENÜZ OKUMADIYSA kendi mesajını düzeltebilir (geri alma = silme her zaman kendi mesajında serbest).
      allow update: if islemeAcik(resource.data.ref) && (hoca()
        || (aile()
          && resource.data.eposta == eposta() && resource.data.okundu == false
          && veliAlanlari()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eposta', 'okundu', 'zaman'])
          && request.resource.data.eposta == resource.data.eposta
          && request.resource.data.okundu == false
          && request.resource.data.ref in aileOgrencileri()
          && request.resource.data.tur in ['mazeret', 'iletisim', 'soru']
          && islemeAcik(request.resource.data.ref)
          && request.resource.data.metin is string && request.resource.data.metin.size() <= 1000));
      allow delete: if hoca() || (dogrulanmis() && resource.data.eposta == eposta());
    }

    /* 1 Kasım 2026 — Online envanter («Neler biliyorum?»): hoca telefonunda 9–13 öğrenci kendi dokunur, 5–8'i hoca sorar.
       Kâğıt envanterle aynı madde kimlikleri (veri/envanter-maddeleri.json → src/data/ogrenci-envanteri/maddeler.json).
       Belge kimliği {ref}_{tarih}_{grup}; yalnız hoca okur/yazar, veli görmez. Eşzamanlılık `surum`: yazım sunucudaki
       sürümden tam bir fazla olmalı (başka telefon araya girdiyse eski ekranın yazımı reddedilir). Madde değerleri 0–2.
       Sahte öğrenci TEST-ENVANTER yalnız deneme içindir; içe aktarıcılar onu yok sayar. Silme yalnız o deneme belgelerine. */
    /* Envanter belgesinin alan doğrulaması (kaydeden hariç) — hoca ekranı ve bağlantı sayfası aynı şartı kullanır. */
    function envVeri(d, id) {
        return d.keys().hasOnly(['ref','tarih','grup','kaynak','ben','hoca','kutular','metin','okuma','okuma_notlari','cizim','sayfaDinlendi','durum','surum','guncelleme','kaydeden'])
          && d.keys().hasAll(['ref','tarih','grup','kaynak','durum','surum','guncelleme','kaydeden'])
          && d.ref is string && gunDizesi(d.tarih) && d.grup in ['5-8','9-13']
          && id == d.ref + '_' + d.tarih + '_' + d.grup
          && d.kaynak in ['online','kagit-2026-10-31']
          && d.durum in ['baslandi','ogrenci-bitti','tamam']
          && d.surum is int && d.guncelleme == request.time && d.kaydeden is string
          && (!('ben' in d) || (d.ben is map && d.ben.size() <= 80 && d.ben.values().hasOnly([0,1,2])))
          && (!('hoca' in d) || (d.hoca is map && d.hoca.size() <= 80 && d.hoca.values().hasOnly([0,1,2])))
          && (!('kutular' in d) || (d.kutular is map && d.kutular.size() <= 20))
          && (!('metin' in d) || (d.metin is map && d.metin.size() <= 30))
          && (!('okuma' in d) || (d.okuma is map && d.okuma.keys().hasOnly(['basamak','sonraki'])
              && d.okuma.get('basamak',0) is int && d.okuma.get('basamak',0) >= 0 && d.okuma.get('basamak',0) <= 6
              && d.okuma.get('sonraki',0) is int && d.okuma.get('sonraki',0) >= 0 && d.okuma.get('sonraki',0) <= 6))
          && (!('okuma_notlari' in d) || (d.okuma_notlari is map && d.okuma_notlari.size() <= 10))
          && (!('sayfaDinlendi' in d) || (d.sayfaDinlendi is map && d.sayfaDinlendi.size() <= 6 && d.sayfaDinlendi.values().hasOnly([true,false])))
          && (!('cizim' in d) || (d.cizim is string && d.cizim.size() <= 210000 && d.grup == '5-8'));
    }
    match /ogrenciEnvanteri/{id} {
      function envGecerli() {
        return envVeri(request.resource.data, id) && request.resource.data.kaydeden == request.auth.uid;
      }
      function refTamam(ref) {
        return ref == 'TEST-ENVANTER' || exists(/databases/$(db)/documents/ogrenciler/$(ref));
      }
      allow read: if hoca();
      allow create: if hoca() && islemeAcik(request.resource.data.ref) && refTamam(request.resource.data.ref)
        && envGecerli() && request.resource.data.surum == 1;
      allow update: if hoca() && islemeAcik(resource.data.ref) && envGecerli()
        && request.resource.data.surum == resource.data.get('surum', 0) + 1
        && request.resource.data.ref == resource.data.ref && request.resource.data.tarih == resource.data.tarih
        && request.resource.data.grup == resource.data.grup && request.resource.data.kaynak == resource.data.kaynak;
      allow delete: if hoca() && resource.data.ref == 'TEST-ENVANTER';
    }
    /* Kişisel program (Python yazar, IAM ile): hoca yalnız okur. Öğrenci kipinde yalnız durum 'onayli' ise gösterilir. */
    match /ogrenciProgrami/{ref} {
      allow read: if hoca();
      allow write: if false;
    }
    /* Günün hoca sırası (Python yazar): hoca okur, yalnız `yapildi` işaretini günceller. */
    match /hocaGunSirasi/{tarih} {
      allow read: if hoca();
      allow update: if hoca() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yapildi'])
        && request.resource.data.yapildi is map && request.resource.data.yapildi.size() <= 80
        && request.resource.data.yapildi.values().hasOnly([true, false]);
      allow create, delete: if false;
    }
    /* 1 Kasım 2026 sabahı — «Neler biliyorum?» BAĞLANTI SAYFASI (/neler-biliyorum/#k=<anahtar>), hoca girişi YOK.
       Rıdvan: «hoca portalının dışında bir sayfa olsun; sadece bu bağlantıya sahip olanlar girebilsin». Yetki = belge
       kimliğindeki gizli anahtar (≥ 24 karakter, Python `secrets` ile; adresin # kısmında). Üst belgeyi yalnız Python
       (IAM) yazar: öğrenci listesi (ref, ad, soyadın baş harfi), `refler`, `bitis` (son kullanma). Liste sorgusu yasak
       (anahtar tahmin edilemez, sayılamaz). Altındaki form belgeleri ogrenciEnvanteri ile AYNI doğrulamadan geçer
       (envVeri + sürüm), kaydeden 'baglanti'. Bitiş geçince ya da belge silinince her şey kapanır. */
    function baglantiAcik(k) {
      return k.size() >= 24 && exists(/databases/$(db)/documents/envanterBaglanti/$(k))
        && get(/databases/$(db)/documents/envanterBaglanti/$(k)).data.bitis > request.time;
    }
    match /envanterBaglanti/{k} {
      allow get: if k.size() >= 24 && resource.data.bitis > request.time;
      allow list, create, update, delete: if false;
      match /kayitlar/{id} {
        function refListede(ref) {
          return ref == 'TEST-ENVANTER' || ref in get(/databases/$(db)/documents/envanterBaglanti/$(k)).data.refler;
        }
        function bagGecerli() {
          return envVeri(request.resource.data, id) && request.resource.data.kaydeden == 'baglanti';
        }
        allow read: if baglantiAcik(k);
        allow create: if baglantiAcik(k) && bagGecerli() && refListede(request.resource.data.ref)
          && islemeAcik(request.resource.data.ref) && request.resource.data.surum == 1;
        allow update: if baglantiAcik(k) && bagGecerli() && islemeAcik(resource.data.ref)
          && request.resource.data.surum == resource.data.get('surum', 0) + 1
          && request.resource.data.ref == resource.data.ref && request.resource.data.tarih == resource.data.tarih
          && request.resource.data.grup == resource.data.grup && request.resource.data.kaynak == resource.data.kaynak;
        allow delete: if baglantiAcik(k) && resource.data.ref == 'TEST-ENVANTER';
      }
      match /gunSirasi/{tarih} {
        allow read: if baglantiAcik(k);
        allow update: if baglantiAcik(k) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yapildi'])
          && request.resource.data.yapildi is map && request.resource.data.yapildi.size() <= 80
          && request.resource.data.yapildi.values().hasOnly([true, false]);
        allow create, delete: if false;
      }
      match /program/{ref} {
        allow read: if baglantiAcik(k);
        allow write: if false;
      }
    }

    /* ───── İlim Yolu (2 Kas 2026, Dilim 1; docs/ILIM-YOLU.md) — hesaplar ─────
       kullanicilar/{uid}: profil. İstemci yalnız dil/sehir/cami/tercihler/sonGiris alanlarını yazar (değişen alan listesiyle
       denetlenir). ad (kullanıcı adı), tur (genel|cocuk|kursYetiskin), ref (kurs bağı) ve olusturma YALNIZ sunucuda yazılır
       (kullaniciAdiAl, cocukHesabiAc, hesabiBagla); istemci bunları ne açar ne değiştirir ne siler. Hesap silme yalnız
       hesabimiSil fonksiyonuyla (30 gün bekletme). Profili başkası okumaz; liste sorgusu yok. */
    function tercihlerGecerli(t) {
      return t is map && t.keys().hasOnly(['haftalik', 'gun', 'saat'])
        && (!('haftalik' in t) || t.haftalik is bool)
        && (!('gun' in t) || (t.gun is int && t.gun >= 0 && t.gun <= 6))
        && (!('saat' in t) || (t.saat is int && t.saat >= 0 && t.saat <= 23));
    }
    // d: yazım sonrası belge; degisen: create'te bütün alanlar, update'te diff ile değişenler. Silinen isteğe bağlı alan serbest.
    function profilGecerli(d, degisen) {
      return degisen.hasOnly(['dil', 'sehir', 'cami', 'tercihler', 'sonGiris'])
        && (!('dil' in degisen) || !('dil' in d) || d.dil in ['tr', 'fr', 'en', 'nl', 'de'])
        && (!('sehir' in degisen) || !('sehir' in d) || (d.sehir is string && d.sehir.size() <= 80))
        && (!('cami' in degisen) || !('cami' in d) || (d.cami is string && d.cami.size() <= 80))
        && (!('tercihler' in degisen) || !('tercihler' in d) || tercihlerGecerli(d.tercihler))
        && (!('sonGiris' in degisen) || !('sonGiris' in d) || d.sonGiris == request.time);
    }
    function uidDizesi(x) { return x is string && x.matches('^[A-Za-z0-9_-]{1,128}$'); }
    match /kullanicilar/{uid} {
      allow get: if sahip(uid);
      // Profili sunucu açar: çocuk hiçbir koşulda kendi profilini oluşturamaz; güncellemede yalnız dil/sonGiris (F-10, F-05).
      allow create: if sahip(uid) && canli(uid) && !cocukOturumu() && profilGecerli(request.resource.data, request.resource.data.keys());
      allow update: if sahip(uid) && canli(uid) && profilGecerli(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && (!cocukOturumu() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dil', 'sonGiris']));
      allow list, delete: if false;

      /* Çalışma ilerlemesi: belge adı yalnız ezber | bilgi | yol. Biçim cihaz durumunun (src/lib/ezber/cihaz.ts CihazDurumu)
         karşılığı: ≤ 120 madde, ≤ 60 gün; her yazımda guncelleme = sunucu zamanı. Okuma: sahibi; kursa bağlı hesabı (sunucunun
         yazdığı ref) hoca; `yol` belgesini ayrıca öğrenenin paylasimlar listesine koyduğu hoca (Dilim 3, «hocamla paylaş»). */
      match /calisma/{ad} {
        function calismaAdi() { return ad in ['ezber', 'bilgi', 'yol', 'okuma', 'ibadet']; }
        function kursaBagli() {
          return exists(/databases/$(db)/documents/kullanicilar/$(uid))
            && get(/databases/$(db)/documents/kullanicilar/$(uid)).data.get('ref', '') != '';
        }
        function paylasildi() {
          return exists(/databases/$(db)/documents/paylasimlar/$(uid))
            && request.auth.uid in get(/databases/$(db)/documents/paylasimlar/$(uid)).data.get('hocalar', []);
        }
        function calismaGecerli() {
          let d = request.resource.data;
          return d.keys().hasOnly(['v', 'ar', 'maddeler', 'gunler', 'guncelleme'])
            && d.maddeler is map && d.maddeler.size() <= 120
            && (!('gunler' in d) || (d.gunler is list && d.gunler.size() <= 60))
            && (!('v' in d) || d.v is int)
            && (!('ar' in d) || (d.ar is int && d.ar >= 0 && d.ar <= 4))
            && calismaDegerleri(d)
            && d.guncelleme == request.time;
        }
        /* Değer sınırları (G-06, 11 Kasım 2026): bilgi, okuma ve ibadet belgelerinde her anahtar bilinen ve değeri kısa bir dizedir
           (istemci: src/lib/ilim-yolu/bilgi-ilerleme.ts ≤ 400 karakter, src/lib/okuma/ilerleme.ts ≤ 3 × 400 = 1200, ibadet-ilerleme.ts ≤ 5;
           sınırlar 2 kat ve üstü payla konuldu). ezber ve yol belgelerinde değerler iç içe nesnedir; kurallar döngü bilmediğinden orada
           yalnız madde sayısı sınırlıdır (değişmedi). */
        function dizeSinirli(m, k, n) { return !(k in m) || (m[k] is string && m[k].size() <= n); }
        function calismaDegerleri(d) {
          return ad == 'bilgi' ? (d.maddeler.keys().hasOnly(['kuran', 'itikat', 'ibadet', 'siyer', 'ahlak'])
                && dizeSinirli(d.maddeler, 'kuran', 800) && dizeSinirli(d.maddeler, 'itikat', 800) && dizeSinirli(d.maddeler, 'ibadet', 800)
                && dizeSinirli(d.maddeler, 'siyer', 800) && dizeSinirli(d.maddeler, 'ahlak', 800))
            : ad == 'okuma' ? (d.maddeler.keys().hasOnly(['o1', 'o2', 'o3', 'o4', 'o5', 'o6', 'o7', 'o8', 'o9'])
                && dizeSinirli(d.maddeler, 'o1', 2400) && dizeSinirli(d.maddeler, 'o2', 2400) && dizeSinirli(d.maddeler, 'o3', 2400)
                && dizeSinirli(d.maddeler, 'o4', 2400) && dizeSinirli(d.maddeler, 'o5', 2400) && dizeSinirli(d.maddeler, 'o6', 2400)
                && dizeSinirli(d.maddeler, 'o7', 2400) && dizeSinirli(d.maddeler, 'o8', 2400) && dizeSinirli(d.maddeler, 'o9', 2400))
            : ad == 'ibadet' ? (d.maddeler.keys().hasOnly(['abdest', 'namaz', 'sabah', 'ogle', 'ikindi', 'aksam', 'yatsi'])
                && dizeSinirli(d.maddeler, 'abdest', 16) && dizeSinirli(d.maddeler, 'namaz', 16) && dizeSinirli(d.maddeler, 'sabah', 16)
                && dizeSinirli(d.maddeler, 'ogle', 16) && dizeSinirli(d.maddeler, 'ikindi', 16) && dizeSinirli(d.maddeler, 'aksam', 16)
                && dizeSinirli(d.maddeler, 'yatsi', 16))
            : true;
        }
        allow get: if calismaAdi() && (sahip(uid) || (hoca() && kursaBagli()) || (ad == 'yol' && hoca() && paylasildi()));
        // Liste sorgusunda belge adı (ad) bağlı değildir; yazım üç adla sınırlı olduğundan sahibi ve kursun hocası listeleyebilir.
        // Paylaşımla gelen hoca listeleyemez, yalnız `yol` belgesini get ile okur.
        allow list: if sahip(uid) || (hoca() && kursaBagli());
        allow create, update: if calismaAdi() && sahip(uid) && canli(uid) && calismaGecerli();
        allow delete: if calismaAdi() && sahip(uid);
      }

      /* Özel nitelikli veri (GVKT md. 9): «Yeni Müslümanım» işareti yalnız burada, Auth'a ya da token'a girmez. Yalnız sahibi
         okur ve yazar; hoca dahil başka kimse okuyamaz. muhtedi == true her yazımda açık rıza ister: riza.zaman = sunucu zamanı,
         riza.metinSurum = okunan rıza metninin sürümü. muhtedi == false iken rıza kaydı tutulmaz. Çocuk hesabı yazamaz (kayıt
         akışı yetişkinler içindir). Silmek (rızayı geri almak) serbest. */
      match /ozel/{belge} {
        function hassasGecerli() {
          let d = request.resource.data;
          return d.keys().hasOnly(['muhtedi', 'riza']) && d.keys().hasAll(['muhtedi']) && d.muhtedi is bool
            && ((d.muhtedi == true && ('riza' in d) && d.riza is map && d.riza.keys().hasOnly(['zaman', 'metinSurum'])
                 && d.riza.zaman == request.time
                 && d.riza.metinSurum is string && d.riza.metinSurum.size() >= 1 && d.riza.metinSurum.size() <= 40)
              || (d.muhtedi == false && !('riza' in d)));
        }
        /* 12 haftalık yolun ilerlemesi (11 Kasım 2026): hafta başına dört işaret, başka hiçbir şey. calisma/ DEĞİL, burada: calisma listesini kursun
           hocası okuyabilir, bu belgeyi YALNIZ sahibi okur (hoca, haftalık e-posta, veli ve rapor görünümleri dışarıda). Biçim: v, maddeler (en çok
           h01…h12), guncelleme = sunucu zamanı; değerler ≤ 16 karakterlik dizedir (istemci 4 haneli '0'…'3' yazar). */
        function yol12Gecerli() {
          let d = request.resource.data;
          return d.keys().hasOnly(['v', 'maddeler', 'guncelleme']) && d.keys().hasAll(['maddeler', 'guncelleme'])
            && d.maddeler is map && d.maddeler.size() <= 12
            && d.maddeler.keys().hasOnly(['h01', 'h02', 'h03', 'h04', 'h05', 'h06', 'h07', 'h08', 'h09', 'h10', 'h11', 'h12'])
            && (!('v' in d) || d.v is int)
            && yol12Degerleri(d.maddeler)
            && d.guncelleme == request.time;
        }
        /* Değer sınırı (G-06): her hafta ≤ 16 karakterlik dize (istemci ≤ 4, '0'…'3'). */
        function yol12Degerleri(m) {
          return dizeSinirli16(m, 'h01') && dizeSinirli16(m, 'h02') && dizeSinirli16(m, 'h03') && dizeSinirli16(m, 'h04')
            && dizeSinirli16(m, 'h05') && dizeSinirli16(m, 'h06') && dizeSinirli16(m, 'h07') && dizeSinirli16(m, 'h08')
            && dizeSinirli16(m, 'h09') && dizeSinirli16(m, 'h10') && dizeSinirli16(m, 'h11') && dizeSinirli16(m, 'h12');
        }
        function dizeSinirli16(m, k) { return !(k in m) || (m[k] is string && m[k].size() <= 16); }
        allow get, delete: if (belge == 'hassas' || belge == 'yol12') && sahip(uid);
        allow create, update: if (belge == 'hassas' && sahip(uid) && canli(uid) && !cocukOturumu() && hassasGecerli())
          || (belge == 'yol12' && sahip(uid) && canli(uid) && yol12Gecerli());
        allow list: if false;
      }

      /* İhtida özeti (ihtida platformu yazar, Admin SDK): YALNIZ sahibi okur — hoca() ya da başka geniş okuma buraya uzanmaz
         (bu eşleşme dışında kullanicilar/{uid} altında özyinelemeli joker yoktur). İstemci yazamaz. */
      match /ihtida/{belge} {
        allow get: if belge == 'ozet' && sahip(uid);
        allow list, create, update, delete: if false;
      }
    }

    /* Kullanıcı adı → uid eşlemesi: yalnız callable kullaniciAdiAl yazar (ayrılmış adlar sunucuda). Giriş yapan biri tek adı
       sorabilir (müsait mi); liste (sayma, toplama) ve istemci yazımı yok. */
    match /kullaniciAdlari/{ad} {
      allow read, write: if false; // F-06: istemci okumaz (müsaitlik kullaniciAdiAl'da sınanır); uid/çocuk adı sızmasın
    }
    /* Silinen hesapların mezar taşı (F-05): yalnız Admin SDK yazar; kurallar exists() ile okur. */
    match /silinenUidler/{yol=**} {
      allow read, write: if false;
    }

    /* «Hocamla paylaş» (Dilim 3): yalnız öğrenen yazar; en çok 3 hoca uid'si. Silince paylaşım (ve calisma/yol okuması) kapanır.
       Listede adı geçen hoca (hocalar/{uid} kaydı olan) belgeyi okur; liste sorgusu array-contains ile kanıtlanabilir. */
    match /paylasimlar/{uid} {
      function paylasimGecerli() {
        let d = request.resource.data;
        return d.keys().hasOnly(['hocalar', 'zaman']) && d.keys().hasAll(['hocalar', 'zaman'])
          && d.hocalar is list && d.hocalar.size() <= 3
          && (d.hocalar.size() < 1 || uidDizesi(d.hocalar[0])) && (d.hocalar.size() < 2 || uidDizesi(d.hocalar[1]))
          && (d.hocalar.size() < 3 || uidDizesi(d.hocalar[2]))
          && d.zaman == request.time;
      }
      allow read: if sahip(uid) || (hoca() && request.auth.uid in resource.data.hocalar);
      allow create, update: if sahip(uid) && canli(uid) && paylasimGecerli();
      allow delete: if sahip(uid);
    }

    /* İstemciye tamamen kapalı; yalnız fonksiyonlar (Admin SDK) erişir: gizli/** (çocuk şifre özetleri, kart sırrı özetleri,
       giriş kilitleri), bagKodlari/** (tek kullanımlık bağlama kodları), ogrenciHesaplari/** (ref → hesap eşlemesi). */
    match /gizli/{yol=**} {
      allow read, write: if false;
    }
    match /bagKodlari/{yol=**} {
      allow read, write: if false;
    }
    match /ogrenciHesaplari/{yol=**} {
      allow read, write: if false;
    }
    /* Haftalık e-posta kuyruğu (Dilim 2): haftalikKuyruk (Admin SDK) yazar, Apps Script (hizmet kimliği, IAM) boşaltır. İstemci
       hiçbir koşulda okuyamaz/yazamaz (e-posta adresi içerir). */
    match /epostaKuyrugu/{yol=**} {
      allow read, write: if false;
    }
  }
}
