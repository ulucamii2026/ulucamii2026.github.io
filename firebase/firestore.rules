rules_version = '2';
// Veli portalı güvenlik kuralları (6 Eyl 2026). Dağıtım: npm run firebase:kurallar (dernek hesabı, proje ulucamii-portal).
//
// Roller
//   hoca  : Firebase kullanıcısı + hocalar/{uid} belgesi var (belge yalnız yönetici betiğiyle yazılır).
//   veli  : Firebase kullanıcısı + aileler/{e-posta} belgesi var (hoca ekranı oluşturur; e-posta küçük harf).
//           Veli yalnız aileler/{e-posta}.ogrenciler listesindeki öğrencilerin belgelerini okur.
// Liste sorguları: veli tarafı her zaman where('ref','==',…) ya da where('yayin','==',true) ile sorar (kural kanıtlanabilir olsun).
service cloud.firestore {
  match /databases/{db}/documents {
    function girisli() { return request.auth != null && request.auth.token.email != null; }
    function eposta() { return request.auth.token.email.lower(); }
    function hoca() { return girisli() && exists(/databases/$(db)/documents/hocalar/$(request.auth.uid)); }
    function aile() { return girisli() && exists(/databases/$(db)/documents/aileler/$(eposta())); }
    function aileOgrencileri() { return get(/databases/$(db)/documents/aileler/$(eposta())).data.ogrenciler; }
    function veliOkur(ref) { return aile() && ref in aileOgrencileri(); }

    match /hocalar/{uid} {
      allow read: if girisli() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if girisli() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sifreVar', 'sonGiris']);
    }
    match /ayarlar/{id} {
      allow read, write: if hoca();
    }
    match /aileler/{ep} {
      allow read: if hoca() || (girisli() && eposta() == ep);
      allow create, delete: if hoca();
      allow update: if hoca()
        || (girisli() && eposta() == ep
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dil', 'cep', 'adSoyad', 'sonGiris', 'sifreVar', 'kitapSecim']));
    }
    match /ogrenciler/{ref} {
      allow read: if hoca() || veliOkur(ref);
      allow write: if hoca();
    }
    match /yoklama/{id} {
      allow read: if hoca() || veliOkur(resource.data.ref);
      allow write: if hoca();
    }
    match /ilerleme/{ref} {
      allow read: if hoca() || veliOkur(ref);
      allow write: if hoca();
    }
    match /degerlendirme/{id} {
      allow read: if hoca() || veliOkur(resource.data.ref);
      allow write: if hoca();
    }
    match /notlar/{id} {
      allow read: if hoca() || (veliOkur(resource.data.ref) && resource.data.veliyeGorunur == true);
      allow write: if hoca();
    }
    match /odevler/{id} {
      allow read: if hoca() || (aile() && resource.data.yayin == true);
      allow write: if hoca();
    }
    match /duyurular/{id} {
      allow read: if hoca() || (aile() && resource.data.yayin == true);
      allow write: if hoca();
    }
    match /bildirimler/{id} {
      allow read: if hoca() || (girisli() && resource.data.eposta == eposta());
      allow create: if aile()
        && request.resource.data.eposta == eposta()
        && request.resource.data.ref in aileOgrencileri()
        && request.resource.data.tur in ['mazeret', 'iletisim', 'soru']
        && request.resource.data.metin is string && request.resource.data.metin.size() <= 1000
        && request.resource.data.okundu == false;
      // Veli, hoca HENÜZ OKUMADIYSA kendi mesajını düzeltebilir (geri alma = silme her zaman kendi mesajında serbest).
      allow update: if hoca()
        || (aile()
          && resource.data.eposta == eposta() && resource.data.okundu == false
          && request.resource.data.eposta == resource.data.eposta
          && request.resource.data.okundu == false
          && request.resource.data.ref in aileOgrencileri()
          && request.resource.data.tur in ['mazeret', 'iletisim', 'soru']
          && request.resource.data.metin is string && request.resource.data.metin.size() <= 1000);
      allow delete: if hoca() || (girisli() && resource.data.eposta == eposta());
    }
  }
}
