---
/**
 * Kur’an kursu sayfa kabuğu (Dilim 4 / P5): ana sitedeki `Base` + `SayfaBasligi` yerine İlim Yolu iskeleti (Taban) + başlık bloğu.
 * Sayfa gövdeleri ana sitedekiyle aynı biçimde yazılıdır (`.kapsayici`, `.kart`, `.dugme` vb. sınıflar styles/kurs.css'te `.kurs` altında tanımlı,
 * Tailwind yok). Henüz hiçbir yerden bağlanmaz: noindex; kanonik adres ulucamii.be'deki asıl sayfadır (arama motoru yinelenen içerik görmesin).
 */
import type { Dil } from '@ortak/i18n/ui';
import Taban from '../layouts/Taban.astro';
import { KURS_YOLLARI, anaAdres } from '../lib/kurs-yollari';
import '../styles/uyum-jetonlari.css';
import '../styles/kurs.css';

interface Props {
  dil: Dil;
  /** Ana site sayfa anahtarı (kurankursu, mufredat, yillikplan, dersmateryalleri, kursgunlugu): egitim yolu ve kanonik adres bundan türer. */
  anahtar: string;
  baslik: string;
  aciklama: string;
  etiket?: string;
  altBaslik?: string;
}
const { dil, anahtar, baslik, aciklama, etiket, altBaslik } = Astro.props;
const yol = KURS_YOLLARI[anahtar];
if (!yol) throw new Error(`kurs yolu tanımsız: ${anahtar}`);
---
<Taban dil={dil} baslik={baslik} aciklama={aciklama} yol={yol} noindex kanonik={anaAdres(dil, anahtar)}>
  <header class="uyum-baslik kurs-baslik">
    <div class="icerik">
      {etiket && <p class="etiket etiket-vurgu">{etiket}</p>}
      <h1>{baslik}</h1>
      {altBaslik && <p class="uyum-alt">{altBaslik}</p>}
      <slot name="baslik-ek" />
    </div>
  </header>
  <div class="kurs">
    <slot />
  </div>
</Taban>

<script>
  import '../scripts/kurs-olcu';
</script>
