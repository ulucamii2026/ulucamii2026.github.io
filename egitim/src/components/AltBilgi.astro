---
/**
 * Alt bilgi: kurs tanıtımı ve ana siteye dönüş, iletişim bloğu (adres · info@ulucamii.be · cami hattı · web; din
 * görevlisinin bilgisi yok), kaynaklar, gizlilik (ana sitedeki «Ezber Kilimi» bölümü: mikrofon ve cihaz hafızası, 2d) ve
 * hukuki satır. Değerler kurumsal kimlikten gelir.
 */
import type { Dil } from '@ortak/i18n/ui';
import { KILIM_METINLERI } from '@ortak/lib/ezber/metinler';
import { ceviri, yol } from '@ortak/i18n/utils';
import { belgeMetinleri } from '../i18n/belge';
import { cevrimdisiMetinleri } from '../i18n/cevrimdisi';
import { kartlarMetinleri } from '../i18n/kartlar';
import { ilimMetinleri } from '../i18n/ilim';
import { kilimimMetinleri } from '../i18n/kilimim';
import { metin } from '../i18n/metinler';
import { takvimMetinleri } from '../i18n/takvim';
import { ANA_SITE, ILETISIM, hukukiSatir, kursAdi } from '../lib/kimlik';

interface Props { dil: Dil }
const { dil } = Astro.props;
const m = metin(dil);
const il = ilimMetinleri(dil);
const belge = belgeMetinleri(dil);
const kilimim = kilimimMetinleri(dil);
const kartlar = kartlarMetinleri(dil);
const cevrimdisi = cevrimdisiMetinleri(dil);
const takvim = takvimMetinleri(dil);
---
<footer class="alt">
  <svg class="kilim-serit" aria-hidden="true" focusable="false"><rect width="100%" height="100%" fill="url(#serit-koyu)" /></svg>
  <div class="icerik">
    <div>
      <p class="alt-damga">{il.marka}</p>
      <p>{il.altTanitim}</p>
      <p>{kursAdi(dil)}</p>
      <p class="don"><a href={`${ANA_SITE}/${dil}/`}>{m.anaSiteyeDon}</a></p>
      <p class="don"><a href={`/${dil}/ezber/`}>{KILIM_METINLERI.baslik[dil]}</a></p>
      <p class="don"><a href={`/${dil}/calisma-belgesi/`}>{belge.baglanti}</a></p>
      <p class="don"><a href={`/${dil}/kilimim/`}>{kilimim.baglanti}</a></p>
      <p class="don"><a href={`/${dil}/takvim/`}>{takvim.baglanti}</a></p>
      <p class="don"><a href={`/${dil}/kartlar/`}>{kartlar.baglanti}</a></p>
      <p class="don"><a href={`/${dil}/cevrimdisi/`}>{cevrimdisi.baglanti}</a></p>
    </div>
    <div>
      <h2>{il.iletisimEtiketi}</h2>
      <ul>
        <li>{ILETISIM.adres}</li>
        <li><a href={`mailto:${ILETISIM.eposta}`}>{ILETISIM.eposta}</a></li>
        <li><a href={`tel:${ILETISIM.telefon.e164}`}>{ILETISIM.telefon.goster}</a></li>
        <li><a href={ILETISIM.web.adres}>{ILETISIM.web.goster}</a></li>
      </ul>
    </div>
    <div>
      <h2>{m.kaynaklarBasligi}</h2>
      <ul>
        <li>{m.kaynakDiyanet} <a href="https://kuran.diyanet.gov.tr">{m.diyanetAdi}</a></li>
        <li>{m.yaziTipleri}</li>
        <li><a href={`${ANA_SITE}${yol(dil, 'gizlilik')}#ezber-kilimi`}>{ceviri(dil)('footer.gizlilik')}</a></li>
      </ul>
    </div>
    <p class="kucuk">{hukukiSatir(dil)}</p>
  </div>
</footer>
