---
/**
 * Üst bilgi (İlim Yolu · Kilim): kilim şeridi, marka damgası, menü, beş dil ve oturum durumu. Ziyaretçi «Giriş yap / Hesap aç», oturum işareti
 * olan «Hesabım» görür; ikisi de HTML'de durur, hangisinin görüneceğini `<html data-oturum>` belirler (public/oturum-isareti.js, Firebase'siz).
 * `sade`: marka damgasından başka bir şey yok (dil bağımsız `/k/` kart girişi sayfası).
 */
import type { Dil } from '@ortak/i18n/ui';
import { ceviri, dilListesi } from '@ortak/i18n/utils';
import { KILIM_METINLERI } from '@ortak/lib/ezber/metinler';
import { ilimMetinleri } from '../i18n/ilim';
import { metin } from '../i18n/metinler';
import { ANA_SITE } from '../lib/kimlik';
import Ikon from './Ikon.astro';

interface Props { dil: Dil; sayfa?: 'ana' | 'ezber' | 'kurs' | 'veli' | 'diger'; yol?: string; sade?: boolean }
const { dil, sayfa = 'diger', yol = '', sade = false } = Astro.props;
const m = metin(dil);
const il = ilimMetinleri(dil);
const t = ceviri(dil);
---
<header class="ust">
  <svg class="kilim-serit" aria-hidden="true" focusable="false"><rect width="100%" height="100%" fill="url(#serit)" /></svg>
  <div class="icerik ust-ic">
    <a class="damga" href={sade ? '/' : `/${dil}/`} aria-label={`${il.marka}, ${il.menuAna}`}>
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><use href="#damga" /></svg>
      <span><span class="damga-ad">{il.marka}</span><span class="damga-alt">{il.markaAlt}</span></span>
    </a>
    {!sade && (
      <>
        <nav class="ust-menu" aria-label={m.anaMenu}>
          <a href={`/${dil}/`} aria-current={sayfa === 'ana' ? 'page' : undefined}>{il.menuAna}</a>
          <a href={`/${dil}/ezber/`} aria-current={sayfa === 'ezber' ? 'page' : undefined}>{KILIM_METINLERI.baslik[dil]}</a>
          <a href={`/${dil}/kurs/`} aria-current={sayfa === 'kurs' ? 'page' : undefined}>{t('nav.kurankursu')}</a>
          <a href={`/${dil}/veli/`} aria-current={sayfa === 'veli' ? 'page' : undefined}>{t('nav.veli')}</a>
          <a href={`${ANA_SITE}/${dil}/`}>ulucamii.be <Ikon ad="dis" /></a>
        </nav>
        <div class="diller" role="group" aria-label={m.dilGrubu}>
          {dilListesi.map((d) => (
            <a href={`/${d}/${yol ? `${yol}/` : ''}`} lang={d} hreflang={d} aria-current={d === dil ? 'true' : undefined}>{d.toUpperCase()}</a>
          ))}
        </div>
        <div class="ust-sag">
          <div class="ust-eylem" data-misafir>
            <a class="dugme ikincil kucuk" href={`/${dil}/hesap/giris/`}>{il.giris}</a>
            <a class="dugme birincil kucuk" href={`/${dil}/hesap/kayit/`}>{il.kayit}</a>
          </div>
          <a class="kisi" data-girisli href={`/${dil}/hesap/`} aria-label={il.hesabim} data-kisi data-sablon={il.hesabimAd('{ad}')}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#kisi-isaret" /></svg>
            <span data-kisi-ad>{il.hesabim}</span>
          </a>
        </div>
      </>
    )}
  </div>
</header>
