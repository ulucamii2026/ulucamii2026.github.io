---
/** Sesli ders dizini — egitim.ulucamii.be/e/ (Dilim 4): asıl adres (ulucamii.be/e/ buraya yönlenir); dizine açık, kanonik kendi adresi. */
import Taban from '../../layouts/Taban.astro';
import SesliDersDizini from '../../components/SesliDersDizini.astro';
import { ANA_SITE } from '../../lib/kimlik';
import '../../styles/uyum-jetonlari.css';
import '../../styles/ecouter.css';
---
<Taban dil="fr" baslik="Cours audio — apprendre et réciter" aciklama="Alphabet arabe, voyelles, sourates et invocations : des cours audio gratuits, accessibles à tous, avec les enregistrements officiels de la Diyanet." kanonik={new URL('/e/', Astro.site).toString()}>
  <div class="ec-sayfa ec-catalogue">
    <nav class="ec-geri" aria-label="Parcours de formation"><a href={`${ANA_SITE}/fr/formation-nouveaux-musulmans/`}>Apprendre ma religion</a></nav>
    <header class="ec-ust">
      <h1>Apprendre, écouter, répéter</h1>
      <p class="ec-altbaslik">Des cours audio pour tous, gratuitement et sans inscription. Vous n’avez besoin ni d’un livre ni d’un code QR.</p>
      <p class="ec-altbaslik">Choisissez un cours, touchez une lettre ou lancez un enregistrement. Les explications sont en français, les récitations en arabe.</p>
      <span class="serit" aria-hidden="true"></span>
    </header>
    <SesliDersDizini dil="fr" />

  </div>
</Taban>
