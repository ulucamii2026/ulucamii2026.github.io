---
/**
 * Madde sayfası (Faz 2b, 19 Ekim 2026; onaylı taslak egitim/docs/taslaklar/madde.html): serlevha, Diyanet tilaveti
 * (dinle–tekrarla çaları), Diyanet metni ve meâli (sayfa dilinin meâli; yoksa «yakında»), hoca onaylı okunuş, namazdaki
 * yeri, çalışma yolu ve aynı şeritteki komşu maddeler. Sesi ya da metni olan her madde sayfa alır.
 * Faz 2e: sayfa aynı zamanda basılı ezber kartıdır. «Kartı yazdır» düğmesi tarayıcının yazdırma penceresini açar; yazdırma
 * stili (styles/kart.css) çalışma araçlarını gizler, metni ve meâli A4'e dizer ve sayfaya götüren vektör kare kodu basar.
 */
import type { Dil } from '@ortak/i18n/ui';
import { dilListesi } from '@ortak/i18n/utils';
import { KATALOG, calismaSayfasiVar, dinlemeSirasi, sesSecenekleri, seviyeOgeleri, sinifHedefleri, yapaySesMi, type KatalogOgesi } from '@ortak/lib/ezber/katalog';
import { SERIT_MOTIFI } from '@ortak/lib/ezber/kilim';
import { BASAMAK_ADLARI, KILIM_METINLERI } from '@ortak/lib/ezber/metinler';
import { anlamBloklari, aralikYaz, arapcaRakam, metinBloklari, onayliOkunus, sayfaMeali, sonKelimeyiAyir } from '@ortak/lib/ezber/madde-metni';
import plan from '@ortak/data/yillik-plan-2026-2027.json';
import Taban from '../../../layouts/Taban.astro';
import Ikon from '../../../components/Ikon.astro';
import { ANA_SITE, kursAdi, veliPortali } from '../../../lib/kimlik';
import { maddeKareKodu } from '../../../lib/kare-kod';
import { cizim } from '../../../lib/cizim';
import { MADDE_METINLERI } from '../../../lib/madde-metinleri';
import { BILGI_METINLERI } from '../../../lib/bilgi-metinleri';
import BilgiBolumu from '../../../components/BilgiBolumu.astro';
import CevrimdisiKutu from '../../../components/CevrimdisiKutu.astro';
import DersSatiri from '../../../components/DersSatiri.astro';
import { metin, tarihYaz } from '../../../i18n/metinler';
import { calismaMetinleri } from '../../../i18n/calisma';
import { DURUSLAR, maddeMetinleri, namazda } from '../../../i18n/madde';
import { kipMetinleri } from '../../../i18n/kip';
import { sinaMetinleri } from '../../../i18n/sina';
import { kartMetinleri } from '../../../i18n/kart';
import { kartlarMetinleri } from '../../../i18n/kartlar';
import { belgeMetinleri } from '../../../i18n/belge';
import { kilimimMetinleri } from '../../../i18n/kilimim';
import { bilgiYazilari } from '../../../i18n/bilgi';
import '../../../styles/calisma.css';
import '../../../styles/madde.css';
import '../../../styles/bilgi.css';
import '../../../styles/cevrimdisi.css';
import '../../../styles/kart.css'; // en sonda: yazdırma stili ekran kurallarını ezer

export function getStaticPaths() {
  return dilListesi.flatMap((dil) => KATALOG.ogeler.filter(calismaSayfasiVar).map((oge) => ({ params: { dil, id: oge.id }, props: { oge } })));
}
interface Props { oge: KatalogOgesi }
const { oge } = Astro.props;
const dil = Astro.params.dil as Dil;
const m = metin(dil);
const c = calismaMetinleri(dil);
const mm = maddeMetinleri(dil);
const sesVar = Boolean(oge.ses?.tam || oge.ses?.parcalar?.length);
const parcalar = oge.ses?.parcalar?.length ? oge.ses.parcalar : oge.ses?.tam ? [oge.ses.tam] : [];
// Diyanet kaydı olmayan Kur'an dışı metin: yapay ses, çalarda görünür etiketle (katalog `ses.yapay`, 24 Ekim 2026).
const yapay = yapaySesMi(oge);
// Aynı maddenin birden çok kaydı (Ezan: beş vakit, katalog `ses.secenekler`, 25 Ekim 2026): seçim grubu çizilir. Varsayılan `ses.tam`dır
// (Ezan'da sabah); giriş listesi, hâfız sesi ve «Kendini sına» yine yalnız `tam` ile çalışır.
const secenekler = sesSecenekleri(oge).length > 1 ? sesSecenekleri(oge) : [];
const varsayilanSecenek = secenekler.find((s) => s.yol === oge.ses?.tam) ?? secenekler[0];
const hedef = sinifHedefleri(plan)[oge.id];
const seviye = KATALOG.seviyeler.find((s) => s.kimlik === oge.seviye)!;
const seritCapasi = oge.seviye === 'kenar' ? 'kenar-suyu' : `serit-${oge.seviye}`;

const mt = MADDE_METINLERI.get(oge.id);
// Bilgi maddesi (iman şartları, farzlar…): ses ve Arapça metin değil, kaynaklı liste (24 Ekim 2026; src/data/ezber/bilgi/<id>.json).
const bilgi = BILGI_METINLERI.get(oge.id);
const bloklar = mt ? metinBloklari(mt, dil) : [];
const meal = mt && sayfaMeali(mt, dil);
// Gruplama cümlesi yalnız birden çok âyeti kapsayan meâl grubu varsa basılır: âyet âyet çeviride (FR Hamidullah) Diyanet
// gruplaması yoktur, «1 · 2 · 3…» de bilgi vermez.
const gruplu = Boolean(meal?.gruplar.some((g) => g.ayetler[0] !== g.ayetler[1]));
// Kur'an dışı maddeler (dualar): künye, başlık ve «meâl yok» iletisi Kur'an'a özgü sözleri taşımaz; hoca onayı yoksa not düşülür.
const dua = Boolean(mt && !mt.kuran);
const duaNotlari = dua && dil === 'tr' ? mt?.zor ?? [] : [];
const arapcaMi = (s: string) => /[؀-ۿ]/.test(s);
const okunus = mt && onayliOkunus(mt, dil);
// Âyet → çalar bölümü: âyet parçaları bölümlerle bire bir olduğunda (tests/ezber-madde-metni.test.mjs) âyete dokunulur.
const parcaSirasi = new Map(
  mt?.kuran && oge.ses?.parcalar?.length === mt.bolumler.length ? mt.bolumler.map((b, i) => [b.no, i] as const) : [],
);
const tamSure = mt?.kuran && oge.tur === 'sure' && mt.kuran.ayetler[0] === 1 && !oge.id.match(/-\d+-\d+$/);
const arAd = tamSure && mt?.sureAdi ? `سُورَةُ ${mt.sureAdi}` : undefined;
const ayetSayisi = mt?.kuran ? mt.kuran.ayetler[1] - mt.kuran.ayetler[0] + 1 : undefined;
const yer = namazda(oge.id, oge.tur);

// Basılı kart: kare kod sayfanın kanonik adresine gider (Taban.astro'daki canonical ile aynı). Metni olmayan maddede kart yoktur.
const k = kartMetinleri(dil);
const kartAdresi = new URL(`/${dil}/calis/${oge.id}/`, Astro.site).toString();
const kareKod = mt ? maddeKareKodu(kartAdresi) : '';

// Çalışma kipleri (Faz 2c, 2d): Arapça metni olan her maddede «Bağlayarak ezberle», «Kademeli gizle» ve «Kendini sına». Veri
// sayfadan istemciye `data-veri` ile gider (satır içi betik yok: CSP). Bölüm sesi yalnız âyet parçaları bölümlerle bire bir
// olduğunda vardır; `hafiz` maddenin bütün dinleme sırasıdır (kendi sesini hafızınkiyle karşılaştırmak için).
const kt = { ...kipMetinleri(dil), ...sinaMetinleri(dil) };
const anlamSayfada = mt ? anlamBloklari(mt, dil) : [];
const kipVeri = mt && mt.bolumler.length
  ? {
      id: oge.id,
      kuran: Boolean(mt.kuran),
      bolumler: mt.bolumler.map((x, i) => ({
        no: x.no,
        ar: x.ar,
        etiket: mt.kuran ? `۝${arapcaRakam(x.no)}` : mt.bolumler.length > 1 ? String(x.no) : '',
        ses: mt.kuran && oge.ses?.parcalar?.length === mt.bolumler.length ? `${ANA_SITE}${oge.ses.parcalar[i]}` : null,
      })),
      hafiz: dinlemeSirasi(oge).map((s) => `${ANA_SITE}${s}`),
      // «Anlamla eşleştir» (Faz 2e): yalnız gözden geçirilmiş anlam metni ve en az iki blok varsa; yoksa oyun düğmesi çıkmaz.
      anlam: anlamSayfada.length >= 2 ? anlamSayfada : undefined,
      m: kt,
    }
  : null;
// Adım 1 (Dinle) sesi olan her maddede hazırdır; 2 (Yüzünden oku) metni olan maddede; 3, 4 ve 5 yalnız metni olan maddede.
// (Yapay sesli, metni henüz olmayan dualarda «Yüzünden oku» da «Yakında» kalır: ortada okunacak metin yok. Tersi de geçerli:
// kitaptan alınan, Diyanet kaydı olmayan dualarda metin vardır, «Dinle» «Yakında» kalır.)
const adimHazir = (a: { hazir: boolean }, i: number) => a.hazir && (i === 0 ? sesVar : Boolean(mt) && (i === 1 || Boolean(kipVeri)));

const serit = seviyeOgeleri(oge.seviye).filter(calismaSayfasiVar);
const sira = serit.findIndex((o) => o.id === oge.id);
const onceki = serit[sira - 1];
const sonraki = serit[sira + 1];
---
<Taban dil={dil} baslik={oge.ad[dil]} aciklama={`${oge.ad[dil]} · ${bilgi ? bilgiYazilari(dil).aciklama : c.giris}`} yol={`calis/${oge.id}`}>
  <div class="icerik madde">
    {mt && <p class="kart-ust kart-yalniz">{k.kart} · {kursAdi(dil)}</p>}
    <nav class="yol" aria-label={mm.yol}>
      <ol>
        <li><a href={`/${dil}/`}>{KILIM_METINLERI.baslik[dil]}</a></li>
        <li><a href={`/${dil}/#${seritCapasi}`}>{seviye.ad[dil]}</a></li>
        <li aria-current="page">{oge.ad[dil]}</li>
      </ol>
    </nav>
    <header class="madde-bas">
      <div class="madalyon" aria-hidden="true"><svg viewBox="0 0 120 120" focusable="false"><use href={`#mt-${SERIT_MOTIFI[oge.seviye]}`} /></svg></div>
      <div class="baslik-blok">
        <h1>{oge.ad[dil]}</h1>
        <p class="bilgi">
          <span>{m.tur[oge.tur]}{ayetSayisi && ayetSayisi > 1 && ` · ${mm.ayet(ayetSayisi)}`}</span>
          <span>{seviye.ad[dil]}</span>
          {hedef && <span>{m.sinifHedefi(tarihYaz(hedef, dil))}</span>}
        </p>
        <DersSatiri dil={dil} id={oge.id} />
      </div>
      {arAd && <p class="ar-ad" lang="ar" dir="rtl">{arAd}</p>}
      {mt && (
        <div class="kart-kare kart-yalniz" data-kart-kare>
          <Fragment set:html={kareKod} />
          <p class="kart-okut">{sesVar ? k.okut : k.okutSessiz}</p>
          <p class="kart-adres" set:html={kartAdresi.replace('https://', '').replaceAll('/', '/<wbr>')} />
        </div>
      )}
    </header>

    <div class="madde-duzen">
      <div class="yan-panel yan-ust">
        {!sesVar && mt && (
          <section class="calisma calisma-sessiz" aria-labelledby="sessiz-baslik">
            <h2 id="sessiz-baslik">{mm.sesYokBaslik}</h2><p>{mm.sesYokNot}</p>
          </section>
        )}
        {sesVar && (
          <section class="calisma calisma-calar" aria-labelledby="calisma-baslik" data-calisma data-baslat={c.baslat}
            data-duraklat={c.duraklat} data-surdur={c.surdur} data-hazir={c.hazir} data-bitti={c.bitti} data-bekliyor={c.bekliyor}
            data-hata={c.hata} data-parca={c.parca}>
            <h2 id="calisma-baslik">{c.baslik}</h2><p>{c.giris}</p>
            {yapay && <p class="yapay-ses" id="yapay-ses-not" data-yapay-ses><span class="yapay-rozet">{c.yapayAd}</span> {c.yapayNot}</p>}
            {secenekler.length > 0 && (
              <fieldset class="vakit-secimi" data-vakit hidden>
                <legend>{c.vakitBaslik}</legend>
                <div class="vakit-sira">
                  {secenekler.map((s) => (
                    <label class="vakit-secenek">
                      <input type="radio" name="vakit" value={s.id} autocomplete="off" checked={s === varsayilanSecenek}
                        data-vakit-secenek data-adres={`${ANA_SITE}${s.yol}`} data-ad={s.ad[dil]} />
                      <span>{s.ad[dil]}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            <fieldset data-ayarlar disabled>
              <legend class="gorunmez">{c.baslik}</legend>
              <label class="calisma-bolum">{c.bolum}<select data-bolum>
                {parcalar.length > 1 && <option value="all">{c.tumu}</option>}
                {parcalar.map((s, i) => <option value={String(i)} data-adres={`${ANA_SITE}${s}`}>{c.parca} {i + 1}</option>)}
              </select></label>
              <label>{c.tekrar}<select data-tekrar><option value="1">{c.bir}</option><option value="3" selected>{c.uc}</option></select></label>
              <label>{c.hiz}<select data-hiz><option value="1">{c.normal}</option><option value="0.75">{c.yavas}</option></select></label>
              <label class="calisma-sira">{c.sira}<select data-sira>
                <option value="0">{c.siraYok}</option><option value="1" selected>{c.sira1}</option><option value="1.5">{c.sira15}</option><option value="2">{c.sira2}</option>
              </select></label>
            </fieldset>
            <div class="calisma-dugmeler"><button class="dugme birincil" type="button" data-oynat aria-describedby={yapay ? 'yapay-ses-not' : undefined} disabled>{c.baslat}</button>
              <button class="dugme ikincil" type="button" data-durdur disabled>{c.durdur}</button></div>
            <p class="calisma-durum" role="status" aria-live="polite" aria-atomic="true" data-durum>{c.hazir}</p>
            <progress class="calisma-ilerleme" data-sira-ilerleme max="1" value="0" aria-hidden="true"></progress>
            <noscript><p>{c.js}</p>{secenekler.length > 0
              ? <ul class="vakit-baglantilar">{secenekler.map((s) => <li><a href={`${ANA_SITE}${s.yol}`}>{m.dinleEtiketi(`${oge.ad[dil]} · ${s.ad[dil]}`)}</a></li>)}</ul>
              : <a href={`${ANA_SITE}${parcalar[0]}`}>{m.dinleEtiketi(oge.ad[dil])}{yapay && ` (${c.yapayAd})`}</a>}</noscript>
            <p class="calisma-not">{!yapay && c.kaynakAciklama}{parcalar.length === 1 && secenekler.length === 0 && ` ${c.parcasiz}`}</p>
            {secenekler.length > 0 && (
              <div class="vakit-notlari" data-vakit-notlari>
                {secenekler.map((s) => (
                  <div data-vakit-not={s.id} hidden={s !== varsayilanSecenek}>
                    {c.vakitNotu[s.id] && <p class="vakit-notu">{c.vakitNotu[s.id]}</p>}
                    {c.vakitEk[s.id] && <><p class="vakit-ek">{c.vakitEk[s.id].metin}</p><p class="kaynak-satiri vakit-kunye">{c.vakitEk[s.id].kunye}</p></>}
                  </div>
                ))}
              </div>
            )}
          </section>
        )}
        <CevrimdisiKutu dil={dil} oge={oge} />
      </div>

      <div class="metin-alani">
        {mt ? (
          <section aria-labelledby="metin-baslik">
            <div class="metin-ust">
              <h2 id="metin-baslik">{meal ? (dua ? mm.metinBaslikDua : mm.metinBaslik) : mm.metinBaslikYalniz}</h2>
              <div class="metin-araclar">
                {kipVeri && (
                  <div class="ar-boyut" role="group" aria-label={kt.arBoyutu} data-ar-boyut hidden>
                    <button class="secim" type="button" data-ar-azalt aria-label={kt.arKucult}><span aria-hidden="true">A−</span></button>
                    <button class="secim" type="button" data-ar-arttir aria-label={kt.arBuyut}><span aria-hidden="true">A+</span></button>
                  </div>
                )}
                {okunus && <button class="secim" type="button" aria-pressed="false" data-okunus-dugme hidden><Ikon ad="goz" />{mm.okunusGoster}</button>}
                <button class="secim" type="button" data-yazdir hidden><Ikon ad="yazici" />{k.yazdir}</button>
                <a class="secim secim-bag" href={`/${dil}/kartlar/?sec=${oge.id}`} data-kartlar-bag><Ikon ad="kart" />{kartlarMetinleri(dil).cokluBas}</a>
              </div>
            </div>
            {!meal && <p class="meal-yok">{dua ? mm.anlamYok : mm.mealYok}</p>}
            {dua && !mt.onay && <p class="onay-bekliyor">{mm.onayBekliyor}</p>}
            {parcaSirasi.size > 0 && <p class="metin-ipucu" data-dokun-ipucu hidden>{mm.dokun}</p>}
            <div class="metin" data-metin data-okunus="gizli">
              {bloklar.map((b) => (
                <div class="ayet-grubu">
                  <p class="ar" lang="ar" dir="rtl">{b.bolumler.map((x) => (
                    <>
                      {/* Son kelime ve âyet numarası bölünmez: numara satıra tek başına düşmez. */}
                      <span class="ayet" data-no={x.no}>{sonKelimeyiAyir(x.ar)[0]}<span class="ayet-son">{sonKelimeyiAyir(x.ar)[1]}
                        {parcaSirasi.has(x.no)
                          ? <button class="ayet-no" type="button" data-parca={parcaSirasi.get(x.no)} aria-label={mm.ayetiDinle(x.no)} disabled>۝{arapcaRakam(x.no)}</button>
                          : mt.kuran && <span class="ayet-no" aria-hidden="true">۝{arapcaRakam(x.no)}</span>}</span></span>{' '}
                    </>
                  ))}</p>
                  {b.okunus && <div class="okunuslar">{b.okunus.map((o) => <p class="okunus" lang={dil === 'fr' ? 'fr' : 'tr'}><span class="no">{o.no}</span>{o.metin}</p>)}</div>}
                  {b.meal !== undefined && <p class="meal">{(!dua || mt.bolumler.length > 1) && <span class="no">{aralikYaz(b.ayetler)}</span>}{b.meal}</p>}
                </div>
              ))}
            </div>
            {duaNotlari.length > 0 && (
              <section class="zor-yerler" aria-labelledby="zor-baslik">
                <h3 id="zor-baslik">{mm.zorBaslik}</h3>
                <ul>{duaNotlari.map((z) => (
                  <li><b lang={arapcaMi(z.kelime) ? 'ar' : undefined} dir={arapcaMi(z.kelime) ? 'rtl' : undefined}>{z.kelime}</b>{z.not && ` — ${z.not}`}</li>
                ))}</ul>
              </section>
            )}
            <p class="kaynak-satiri">
              {dua
                ? (dil !== 'tr' && meal ? mm.kunyeKaynakDil(mt.kaynak.ar, meal.kaynak) : mm.kunyeKaynak(mt.kaynak.ar, meal?.kaynak))
                : <>{mm.kunyeAr}{meal && ` ${mm.kunyeMeal}${gruplu ? ` ${mm.gruplama(meal.gruplar.map((g) => aralikYaz(g.ayetler)).join(' · '))}` : ''}`}</>}
              {meal?.inceleme && ` ${mm.mealInceleme}`}{okunus && ` ${mm.okunusUsulu}`}
            </p>
          </section>
        ) : bilgi ? <BilgiBolumu oge={oge} bilgi={bilgi} dil={dil} /> : <p class="metin-yok">{mm.metinYok}</p>}

        {!bilgi && (
        <section class="yollar-bolumu" aria-labelledby="yol-baslik">
          <h2 id="yol-baslik">{mm.yolBaslik}</h2>
          <ol class="yollar">
            {mm.adimlar.map((a, i) => (
              <li class={adimHazir(a, i) ? undefined : 'sonra'}>
                <span class="sira" aria-hidden="true">{i + 1}</span>
                <h3>{a.ad}</h3><p>{a.metin}</p>
                {!adimHazir(a, i) && <span class="yakinda">{mm.yakinda}</span>}
              </li>
            ))}
          </ol>
          {kipVeri && (
            <section class="kip" data-kip data-veri={JSON.stringify(kipVeri)} aria-labelledby="kip-baslik" hidden>
              <h3 id="kip-baslik">{kt.baslik}</h3>
              <div class="kip-sekmeler" role="tablist" aria-label={kt.sekmeler}>
                <button type="button" role="tab" id="kip-sekme-zincir" data-kip-sekme="zincir" aria-selected="true" aria-controls="kip-panel-zincir" tabindex="0"><span class="sira" aria-hidden="true">3</span>{mm.adimlar[2].ad}</button>
                <button type="button" role="tab" id="kip-sekme-gizle" data-kip-sekme="gizle" aria-selected="false" aria-controls="kip-panel-gizle" tabindex="-1"><span class="sira" aria-hidden="true">4</span>{mm.adimlar[3].ad}</button>
                <button type="button" role="tab" id="kip-sekme-sina" data-kip-sekme="sina" aria-selected="false" aria-controls="kip-panel-sina" tabindex="-1"><span class="sira" aria-hidden="true">5</span>{mm.adimlar[4].ad}</button>
              </div>
              <div role="tabpanel" id="kip-panel-zincir" class="kip-panel" data-kip-panel="zincir" aria-labelledby="kip-sekme-zincir" tabindex="0"></div>
              <div role="tabpanel" id="kip-panel-gizle" class="kip-panel" data-kip-panel="gizle" aria-labelledby="kip-sekme-gizle" tabindex="0" hidden></div>
              <div role="tabpanel" id="kip-panel-sina" class="kip-panel" data-kip-panel="sina" aria-labelledby="kip-sekme-sina" tabindex="0" hidden></div>
            </section>
          )}
        </section>
        )}
        <p class="belge-bag"><a href={`/${dil}/calisma-belgesi/`}>{belgeMetinleri(dil).baglanti}</a> · <a href={`/${dil}/kilimim/`}>{kilimimMetinleri(dil).baglanti}</a> · <a href={`/${dil}/kartlar/`}>{kartlarMetinleri(dil).baglanti}</a></p>
      </div>

      <div class="yan-panel yan-alt">
        <aside class="hoca-kutu" aria-labelledby="hoca-baslik">
          <h2 id="hoca-baslik">{mm.hocaBaslik}</h2>
          <p>{mm.hocaMetin}</p>
          <ol class="basamak-sirasi">
            {([1, 2, 3, 4] as const).map((b) => (
              <li><svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                {b === 4 && <rect x="4" y="4" width="112" height="112" class="kl-b4-cerceve" />}
                <use href="#mt-goz" class={`kl-m kl-b${b}`} /></svg>{BASAMAK_ADLARI[b][dil]}</li>
            ))}
          </ol>
          <a href={veliPortali(dil)}>{mm.veliBag}</a>
        </aside>
        {yer && (
          <section class="namazda" aria-labelledby="namazda-baslik">
            <h2 id="namazda-baslik">{mm.namazBaslik}</h2>
            <div class="durus-sirasi">
              {DURUSLAR.map((d) => (
                <figure class={d === yer.durus ? 'burada' : undefined}><Fragment set:html={cizim(`durus-${d}`)} /><figcaption>{mm.durus[d]}</figcaption></figure>
              ))}
            </div>
            <p>{yer.metin[dil]}</p>
            <p class="kaynak-satiri">{yer.kaynak?.[dil] ?? mm.namazKaynak}</p>
          </section>
        )}
      </div>
    </div>

    <nav class="komsu" aria-label={seviye.ad[dil]}>
      {onceki && <a href={`/${dil}/calis/${onceki.id}/`}><span><Ikon ad="geri" />{mm.onceki}</span><b>{onceki.ad[dil]}</b></a>}
      <a class="calisma-geri" href={`/${dil}/#m-${oge.id}`}><span>{mm.seriteDon}</span><b>{seviye.ad[dil]}</b></a>
      {sonraki && <a class="sonraki" href={`/${dil}/calis/${sonraki.id}/`}><span>{mm.sonraki}<Ikon ad="ok" /></span><b>{sonraki.ad[dil]}</b></a>}
    </nav>
    {mt && <p class="kart-alt kart-yalniz">{c.ilerleme} · {kursAdi(dil)} · egitim.ulucamii.be</p>}
  </div>
</Taban>
