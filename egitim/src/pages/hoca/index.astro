---
/**
 * Hoca ekranı — egitim.ulucamii.be/hoca/ (Dilim 4 / P4, 10 Kasım 2026; yalnız Türkçe). Ana sitedeki /hoca/ sayfasının egitim kabuğu: aynı betik
 * (src/scripts/hoca-ekrani.ts), aynı CSS, aynı `hoca-veri` bloğu. Eklemeli: ulucamii.be/hoca/ yerinde durur; bu sayfa HENÜZ hiçbir yerden
 * bağlanmaz. noindex, robots.txt'te yasak, site haritasında ve çevrim dışı önbellekte yok. Kimlik: Firebase Authentication (hocalar/{uid} belgesi
 * olan hesaplar; ilim uygulaması + egitim alanı, src/lib/firebase.ts egitim bayrağı); veri: Firestore, kurallar firebase/firestore.rules.
 */
import { yol } from '@ortak/i18n/utils';
import plan from '@ortak/data/yillik-plan-2026-2027.json';
import materyal from '@ortak/data/ders-materyalleri.json';
import siteYaml from '@ortak/content/ayarlar/site.yaml?raw';
import { parse } from 'yaml';
import { ANA_SITE } from '../../lib/kimlik';
import Taban from '../../layouts/Taban.astro';
import '@ortak/styles/haftalik-bulten.css';
import '@ortak/styles/ders-defteri.css';
import '@ortak/styles/hoca-odev.css';
import '@ortak/styles/hoca-ezber.css';
import '@ortak/styles/hoca-envanter.css';
import '@ortak/styles/hoca-ilim-yolu.css';
import '@ortak/styles/portal-sinif.css';
import '@ortak/styles/baski.css';
import '../../styles/uyum-jetonlari.css';
import '../../styles/hoca.css';

type PlanGun = { tarih: string; hafta: number; gun: string; dersler: { no?: number; sira?: number; alan: string; kod: string; konu: string; ezber?: string[] }[] };
const gunler = (plan as { gunler: PlanGun[] }).gunler.map((g) => ({
  tarih: g.tarih, hafta: g.hafta, gun: g.gun,
  dersler: g.dersler.map((d) => ({ no: d.sira ?? d.no ?? 0, kod: d.kod, alan: d.alan, konu: d.konu, ezber: d.ezber || [] })),
}));
const materyalGunleri = (materyal.gunler as { tarih: string }[]).map((g) => g.tarih);
// Defter çevirisi ucu (Apps Script): ana sitedeki hoca sayfasıyla aynı kaynak (CMS'in site.yaml dosyası).
const ceviriUcu = (parse(siteYaml) as { site: { servisler: { basvuru: string } } }).site.servisler.basvuru;
const veliYollari = { tr: '/tr/veli/', fr: '/fr/veli/', en: '/en/veli/', nl: '/nl/veli/', de: '/de/veli/' };
const veri = {
  donem: (plan as { donem: string }).donem, gunler, materyalGunleri,
  materyalYolu: ANA_SITE + yol('tr', 'dersmateryalleri'), // ders materyalleri sayfası henüz ulucamii.be'dedir (P5b'de egitim'e taşınınca /tr/kurs/materyaller/)
  veliYollari,
  ceviriUcu,
};
---
<Taban dil="tr" baslik="Hoca ekranı" aciklama="Kur’an kursu hoca ekranı: yoklama, ilerleme, ezber-ödev, duyuru." noindex oturum={false}>
  <div class="icerik uyum-ana dar">
    <div id="hoca-ekrani" data-veli-yolu={veliYollari.tr} class="portal hoca">
      <p class="not">Yükleniyor…</p>
      <noscript><p class="not">Bu sayfa JavaScript gerektirir.</p></noscript>
    </div>
    <div id="hoca-durum" class="portal-durum" role="status" aria-live="polite" hidden></div>
    <script is:inline type="application/json" id="hoca-veri" set:html={JSON.stringify(veri).replace(/</g, '\\u003c')} />
  </div>
</Taban>

<script>
  import { hocaEkrani } from '@ortak/scripts/hoca-ekrani';
  hocaEkrani();
</script>
