 "farklar": {
  "106:2": {
   "diyanet": "6a95432945d13dbb",
   "neden": "İmlâ farkı, lafız aynı (îlâfihim): Diyanet uzatma yâsını tam harf ve çeker esreyle yazar (اٖیلَافِهِمْ); Tanzil Uthmani küçük yâ (ۦ) kullanır, gevşek iskelet onu düşürür."
  },
  "91:13": {
   "diyanet": "64dff5602fe298f9",
   "neden": "İmlâ farkı, lafız aynı (vesukyâhâ): Diyanet'in Türk imlâsı elif-i maksûreyi yâ ve üstünde çeker üstünle yazar (وَسُقْیٰیهَا); Tanzil Uthmani metni küçük elifle (وَسُقْيَٰهَا) yazar."
  },
  "91:15": {
   "diyanet": "363fe76506465eb4",
   "neden": "İmlâ farkı, lafız aynı (ukbâhâ): Diyanet elif-i maksûreyi yâ ve çeker üstünle yazar (عُقْبٰیهَا); Tanzil Uthmani yâsız, küçük elifle (عُقْبَٰهَا) yazar."
  }
 }
